(module create chunkstore
  (function create empty (visibility public)
    (returns ChunkPlan) (effect pure)
    (body (record structural (field total (i64 -1)) (field hashes (list Text)))))

  (function create read (visibility public)
    (parameter create id (type Text))
    (returns ChunkPlan) (effect (task (requirement service::app::store)))
    (body (let (binding items (call db::read (text "upload-parts") (local id))) (in (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local items)) (i64 1)) (call std::data-decode-or (types ChunkPlan) (field (call std::list-get (types std::DataEntry) (local items) (i64 0)) std::DataEntry::value) (call chunkstore::empty)) (call chunkstore::empty))))))

  (function create save (visibility public)
    (parameter create id (type Text))
    (parameter create plan (type ChunkPlan))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (call db::put (text "upload-parts") (local id) (call std::data-encode (types ChunkPlan) (local plan)))))

  (function create owner (visibility public)
    (parameter create ctx (type Context))
    (parameter create media (type Media))
    (returns Bool) (effect pure)
    (body (if (call util::signed (local ctx)) (if (call std::text-equal (field (local media) (name owner)) (field (local ctx) (name user))) (if (call std::i64-equal (field (local media) (name offset)) (i64 -1)) (bool true) (bool false)) (bool false)) (bool false))))

  (function create pending (visibility public)
    (parameter create ctx (type Context))
    (parameter create id (type Text))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (let (binding media (call db::media (local id))) (in (if (call chunkstore::owner (local ctx) (local media)) (if (call std::text-equal (field (local media) (name state)) (text "uploading")) (bool true) (bool false)) (bool false))))))

  (function create start (visibility public)
    (parameter create ctx (type Context))
    (parameter create id (type Text))
    (parameter create name (type Text))
    (parameter create size (type I64))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (if (if (call util::token (local id)) (if (call util::clean (local name) (i64 1) (i64 255)) (if (call chunkmath::valid-size (local size)) (bool true) (bool false)) (bool false)) (bool false)) (let (binding media (call db::media (local id))) (in (if (call util::token (field (local media) (name id))) (if (if (call chunkstore::owner (local ctx) (local media)) (if (call std::text-equal (field (local media) (name name)) (local name)) (if (call std::i64-equal (field (call chunkstore::read (local id)) (name total)) (local size)) (if (call util::has (list Text (text "uploading") (text "ready")) (field (local media) (name state)) (i64 0)) (bool true) (bool false)) (bool false)) (bool false)) (bool false)) (call chunkstore::position (local id)) (call page::error (i64 409) (text "This upload is no longer available. Choose the file again from a new upload page."))) (if (call drive::reserve (local ctx) (local id) (text "") (local size)) (sequence (call db::save-media (record structural (field id (field (call db::media (local id)) (name id))) (field owner (field (call db::media (local id)) (name owner))) (field name (local name)) (field mime (field (call db::media (local id)) (name mime))) (field alt (field (call db::media (local id)) (name alt))) (field folder (field (call db::media (local id)) (name folder))) (field size (local size)) (field created (field (call db::media (local id)) (name created))) (field sensitive (field (call db::media (local id)) (name sensitive))) (field state (field (call db::media (local id)) (name state))) (field digest (field (call db::media (local id)) (name digest))) (field refs (field (call db::media (local id)) (name refs))) (field version (field (call db::media (local id)) (name version))) (field offset (i64 -1)) (field stored (field (call db::media (local id)) (name stored))))) (call chunkstore::save (local id) (record structural (field total (local size)) (field hashes (list Text)))) (call chunkstore::position (local id))) (call page::error (i64 409) (text "There is not enough free space in your Drive.")))))) (call page::error (i64 422) (text "Choose a file up to 256 MiB with a valid file name.")))))

  (function create position (visibility public)
    (parameter create id (type Text))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (call page::raw (i64 200) (call std::bytes-from-text (call std::i64-to-text (call std::list-length (types Text) (field (call chunkstore::read (local id)) (name hashes))))) (text "text/plain; charset=utf-8") (list Header))))

  (function create admit (visibility public)
    (parameter create ctx (type Context))
    (parameter create id (type Text))
    (parameter create index (type I64))
    (parameter create length (type I64))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (let (binding plan (call chunkstore::read (local id))) (in (if (call chunkstore::pending (local ctx) (local id)) (if (call chunkmath::valid-size (field (local plan) (name total))) (if (call std::less-equal (i64 0) (local index)) (if (call std::less (local index) (call chunkmath::count (field (local plan) (name total)))) (if (call std::less-equal (local index) (call std::list-length (types Text) (field (local plan) (name hashes)))) (if (call std::i64-equal (local length) (call chunkmath::length (field (local plan) (name total)) (local index))) (bool true) (bool false)) (bool false)) (bool false)) (bool false)) (bool false)) (bool false))))))

  (function create ack (visibility public)
    (parameter create ctx (type Context))
    (parameter create id (type Text))
    (parameter create index (type I64))
    (parameter create receipt (type PutReceipt))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (let (binding plan (call chunkstore::read (local id))) (binding size (field (local receipt) (name size))) (binding hash (field (local receipt) (name blake3))) (binding count (call std::list-length (types Text) (field (local plan) (name hashes)))) (in (if (if (call chunkstore::admit (local ctx) (local id) (local index) (local size)) (if (call std::text-equal (field (local receipt) (name key)) (call chunkmath::key (local id) (local index))) (if (call util::token (local hash)) (bool true) (bool false)) (bool false)) (bool false)) (if (call std::i64-equal (local index) (local count)) (call chunkstore::save (local id) (record structural (field total (field (local plan) (name total))) (field hashes (call std::list-append (types Text) (field (local plan) (name hashes)) (local hash))))) (call std::text-equal (call std::list-get (types Text) (field (local plan) (name hashes)) (local index)) (local hash))) (bool false))))))

  (function create complete (visibility public)
    (parameter create ctx (type Context))
    (parameter create id (type Text))
    (parameter create mime (type Text))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (let (binding media (call db::media (local id))) (binding plan (call chunkstore::read (local id))) (in (if (if (call chunkstore::owner (local ctx) (local media)) (if (call chunkmath::valid-size (field (local plan) (name total))) (if (call std::i64-equal (call std::list-length (types Text) (field (local plan) (name hashes))) (call chunkmath::count (field (local plan) (name total)))) (bool true) (bool false)) (bool false)) (bool false)) (if (call std::text-equal (field (local media) (name state)) (text "ready")) (bool true) (if (call std::text-equal (field (local media) (name state)) (text "uploading")) (sequence (call db::save-media (record structural (field id (field (local media) (name id))) (field owner (field (local media) (name owner))) (field name (field (local media) (name name))) (field mime (local mime)) (field alt (field (local media) (name alt))) (field folder (field (local media) (name folder))) (field size (field (local media) (name size))) (field created (field (local media) (name created))) (field sensitive (bool false)) (field state (text "ready")) (field digest (call util::digest (call std::text-join (field (local plan) (name hashes)) (text "/")))) (field refs (field (local media) (name refs))) (field version (call std::add (field (local media) (name version)) (i64 1))) (field offset (field (local media) (name offset))) (field stored (field (local media) (name stored))))) (bool true))  (bool false))) (bool false))))))

)
