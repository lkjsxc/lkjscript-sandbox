(module create downloadview
  (function create page (visibility public)
    (parameter create ctx (type Context))
    (parameter create request (type Request))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (let (binding media (call db::media (call util::query (local request) (text "id")))) (binding note (call db::note (call util::query (local request) (text "note")))) (in (if (call access::media (local ctx) (local media) (local note)) (call page::ok (local ctx) (text "Download") (call std::text-join (list Text (text "<section class=\"panel stack download-workspace\"><h2>") (call std::html-escape-text (field (local media) (name name))) (text "</h2><p class=\"field-help\">") (call page::bytes (field (local media) (name size))) (text "</p><a class=\"button primary\" data-download=\"1\" data-size=\"") (call std::i64-to-text (field (local media) (name size))) (text "\" data-name=\"") (call std::html-escape-text (field (local media) (name name))) (text "\" href=\"") (call std::html-escape-text (call paths::canonical (call std::text-join (list Text (text "/media?id=") (field (local media) (name id)) (text "&note=") (field (local note) (name id)) (text "&download=yes")) (text "")))) (text "\">Download file</a><progress class=\"transfer-progress\" hidden></progress><p class=\"transfer-status\" role=\"status\" aria-live=\"polite\"></p><noscript><p>JavaScript is required to download files larger than 32 MiB.</p></noscript></section>")) (text ""))) (call page::error (i64 404) (text "This file is unavailable.")))))))

)
