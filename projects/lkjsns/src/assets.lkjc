-child(2)){grid-template-columns:repeat(2,minmax(0,1fr))}\n.media-original{min-width:0;margin:0;overflow:hidden}.image-original{display:block;border-radius:11px;overflow:hidden;background:var(--bg)}\n.media-original img,.media-original video{display:block;width:100%;max-height:540px;object-fit:contain;border-radius:11px;background:var(--bg)}.media-original audio{display:block;max-width:100%;width:100%;margin:10px 0}\n.media-grid:has(>:nth-child(2)) img{height:230px;object-fit:cover}.media-original figcaption{font-size:.77rem;color:var(--muted);padding:8px 0 2px;overflow-wrap:anywhere}\n.media-download{display:block;padding-top:6px;min-height:30px;overflow-wrap:anywhere;font-size:.74rem;color:var(--muted)}.sensitive-media{border:1px solid var(--line);border-radius:11px;padding:0 12px;min-width:0}.sensitive-media[open]{padding-bottom:12px}\n.empty{padding:24px 26px;text-align:center}.empty>svg{width:26px;height:26px;color:var(--muted);margin-bottom:10px}.empty h2{font-size:1rem;margin-bottom:6px}.empty p{font-size:.83rem;color:var(--muted);max-width:380px;margin:0 auto 14px}\n.drive-toolbar{margin-bottom:12px}.drive-toolbar .context-hint{max-width:360px}\n.quota{padding:10px 18px;background:var(--surface);border:1px solid var(--line);border-radius:12px;margin-bottom:12px;font-size:.79rem}.quota strong{font-size:.83rem}.quota progress{display:block;width:100%;height:5px;margin:8px 0;accent-color:var(--accent)}.quota p{font-size:.74rem;color:var(--muted)}\n.drive-filters{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr) minmax(0,1.2fr) auto;gap:9px;align-items:end;margin-bottom:12px}.drive-filters label{font-size:.75rem}.drive-filters input,.drive-filters select{padding:10px 9px;font-size:.82rem}.drive-filters button{min-height:43px;padding:9px 12px}\n.drive-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;margin-bottom:12px}.file-card{min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:12px;background:var(--surf