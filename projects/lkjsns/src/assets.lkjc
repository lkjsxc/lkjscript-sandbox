(module create assets
  (function create style (visibility public) (returns Text) (effect pure) (body (text "/* Native, server-rendered interface. No remote fonts, scripts, or motion loops. */\n:root{color-scheme:light dark;--bg:#f6f6f6;--surface:#fff;--ink:#1d1d1d;--muted:#5e5e5e;--line:#d4d4d4;--control-line:#777;--accent:#303030;--on-accent:#fff;--tint:#eee;--danger:#303030;--danger-bg:#eee;--radius:14px;font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:16px;line-height:1.6}\n*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink)}\na{color:inherit;text-decoration:none}a:hover{color:var(--accent)}\nbutton,input,textarea,select{font:inherit;color:inherit}button{cursor:pointer}\nbutton,a,input,textarea,select,summary{-webkit-tap-highlight-color:transparent}\na:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--accent);outline-offset:3px}\nsvg{width:21px;height:21px;flex:none;vertical-align:middle}h1,h2,h3,p{margin:0}\nh1{min-width:0;overflow-wrap:anywhere;font-size:1.24rem;letter-spacing:-.02em;font-weight:720}h2{font-size:1.02rem}h3{font-size:.95rem}p+p{margin-top:.9em}\nsmall,.muted{color:var(--muted)}small{font-size:.8rem}strong{font-weight:650}\n.skip{position:fixed;top:-100px;left:16px;z-index:100;padding:12px;background:var(--surface);border:1px solid var(--accent)}.skip:focus{top:8px}\n.layout{max-width:1080px;margin:0 auto;display:grid;grid-template-columns:220px minmax(0,728px);gap:36px;padding:20px 32px 40px;align-items:start}\n.sidebar{position:sticky;top:20px;min-height:calc(100dvh - 40px);display:flex;flex-direction:column;gap:14px}\n.brand{display:flex;gap:11px;align-items:center;font-size:1.4rem;font-weight:750;letter-spacing:-.07em;padding:2px 14px}\n.brand-mark{display:block;width:32px;height:32px;flex:none;object-fit:contain;border-radius:50%;background:transparent}\n.nav{display:grid;gap:3px}.nav a{display:flex;align-