(module create assets
  (function create style (visibility public)
    (returns Text) (effect pure)
    (body (text "/* Native, server-rendered interface. No remote fonts, scripts, or motion loops. */\n:root{color-scheme:light dark;--bg:#f6f7fa;--surface:#fff;--ink:#1b2332;--muted:#606b7e;--line:#dce2ec;--accent:#315bce;--tint:#edf2ff;--danger:#a02d3b;--danger-bg:#fff1f2;--radius:14px;font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:16px;line-height:1.6}\n*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink)}\na{color:inherit;text-decoration:none}a:hover{color:var(--accent)}\nbutton,input,textarea,select{font:inherit;color:inherit}button{cursor:pointer}\nbutton,a,input,textarea,select,summary{-webkit-tap-highlight-color:transparent}\na:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--accent);outline-offset:3px}\nsvg{width:21px;height:21px;flex:none;vertical-align:middle}h1,h2,h3,p{margin:0}\nh1{min-width:0;overflow-wrap:anywhere;font-size:1.24rem;letter-spacing:-.02em;font-weight:720}h2{font-size:1.02rem}h3{font-size:.95rem}p+p{margin-top:.9em}\nsmall,.muted{color:var(--muted)}small{font-size:.8rem}strong{font-weight:650}\n.skip{position:fixed;top:-100px;left:16px;z-index:100;padding:12px;background:var(--surface);border:1px solid var(--accent)}.skip:focus{top:8px}\n.layout{max-width:1080px;margin:0 auto;display:grid;grid-template-columns:220px minmax(0,728px);gap:36px;padding:30px 32px 64px;align-items:start}\n.sidebar{position:sticky;top:30px;min-height:calc(100dvh - 60px);display:flex;flex-direction:column;gap:22px}\n.brand{display:flex;gap:11px;align-items:center;font-size:1.4rem;font-weight:750;letter-spacing:-.07em;padding:2px 14px}\n.brand-mark{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;background:var(--ink);color:var(--surface);font:600 14px ui-monospace,monospace;letter-spacing:-2px}\n.nav{display:grid;gap:3px}.nav a{display:flex;align-items:center;gap:14px;min-height:47px;padding:11px 14px;border-radius:10px;color:var(--muted);font-weight:560}\n.nav a:hover{background:var(--surface);color:var(--ink)}.nav a[aria-current=page]{background:var(--tint);color:var(--accent)}\n.sidebar>.primary{margin:0 6px}.account{margin-top:auto;display:grid;gap:14px;padding:18px 14px 0;border-top:1px solid var(--line);overflow-wrap:anywhere}\n.account-identity{display:flex;align-items:center;gap:10px;min-height:44px}.account-identity strong{font-size:.88rem}.account small{font-size:.76rem}\n.content{min-width:0}.page-header{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:42px;margin-bottom:21px;padding:0 2px}\n.button,button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:9px 16px;border:1px solid var(--line);border-radius:9px;background:var(--surface);font-size:.91rem;font-weight:600;line-height:1.5;text-align:center}\n.button:hover,button:hover{border-color:var(--accent);color:var(--accent)}.primary{background:var(--accent);border-color:var(--accent);color:#fff}.primary:hover{color:#fff;filter:brightness(.94)}\n.subtle{background:transparent;border-color:transparent}.compact{padding:6px 11px;min-height:36px;font-size:.82rem}.danger{color:var(--danger)}.full{width:100%}\nbutton:disabled{cursor:not-allowed;opacity:.48}button[aria-pressed=true]{background:var(--tint);border-color:var(--accent);color:var(--accent)}\n.panel,.feed,.note-detail{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius)}.panel{padding:26px;margin-bottom:18px}\n.panel>h2{margin-bottom:13px}.stack{display:grid;gap:18px}.row,.toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.spread{justify-content:space-between}.end{justify-content:flex-end}\nlabel{display:grid;gap:7px;font-size:.86rem;font-weight:560;min-width:0}input:not([type=checkbox]),textarea,select{width:100%;min-width:0;padding:11px 12px;border:1px solid var(--line);border-radius:9px;background:var(--surface);line-height:1.6;box-shadow:none}\ntextarea{resize:vertical;min-height:116px;font-weight:400;font-size:1rem}textarea[readonly]{background:var(--bg)}input[type=checkbox]{width:18px;height:18px;accent-color:var(--accent);flex:none}\n.check{display:flex;align-items:center;gap:9px;font-weight:400;margin:15px 0}.field-help,.context-hint{color:var(--muted);font-size:.82rem;font-weight:400;line-height:1.8}\n.field-help a,.context-hint a,.note-body a,.usage-list a,.crumbs a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}\n.context-hint{margin-bottom:17px}.row .context-hint,.toolbar .context-hint{margin:0}.section-heading{margin:28px 2px 12px}\nsummary{cursor:pointer;min-height:42px;display:list-item;list-style-position:inside;padding:8px 0;font-size:.88rem;font-weight:600}details>p{margin:10px 0}details[open]>summary{margin-bottom:10px}\n.notice{padding:14px 17px;border:1px solid var(--line);border-radius:11px;background:var(--tint);font-size:.86rem;margin-bottom:18px}.notice.danger{background:var(--danger-bg);border-color:var(--danger);color:var(--danger)}\n.tabs{display:flex;align-items:center;gap:28px;padding:0 26px;overflow:auto;white-space:nowrap}.tabs a{padding:14px 0;border-bottom:2px solid transparent;font-size:.9rem;font-weight:600;color:var(--muted)}\n.tabs a[aria-current=page]{border-color:var(--accent);color:var(--ink)}.feed:has(>.tabs){margin-bottom:12px;border-radius:12px}\n.note{padding:24px 28px;border-bottom:1px solid var(--line);overflow-wrap:anywhere}.note:last-child{border-bottom:0}\n.note-head{display:flex;align-items:center;gap:11px;margin-bottom:13px}.avatar{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--tint);color:var(--accent);font-size:.98rem;font-weight:650;flex:none}\n.identity{min-width:0;flex:1}.identity>a{font-weight:650;font-size:.93rem}.identity .meta,.meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;color:var(--muted);font-size:.76rem;line-height:1.6}\n.badge{font-size:.69rem;padding:1px 7px;border:1px solid var(--line);border-radius:99px;line-height:1.6}.note-body{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.65;font-size:.97rem}\n.reply-context{color:var(--muted);font-size:.79rem;margin:0 0 13px}.reply-context a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}\n.note-actions{display:flex;align-items:center;gap:5px;flex-wrap:wrap;margin:17px -8px -4px}.note-actions form{margin:0}.note-actions button,.note-actions .button{padding:7px 10px;font-size:.77rem;min-height:36px;border-color:transparent;background:transparent;color:var(--muted)}\n.note-actions button[aria-pressed=true]{background:var(--tint);color:var(--accent)}.note-actions button:hover,.note-actions a:hover{background:var(--bg);color:var(--accent)}\n.cw{padding:0 14px;border:1px solid var(--line);border-radius:10px}.cw>summary{font-weight:550;overflow-wrap:anywhere}.cw[open]{padding-bottom:15px}\n.composer textarea[name=body]{min-height:238px;border-color:transparent;padding:2px 0;background:transparent;line-height:1.7}.composer textarea[name=body]:focus-visible{outline-offset:7px}\n.composer-tools{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px}.composer-tools .field-help{flex:1;min-width:180px}.attachment-button{white-space:normal}\n.composer-attachments>h2{margin-bottom:11px;font-size:.86rem}.form-actions{padding-top:10px;border-top:1px solid var(--line)}.destructive>summary{color:var(--muted)}\n.conflict{white-space:pre-wrap;overflow-wrap:anywhere;max-height:280px;overflow:auto;margin:12px 0;padding:15px;background:var(--bg);border:1px solid var(--line);border-radius:9px;font:inherit;font-size:.86rem}\n.media-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:10px;margin-top:16px}.media-grid:has(>:nth-child(2)){grid-template-columns:repeat(2,minmax(0,1fr))}\n.media-original{min-width:0;margin:0;overflow:hidden}.image-original{display:block;border-radius:11px;overflow:hidden;background:var(--bg)}\n.media-original img,.media-original video{display:block;width:100%;max-height:540px;object-fit:contain;border-radius:11px;background:var(--bg)}.media-original audio{display:block;max-width:100%;width:100%;margin:10px 0}\n.media-grid:has(>:nth-child(2)) img{height:230px;object-fit:cover}.media-original figcaption{font-size:.77rem;color:var(--muted);padding:8px 0 2px;overflow-wrap:anywhere}\n.media-download{display:block;padding-top:6px;min-height:30px;overflow-wrap:anywhere;font-size:.74rem;color:var(--muted)}.sensitive-media{border:1px solid var(--line);border-radius:11px;padding:0 12px;min-width:0}.sensitive-media[open]{padding-bottom:12px}\n.empty{padding:47px 26px;text-align:center}.empty>svg{width:26px;height:26px;color:var(--muted);margin-bottom:15px}.empty h2{font-size:1rem;margin-bottom:10px}.empty p{font-size:.83rem;color:var(--muted);max-width:380px;margin:0 auto 23px}\n.pager{display:flex;justify-content:center;padding:23px 0}.drive-toolbar{margin-bottom:18px}.drive-toolbar .context-hint{max-width:360px}\n.quota{padding:16px 18px;background:var(--surface);border:1px solid var(--line);border-radius:12px;margin-bottom:18px;font-size:.79rem}.quota strong{font-size:.83rem}.quota progress{display:block;width:100%;height:5px;margin:12px 0;accent-color:var(--accent)}.quota p{font-size:.74rem;color:var(--muted)}\n.drive-filters{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr) minmax(0,1.2fr) auto;gap:9px;align-items:end;margin-bottom:20px}.drive-filters label{font-size:.75rem}.drive-filters input,.drive-filters select{padding:10px 9px;font-size:.82rem}.drive-filters button{min-height:43px;padding:9px 12px}\n.drive-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;margin-bottom:22px}.file-card{min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:12px;background:var(--surface)}.file-card:hover{border-color:var(--accent)}.file-card.selected-file{outline:2px solid var(--accent);outline-offset:1px}\n.file-link{display:block;min-width:0}.file-thumb{height:158px;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:var(--muted);font-size:.75rem}.file-thumb>svg{width:30px;height:30px}.file-thumb img{height:100%;width:100%;object-fit:cover}\n.file-info{padding:12px 13px}.file-info strong,.file-info small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.file-info strong{font-size:.81rem}.file-info small{font-size:.69rem;margin-top:4px}.file-card>form{padding:0 10px 10px}.file-card>form button{font-size:.78rem;padding:8px}\n.picker-context .field-help{margin:7px 0 0}.selection-count{font-size:.78rem;color:var(--muted);margin-top:12px}.picker-context .button{font-size:.8rem}\n.crumbs{font-size:.79rem;color:var(--muted);overflow-wrap:anywhere;margin:0 2px 17px}.file-detail{display:grid;gap:24px}.file-detail .preview{min-width:0}.file-detail .preview img,.file-detail .preview video{max-height:470px;width:100%;object-fit:contain}\n.usage-list{margin:12px 0 0;padding-left:21px;font-size:.84rem}.usage-list li{padding:8px 0}.file-drop{min-height:160px;padding:25px;border:1px dashed var(--muted);border-radius:12px;background:var(--bg);align-content:center;gap:15px}.file-drop input[type=file]{font-size:.83rem;background:var(--surface);padding:10px}\n.auth-panel{max-width:460px;margin:28px auto}.auth-panel label input{font-size:1rem}.auth-panel .field-help{font-size:.76rem}\n.account-destinations{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px;padding:12px}.account-destinations a{display:flex;align-items:center;gap:10px;min-height:49px;padding:10px;border-radius:8px;font-size:.85rem}.account-destinations a:hover{background:var(--tint)}\n.member-list{padding:4px 23px}.member-row{display:flex;align-items:center;gap:13px;min-height:80px;padding:17px 1px;border-bottom:1px solid var(--line)}.member-row:last-child{border-bottom:0}.member-row .identity{display:flex;flex-direction:column;font-size:.83rem}.member-row small{font-size:.75rem}.member-row>svg{color:var(--muted);width:18px}\n.profile>.avatar{height:60px;width:60px;font-size:1.5rem;margin-bottom:15px}.profile>h2{font-size:1.2rem;margin:0 0 4px}.profile>.note-body{margin:17px 0;font-size:.9rem}.profile .row{margin-top:17px}\n.invitation{padding:17px 0;border-bottom:1px solid var(--line)}.invitation:last-child{border-bottom:0}.invitation .meta{margin:7px 0 12px}.copy-value{padding:14px;background:var(--bg);border-radius:9px;overflow-wrap:anywhere;font-family:ui-monospace,monospace;font-size:.8rem}\n.mobile-nav,.mobile-brand{display:none}hr{border:0;border-top:1px solid var(--line);margin:20px 0}\n@media(prefers-color-scheme:dark){:root{--bg:#11151d;--surface:#191f2b;--ink:#edf1f9;--muted:#a3b0c5;--line:#354057;--accent:#adc1ff;--tint:#253352;--danger:#ffabb4;--danger-bg:#38262b}.primary,.primary:hover{color:#132147}.brand-mark{color:var(--bg)}.file-thumb{background:#121923}}\n@media(max-width:1020px){.layout{grid-template-columns:185px minmax(0,728px);gap:22px;padding:26px 22px 60px}.sidebar{top:26px}.brand{font-size:1.26rem}.nav a{padding-left:11px}.drive-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.file-thumb{height:190px}}\n@media(max-width:720px){.layout{display:block;padding:0 0 calc(93px + env(safe-area-inset-bottom))}.sidebar{display:none}.mobile-brand{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 18px;background:var(--surface);border-bottom:1px solid var(--line)}.mobile-brand .brand{padding:0;font-size:1.2rem}.mobile-brand .brand-mark{width:28px;height:28px;font-size:12px;border-radius:8px}.account-link{font-size:.78rem;overflow-wrap:anywhere;min-height:36px;display:flex;align-items:center}.page-header{padding:18px 18px 0;margin-bottom:17px;min-height:52px}.page-header h1{font-size:1.14rem}.panel,.feed,.note-detail{border-left:0;border-right:0;border-radius:0}.panel{padding:23px 18px;margin-bottom:13px}.feed:has(>.tabs){border-radius:0}.tabs{gap:27px;padding:0 18px}.tabs a{padding:13px 0}.note{padding:22px 18px}.note-body{font-size:1rem}.note-actions{gap:3px}.note-actions button,.note-actions .button{min-height:42px}.notice{border-radius:0;border-left:0;border-right:0}.panel .notice{border:1px solid var(--line);border-radius:10px}.panel .notice.danger{border-color:var(--danger)}.section-heading{margin:27px 18px 12px}.context-hint{margin-bottom:16px}.content>.context-hint{padding:0 18px}.composer textarea[name=body]{min-height:218px}.composer-tools{display:grid;justify-content:stretch}.composer-tools .field-help{min-width:0}.form-actions{gap:8px}.form-actions button{padding:10px 13px}.media-grid{gap:8px}.media-grid:has(>:nth-child(2)) img{height:174px}.drive-toolbar{margin:0 18px 18px}.quota{margin:0 18px 17px}.drive-filters{margin:0 18px 21px;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.drive-filters>label:first-child{grid-column:1/-1}.drive-filters button{grid-column:1/-1}.drive-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding:0 13px}.file-thumb{height:164px}.file-info{padding:11px}.crumbs{margin:0 18px 17px}.auth-panel{margin:0 auto;max-width:none}.account-destinations{padding:12px}.member-list{padding:3px 18px}.empty{padding:43px 23px}.mobile-nav{position:fixed;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));bottom:0;left:0;right:0;z-index:20;padding:7px 8px calc(7px + env(safe-area-inset-bottom));background:var(--surface);border-top:1px solid var(--line)}.mobile-nav a{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;min-height:52px;padding:6px 2px;border-radius:9px;font-size:.65rem;color:var(--muted)}.mobile-nav a[aria-current=page]{color:var(--accent);background:var(--tint)}}\n@media(max-width:360px){.drive-grid{gap:8px;padding:0 10px}.file-thumb{height:136px}.account-destinations{grid-template-columns:minmax(0,1fr)}.media-grid:has(>:nth-child(2)){grid-template-columns:minmax(0,1fr)}.note-actions{gap:0}.note-actions button,.note-actions .button{padding:7px 8px}.mobile-nav a{font-size:.61rem}.account-link{max-width:150px}}\n@media(prefers-reduced-motion:no-preference){a,button{transition:background-color .12s,border-color .12s,color .12s}}\n@media print{.sidebar,.mobile-nav,.mobile-brand,.note-actions,.drive-filters{display:none}.layout{display:block;padding:0}.panel,.feed{border:0}.note{break-inside:avoid}.content{max-width:none}}\n\n/* A saved object and a published attachment are deliberately different steps. */\n.attachment-next .field-help{margin:10px 0 15px}.attachment-next{scroll-margin-top:20px}\n.scope-help{margin-top:-6px}.mobile-nav.guest-nav{grid-template-columns:repeat(3,minmax(0,1fr))}\n@media(max-width:720px){input:not([type=checkbox]),select,.drive-filters input,.drive-filters select{font-size:16px}.attachment-next{scroll-margin-top:12px}}\n\n/* Stable, keyboard-visible writing and attachment actions. */\n:root{font-synthesis:none;text-rendering:optimizeLegibility}\n.content{overflow-wrap:anywhere}.nav a{font-size:.94rem}.note-head .identity>a{line-height:1.4}\n.composer .form-actions{position:sticky;bottom:16px;background:var(--surface);padding:14px 0 0;z-index:5}\n.picker-context{position:sticky;top:12px;z-index:5;box-shadow:0 5px 18px #00000009}\n.file-card:focus-within{outline:2px solid var(--accent);outline-offset:3px}\n.file-drop input::file-selector-button{font:inherit;background:var(--tint);color:var(--ink);border:0;border-radius:6px;padding:8px 12px;margin-right:12px;cursor:pointer}\n.quota progress{min-height:7px}.scope-help{max-width:62ch;line-height:1.6}\nbutton,a.button{scroll-margin-block:100px}.note-actions .button,.note-actions button{min-height:44px}\n@media(max-width:720px){.composer .form-actions{bottom:calc(80px + env(safe-area-inset-bottom));padding:12px 0;box-shadow:0 -8px 12px var(--surface)}.picker-context{top:0}.mobile-nav a{font-size:.7rem}.file-info strong{font-size:.85rem}.file-info small{font-size:.75rem}}\n@media(forced-colors:active){.brand-mark,.avatar{border:1px solid CanvasText}.nav a[aria-current=page],.mobile-nav a[aria-current=page]{outline:2px solid Highlight}.primary{border:2px solid ButtonText}}\n\n.note{scroll-margin-top:20px}.note:target{box-shadow:inset 3px 0 var(--accent)}\n\n/* Reading context is separate from the editor and never previews hidden media. */\n.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}\n.reply-preview{margin:0 0 24px;padding:16px 18px;border-left:3px solid var(--accent);border-radius:0 10px 10px 0;background:var(--bg)}\n.eyebrow{font-size:.78rem;font-weight:650;color:var(--muted);margin-bottom:8px}\n.context-copy,.activity-preview{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;white-space:pre-wrap;overflow-wrap:anywhere}\n.context-copy{font-size:.9rem;line-height:1.6}.context-open{display:inline-flex;align-items:center;min-height:44px;font-size:.82rem;color:var(--accent);text-decoration:underline;text-underline-offset:3px}\n.reply-preview .field-help{margin:0;font-size:.75rem}.conversation-heading{display:flex;gap:12px;align-items:center;justify-content:space-between;scroll-margin-top:20px}\n.activity-tabs{justify-content:space-between;gap:16px}.activity-row{display:flex;gap:13px;align-items:flex-start;padding:23px 26px;border-bottom:1px solid var(--line);min-height:84px}\n.activity-row:last-child{border-bottom:0}.activity-row:hover{background:var(--bg);color:var(--ink)}.activity-row:focus-visible{outline-offset:-4px}\n.activity-content{flex:1;min-width:0}.activity-title{display:block;font-size:.9rem;line-height:1.6}.activity-preview{margin-top:10px;font-size:.87rem;color:var(--muted)}.activity-row>svg{margin-top:8px;color:var(--muted);width:18px}\n@media(max-width:720px){.activity-row{padding:21px 18px}.activity-tabs{gap:12px}.activity-tabs a{min-height:48px}.conversation-heading .button{font-size:.8rem;padding:8px 10px}.reply-preview{padding:13px 14px}.mobile-nav a{font-size:.65rem}}\n@media(forced-colors:active){.reply-preview{border:1px solid CanvasText}.activity-row{border-color:CanvasText}}\n\n/* A writing workspace: save before moving, preview before publishing. */\n.writing-attachment{min-width:0;padding:12px;border:1px solid var(--line);border-radius:12px;background:var(--bg)}\n.writing-attachment .media-original img,.writing-attachment .media-original video{max-height:290px}\n.attachment-edit{border-top:1px solid var(--line);padding-top:10px;margin-top:10px}.attachment-edit .field-help{font-size:.75rem;margin-bottom:7px}\n.attachment-edit .row{gap:5px}.attachment-edit button{font-size:.74rem;min-height:44px;padding:7px 9px}\n.preview-summary{padding:22px 26px}.preview-summary h2{font-size:1.16rem;margin-bottom:8px}.preview-summary .eyebrow{margin-bottom:5px}\n.description-reminder{font-size:.82rem;line-height:1.7;padding-top:14px;margin-top:14px;border-top:1px solid var(--line);color:var(--muted)}\n.preview-card{margin-bottom:18px}.preview-footer{position:sticky;bottom:16px;z-index:5;box-shadow:0 4px 20px #0000000a}.preview-footer>.field-help{margin-top:13px}\n.preview-actions{gap:12px}.preview-actions .primary{min-width:104px}.preview-card .identity strong{font-size:.93rem}\n.selected-tray{padding:19px 22px}.selected-tray>h2{font-size:.88rem;margin-bottom:6px}.selected-tray>.field-help{font-size:.77rem}\n.selected-files{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:14px}\n.selected-item{display:flex;align-items:center;justify-content:space-between;gap:6px;min-width:0;padding:7px;border:1px solid var(--line);border-radius:10px}\n.selected-file-link{display:flex;align-items:center;gap:9px;min-width:0;flex:1}.selection-name{font-size:.76rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.selection-preview{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;width:42px;height:42px;flex:none;border-radius:7px;overflow:hidden;background:var(--bg);color:var(--muted)}\n.selection-preview img{width:100%;height:100%;object-fit:cover}.selection-preview svg{width:19px;height:19px}.selection-preview>span{font-size:9px;line-height:1.2}\n.selected-item form{flex:none}.selected-item button{min-height:44px;padding:6px;font-size:.73rem}\n.file-card{scroll-margin-top:170px}.file-card:target{outline:2px solid var(--accent);outline-offset:3px}\n@media(max-width:720px){.writing-attachment{padding:9px}.attachment-edit .row{display:grid}.attachment-edit button{width:100%;font-size:.76rem}.preview-summary{padding:22px 18px}.preview-footer{bottom:calc(80px + env(safe-area-inset-bottom));padding:17px 18px}.selected-tray{padding:18px}.selected-files{grid-template-columns:minmax(0,1fr)}.selection-name{font-size:.82rem}.selected-item button{font-size:.79rem}.preview-actions .button,.preview-actions button{padding:10px 12px}.composer-tools{gap:10px}}\n@media(forced-colors:active){.writing-attachment,.selected-item,.preview-footer{border:1px solid CanvasText}.file-card:target{outline:2px solid Highlight}}\n@media print{.preview-footer,.attachment-edit,.selected-item form{display:none}.preview-card{border:0}}\n")))
)
