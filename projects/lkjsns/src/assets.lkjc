ht:64px;padding:10px 1px;border-bottom:1px solid var(--line)}.member-row:last-child{border-bottom:0}.member-row .identity{display:flex;flex-direction:column;font-size:.83rem}.member-row small{font-size:.75rem}.member-row>svg{color:var(--muted);width:18px}\n.profile>.avatar{height:60px;width:60px;font-size:1.5rem;margin-bottom:10px}.profile>h2{font-size:1.2rem;margin:0 0 4px}.profile>.note-body{margin:12px 0;font-size:.9rem}.profile .row{margin-top:12px}\n.invitation{padding:10px 0;border-bottom:1px solid var(--line)}.invitation:last-child{border-bottom:0}.invitation .meta{margin:7px 0 12px}.copy-value{padding:14px;background:var(--bg);border-radius:9px;overflow-wrap:anywhere;font-family:ui-monospace,monospace;font-size:.8rem}\n.mobile-nav,.mobile-brand{display:none}hr{border:0;border-top:1px solid var(--line);margin:12px 0}\n@media(prefers-color-scheme:dark){:root{--bg:#121212;--surface:#1c1c1c;--ink:#f0f0f0;--muted:#b8b8b8;--line:#4b4b4b;--control-line:#929292;--accent:#ededed;--on-accent:#191919;--tint:#303030;--danger:#ededed;--danger-bg:#303030}.primary,.primary:hover{color:var(--on-accent)}.file-thumb{background:#181818}}\n@media(max-width:1020px){.layout{grid-template-columns:185px minmax(0,728px);gap:22px;padding:20px 22px 40px}.sidebar{top:20px}.brand{font-size:1.26rem}.nav a{padding-left:11px}.drive-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.file-thumb{height:128px}}\n@media(max-width:720px){body{min-height:100dvh;display:flex;flex-direction:column}.layout{display:block;width:100%;flex:1 0 auto;padding:0 0 8px}.sidebar{display:none}.mobile-brand{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 18px;background:var(--surface);border-bottom:1px solid var(--line)}.mobile-brand .brand{padding:0;font-size:1.2rem}.mobile-brand .brand-mark{width:32px;height:32px;border-radius:50%}.account-link{font-size:.78rem;overflow-wrap:anywhere;min-height:36px;display:flex;align-items:center}.page-header{padding:18px 18px 0;margin-bot