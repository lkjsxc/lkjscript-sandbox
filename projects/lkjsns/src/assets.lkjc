-self:stretch;width:2px;margin:0 0 -18px;background:var(--line);pointer-events:none}\n.conversation-pair>.note{padding-top:12px}.conversation-pair>.parent-unavailable{padding:12px 28px 0;margin:0;font-size:.82rem;color:var(--muted)}\n.composer .parent-card.reply-preview{padding:0 0 12px;margin:0 0 12px;border-bottom:1px solid var(--line)}\n.parent-card:focus-visible{outline:2px solid var(--accent)!important;outline-offset:-3px}\n.post-navigation{display:flex;align-items:center;margin:0 0 8px;min-height:44px}\n.back-link{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:8px 12px;border-radius:10px;font-size:.9rem;font-weight:500}\n.back-link svg{width:20px;height:20px;transform:rotate(180deg)}.back-link:hover{background:var(--surface)}\n@media(max-width:720px){.post-navigation{padding:5px 6px 0;margin:0 0 6px}.parent-card.reply-preview{padding:10px 18px 6px}.parent-card .context-copy{font-size:.9rem;margin:0}.conversation-pair>.parent-unavailable{padding:12px 18px 0}.conversation-pair>.note{padding-top:12px}}\n@media(forced-colors:active){.conversation-pair>.parent-card::after{background:CanvasText}.back-link:focus-visible{outline:2px solid Highlight}}\n\n/* Keyboard navigation and accessible shortcut help. */\n.keyboard-current{outline:3px solid var(--accent);outline-offset:3px}\n.shortcut-help-button{width:100%;background:transparent;border:0;color:inherit;font:inherit;cursor:pointer;text-align:left}\n.shortcut-help{max-width:min(34rem,calc(100vw - 32px));padding:16px 24px;border:1px solid var(--line);border-radius:16px;color:var(--ink);background:var(--surface)}\n.shortcut-help p{line-height:1.7}.shortcut-help label{display:block;margin:12px 0}.shortcut-help input{margin-right:8px}\n.pager .button:disabled{opacity:.48;cursor:not-allowed}.pager .pager-first{align-self:stretch;display:flex;align-items:center;justify-content:center;flex:0 0 auto;min-width:64px;min-height:48px;padding:8px;color:var(--accent);text-decoration: