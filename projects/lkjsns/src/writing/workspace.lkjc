(module create writingview
  (function create audience (visibility public)
    (parameter create value (type Text))
    (returns Text) (effect pure)
    (body (if (call std::text-equal (local value) (text "public"))
      (text "Anyone, including people who are not signed in, will be able to read this post and its attachments.")
      (text "Everyone registered here will be able to read this post and its attachments. This is independent of attention relationships."))))

  (function create content (visibility public) (parameter create ctx (type Context)) (parameter create note (type Note)) (returns Text) (effect (task (requirement service::app::store))) (body (call std::text-join (list Text (text "<div class=\"note-body markdown\">") (call markdown::render (field (local note) (name body))) (text "</div>") (if (call std::less (i64 0) (call std::list-length (types Text) (field (local note) (name media)))) (call std::text-join (list Text (text "<div class=\"media-grid\">") (call mediaui::attachments (local ctx) (local note) (i64 0) (text "")) (text "</div>")) (text "")) (text ""))) (text ""))))

  (function create files (visibility public)
    (parameter create ctx (type Context)) (parameter create note (type Note))
    (parameter create index (type I64)) (parameter create out (type Text))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (if (call std::less (local index) (call std::list-length (types Text) (field (local note) (name media))))
      (let (binding media (call db::media (call std::list-get (types Text) (field (local note) (name media)) (local index))))
        (in (call writingview::files (local ctx) (local note) (call std::add (local index) (i64 1))
          (call std::text-join (list Text (local out)
            (if (call access::media (local ctx) (local media) (local note))
              (call std::text-join (list Text (text "<div class=\"writing-attachment\">")
                (call mediaui::render (local media) (field (local note) (name id)) (text ""))
                (if (field (local note) (name published)) (text "")
                  (call std::text-join (list Text (text "<div class=\"attachment-edit row\"><button class=\"compact subtle\" name=\"mode\" value=\"detach:") (field (local media) (name id)) (text "\">Remove</button><button class=\"compact subtle\" name=\"mode\" value=\"details:") (field (local media) (name id)) (text "\">File options</button></div>")) (text "")))
                (text "</div>")) (text ""))
              (text "<p class=\"field-help\">This attachment is currently unavailable.</p>"))) (text "")))))
      (local out))))

  (function create change-ok (visibility public)
    (parameter create note (type Note)) (parameter create mode (type Text))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (if (call writingintents::removing (local mode))
      (let (binding media (call db::media (call writingintents::file-id (local mode))))
        (in (if (call std::text-equal (field (local media) (name owner)) (field (local note) (name author)))
          (if (call std::less-equal (i64 0) (field (local media) (name version)))
            (if (call std::less-equal (field (local media) (name version)) (i64 2147483646))
              (call util::has (field (local media) (name refs)) (field (local note) (name id)) (i64 0))
              (bool false)) (bool false)) (bool false))))
      (bool true))))

  (function create missing-descriptions (visibility public)
    (parameter create ids (type (list Text))) (parameter create index (type I64))
    (returns I64) (effect (task (requirement service::app::store)))
    (body (if (call std::less (local index) (call std::list-length (types Text) (local ids)))
      (call std::add
        (if (call std::text-equal (field (call db::media (call std::list-get (types Text) (local ids) (local index))) (name alt)) (text ""))
          (i64 1) (i64 0))
        (call writingview::missing-descriptions (local ids) (call std::add (local index) (i64 1))))
      (i64 0))))

  (function create publish-form (visibility public)
    (parameter create ctx (type Context)) (parameter create note (type Note))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text
      (call page::begin (local ctx) (text "note"))
      (call page::hidden (text "id") (field (local note) (name id)))
      (call page::hidden (text "version") (call std::i64-to-text (field (local note) (name version))))
      (call page::hidden (text "reply") (field (local note) (name reply)))
      (call page::hidden (text "body") (field (local note) (name body)))
      (call page::hidden (text "cw") (field (local note) (name cw)))
      (call page::hidden (text "audience") (field (local note) (name audience)))
      (text "<div class=\"row spread preview-actions\"><a class=\"button\" href=\"/")
      (field (local note) (name id)) (text "/edit\">Back to writing</a><button class=\"primary\" name=\"mode\" value=\"publish\"")
      (if (if (call std::less (i64 0) (call util::size (field (local note) (name body)))) (bool true)
        (call std::less (i64 0) (call std::list-length (types Text) (field (local note) (name media)))))
        (text "") (text " disabled"))
      (text ">Post</button></div></form>")) (text ""))))

  (function create preview (visibility public)
    (parameter create ctx (type Context)) (parameter create note (type Note))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (let (binding author (call db::user (field (local note) (name author))))
      (binding missing (call writingview::missing-descriptions (field (local note) (name media)) (i64 0)))
      (in (call std::text-join (list Text
        (text "<p class=\"notice\" role=\"status\">Your draft is saved. This preview is only visible to you.</p>")
        (call conversation::context (local ctx) (field (local note) (name reply)))
        (text "<div class=\"note-detail preview-card\"><article class=\"note\"><header class=\"note-head\">")
        (call page::avatar (field (local note) (name author)))
        (text "<div class=\"identity\"><strong>")
        (call std::html-escape-text (field (local author) (name display)))
        (text "</strong><div class=\"meta\"><span>@")
        (call std::html-escape-text (field (local note) (name author)))
        (text "</span><span class=\"badge\">Not posted</span></div></div></header>")
        (if (call std::text-equal (field (local note) (name cw)) (text ""))
          (call writingview::content (local ctx) (local note))
          (call std::text-join (list Text (text "<details class=\"cw\"><summary>")
            (call std::html-escape-text (field (local note) (name cw))) (text "</summary>")
            (call writingview::content (local ctx) (local note)) (text "</details>")) (text "")))
        (text "</article></div>") (text "<section class=\"panel preview-summary\"><p class=\"eyebrow\">Before you post</p><h2>")
        (if (call std::text-equal (field (local note) (name audience)) (text "public"))
          (text "Public — anyone") (text "Members"))
        (text "</h2><p class=\"field-help\">")
        (call writingview::audience (field (local note) (name audience)))
        (text "</p>")
        (text "")
        (text "</section>")  (text "<section class=\"panel preview-footer\">")
        (call writingview::publish-form (local ctx) (local note))
        (text "<p class=\"field-help\">This has not been posted. Your text and attachment selection will be checked again when you post.</p></section>")) (text "")))))
)

  (test create public-audience-is-explicit (visibility private)
    (actual (call std::text-contains (call writingview::audience (text "public")) (text "not signed in")))
    (expected (bool true)))
  (test create members-audience-is-independent (visibility private)
    (actual (call std::text-contains (call writingview::audience (text "members")) (text "independent of attention relationships")))
    (expected (bool true)))
  (test create empty-preview-cannot-post (visibility private)
    (actual (call std::text-contains (call writingview::publish-form (call auth::guest (i64 0)) (call db::empty-note))
      (text "value=\"publish\" disabled"))) (expected (bool true)))

  (function create default-submit (visibility public)
    (parameter create published (type Bool))
    (returns Text) (effect pure)
    (body (if (local published) (text "<input type=\"submit\" name=\"mode\" value=\"publish\" hidden>") (text "<input type=\"submit\" name=\"mode\" value=\"draft\" hidden>"))))

  (test create implicit-draft-never-posts (visibility private)
    (actual (call writingview::default-submit (bool false)))
    (expected (text "<input type=\"submit\" name=\"mode\" value=\"draft\" hidden>")))
  (test create implicit-published-edit-saves-changes (visibility private)
    (actual (call writingview::default-submit (bool true)))
    (expected (text "<input type=\"submit\" name=\"mode\" value=\"publish\" hidden>")))
)
