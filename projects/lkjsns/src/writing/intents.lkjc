(module create writingintents
  (function create file-id (visibility public)
    (parameter create mode (type Text))
    (returns Text) (effect pure)
    (body (if (call std::text-starts-with (local mode) (text "details:"))
      (call util::slice (local mode) (i64 8) (call util::size (local mode)))
      (if (call std::text-starts-with (local mode) (text "detach:"))
        (call util::slice (local mode) (i64 7) (call util::size (local mode)))
        (text "")))))

  (function create removing (visibility public)
    (parameter create mode (type Text))
    (returns Bool) (effect pure)
    (body (if (call std::text-starts-with (local mode) (text "detach:"))
      (call util::token (call writingintents::file-id (local mode))) (bool false))))

  (function create valid (visibility public)
    (parameter create note (type Note)) (parameter create mode (type Text))
    (returns Bool) (effect pure)
    (body (if (call util::has
      (list Text (text "draft") (text "publish") (text "picker") (text "upload") (text "preview"))
      (local mode) (i64 0)) (bool true)
      (if (call util::token (call writingintents::file-id (local mode)))
        (call util::has (field (local note) (name media))
          (call writingintents::file-id (local mode)) (i64 0)) (bool false)))))

  (function create media (visibility public)
    (parameter create note (type Note)) (parameter create mode (type Text))
    (returns (list Text)) (effect pure)
    (body (if (call writingintents::removing (local mode))
      (call util::remove (field (local note) (name media)) (call writingintents::file-id (local mode)))
      (field (local note) (name media)))))

  (function create location (visibility public)
    (parameter create id (type Text)) (parameter create mode (type Text))
    (parameter create published (type Bool))
    (returns Text) (effect pure)
    (body (if (call util::post-id (local id))
      (if (local published)
        (call paths::canonical (call std::text-join (list Text (text "/note?id=") (local id) (text "&saved=1")) (text "")))
        (if (call std::text-equal (local mode) (text "picker"))
          (call std::text-join (list Text (text "/pick?draft=") (local id) (text "&saved=1")) (text ""))
          (if (call std::text-equal (local mode) (text "upload"))
            (call std::text-join (list Text (text "/upload?draft=") (local id)) (text ""))
            (if (call std::text-equal (local mode) (text "preview"))
              (call paths::canonical (call std::text-join (list Text (text "/compose?id=") (local id) (text "&preview=1")) (text "")))
              (if (if (call std::text-starts-with (local mode) (text "details:"))
                (call util::token (call writingintents::file-id (local mode))) (bool false))
                (call paths::canonical (call std::text-join (list Text (text "/file?id=")
                  (call writingintents::file-id (local mode)) (text "&draft=") (local id)) (text "")))
                (call paths::canonical (call std::text-join (list Text (text "/compose?id=") (local id) (text "&saved=1")) (text ""))))))))
      (text "/drafts"))))

  (test create accepts-preview (visibility private)
    (actual (call writingintents::valid (call db::empty-note) (text "preview"))) (expected (bool true)))
  (test create accepts-upload (visibility private)
    (actual (call writingintents::valid (call db::empty-note) (text "upload"))) (expected (bool true)))
  (test create accepts-draft (visibility private)
    (actual (call writingintents::valid (call db::empty-note) (text "draft"))) (expected (bool true)))
  (test create accepts-publish (visibility private)
    (actual (call writingintents::valid (call db::empty-note) (text "publish"))) (expected (bool true)))
  (test create accepts-picker (visibility private)
    (actual (call writingintents::valid (call db::empty-note) (text "picker"))) (expected (bool true)))
  (test create rejects-unknown-intent (visibility private)
    (actual (call writingintents::valid (call db::empty-note) (text "autosave"))) (expected (bool false)))
  (test create rejects-detached-file (visibility private)
    (actual (call writingintents::valid (call db::empty-note)
      (text "detach:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))) (expected (bool false)))
  (test create rejects-unattached-details (visibility private)
    (actual (call writingintents::valid (call db::empty-note)
      (text "details:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))) (expected (bool false)))
  (test create rejects-malformed-removal (visibility private)
    (actual (call writingintents::removing (text "detach:unknown"))) (expected (bool false)))
  (test create details-do-not-remove (visibility private)
    (actual (call writingintents::removing
      (text "details:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))) (expected (bool false)))
  (test create extracts-details-id (visibility private)
    (actual (call writingintents::file-id
      (text "details:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))
    (expected (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))
  (test create preview-is-owner-editor-location (visibility private)
    (actual (call writingintents::location
      (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") (text "preview") (bool false)))
    (expected (text "/nananananananana/edit?preview=1")))
  (test create upload-retains-draft (visibility private)
    (actual (call writingintents::location
      (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") (text "upload") (bool false)))
    (expected (text "/upload?draft=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))
  (test create published-returns-to-post (visibility private)
    (actual (call writingintents::location
      (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") (text "preview") (bool true)))
    (expected (text "/nananananananana?saved=1")))
  (test create invalid-id-cannot-inject-query (visibility private)
    (actual (call writingintents::location (text "bad&next=elsewhere") (text "upload") (bool false)))
    (expected (text "/drafts")))
)
