(module create service
  (component create app (visibility public)
    (requirement create store (interface std::DataStore)
      (operations std::DataStore::get std::DataStore::put std::DataStore::delete std::DataStore::transaction)
      (limits (maximum_calls 100000 calls)))
    (requirement create entropy (interface std::SecureRandom)
      (operations std::SecureRandom::bytes) (limits (maximum_calls 128 calls)))
    (requirement create clock (interface std::WallClock)
      (operations std::WallClock::utc-milliseconds) (limits (maximum_calls 128 calls)))
    (requirement create config (interface std::Configuration)
      (operations std::Configuration::text) (limits (maximum_calls 1024 calls)))
    (requirement create passwords (interface std::PasswordHash)
      (operations std::PasswordHash::hash std::PasswordHash::verify) (limits (maximum_calls 8 calls)))
    (requirement create bootstrap (interface std::SecretVerifier)
      (operations std::SecretVerifier::matches) (limits (maximum_calls 8 calls)))
    (requirement create streams (interface std::ByteStream)
      (operations std::ByteStream::read-all std::ByteStream::close) (limits (maximum_calls 16 calls)))
    (requirement create objects (interface std::ObjectStorage)
      (operations std::ObjectStorage::put-new std::ObjectStorage::get std::ObjectStorage::range std::ObjectStorage::reconcile-put std::ObjectStorage::delete)
      (limits (maximum_calls 128 calls)))
    (port create health (type (task-function (Request) Response (row))) (function health::respond))
    (port create view (type (task-function (Request) Response
      (row (requirement store) (requirement entropy) (requirement clock) (requirement config) (requirement passwords) (requirement bootstrap) (requirement streams) (requirement objects)))) (function http::view))
    (port create unavailable-1 (type (task-function (Request Text) Response
      (row (requirement store) (requirement clock) (requirement entropy) (requirement config) (requirement passwords) (requirement bootstrap) (requirement objects) (requirement streams)))) (function unavailable::missing-1))
    (port create unavailable-2 (type (task-function (Request Text Text) Response
      (row (requirement store) (requirement clock) (requirement entropy) (requirement config) (requirement passwords) (requirement bootstrap) (requirement objects) (requirement streams)))) (function unavailable::missing-2))
    (port create unavailable-3 (type (task-function (Request Text Text Text) Response
      (row (requirement store) (requirement clock) (requirement entropy) (requirement config) (requirement passwords) (requirement bootstrap) (requirement objects) (requirement streams)))) (function unavailable::missing-3))
    (port create unavailable-4 (type (task-function (Request Text Text Text Text) Response
      (row (requirement store) (requirement clock) (requirement entropy) (requirement config) (requirement passwords) (requirement bootstrap) (requirement objects) (requirement streams)))) (function unavailable::missing-4))
    (port create unavailable-5 (type (task-function (Request Text Text Text Text Text) Response
      (row (requirement store) (requirement clock) (requirement entropy) (requirement config) (requirement passwords) (requirement bootstrap) (requirement objects) (requirement streams)))) (function unavailable::missing-5))
    (port create unavailable-6 (type (task-function (Request Text Text Text Text Text Text) Response
      (row (requirement store) (requirement clock) (requirement entropy) (requirement config) (requirement passwords) (requirement bootstrap) (requirement objects) (requirement streams)))) (function unavailable::missing-6))
    (port create unavailable-7 (type (task-function (Request Text Text Text Text Text Text Text) Response
      (row (requirement store) (requirement clock) (requirement entropy) (requirement config) (requirement passwords) (requirement bootstrap) (requirement objects) (requirement streams)))) (function unavailable::missing-7))
    (port create unavailable-8 (type (task-function (Request Text Text Text Text Text Text Text Text) Response
      (row (requirement store) (requirement clock) (requirement entropy) (requirement config) (requirement passwords) (requirement bootstrap) (requirement objects) (requirement streams)))) (function unavailable::missing-8))
  ))
