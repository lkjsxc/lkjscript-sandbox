(module create service
  (component create app (visibility public)
    (requirement create store (interface std::DataStore)
      (operations std::DataStore::get std::DataStore::put std::DataStore::delete std::DataStore::transaction)
      (limits (maximum_calls 100000 calls)))
    (requirement create entropy (interface std::SecureRandom)
      (operations std::SecureRandom::bytes) (limits (maximum_calls 128 calls)))
    (requirement create clock (interface std::WallClock)
      (operations std::WallClock::utc-milliseconds) (limits (maximum_calls 128 calls)))
    (requirement create config (interface std::Configuration)
      (operations std::Configuration::text) (limits (maximum_calls 1024 calls)))
    (requirement create passwords (interface std::PasswordHash)
      (operations std::PasswordHash::hash std::PasswordHash::verify) (limits (maximum_calls 8 calls)))
    (requirement create bootstrap (interface std::SecretVerifier)
      (operations std::SecretVerifier::matches) (limits (maximum_calls 8 calls)))
    (requirement create streams (interface std::ByteStream)
      (operations std::ByteStream::read-all std::ByteStream::close) (limits (maximum_calls 16 calls)))
    (requirement create objects (interface std::ObjectStorage)
      (operations std::ObjectStorage::put-new std::ObjectStorage::get std::ObjectStorage::range std::ObjectStorage::reconcile-put std::ObjectStorage::delete)
      (limits (maximum_calls 32 calls)))
    (port create view (type (task-function (Request) Response
      (row (requirement store) (requirement entropy) (requirement clock) (requirement config) (requirement passwords) (requirement bootstrap) (requirement streams) (requirement objects)))) (function http::view))
  ))
(target create lkjsns (component service::app) (runner http)
  (route create home (method GET) (path "/") (port service::app::view)))
