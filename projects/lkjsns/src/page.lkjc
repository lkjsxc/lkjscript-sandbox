  (function create raw (visibility public) (parameter create status (type I64)) (parameter create body (type Bytes)) (parameter create mime (type Text)) (parameter create extra (type (list Header))) (returns Response) (effect pure) (body (record structural (field status (local status)) (field body (local body)) (field headers (call page::append-headers (list Header (call editor::header (text "cache-control") (text "no-store")) (call editor::header (text "content-security-policy") (text "default-src 'none'; manifest-src 'self'; script-src 'self'; connect-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'")) (call editor::header (text "x-content-type-options") (text "nosniff")) (call editor::header (text "referrer-policy") (text "same-origin")) (call editor::header (text "cross-origin-resource-policy") (text "same-origin")) (call editor::header (text "x-frame-options") (text "DENY")) (call editor::header (text "permissions-policy") (text "camera=(), microphone=(), geolocation=()")) (call editor::header (text "content-type") (local mime))) (local extra) (i64 0))))))

