  (function create mobile (visibility public) (parameter create ctx (type Context)) (parameter create title (type Text)) (returns Text) (effect pure) (body (if (call util::signed (local ctx)) (call std::text-join (list Text (text "<nav class=\"mobile-nav\" aria-label=\"Mobile navigation\">") (call page::link (text "/") (text "Home") (text "home") (call std::text-equal (local title) (text "Home"))) (call page::link (text "/compose") (text "Post") (text "plus") (call page::write-active (local title))) (call page::link (text "/notifications") (text "Notifications") (text "bell") (call std::text-equal (local title) (text "Notifications"))) (call page::link (text "/more") (text "More") (text "more") (call std::bool-not (if (call std::text-equal (local title) (text "Home")) (bool true) (if (call page::write-active (local title)) (bool true) (if (call std::text-equal (local title) (text "Notifications")) (bool true) (bool false)))))) (text "</nav>")) (text "")) (call std::text-join (list Text (text "<nav class=\"mobile-nav guest-nav\" aria-label=\"Mobile navigation\">") (call page::link (text "/") (text "Home") (text "home") (call std::text-equal (local title) (text "Home"))) (call page::link (text "/login") (text "Sign in") (text "lock") (call std::text-equal (local title) (text "Sign in"))) (call page::link (text "/join") (text "Join") (text "plus") (call std::text-equal (local title) (text "Create account"))) (call page::link (text "/more") (text "More") (text "more") (call page::more-active (local title))) (text "</nav>")) (text "")))))

  (function create frame-at (visibility public) (parameter create ctx (type Context)) (parameter create title (type Text)) (parameter create place (type Text)) (parameter create body (type Text)) (returns Text) (effect pure) (body (call std::text-join (list Text (text "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><meta name=\"color-scheme\" content=\"light dark\"><title>") (call std::html-escape-text (local title)) (call std::text-join (list Text (text " · lkjsns</title>") (call icons::links) (call std::text-join (list Text (text "<link rel=\"stylesheet\" href=\"/style.css\"><script defer src=\"/ui.js\"></script><script defer src=\"/transfer.js\"></script></head><body><a class=\"skip\" href=\"#main\">Skip to content</a><div class=\"mobile-brand\">") (call icons::brand) (text "")) (text ""))) (text "")) (if (call util::signed (local ctx)) (call std::text-join (list Text (call std::text-join (list Text (text "<a class=\"account-link\" href=\"/@") (call std::html-escape-text (field (local ctx) (name user))) (text "\">@")) (text "")) (call std::html-escape-text (field (local ctx) (name user))) (text "</a>")) (text "")) (if (call std::text-equal (local place) (text "Sign in")) (text "<a class=\"account-link\" href=\"/join\">Join</a>") (text "<a class=\"account-link\" href=\"/login\">Sign in</a>"))) (call std::text-join (list Text (text "</div><div class=\"layout\"><aside class=\"sidebar\">") (call icons::brand) (text "<nav class=\"nav\" aria-label=\"Main navigation\">")) (text "")) (if (call util::signed (local ctx)) (call page::nav (local place)) (call page::guest-nav (local place))) (text "</nav>") (if (call util::signed (local ctx)) (call std::text-join (list Text (text "<a class=\"button primary\" href=\"/compose\">") (call page::icon (text "plus")) (text "New post</a>")) (text "")) (text "")) (text "<div class=\"account\">") (if (call util::signed (local ctx)) (call std::text-join (list Text (call std::text-join (list Text (text "<a class=\"account-identity\" href=\"/@") (call std::html-escape-text (field (local ctx) (name user))) (text "\">")) (text "")) (call page::avatar (field (local ctx) (name user))) (text "<strong>@") (call std::html-escape-text (field (local ctx) (name user))) (text "</strong></a>")) (text "")) (text "")) (call std::text-join (list Text (text "</div></aside><main id=\"main\" class=\"content\" tabindex=\"-1\">") (call std::text-join (list Text (text "<h1 class=\"sr-only\">") (call std::html-escape-text (local title)) (text "</h1>")) (text ""))) (text "")) (local body) (text "</main></div>") (call page::mobile (local ctx) (local place)) (text "</body></html>")) (text ""))))

