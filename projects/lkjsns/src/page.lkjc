  (function create error (visibility public) (parameter create status (type I64)) (parameter create message (type Text)) (returns Response) (effect pure) (body (call page::reply (local status) (call std::text-join (list Text (text "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>lkjsns — ") (call std::html-escape-text (if (call util::has (list Text (text "403") (text "404")) (call std::i64-to-text (local status)) (i64 0)) (text "Page unavailable") (text "Check this action"))) (call std::text-join (list Text (text "</title>") (call icons::links) (call std::text-join (list Text (text "<link rel=\"stylesheet\" href=\"/style.css\"></head><body><main class=\"error-page\">") (call icons::brand) (text "<section class=\"panel stack\"><h1>")) (text ""))) (text "")) (if (call util::has (list Text (text "403") (text "404")) (call std::i64-to-text (local status)) (i64 0)) (text "This page is unavailable") (text "This action could not be completed")) (text "</h1><p role=\"alert\">") (call std::html-escape-text (local message)) (text "</p>") (if (call std::i64-equal (local status) (i64 409)) (text "<p class=\"field-help\">Check what is currently saved before repeating this action.</p>") (text "")) (text "</section></main></body></html>")) (text "")) (text "") (text ""))))

  (function create ago
    (visibility public) (parameter create now (type I64)) (parameter create at (type I64))
    (returns Text) (effect pure)
