(module create adminview
  (function create invites (visibility public)
    (parameter create ctx (type Context))
    (parameter create ids (type (list Text)))
    (parameter create index (type I64))
    (parameter create out (type Text))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (if (call std::less (local index) (call std::list-length (types Text) (local ids))) (let (binding invite (call db::invite (call std::list-get (types Text) (local ids) (local index)))) (in (call adminview::invites (local ctx) (local ids) (call std::add (local index) (i64 1)) (call std::text-join (list Text (local out) (text "<article class=\"invitation\"><h3>") (call std::html-escape-text (field (local invite) (name label))) (text "</h3><p class=\"meta\">") (if (field (local invite) (name revoked)) (text "無効") (if (call std::less-equal (field (local invite) (name expires)) (field (local ctx) (name now))) (text "期限切れ") (call std::text-join (list Text (text "残り ") (call std::i64-to-text (field (local invite) (name remaining))) (text " 回")) (text "")))) (text "</p>") (if (if (call std::bool-not (field (local invite) (name revoked))) (if (call std::less (field (local ctx) (name now)) (field (local invite) (name expires))) (if (call std::less (i64 0) (field (local invite) (name remaining))) (bool true) (bool false)) (bool false)) (bool false)) (call std::text-join (list Text (call page::begin (local ctx) (text "revoke-invite")) (call page::hidden (text "id") (field (local invite) (name id))) (text "<button class=\"danger compact\">この招待を無効にする</button></form>")) (text "")) (text "")) (text "</article>")) (text ""))))) (local out))))

  (function create admin (visibility public)
    (parameter create ctx (type Context))
    (parameter create request (type Request))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (let (binding user (call db::user (field (local ctx) (name user)))) (in (if (if (call util::signed (local ctx)) (if (field (local user) (name admin)) (bool true) (bool false)) (bool false)) (let (binding listing (call db::listing (text "invites") (call util::query (local request) (text "cursor")) (i64 30))) (in (call page::reply (i64 200) (call page::frame (local ctx) (text "招待の管理") (call std::text-join (list Text (text "<section class=\"panel\"><h2>招待を作成</h2><p class=\"context-hint\">リンクを渡した相手だけが登録できます。発行後のリンクは一度だけ表示します。</p>") (call page::begin (local ctx) (text "invite")) (text "<div class=\"stack\">") (call controls::input (text "label") (text "招待の名前（自分用のメモ）") (text "") (text "text")) (text "<div class=\"row\">") (call controls::input (text "uses") (text "登録できる人数（1〜20人）") (text "1") (text "number")) (call controls::input (text "days") (text "有効期間（1〜30日）") (text "7") (text "number")) (text "</div><button class=\"primary\">招待リンクを作成</button></div></form></section><section class=\"panel\"><h2>発行済みの招待</h2>") (call adminview::invites (local ctx) (field (local listing) (name ids)) (i64 0) (text "")) (text "</section>") (call page::pager (field (local listing) (name next)) (text "/admin?"))) (text ""))) (text "") (text "")))) (call page::error (i64 403) (text "この画面は管理者のみ利用できます。")))))))

  (function create notices (visibility public)
    (parameter create ctx (type Context))
    (parameter create viewer (type User))
    (parameter create ids (type (list Text)))
    (parameter create index (type I64))
    (parameter create out (type Text))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (if (call std::less (local index) (call std::list-length (types Text) (local ids))) (let (binding notice (call db::notice (call std::list-get (types Text) (local ids) (local index)))) (binding note (call db::note (field (local notice) (name note)))) (binding show (if (call util::handle (field (local notice) (name actor))) (if (call std::bool-not (call util::has (field (local viewer) (name muted)) (field (local notice) (name actor)) (i64 0))) (if (if (call std::text-equal (field (local notice) (name kind)) (text "follow")) (bool true) (if (if (call access::visible (local ctx) (local note)) (if (field (local note) (name published)) (if (if (call std::text-equal (field (local notice) (name kind)) (text "reply")) (bool true) (if (call std::text-equal (field (local notice) (name kind)) (text "eyes")) (bool true) (bool false))) (bool true) (bool false)) (bool false)) (bool false)) (bool true) (bool false))) (bool true) (bool false)) (bool false)) (bool false))) (in (call adminview::notices (local ctx) (local viewer) (local ids) (call std::add (local index) (i64 1)) (if (local show) (call std::text-join (list Text (local out) (text "<a class=\"member-row\" href=\"") (call std::html-escape-text (if (call std::text-equal (field (local notice) (name kind)) (text "follow")) (call std::text-join (list Text (text "/profile?user=") (field (local notice) (name actor))) (text "")) (call std::text-join (list Text (text "/note?id=") (field (local notice) (name note))) (text "")))) (text "\">") (call page::avatar (field (local notice) (name actor))) (text "<span class=\"identity\"><strong>@") (call std::html-escape-text (field (local notice) (name actor))) (text "</strong><span>") (if (call std::text-equal (field (local notice) (name kind)) (text "follow")) (text " があなたをフォローしました") (if (call std::text-equal (field (local notice) (name kind)) (text "reply")) (text " が返信しました") (text " がノートを「見た」"))) (text "</span><small>") (call page::ago (field (local ctx) (name now)) (field (local notice) (name at))) (text "</small></span></a>")) (text "")) (local out))))) (local out))))

  (function create notifications (visibility public)
    (parameter create ctx (type Context))
    (parameter create request (type Request))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (let (binding viewer (call db::user (field (local ctx) (name user)))) (binding listing (call db::listing (call std::text-join (list Text (text "notice/") (field (local ctx) (name user))) (text "")) (call util::query (local request) (text "cursor")) (i64 30))) (binding rows (call adminview::notices (local ctx) (local viewer) (field (local listing) (name ids)) (i64 0) (text ""))) (in (call page::reply (i64 200) (call page::frame (local ctx) (text "通知") (call std::text-join (list Text (text "<div class=\"panel member-list\">") (if (call std::text-equal (local rows) (text "")) (text "<p class=\"context-hint\">このページに表示できる通知はありません。</p>") (local rows)) (text "</div>") (call page::pager (field (local listing) (name next)) (text "/notifications?"))) (text ""))) (text "") (text ""))))))
)
