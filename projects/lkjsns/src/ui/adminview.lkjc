(module create adminview
  (function create invites (visibility public)
    (parameter create ctx (type Context))
    (parameter create ids (type (list Text)))
    (parameter create index (type I64))
    (parameter create out (type Text))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (if (call std::less (local index) (call std::list-length (types Text) (local ids))) (let (binding invite (call db::invite (call std::list-get (types Text) (local ids) (local index)))) (in (call adminview::invites (local ctx) (local ids) (call std::add (local index) (i64 1)) (call std::text-join (list Text (local out) (text "<article class=\"invitation\"><h3>") (call std::html-escape-text (field (local invite) (name label))) (text "</h3><p class=\"meta\">") (if (field (local invite) (name revoked)) (text "Revoked") (if (if (call std::i64-equal (field (local invite) (name expires)) (i64 -1)) (bool false) (call std::less-equal (field (local invite) (name expires)) (field (local ctx) (name now)))) (text "Expired") (call std::text-join (list Text (if (call std::i64-equal (field (local invite) (name remaining)) (i64 -1)) (text "Unlimited uses") (call std::text-join (list Text (text "Remaining: ") (call std::i64-to-text (field (local invite) (name remaining))) (text " uses")) (text ""))) (if (call std::i64-equal (field (local invite) (name expires)) (i64 -1)) (text " · Never expires") (text ""))) (text "")))) (text "</p>") (if (call invitations::usable (local invite) (field (local ctx) (name now))) (call std::text-join (list Text (call page::begin (local ctx) (text "revoke-invite")) (call page::hidden (text "id") (field (local invite) (name id))) (text "<button class=\"danger compact\">Revoke invitation</button></form>")) (text "")) (text "")) (text "</article>")) (text ""))))) (local out))))

  (function create invitations (visibility public) (parameter create ctx (type Context)) (parameter create request (type Request)) (returns Response) (effect (task (requirement service::app::store))) (body (let (binding user (call db::user (field (local ctx) (name user)))) (in (if (if (call util::signed (local ctx)) (if (field (local user) (name admin)) (bool true) (bool false)) (bool false)) (let (binding listing (call db::listing (text "invites") (call util::query (local request) (text "cursor")) (i64 30))) (in (call page::reply (i64 200) (call page::frame (local ctx) (text "Invitations") (call std::text-join (list Text (call paging::previous (local request) (text "/admin/invitations?")) (text "<nav class=\"crumbs\" aria-label=\"Breadcrumb\"><a href=\"/admin\">Admin</a> / Invitations</nav><section class=\"panel\"><h2>New invitation</h2><p class=\"context-hint\">Invite only the people you intend to join. The invitation link is shown once, after creation.</p>") (call page::begin (local ctx) (text "invite")) (text "<div class=\"stack\">") (call controls::input (text "label") (text "Label (for your reference)") (text "") (text "text")) (text "<div class=\"row\">") (text "<label>Number of people<input name=\"uses\" type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]*\" value=\"1\" placeholder=\"Unlimited\" aria-describedby=\"invite-limits\"></label>") (text "<label>Expires after (days)<input name=\"days\" type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]*\" value=\"7\" placeholder=\"Never\" aria-describedby=\"invite-limits\"></label>") (text "</div><p class=\"field-help\" id=\"invite-limits\">Leave people blank for unlimited uses, or days blank for no expiration.</p><button class=\"primary\">Create invitation</button></div></form></section><section class=\"panel\"><h2>Your invitations</h2>") (call adminview::invites (local ctx) (field (local listing) (name ids)) (i64 0) (text "")) (text "</section>") (call paging::next (local request) (field (local listing) (name next)) (text "/admin/invitations?"))) (text ""))) (text "") (text "")))) (call page::error (i64 403) (text "Only administrators can open this page.")))))))




  (function create admin (visibility public)
    (parameter create ctx (type Context))
    (parameter create request (type Request))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (if (if (call util::signed (local ctx)) (if (field (call db::user (field (local ctx) (name user))) (name admin)) (bool true) (bool false)) (bool false)) (call page::ok-at (local ctx) (text "Admin") (text "Settings") (call std::text-join (list Text (text "<div class=\"admin-metrics\"><section class=\"panel\"><strong>") (call std::i64-to-text (call db::count (text "users"))) (text "</strong><span>Members registered</span></section><section class=\"panel\"><strong>") (call std::i64-to-text (call db::count (text "timeline"))) (text "</strong><span>Posts created</span></section></div><section class=\"panel settings-list\">") (call page::destination (text "/admin/invitations") (text "Invitations") (text "Create and revoke access to the community.") (text "lock")) (call page::destination (text "/people") (text "Members") (text "Review member profiles.") (text "people")) (text "</section><section class=\"panel\"><h2>Storage policy</h2><p class=\"field-help\">Any file type · 256 MiB per file · 2 GiB per account</p></section>")) (text ""))) (call page::error (i64 403) (text "This page is only available to administrators.")))))

)
