(module create navigation
  (function create unreserved (visibility public)
    (parameter create byte (type I64))
    (returns Bool) (effect pure)
    (body (if (if (call std::less-equal (i64 48) (local byte)) (if (call std::less-equal (local byte) (i64 57)) (bool true) (bool false)) (bool false)) (bool true) (if (if (call std::less-equal (i64 65) (local byte)) (if (call std::less-equal (local byte) (i64 90)) (bool true) (bool false)) (bool false)) (bool true) (if (if (call std::less-equal (i64 97) (local byte)) (if (call std::less-equal (local byte) (i64 122)) (bool true) (bool false)) (bool false)) (bool true) (if (call std::i64-equal (local byte) (i64 45)) (bool true) (if (call std::i64-equal (local byte) (i64 46)) (bool true) (if (call std::i64-equal (local byte) (i64 95)) (bool true) (if (call std::i64-equal (local byte) (i64 126)) (bool true) (bool false))))))))))

  (function create encode-bytes (visibility public)
    (parameter create bytes (type Bytes))
    (parameter create index (type I64))
    (parameter create out (type Text))
    (returns Text) (effect pure)
    (body (if (call std::less (local index) (call std::bytes-length (local bytes))) (let (binding byte (call std::bytes-get (local bytes) (local index))) (binding single (call std::bytes-from-list (list I64 (local byte)))) (in (call navigation::encode-bytes (local bytes) (call std::add (local index) (i64 1)) (call std::text-join (list Text (local out) (if (call navigation::unreserved (local byte)) (call std::bytes-to-text (local single)) (call std::text-join (list Text (text "%") (call std::bytes-to-hex (local single))) (text "")))) (text ""))))) (local out))))

  (function create encode (visibility public)
    (parameter create value (type Text))
    (returns Text) (effect pure)
    (body (call navigation::encode-bytes (call std::bytes-from-text (local value)) (i64 0) (text ""))))

  (function create option (visibility public)
    (parameter create value (type Text))
    (parameter create label (type Text))
    (parameter create selected (type Text))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "<option value=\"") (call std::html-escape-text (local value)) (text "\"") (if (call std::text-equal (local value) (local selected)) (text " selected") (text "")) (text ">") (call std::html-escape-text (local label)) (text "</option>")) (text ""))))

  (test create query-escaping (visibility private)
    (actual (call navigation::encode (text "a&b=c +/"))) (expected (text "a%26b%3dc%20%2b%2f")))

  (test create utf8-query (visibility private)
    (actual (call navigation::encode (text "写真"))) (expected (text "%e5%86%99%e7%9c%9f")))

  (test create unreserved-query (visibility private)
    (actual (call navigation::encode (text "hello-_.~123"))) (expected (text "hello-_.~123")))
  (function create reading-place (visibility public) (parameter create place (type Text)) (returns Bool) (effect pure) (body (if (if (call std::text-starts-with (local place) (text "file:")) (if (call util::token (call util::slice (local place) (i64 5) (call util::size (local place)))) (bool true) (bool false)) (bool false)) (bool true) (if (if (call util::has (list Text (text "home") (text "attention") (text "bookmarks")) (local place) (i64 0)) (bool true) (if (call std::text-starts-with (local place) (text "profile:")) (call util::handle (call util::slice (local place) (i64 8) (call util::size (local place)))) (if (call std::text-starts-with (local place) (text "thread:")) (call util::post-id (call util::slice (local place) (i64 7) (call util::size (local place)))) (bool false)))) (bool true) (bool false)))))

  (function create reading-cursor (visibility public)
    (parameter create cursor (type Text)) (returns Bool) (effect pure)
    (body (if (call std::text-equal (local cursor) (text "")) (bool true)
      (call std::less-equal (i64 0) (call util::number (local cursor) (i64 9999999999))))))

  (function create reading-base (visibility private)
    (parameter create place (type Text)) (returns Text) (effect pure)
    (body (if (call std::text-equal (local place) (text "home")) (text "/")
      (if (call std::text-equal (local place) (text "attention")) (text "/?feed=attention")
        (if (call std::text-equal (local place) (text "bookmarks")) (text "/saved")
          (if (call std::text-starts-with (local place) (text "profile:"))
            (call std::text-join (list Text (text "/@")
              (call util::slice (local place) (i64 8) (call util::size (local place)))) (text ""))
            (call paths::canonical (call std::text-join (list Text (text "/note?id=")
              (call util::slice (local place) (i64 7) (call util::size (local place)))) (text "")))))))))

  (function create reading-return (visibility public) (parameter create place (type Text)) (parameter create cursor (type Text)) (parameter create post (type Text)) (returns Text) (effect pure) (body (if (if (if (call std::text-starts-with (local place) (text "file:")) (if (call util::token (call util::slice (local place) (i64 5) (call util::size (local place)))) (bool true) (bool false)) (bool false)) (if (call navigation::reading-cursor (local cursor)) (if (call util::post-id (local post)) (bool true) (bool false)) (bool false)) (bool false)) (call std::text-join (list Text (text "/") (call util::slice (local place) (i64 5) (call util::size (local place))) (text "?cursor=") (call navigation::encode (local cursor)) (text "#post-") (call util::short-id (local post))) (text "")) (if (if (call navigation::reading-place (local place)) (if (call navigation::reading-cursor (local cursor)) (call util::post-id (local post)) (bool false)) (bool false)) (let (binding base (call navigation::reading-base (local place))) (in (call std::text-join (list Text (local base) (if (call std::text-equal (local cursor) (text "")) (text "") (call std::text-join (list Text (if (call std::text-contains (local base) (text "?")) (text "&cursor=") (text "?cursor=")) (call std::i64-to-text (call util::number (local cursor) (i64 9999999999)))) (text ""))) (text "#post-") (call util::short-id (local post))) (text "")))) (text "/")))))

  (test create reading-accepts-home (visibility private)
    (actual (call navigation::reading-place (text "home"))) (expected (bool true)))
  (test create reading-accepts-profile (visibility private)
    (actual (call navigation::reading-place (text "profile:alice"))) (expected (bool true)))
  (test create reading-refuses-url (visibility private)
    (actual (call navigation::reading-place (text "https://example.invalid/"))) (expected (bool false)))
  (test create reading-refuses-network-path (visibility private)
    (actual (call navigation::reading-place (text "//example.invalid/"))) (expected (bool false)))
  (test create reading-refuses-profile-injection (visibility private)
    (actual (call navigation::reading-place (text "profile:alice&admin=1"))) (expected (bool false)))
  (test create reading-refuses-missing-thread (visibility private)
    (actual (call navigation::reading-place (text "thread:"))) (expected (bool false)))
  (test create reading-cursor-refuses-query (visibility private)
    (actual (call navigation::reading-cursor (text "1&feed=attention"))) (expected (bool false)))
  (test create reading-cursor-refuses-negative (visibility private)
    (actual (call navigation::reading-cursor (text "-1"))) (expected (bool false)))
  (test create reading-cursor-refuses-overflow (visibility private)
    (actual (call navigation::reading-cursor (text "99999999999"))) (expected (bool false)))
  (test create reading-cursor-allows-first-page (visibility private)
    (actual (call navigation::reading-cursor (text ""))) (expected (bool true)))
  (test create reading-home-keeps-anchor (visibility private)
    (actual (call navigation::reading-return (text "home") (text "") (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))
    (expected (text "/#post-nananananananana")))
  (test create reading-attention-keeps-page (visibility private)
    (actual (call navigation::reading-return (text "attention") (text "30") (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))
    (expected (text "/?feed=attention&cursor=30#post-nananananananana")))
  (test create reading-profile-keeps-page (visibility private)
    (actual (call navigation::reading-return (text "profile:alice") (text "30") (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))
    (expected (text "/@alice?cursor=30#post-nananananananana")))
  (test create reading-thread-keeps-parent (visibility private)
    (actual (call navigation::reading-return (text "thread:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb") (text "") (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))
    (expected (text "/qexvqexvqexvqexv#post-nananananananana")))
  (test create reading-invalid-fails-closed (visibility private)
    (actual (call navigation::reading-return (text "//example.invalid/") (text "") (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))
    (expected (text "/")))
  (test create reading-invalid-anchor-fails-closed (visibility private)
    (actual (call navigation::reading-return (text "home") (text "") (text "oops#fragment"))) (expected (text "/")))

  (test create bookmark-history-return (visibility private) (actual (call navigation::reading-return (text "bookmarks") (text "5") (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))) (expected (text "/saved?cursor=5#post-nananananananana")))
)
