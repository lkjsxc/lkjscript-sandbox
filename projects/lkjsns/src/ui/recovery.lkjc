(module create recovery
  (function create copy (visibility public)
    (parameter create label (type Text))
    (parameter create value (type Text))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "<label>") (call std::html-escape-text (local label)) (text "<textarea readonly rows=\"6\">") (call std::html-escape-text (local value)) (text "</textarea></label>")) (text ""))))

  (function create input (visibility public)
    (parameter create ctx (type Context))
    (parameter create form (type Form))
    (parameter create message (type Text))
    (parameter create status (type I64))
    (returns Response) (effect pure)
    (body (call page::reply (local status) (call page::frame (local ctx) (text "操作の確認") (call std::text-join (list Text (text "<section class=\"panel stack\"><div class=\"notice danger\" role=\"alert\">") (call std::html-escape-text (local message)) (text "</div>") (if (call std::text-equal (call util::value (local form) (text "intent")) (text "note")) (call std::text-join (list Text (call recovery::copy (text "送信した本文") (call util::value (local form) (text "body"))) (call recovery::copy (text "送信した注意書き") (call util::value (local form) (text "cw")))) (text "")) (if (call std::text-equal (call util::value (local form) (text "intent")) (text "file")) (call std::text-join (list Text (call recovery::copy (text "送信したファイル名") (call util::value (local form) (text "name"))) (call recovery::copy (text "送信した説明") (call util::value (local form) (text "alt")))) (text "")) (if (call std::text-equal (call util::value (local form) (text "intent")) (text "profile")) (call std::text-join (list Text (call recovery::copy (text "送信した表示名") (call util::value (local form) (text "display"))) (call recovery::copy (text "送信した自己紹介") (call util::value (local form) (text "bio")))) (text "")) (text "")))) (text "<p class=\"field-help\">送信した内容が表示されている場合は、コピーしてから移動してください。この画面だけでは保存結果を確認できません。</p><div class=\"row\"><a class=\"button\" href=\"/login\" target=\"_blank\" rel=\"noopener\">別のタブでログイン</a><a class=\"button\" href=\"/drafts\" target=\"_blank\" rel=\"noopener\">保存済みの下書きを確認</a></div></section>")) (text ""))) (text "") (text ""))))

  (function create profile (visibility public)
    (parameter create ctx (type Context))
    (parameter create form (type Form))
    (parameter create status (type I64))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (let (binding user (call db::user (field (local ctx) (name user)))) (in (call page::reply (local status) (call page::frame (local ctx) (text "プロフィールの確認") (call std::text-join (list Text (call controls::message (text "入力は反映されていません。現在の内容を確認してから、下に残した入力を保存してください。")) (text "<details class=\"panel\" open><summary>現在のプロフィール</summary><p>") (call std::html-escape-text (field (local user) (name display))) (text "</p><pre class=\"conflict\">") (call std::html-escape-text (field (local user) (name bio))) (text "</pre></details><section class=\"panel\">") (call page::begin (local ctx) (text "profile")) (call page::hidden (text "version") (call std::i64-to-text (field (local user) (name version)))) (text "<div class=\"stack\">") (call controls::input (text "display") (text "送信した表示名") (call util::value (local form) (text "display")) (text "text")) (call controls::area (text "bio") (text "送信した自己紹介") (call util::value (local form) (text "bio"))) (text "<button class=\"primary\">確認した内容を保存</button></div></form></section>")) (text ""))) (text "") (text ""))))))

  (function create conflict (visibility public)
    (parameter create request (type Request))
    (parameter create form (type Form))
    (returns Response) (effect (task (requirement service::app::store) (requirement service::app::clock) (requirement service::app::config)))
    (body (let (binding ctx (call auth::context (local request))) (in (if (call util::csrf (local ctx) (local form)) (if (call std::text-equal (call util::value (local form) (text "intent")) (text "note")) (let (binding stored (call db::note (call util::value (local form) (text "id")))) (binding fresh (call std::i64-equal (call std::list-length (types std::DataEntry) (call db::read (text "note") (call util::value (local form) (text "id")))) (i64 0))) (binding note (if (local fresh) (call journal::blank (local ctx) (call util::value (local form) (text "id"))) (local stored))) (in (if (if (call util::token (call util::value (local form) (text "id"))) (if (call std::text-equal (field (local note) (name author)) (field (local ctx) (name user))) (if (call std::bool-not (field (local note) (name deleted))) (if (call std::less-equal (i64 0) (field (local note) (name version))) (bool true) (bool false)) (bool false)) (bool false)) (bool false)) (call journalview::recover (local ctx) (local form) (local note) (text "同時に別の操作が行われ、保存を確定できませんでした。現在の内容とあなたの入力を比較してください。") (i64 409)) (call recovery::input (local ctx) (local form) (text "保存対象の状態が変わりました。入力をコピーして保存済みの内容を確認してください。") (i64 409))))) (if (call std::text-equal (call util::value (local form) (text "intent")) (text "file")) (call mediaflow::recover (local ctx) (local form) (i64 409)) (if (call std::text-equal (call util::value (local form) (text "intent")) (text "profile")) (call recovery::profile (local ctx) (local form) (i64 409)) (call recovery::input (local ctx) (local form) (text "同時に別の操作が行われ、結果を確定できませんでした。現在の状態を確認してください。") (i64 409))))) (call recovery::input (local ctx) (local form) (text "ログイン状態が変わりました。送信した入力を保存済みの内容と確認してください。") (i64 401)))))))

  (test create copy-escapes-html (visibility private)
    (actual (call recovery::copy (text "Note") (text "</textarea><script>"))) (expected (text "<label>Note<textarea readonly rows=\"6\">&lt;/textarea&gt;&lt;script&gt;</textarea></label>")))

  (test create recovery-never-echoes-password (visibility private)
    (actual (call std::text-contains (call std::bytes-to-text (field (call recovery::input (call auth::guest (i64 1)) (call util::parse (call std::bytes-from-text (text "intent=login&csrf=&handle=alice&password=UNIQUE-SECRET-PASSWORD"))) (text "Please sign in again.") (i64 403)) (name body))) (text "UNIQUE-SECRET-PASSWORD"))) (expected (bool false)))
)
