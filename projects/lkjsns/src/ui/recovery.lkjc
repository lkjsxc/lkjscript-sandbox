(module create recovery
  (function create copy (visibility public)
    (parameter create label (type Text))
    (parameter create value (type Text))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "<label>") (call std::html-escape-text (local label)) (text "<textarea readonly rows=\"6\">") (call std::html-escape-text (local value)) (text "</textarea></label>")) (text ""))))

  (function create input (visibility public)
    (parameter create ctx (type Context))
    (parameter create form (type Form))
    (parameter create message (type Text))
    (parameter create status (type I64))
    (returns Response) (effect pure)
    (body (call page::reply (local status) (call page::frame (local ctx) (text "Check this action") (call std::text-join (list Text (text "<section class=\"panel stack\"><div class=\"notice danger\" role=\"alert\">") (call std::html-escape-text (local message)) (text "</div>") (if (call std::text-equal (call util::value (local form) (text "intent")) (text "note")) (call std::text-join (list Text (call recovery::copy (text "Submitted text") (call util::value (local form) (text "body"))) (call recovery::copy (text "Submitted content warning") (call util::value (local form) (text "cw")))) (text "")) (if (call std::text-equal (call util::value (local form) (text "intent")) (text "file")) (call std::text-join (list Text (call recovery::copy (text "Submitted file name") (call util::value (local form) (text "name"))) (call recovery::copy (text "Submitted description") (call util::value (local form) (text "alt")))) (text "")) (if (call std::text-equal (call util::value (local form) (text "intent")) (text "profile")) (call std::text-join (list Text (call recovery::copy (text "Submitted display name") (call util::value (local form) (text "display"))) (call recovery::copy (text "Submitted bio") (call util::value (local form) (text "bio")))) (text "")) (text "")))) (text "<p class=\"field-help\">Copy any submitted text shown here before leaving. This screen alone cannot confirm what was saved.</p><div class=\"row\"><a class=\"button\" href=\"/login\" target=\"_blank\" rel=\"noopener\">Sign in in another tab</a><a class=\"button\" href=\"/drafts\" target=\"_blank\" rel=\"noopener\">Check saved drafts</a></div></section>")) (text ""))) (text "") (text ""))))

  (function create profile (visibility public)
    (parameter create ctx (type Context))
    (parameter create form (type Form))
    (parameter create status (type I64))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (let (binding user (call db::user (field (local ctx) (name user)))) (in (call page::reply (local status) (call page::frame (local ctx) (text "Review profile") (call std::text-join (list Text (call controls::message (text "Your changes were not applied. Review the current version before saving your preserved input below.")) (text "<details class=\"panel\" open><summary>Current profile</summary><p>") (call std::html-escape-text (field (local user) (name display))) (text "</p><pre class=\"conflict\">") (call std::html-escape-text (field (local user) (name bio))) (text "</pre></details><section class=\"panel\">") (call page::begin (local ctx) (text "profile")) (call page::hidden (text "version") (call std::i64-to-text (field (local user) (name version)))) (text "<div class=\"stack\">") (call controls::input (text "display") (text "Submitted display name") (call util::value (local form) (text "display")) (text "text")) (call controls::area (text "bio") (text "Submitted bio") (call util::value (local form) (text "bio"))) (text "<button class=\"primary\">Save reviewed changes</button></div></form></section>")) (text ""))) (text "") (text ""))))))

  (function create conflict (visibility public)
    (parameter create request (type Request))
    (parameter create form (type Form))
    (returns Response) (effect (task (requirement service::app::store) (requirement service::app::clock) (requirement service::app::config)))
    (body (let (binding ctx (call auth::context (local request))) (in (if (call util::csrf (local ctx) (local form)) (if (call std::text-equal (call util::value (local form) (text "intent")) (text "note")) (let (binding stored (call db::note (call util::value (local form) (text "id")))) (binding fresh (call std::i64-equal (call std::list-length (types std::DataEntry) (call db::read (text "note") (call util::value (local form) (text "id")))) (i64 0))) (binding note (if (local fresh) (call journal::blank (local ctx) (call util::value (local form) (text "id"))) (local stored))) (in (if (if (call util::token (call util::value (local form) (text "id"))) (if (call std::text-equal (field (local note) (name author)) (field (local ctx) (name user))) (if (call std::bool-not (field (local note) (name deleted))) (if (call std::less-equal (i64 0) (field (local note) (name version))) (bool true) (bool false)) (bool false)) (bool false)) (bool false)) (call journalview::recover (local ctx) (local form) (local note) (text "Another action happened at the same time and the save could not be confirmed. Compare the saved version with your input.") (i64 409)) (call recovery::input (local ctx) (local form) (text "The item changed. Copy your input and check the saved version.") (i64 409))))) (if (call std::text-equal (call util::value (local form) (text "intent")) (text "file")) (call mediaflow::recover (local ctx) (local form) (i64 409)) (if (call std::text-equal (call util::value (local form) (text "intent")) (text "profile")) (call recovery::profile (local ctx) (local form) (i64 409)) (call recovery::input (local ctx) (local form) (text "Another action happened at the same time and the result could not be confirmed. Check the current state.") (i64 409))))) (call recovery::input (local ctx) (local form) (text "Your sign-in changed. Compare your submitted input with the saved version.") (i64 401)))))))

  (test create copy-escapes-html (visibility private)
    (actual (call recovery::copy (text "Note") (text "</textarea><script>"))) (expected (text "<label>Note<textarea readonly rows=\"6\">&lt;/textarea&gt;&lt;script&gt;</textarea></label>")))

  (test create recovery-never-echoes-password (visibility private)
    (actual (call std::text-contains (call std::bytes-to-text (field (call recovery::input (call auth::guest (i64 1)) (call util::parse (call std::bytes-from-text (text "intent=login&csrf=&handle=alice&password=UNIQUE-SECRET-PASSWORD"))) (text "Please sign in again.") (i64 403)) (name body))) (text "UNIQUE-SECRET-PASSWORD"))) (expected (bool false)))
)
