  (function create reply-ok (visibility public)
 (parameter create ctx (type Context)) (parameter create form (type Form))
 (returns Bool) (effect (task (requirement service::app::store)))
 (body (if (call std::text-equal (call util::value (local form) (text "reply")) (text "")) (bool true)
  (let (binding parent (call db::note (call util::value (local form) (text "reply"))))
