(module create accounts
  (function create password (visibility public)
    (parameter create name (type Text)) (parameter create label (type Text))
    (parameter create fresh (type Bool)) (returns Text) (effect pure)
    (body (call std::text-join (list Text
      (text "<label>") (call std::html-escape-text (local label))
      (text "<input type=\"password\" name=\"") (call std::html-escape-text (local name))
      (text "\" autocomplete=\"") (if (local fresh) (text "new-password") (text "current-password"))
      (text "\" required minlength=\"12\" maxlength=\"128\"></label>")) (text ""))))

  (function create login (visibility public) (parameter create ctx (type Context)) (parameter create request (type Request)) (parameter create joining (type Bool)) (returns Response) (effect pure) (body (if (call util::signed (local ctx)) (call page::redirect (text "/settings")) (call page::ok (local ctx) (if (local joining) (text "Create account") (text "Sign in")) (call std::text-join (list Text (text "<section class=\"panel auth-panel\"><div class=\"stack\">") (if (local joining) (text "<p class=\"context-hint\">Use your invitation to join the community.</p>") (text "<p class=\"context-hint\">Sign in to your account.</p>")) (call page::begin (local ctx) (if (local joining) (text "join") (text "login"))) (text "<div class=\"stack\"><label>Username<input name=\"handle\" autocomplete=\"username\" autocapitalize=\"none\" spellcheck=\"false\" required minlength=\"3\" maxlength=\"24\" pattern=\"[a-z0-9_-]{3,24}\"><span class=\"field-help\">3–24 lowercase letters, numbers, hyphens, or underscores.</span></label>") (call accounts::password (text "password") (text "Password") (local joining)) (if (local joining) (call std::text-join (list Text (call accounts::password (text "confirm") (text "Confirm password") (bool true)) (call controls::input (text "invite") (text "Invitation code") (call util::query (local request) (text "invite")) (text "text")) (text "<p class=\"field-help\">Use 12–128 bytes. There is no email recovery, so keep your password somewhere safe.</p>")) (text "")) (text "")) (text "<button class=\"primary full\">") (if (local joining) (text "Create account") (text "Sign in")) (call std::text-join (list Text (text "</button></div>") (if (local joining) (text "<p class=\"field-help auth-legal\">By creating an account, you agree to the <a href=\"/terms\" target=\"_blank\" rel=\"noopener noreferrer\">Terms of service</a> and <a href=\"/guidelines\" target=\"_blank\" rel=\"noopener noreferrer\">Community guidelines</a>. Read the <a href=\"/privacy\" target=\"_blank\" rel=\"noopener noreferrer\">Privacy policy</a>.</p>") (text "")) (text "</form><p class=\"field-help\">")) (text "")) (if (local joining) (text "Already have an account? <a href=\"/login\">Sign in</a>") (text "Have an invitation? <a href=\"/join\">Create account</a>")) (text "</p></div></section>")) (text ""))))))

  (function create settings (visibility public) (parameter create ctx (type Context)) (returns Response) (effect (task (requirement service::app::store))) (body (call page::ok (local ctx) (text "Settings") (call std::text-join (list Text (text "<section class=\"settings-group\"><div class=\"panel settings-list\">") (call page::destination (text "/settings/profile") (text "Profile") (text "Name, bio, and profile image.") (text "people")) (call page::destination (text "/settings/security") (text "Password and security") (text "Change your password and manage sign-in.") (text "lock")) (text "</div></section><section class=\"panel\">") (call page::begin (local ctx) (text "logout")) (text "<button class=\"subtle\">Sign out</button></form></section>")) (text "")))))

  (function create member (visibility public)
    (parameter create user (type User)) (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "<a class=\"member-row\" href=\"/@")
      (call std::html-escape-text (field (local user) (name handle))) (text "\">")
      (call page::avatar (field (local user) (name handle)))
      (text "<span class=\"identity\"><strong>") (call std::html-escape-text (field (local user) (name display)))
      (text "</strong><small>@") (call std::html-escape-text (field (local user) (name handle)))
      (text "</small></span>") (call page::icon (text "arrow")) (text "</a>")) (text ""))))

  (function create members (visibility public)
    (parameter create ids (type (list Text))) (parameter create index (type I64)) (parameter create out (type Text))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (if (call std::less (local index) (call std::list-length (types Text) (local ids)))
      (let (binding user (call db::user (call std::list-get (types Text) (local ids) (local index))))
        (in (call accounts::members (local ids) (call std::add (local index) (i64 1))
          (if (call util::handle (field (local user) (name handle)))
            (if (field (local user) (name suspended)) (local out)
              (call std::text-join (list Text (local out) (call accounts::member (local user))) (text "")))
            (local out))))) (local out))))

  (function create people (visibility public) (parameter create ctx (type Context)) (parameter create request (type Request)) (returns Response) (effect (task (requirement service::app::store))) (body (let (binding listing (call db::listing (text "users") (call util::query (local request) (text "cursor")) (i64 30))) (in (call page::ok (local ctx) (text "Members") (call std::text-join (list Text (text "") (text "<div class=\"panel member-list\">") (call accounts::members (field (local listing) (name ids)) (i64 0) (text "")) (text "</div>") (call paging::controls (local request) (field (local listing) (name next)) (text "/people?"))) (text "")))))))

  (function create relationship (visibility public)
    (parameter create ctx (type Context)) (parameter create target (type Text))
    (parameter create intent (type Text)) (parameter create enabled (type Bool))
    (returns Text) (effect pure)
    (body (if (call std::text-equal (local intent) (text "attention"))
      (call attentionui::toggle (local ctx) (local target) (local enabled) (local target) (text "profile") (text "") (text ""))
      (call std::text-join (list Text (call page::begin (local ctx) (text "mute"))
        (call page::hidden (text "handle") (local target))
        (call page::hidden (text "enabled") (if (local enabled) (text "0") (text "1")))
        (text "<button class=\"subtle\">") (if (local enabled) (text "Unmute") (text "Mute"))
        (text "</button></form>")) (text "")))))

  (function create profile (visibility public) (parameter create ctx (type Context)) (parameter create request (type Request)) (returns Response) (effect (task (requirement service::app::store))) (body (let (binding user (call db::user (call util::query (local request) (text "user")))) (binding viewer (call db::user (field (local ctx) (name user)))) (in (if (call util::handle (field (local user) (name handle))) (if (field (local user) (name suspended)) (call page::error (i64 404) (text "Member not found.")) (let (binding listing (call db::listing (call std::text-join (list Text (text "author/") (field (local user) (name handle))) (text "")) (call util::query (local request) (text "cursor")) (i64 30))) (in (call page::ok-at (local ctx) (field (local user) (name display)) (text "Profile") (call std::text-join (list Text (text "") (text "<section class=\"panel profile\">") (call page::avatar (field (local user) (name handle))) (text "<h2>") (call std::html-escape-text (field (local user) (name display))) (text "</h2><p class=\"meta\">@") (call std::html-escape-text (field (local user) (name handle))) (text "</p><p class=\"note-body\">") (call links::render (field (local user) (name bio))) (text "</p>") (call attentionui::profile-badge (local viewer) (local user)) (call attentionui::links (local ctx) (field (local user) (name handle))) (text "<div class=\"row\">") (if (call util::signed (local ctx)) (if (call std::text-equal (field (local ctx) (name user)) (field (local user) (name handle))) (text "<a class=\"button\" href=\"/settings/profile\">Edit profile</a>") (call std::text-join (list Text (call accounts::relationship (local ctx) (field (local user) (name handle)) (text "attention") (call util::has (field (local viewer) (name attention)) (field (local user) (name handle)) (i64 0))) (call accounts::relationship (local ctx) (field (local user) (name handle)) (text "mute") (call util::has (field (local viewer) (name muted)) (field (local user) (name handle)) (i64 0)))) (text ""))) (text "")) (text "</div></section>") (call paging::top (local request) (field (local listing) (name next)) (call std::text-join (list Text (text "/@") (field (local user) (name handle)) (text "?")) (text ""))) (text "<div class=\"feed\">") (call journalview::rows (local ctx) (field (local listing) (name ids)) (i64 0) (text "everyone") (local viewer) (text "") (call std::text-join (list Text (text "profile:") (field (local user) (name handle))) (text "")) (call util::query (local request) (text "cursor")) (call util::query (local request) (text "trail"))) (text "</div>") (call paging::controls (local request) (field (local listing) (name next)) (call std::text-join (list Text (text "/@") (field (local user) (name handle)) (text "?")) (text "")))) (text "")))))) (call page::error (i64 404) (text "Member not found.")))))))

  (test create password-autocomplete (visibility private)
    (actual (call accounts::password (text "password") (text "Password") (bool true)))
    (expected (text "<label>Password<input type=\"password\" name=\"password\" autocomplete=\"new-password\" required minlength=\"12\" maxlength=\"128\"></label>")))
  (function create profile-settings (visibility public)
    (parameter create ctx (type Context))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (let (binding user (call db::user (field (local ctx) (name user)))) (in (call page::ok-at (local ctx) (text "Profile") (text "Settings") (call std::text-join (list Text (text "<nav class=\"crumbs\" aria-label=\"Breadcrumb\"><a href=\"/settings\">Settings</a> / Profile</nav>") (text "<section class=\"panel\"><div class=\"profile-image-setting\"><a class=\"avatar-picker-link\" href=\"/settings/avatar\" aria-label=\"Change profile image\">") (call page::avatar (field (local ctx) (name user))) (text "</a><div><p class=\"field-help\">Your profile image is public.</p></div></div>") (call page::begin (local ctx) (text "profile")) (call page::hidden (text "version") (call std::i64-to-text (field (local user) (name version)))) (text "<div class=\"stack\">") (call controls::input (text "display") (text "Display name") (field (local user) (name display)) (text "text")) (call controls::area (text "bio") (text "Bio") (field (local user) (name bio))) (text "<div class=\"row\"><button class=\"primary\">Save profile</button></div></div></form></section>")) (text "")))))))

  (function create security (visibility public)
    (parameter create ctx (type Context))
    (returns Response) (effect pure)
    (body (call page::ok-at (local ctx) (text "Password and security") (text "Settings") (call std::text-join (list Text (text "<nav class=\"crumbs\" aria-label=\"Breadcrumb\"><a href=\"/settings\">Settings</a> / Password and security</nav>") (text "<section class=\"panel\"><p class=\"context-hint\">Changing your password signs you out on every device.</p>") (call page::begin (local ctx) (text "password")) (text "<div class=\"stack\">") (call accounts::password (text "old") (text "Current password") (bool false)) (call accounts::password (text "password") (text "New password") (bool true)) (call accounts::password (text "confirm") (text "Confirm new password") (bool true)) (text "<button class=\"primary\">Change password</button></div></form></section>")) (text "")))))

)
