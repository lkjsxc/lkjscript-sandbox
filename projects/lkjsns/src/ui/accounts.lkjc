(module create accounts
  (function create password (visibility public)
    (parameter create name (type Text)) (parameter create label (type Text))
    (parameter create fresh (type Bool)) (returns Text) (effect pure)
    (body (call std::text-join (list Text
      (text "<label>") (call std::html-escape-text (local label))
      (text "<input type=\"password\" name=\"") (call std::html-escape-text (local name))
      (text "\" autocomplete=\"") (if (local fresh) (text "new-password") (text "current-password"))
      (text "\" required minlength=\"12\" maxlength=\"128\"></label>")) (text ""))))

  (function create login (visibility public)
    (parameter create ctx (type Context)) (parameter create request (type Request))
    (parameter create joining (type Bool)) (returns Response) (effect pure)
    (body (if (call util::signed (local ctx)) (call page::redirect (text "/settings"))
      (call page::ok (local ctx) (if (local joining) (text "アカウントを作成") (text "ログイン"))
        (call std::text-join (list Text (text "<section class=\"panel auth-panel\"><div class=\"stack\">")
          (if (local joining)
            (text "<p class=\"context-hint\">招待された方のための登録画面です。登録後はメンバー限定のノートを読めます。</p>")
            (text "<p class=\"context-hint\">ユーザー名とパスワードでログインします。</p>"))
          (call page::begin (local ctx) (if (local joining) (text "join") (text "login")))
          (text "<div class=\"stack\"><label>ユーザー名<input name=\"handle\" autocomplete=\"username\" autocapitalize=\"none\" spellcheck=\"false\" required minlength=\"3\" maxlength=\"24\" pattern=\"[a-z0-9_-]{3,24}\"><span class=\"field-help\">半角小文字・数字・ハイフン・アンダースコア、3〜24文字</span></label>")
          (call accounts::password (text "password") (text "パスワード") (local joining))
          (if (local joining) (call std::text-join (list Text
            (call accounts::password (text "confirm") (text "パスワード（確認）") (bool true))
            (call controls::input (text "invite") (text "招待コード") (call util::query (local request) (text "invite")) (text "text"))
            (text "<p class=\"field-help\">パスワードは12〜128バイト。現在、メールによる復旧はありません。安全な場所に保管してください。</p>")) (text "")) (text ""))
          (text "<button class=\"primary full\">") (if (local joining) (text "アカウントを作成") (text "ログイン"))
          (text "</button></div></form><p class=\"field-help\">")
          (if (local joining) (text "すでに登録済みですか？ <a href=\"/login\">ログイン</a>")
            (text "招待を受け取った方は <a href=\"/join\">アカウントを作成</a>"))
          (text "</p></div></section>")) (text ""))))))

  (function create settings (visibility public)
    (parameter create ctx (type Context)) (returns Response)
    (effect (task (requirement service::app::store)))
    (body (let (binding user (call db::user (field (local ctx) (name user))))
      (in (call page::ok (local ctx) (text "アカウント")
        (call std::text-join (list Text
          (text "<nav class=\"account-destinations panel\" aria-label=\"アカウントメニュー\">")
          (call page::link (text "/drafts") (text "下書き") (text "draft") (bool false))
          (call page::link (text "/saved") (text "しおり") (text "bookmark") (bool false))
          (call page::link (text "/notifications") (text "通知") (text "bell") (bool false))
          (call page::link (text "/people") (text "メンバー") (text "people") (bool false))
          (if (field (local user) (name admin)) (call page::link (text "/admin") (text "招待の管理") (text "lock") (bool false)) (text ""))
          (text "</nav><section class=\"panel\"><h2>プロフィール</h2><p class=\"field-help\">@")
          (call std::html-escape-text (field (local user) (name handle)))
          (text " · ユーザー名は変更できません。表示名と自己紹介は公開されます。</p>")
          (call page::begin (local ctx) (text "profile"))
          (call page::hidden (text "version") (call std::i64-to-text (field (local user) (name version))))
          (text "<div class=\"stack\">")
          (call controls::input (text "display") (text "表示名") (field (local user) (name display)) (text "text"))
          (call controls::area (text "bio") (text "自己紹介") (field (local user) (name bio)))
          (text "<button class=\"primary\">プロフィールを保存</button></div></form></section><details class=\"panel\"><summary>パスワードを変更</summary><p class=\"field-help\">変更すると、すべての端末からログアウトします。</p>")
          (call page::begin (local ctx) (text "password")) (text "<div class=\"stack\">")
          (call accounts::password (text "old") (text "現在のパスワード") (bool false))
          (call accounts::password (text "password") (text "新しいパスワード") (bool true))
          (call accounts::password (text "confirm") (text "新しいパスワード（確認）") (bool true))
          (text "<button>パスワードを変更</button></div></form></details><section class=\"panel\">")
          (call page::begin (local ctx) (text "logout"))
          (text "<button>この端末からログアウト</button></form></section>")) (text "")))))))

  (function create member (visibility public)
    (parameter create user (type User)) (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "<a class=\"member-row\" href=\"/profile?user=")
      (call std::html-escape-text (field (local user) (name handle))) (text "\">")
      (call page::avatar (field (local user) (name handle)))
      (text "<span class=\"identity\"><strong>") (call std::html-escape-text (field (local user) (name display)))
      (text "</strong><small>@") (call std::html-escape-text (field (local user) (name handle)))
      (text "</small></span>") (call page::icon (text "arrow")) (text "</a>")) (text ""))))

  (function create members (visibility public)
    (parameter create ids (type (list Text))) (parameter create index (type I64)) (parameter create out (type Text))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (if (call std::less (local index) (call std::list-length (types Text) (local ids)))
      (let (binding user (call db::user (call std::list-get (types Text) (local ids) (local index))))
        (in (call accounts::members (local ids) (call std::add (local index) (i64 1))
          (if (call util::handle (field (local user) (name handle)))
            (if (field (local user) (name suspended)) (local out)
              (call std::text-join (list Text (local out) (call accounts::member (local user))) (text "")))
            (local out))))) (local out))))

  (function create people (visibility public)
    (parameter create ctx (type Context)) (parameter create request (type Request)) (returns Response)
    (effect (task (requirement service::app::store)))
    (body (let (binding listing (call db::listing (text "users") (call util::query (local request) (text "cursor")) (i64 30)))
      (in (call page::ok (local ctx) (text "メンバー") (call std::text-join (list Text
        (text "<div class=\"panel member-list\">")
        (call accounts::members (field (local listing) (name ids)) (i64 0) (text "")) (text "</div>")
        (call page::pager (field (local listing) (name next)) (text "/people?"))) (text "")))))))

  (function create relationship (visibility public)
    (parameter create ctx (type Context)) (parameter create target (type Text))
    (parameter create intent (type Text)) (parameter create enabled (type Bool))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (call page::begin (local ctx) (local intent))
      (call page::hidden (text "handle") (local target))
      (call page::hidden (text "enabled") (if (local enabled) (text "0") (text "1")))
      (text "<button aria-pressed=\"") (if (local enabled) (text "true") (text "false")) (text "\">")
      (if (call std::text-equal (local intent) (text "follow"))
        (if (local enabled) (text "フォロー解除") (text "フォロー"))
        (if (local enabled) (text "ミュート解除") (text "ミュート"))) (text "</button></form>")) (text ""))))

  (function create profile (visibility public)
    (parameter create ctx (type Context)) (parameter create request (type Request)) (returns Response)
    (effect (task (requirement service::app::store)))
    (body (let (binding user (call db::user (call util::query (local request) (text "user"))))
      (binding viewer (call db::user (field (local ctx) (name user))))
      (in (if (call util::handle (field (local user) (name handle)))
        (if (field (local user) (name suspended)) (call page::error (i64 404) (text "このメンバーは見つかりません。"))
          (let (binding listing (call db::listing (call std::text-join (list Text (text "author/") (field (local user) (name handle))) (text ""))
                    (call util::query (local request) (text "cursor")) (i64 30)))
            (in (call page::ok (local ctx) (field (local user) (name display))
              (call std::text-join (list Text (text "<section class=\"panel profile\">")
                (call page::avatar (field (local user) (name handle)))
                (text "<h2>") (call std::html-escape-text (field (local user) (name display)))
                (text "</h2><p class=\"meta\">@") (call std::html-escape-text (field (local user) (name handle)))
                (text "</p><p class=\"note-body\">") (call std::html-escape-text (field (local user) (name bio)))
                (text "</p><div class=\"row\">")
                (if (call util::signed (local ctx))
                  (if (call std::text-equal (field (local ctx) (name user)) (field (local user) (name handle)))
                    (text "<a class=\"button\" href=\"/settings\">プロフィールを編集</a>")
                    (call std::text-join (list Text
                      (call accounts::relationship (local ctx) (field (local user) (name handle)) (text "follow")
                        (call util::has (field (local viewer) (name following)) (field (local user) (name handle)) (i64 0)))
                      (call accounts::relationship (local ctx) (field (local user) (name handle)) (text "mute")
                        (call util::has (field (local viewer) (name muted)) (field (local user) (name handle)) (i64 0)))) (text ""))) (text ""))
                (text "</div></section><div class=\"feed\">")
                (call journalview::rows (local ctx) (field (local listing) (name ids)) (i64 0) (text "everyone") (local viewer) (text ""))
                (text "</div>") (call page::pager (field (local listing) (name next))
                  (call std::text-join (list Text (text "/profile?user=") (field (local user) (name handle)) (text "&")) (text "")))) (text ""))))))
        (call page::error (i64 404) (text "このメンバーは見つかりません。")))))))

  (test create password-autocomplete (visibility private)
    (actual (call accounts::password (text "password") (text "Password") (bool true)))
    (expected (text "<label>Password<input type=\"password\" name=\"password\" autocomplete=\"new-password\" required minlength=\"12\" maxlength=\"128\"></label>")))
)
