able to readers. Remove it after 5 minutes to recover the reserved storage.</div>")) (text "</section>") (call fileactions::selection (local ctx) (local media) (call db::note (local draft-id))) (text "<section class=\"panel\"><h2>Used in</h2>") (if (call std::i64-equal (call std::list-length (types Text) (field (local media) (name refs))) (i64 0)) (text "<p class=\"field-help\">Not attached to a post. Only you can access this file.</p>") (call std::text-join (list Text (text "<p class=\"field-help\">Files in use cannot be deleted. If used in a Public post, anyone can access the file through that post.</p><ul class=\"usage-list\">") (call driveview::uses (local ctx) (call std::list-window (types Text) (field (local media) (name refs)) (local start) (i64 30)) (i64 0) (text "")) (text "</ul>") (call page::pager (if (call std::less (call std::add (local start) (i64 30)) (call std::list-length (types Text) (field (local media) (name refs)))) (call std::add (local start) (i64 30)) (i64 -1)) (call std::text-join (list Text (text "/file?id=") (field (local media) (name id)) (text "&draft=") (local draft-id) (text "&")) (text "")))) (text ""))) (text "</section>") (if (call std::i64-equal (call std::list-length (types Text) (field (local media) (name refs))) (i64 0)) (call std::text-join (list Text (text "<details class=\"panel\"><summary>Delete this file</summary><p class=\"field-help\">This cannot be undone. It does not guarantee physical erasure from retained data history or backups.</p>") (call page::begin (local ctx) (text "delete-file")) (call page::hidden (text "id") (field (local media) (name id))) (call page::hidden (text "version") (call std::i64-to-text (field (local media) (name version)))) (call page::hidden (text "draft") (local draft-id)) (text "<label class=\"check\"><input type=\"checkbox\" name=\"confirm\" value=\"delete\" required>I understand this cannot be undone</label><button class=\"danger\">Delete file</button></form></details>")) (text "")) (text ""