(module create information

  (function create known (visibility public) (parameter create path (type Text)) (returns Bool) (effect pure) (body (call util::has (list Text (text "/more") (text "/about") (text "/privacy") (text "/terms") (text "/guidelines") (text "/contact")) (local path) (i64 0))))

  (function create title (visibility public) (parameter create path (type Text)) (returns Text) (effect pure) (body (if (call std::text-equal (local path) (text "/about")) (text "About") (if (call std::text-equal (local path) (text "/privacy")) (text "Privacy policy") (if (call std::text-equal (local path) (text "/terms")) (text "Terms of service") (if (call std::text-equal (local path) (text "/guidelines")) (text "Community guidelines") (if (call std::text-equal (local path) (text "/contact")) (text "Contact") (text ""))))))))

  (function create copy (visibility public) (parameter create path (type Text)) (returns Text) (effect pure) (body (if (call std::text-equal (local path) (text "/about")) (text "<p>lkjsns is an invitation-only community operated by <a href=\"/@lkjsxc\">lkjsxc</a>. Posts appear in chronological order. You choose who can read each post.</p><h3>Posts and files</h3><p>Public posts can be read without an account. Members posts can be read by registered members, regardless of attention relationships. Drive is your reusable file library: uploading a file does not publish it.</p><p>A post can have up to four attachments. Each account has 2 GiB of storage, with up to 256 MiB per upload. Original files are preserved rather than compressed or transcoded.</p><h3>Built in the open</h3><p>This service is an experimental application built with lkjscript. It can change, be interrupted, or lose data. Keep your own copies of files that matter.</p><p><a href=\"https://github.com/lkjsxc/lkjscript-sandbox/tree/main/projects/lkjsns\" target=\"_blank\" rel=\"noopener noreferrer\">Source code <span aria-hidden=\"true\">↗</span></a></p>") (if (call std::text-equal (local path) (text "/privacy")) (text "<p>This policy describes the lkjsns service operated by lkjsxc. For questions or requests about personal information, contact <a href=\"mailto:lkjsxc@gmail.com\">lkjsxc@gmail.com</a>.</p><h3>Information held by the service</h3><p>The application stores your account handle, password hash, profile name and bio, selected profile image, session records, and invitation information. It also stores posts and replies, uploaded files and their metadata, attachment relationships, bookmarks, attention relationships, mutes, post attention reactions, notifications, audience preferences, storage usage, and security-related account state.</p><p>Text and attachment selections may be retained while you move between writing and file selection. Uploads may include filenames, embedded metadata, and temporary transfer records. Passwords are verified using password hashing; the service does not need a recoverable copy of your password.</p><h3>Why information is used</h3><p>Information is used to provide accounts, deliver posts and files to their intended audience, keep your selections and preferences, generate activity notifications, enforce storage limits, operate invitations, investigate misuse, and maintain or recover the service. Messages sent to the operator are used to respond to your inquiry.</p><h3>Who can see it</h3><p>Public posts and their attachments can be read by anyone. Members posts and their attachments can be read by signed-in members. Profile information and your selected profile image may be visible publicly. Attention to and Attention from lists are visible to signed-in members, not to guests. Bookmarks and mutes are not exposed as public lists.</p><p>A file in Drive is available to its owner until it is used in a readable post or selected as a public profile image. Reusing a file in several places may give it several readable references. Removing one reference does not remove the others. Original files may contain location or other embedded metadata; lkjsns does not strip that metadata.</p><p>This is not an end-to-end encrypted service. The operator and systems with authorized access to its storage may access stored information for administration, maintenance, recovery, security, and handling requests. Do not use a Members audience as a promise of confidentiality: recipients can copy or redistribute content.</p><h3>Cookies and browser storage</h3><p>The application uses a sign-in cookie, normally valid for up to 30 days, and security tokens to protect actions. Browser storage may temporarily hold your audience selection so that it can be reconciled with your account preference. This tab may also keep a bounded set of recently visited in-service addresses and scroll positions to restore reading. These records contain no post text and are cleared on sign-out. Signing out invalidates that session. lkjsns does not include advertising scripts or third-party analytics in its application pages.</p><h3>Hosting, connections, and external services</h3><p>The service is delivered through the operator's Coder workspace and its HTTPS/network infrastructure. To deliver a request, these systems receive technical information such as your IP address, browser information, requested address, and timing; operational logs may retain this information. The application does not fetch external websites just because their links appear in a post. Opening an external link sends a request to that website, whose own privacy practices apply.</p><p>Email inquiries are delivered to the operator through Gmail. Information may also be disclosed when required by applicable law or when necessary to address abuse or a security incident. The service does not have a public advertising-data or data-broker integration.</p><h3>Retention and deletion</h3><p>Account and content records are retained to operate the service. Deleting a post removes it from normal reading and releases its attachment references. A file must no longer be in use before it can be deleted. Storage history, recovery copies, logs, and operational backups may retain earlier records; deletion in the interface is not a guarantee of immediate physical erasure from every copy. No automatic deletion period for all recovery copies is currently promised.</p><p>Copies already downloaded or made by other people are outside the operator's control. Keep a copy of your own important material.</p><h3>Your requests</h3><p>You can edit your profile and posts and delete your posts and unused files through the interface. For requests about access, correction, removal, account closure, or the handling of your personal information, use <a href=\"/contact\">Contact</a>. These requests are handled by the operator rather than an automated export or account-deletion feature. The operator may need to confirm your identity and the scope of the request without asking for your password.</p><h3>Changes</h3><p>The date on this page identifies this version. Material changes to these practices should be communicated through the service before they take effect where required.</p>") (if (call std::text-equal (local path) (text "/terms")) (text "<h3>Using lkjsns</h3><p>These terms apply to lkjsns, an experimental invitation-only service operated by lkjsxc. Use an invitation issued to you, provide information you are entitled to use, keep your sign-in details secure, and follow the <a href=\"/guidelines\">Community guidelines</a>. Do not share someone else's invitation or account without permission.</p><h3>Your content</h3><p>You keep your rights in the content you submit. You give the operator permission to store, reproduce, and deliver that content only as needed to operate, maintain, secure, and recover the service and display it to the audience you choose. This does not transfer ownership of your work.</p><p>Only upload or post material that you are entitled to share. You are responsible for choosing its audience and checking files for private information, including embedded metadata. Public posts and profile images may be accessible without an account. Members can copy what they can read.</p><h3>Acceptable use</h3><p>Do not use the service for unlawful content or conduct, threats or targeted harassment, privacy violations, impersonation, infringement of others' rights, spam, malicious files, unauthorized access, or deliberate disruption. Do not attempt to bypass access controls, invitations, or storage limits.</p><h3>Administration</h3><p>The operator may restrict access or remove content when needed to address misuse, legal obligations, security, or service operation. Questions about a restriction, reports of harmful content, and requests concerning your account can be sent through <a href=\"/contact\">Contact</a>. Include enough context to locate the issue, but not passwords or unnecessary personal information.</p><h3>Availability and ending use</h3><p>The service is experimental. Features, limits, and availability can change, and uninterrupted operation or permanent storage is not guaranteed. Keep independent copies of important material. You can stop using the service and request account closure from the operator. The <a href=\"/privacy\">Privacy policy</a> explains the limitations of deletion and retained copies.</p><h3>Your legal rights</h3><p>Nothing in these terms excludes rights or liabilities that cannot be excluded under applicable law. These terms are not a promise of a paid service level, and they do not authorize the operator to use your content outside the purposes described above.</p><h3>Changes and questions</h3><p>The date on this page identifies this version. Material changes should be communicated through the service before they take effect where required. Contact <a href=\"mailto:lkjsxc@gmail.com\">lkjsxc@gmail.com</a> with questions.</p>") (if (call std::text-equal (local path) (text "/guidelines")) (text "<h3>Respect the people here</h3><p>Disagree with ideas without targeting people. Do not threaten, harass, impersonate, or expose someone's private information. Do not post discriminatory abuse or content intended to intimidate someone into leaving.</p><h3>Share responsibly</h3><p>Post content you are entitled to share. Do not upload malicious files, distribute unlawful material, or use the service for scams, spam, or coordinated disruption. Use a content warning or sensitive-media setting when context should come before the content.</p><h3>Respect audience boundaries</h3><p>A Members post is intended for registered members. Do not redistribute someone else's restricted content without their permission. Remember that audience controls cannot stop a recipient from making a copy.</p><h3>Report a problem</h3><p>Send the post or file address and a brief explanation through <a href=\"/contact\">Contact</a>. Reports go to the operator; reporting publicly may expose the very information you want removed. Do not attach more personal information than is needed. For a security issue, contact the operator privately before publishing details.</p><h3>What happens next</h3><p>The operator reviews issues in context and may remove content or restrict access. You can contact the operator to provide relevant context or ask for a decision to be reviewed. This service is not monitored continuously and is not an emergency service.</p>") (if (call std::text-equal (local path) (text "/contact")) (text "<h3>Contact the operator</h3><p>lkjsns is operated by lkjsxc. Email <a href=\"mailto:lkjsxc@gmail.com\">lkjsxc@gmail.com</a> for help, privacy requests, account-closure requests, content reports, or questions about the service.</p><h3>What to include</h3><p>Include your account handle, the relevant post or file address where applicable, and what you need help with. For a privacy request, describe the information and the action you are requesting. Never send your password, sign-in cookie, or a live invitation code.</p><h3>Security and sensitive issues</h3><p>Send security reports and private matters by email rather than posting them in the community or in a public issue. The operator may ask for a safe way to verify that an account or request belongs to you.</p><h3>Public development issues</h3><p>For a reproducible software problem that contains no private information, you can use the <a href=\"https://github.com/lkjsxc/lkjscript-sandbox/issues\" target=\"_blank\" rel=\"noopener noreferrer\">public issue tracker <span aria-hidden=\"true\">↗</span></a>. This is a public page, not a private support channel. There is no guaranteed response time.</p>") (text ""))))))))

  (function create menu (visibility public) (parameter create ctx (type Context)) (returns Response) (effect (task (requirement service::app::store))) (body (let (binding viewer (if (call util::signed (local ctx)) (call db::user (field (local ctx) (name user))) (call db::empty-user))) (in (call page::ok (local ctx) (text "More") (call std::text-join (list Text (if (call util::signed (local ctx)) (call std::text-join (list Text (call std::text-join (list Text (text "<section class=\"settings-group more-group\"><h2>Explore</h2><div class=\"panel settings-list\">") (call page::destination (text "/search") (text "Search") (text "Find posts and people.") (text "search")) (call page::destination (text "/saved") (text "Bookmarks") (text "Posts you have kept.") (text "bookmark")) (call page::destination (text "/link-posts") (text "Link-only posts") (text "Your posts shared by link.") (text "lock")) (call page::destination (text "/drive") (text "Drive") (text "Your files and attachments.") (text "drive")) (call page::destination (text "/people") (text "Members") (text "People in this community.") (text "people")) (text "</div></section>")) (text "")) (call std::text-join (list Text (text "<section class=\"settings-group more-group\"><h2>Account</h2><div class=\"panel settings-list\">") (call page::destination (call std::text-join (list Text (text "/@") (field (local ctx) (name user))) (text "")) (text "Your profile") (text "Your posts and public profile.") (text "people")) (call page::destination (text "/settings") (text "Settings") (text "Profile, password, and sign-in.") (text "settings")) (if (field (local viewer) (name admin)) (call page::destination (text "/admin") (text "Admin") (text "Community overview and invitations.") (text "settings")) (text "")) (text "</div></section>")) (text ""))) (text "")) (call std::text-join (list Text (text "<section class=\"settings-group more-group\"><h2>Explore</h2><div class=\"panel settings-list\">") (call page::destination (text "/search") (text "Search") (text "Find public posts.") (text "search")) (call page::destination (text "/login") (text "Sign in") (text "Return to your account.") (text "lock")) (call page::destination (text "/join") (text "Join") (text "Create an account with an invitation.") (text "plus")) (text "</div></section>")) (text ""))) (call std::text-join (list Text (text "<section class=\"settings-group more-group\"><h2>Service</h2><div class=\"panel settings-list\">") (call page::destination (text "/about") (text "About") (text "The community and the software behind it.") (text "people")) (call page::destination (text "/privacy") (text "Privacy policy") (text "Your information, audience, and storage.") (text "lock")) (call page::destination (text "/terms") (text "Terms of service") (text "Using the service and your content rights.") (text "file")) (call page::destination (text "/guidelines") (text "Community guidelines") (text "Sharing responsibly and reporting problems.") (text "people")) (call page::destination (text "/contact") (text "Contact") (text "Help, privacy requests, and reports.") (text "reply")) (text "</div></section>")) (text ""))) (text "")))))))

  (function create view (visibility public) (parameter create ctx (type Context)) (parameter create request (type Request)) (returns Response) (effect (task (requirement service::app::store))) (body (if (call std::text-equal (field (local request) (name path)) (text "/more")) (call information::menu (local ctx)) (call page::ok-at (local ctx) (call information::title (field (local request) (name path))) (text "More") (call std::text-join (list Text (text "<nav class=\"crumbs\" aria-label=\"Breadcrumb\"><a href=\"/more\">More</a> / ") (call std::html-escape-text (call information::title (field (local request) (name path)))) (text "</nav><article class=\"panel service-copy\"><h2 class=\"service-title\">") (call std::html-escape-text (call information::title (field (local request) (name path)))) (text "</h2><p class=\"effective\">Updated October 17, 2026</p>") (call information::copy (field (local request) (name path))) (text "<nav class=\"service-links\" aria-label=\"Service information\"><a href=\"/about\">About</a><a href=\"/privacy\">Privacy</a><a href=\"/terms\">Terms</a><a href=\"/guidelines\">Guidelines</a><a href=\"/contact\">Contact</a></nav>") (text "</article>")) (text ""))))))

  (test create public-information (visibility private) (actual (call information::known (text "/privacy"))) (expected (bool true)))

  (test create unknown-route (visibility private) (actual (call information::known (text "/privacy/anything"))) (expected (bool false)))

  (test create policy-names-contact (visibility private) (actual (call std::text-contains (call information::copy (text "/privacy")) (text "mailto:lkjsxc@gmail.com"))) (expected (bool true)))

  (test create policy-does-not-promise-erasure (visibility private) (actual (call std::text-contains (call information::copy (text "/privacy")) (text "not a guarantee of immediate physical erasure"))) (expected (bool true)))
)
