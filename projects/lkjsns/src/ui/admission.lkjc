  (function create with-optional (visibility public)
    (parameter create form (type Form)) (parameter create names (type (list Text)))
    (parameter create first (type Text)) (parameter create second (type Text))
    (returns Bool) (effect pure)
    (body (if (call controls::schema (local form) (local names)) (bool true)
      (if (call controls::schema (local form) (call std::list-append (types Text) (local names) (local first))) (bool true)
      (if (call controls::schema (local form) (call std::list-append (types Text) (local names) (local second))) (bool true)
        (call controls::schema (local form) (call std::list-append (types Text)
          (call std::list-append (types Text) (local names) (local first)) (local second))))))))

  (function create valid (visibility public) (parameter create form (type Form)) (returns Bool) (effect pure) (body (if (if (call std::text-equal (call util::value (local form) (text "intent")) (text "attention")) (call attentionnav::form-valid (local form)) (bool true)) (if (call util::has (list Text (text "audience") (text "avatar") (text "login") (text "join") (text "logout") (text "profile") (text "password") (text "invite") (text "revoke-invite") (text "note") (text "delete-note") (text "eyes") (text "bookmark") (text "attention") (text "mute") (text "file") (text "delete-file") (text "folder") (text "attach")) (call util::value (local form) (text "intent")) (i64 0)) (if (if (call std::text-equal (call util::value (local form) (text "intent")) (text "attach")) (call librarypath::form-valid (local form)) (if (if (call std::text-equal (call util::value (local form) (text "intent")) (text "file")) (call controls::schema (local form) (list Text (text "intent") (text "csrf") (text "id") (text "version") (text "name") (text "alt") (text "folder") (text "sensitive") (text "draft"))) (bool false)) (bool true) (if (call util::has (list Text (text "eyes") (text "bookmark")) (call util::value (local form) (text "intent")) (i64 0)) (if (call paging::valid-trail (call util::value (local form) (text "trail"))) (call admission::with-optional (local form) (call admission::fields (call util::value (local form) (text "intent"))) (text "trail") (text "share")) (bool false)) (if (call std::text-equal (call util::value (local form) (text "intent")) (text "note"))
  (if (call admission::with-optional (local form) (call admission::fields (text "note")) (text "return") (text "share")) (bool true)
 (if (call admission::with-optional (local form) (call std::list-append (types Text) (call admission::fields (text "note")) (text "blob")) (text "return") (text "share")) (bool true)
 (if (call admission::with-optional (local form) (call std::list-append (types Text) (call admission::fields (text "note")) (text "body-loaded")) (text "return") (text "share")) (bool true)
  (call admission::with-optional (local form) (call std::list-append (types Text) (call std::list-append (types Text) (call admission::fields (text "note")) (text "blob")) (text "body-loaded")) (text "return") (text "share")))))
  (call controls::schema (local form) (call admission::fields (call util::value (local form) (text "intent")))))))) (if (call util::has (list Text (text "eyes") (text "bookmark")) (call util::value (local form) (text "intent")) (i64 0)) (if (call navigation::reading-place (call util::value (local form) (text "place"))) (call navigation::reading-cursor (call util::value (local form) (text "cursor"))) (bool false)) (bool true)) (bool false)) (bool false)) (bool false))))

  (function create guest (visibility public)
    (parameter create intent (type Text))
    (returns Bool) (effect pure)
    (body (if (call std::text-equal (local intent) (text "login")) (bool true) (if (call std::text-equal (local intent) (text "join")) (bool true) (bool false)))))

  (function create optional-fields (visibility public)
    (parameter create form (type Form))
    (parameter create names (type (list Text)))
    (returns Bool) (effect pure)
    (body (if (field (local form) (name valid)) (if (call util::unique (field (local form) (name items)) (i64 0)) (if (call controls::allowed (field (local form) (name items)) (local names) (i64 0)) (bool true) (bool false)) (bool false)) (bool false))))

  (function create query (visibility public) (parameter create request (type Request)) (parameter create names (type (list Text))) (returns Bool) (effect pure) (body (if (if (call util::handle (call paths::member-id (field (local request) (name path)))) (call navigation::reading-cursor (call util::query (local request) (text "cursor"))) (bool true)) (if (if (call paging::valid-trail (call util::query (local request) (text "trail")))
 (if (call util::has (list Text (text "") (text "1") (text "2") (text "all")) (call util::query (local request) (text "chunk")) (i64 0))
  (call navigation::reading-cursor (call util::query (local request) (text "snapshot"))) (bool false)) (bool false))
 (if (call admission::optional-fields (call util::parse (call std::bytes-from-text (field (local request) (name query)))) (local names)) (bool true) (bool false)) (bool false)) (bool false))))

  (test create login-complete (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=login&csrf=&handle=alice&password=long-password"))))) (expected (bool true)))

  (test create login-missing-password (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=login&csrf=&handle=alice"))))) (expected (bool false)))

  (test create unknown-intent (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=unknown&csrf="))))) (expected (bool false)))

  (test create duplicate-intent (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=login&intent=join&csrf=&handle=alice&password=long-password"))))) (expected (bool false)))

  (test create duplicate-csrf (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=logout&csrf=a&csrf=a"))))) (expected (bool false)))

  (test create unexpected-owner (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=logout&csrf=a&owner=alice"))))) (expected (bool false)))

  (test create logout-complete (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=logout&csrf=a"))))) (expected (bool true)))

  (test create note-complete (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=note&csrf=a&id=b&version=0&reply=&body=hello&cw=&audience=members&mode=publish"))))) (expected (bool true)))

  (test create delete-without-confirm (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=delete-file&csrf=a&id=b&version=0"))))) (expected (bool false)))

  (test create attach-complete (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=attach&csrf=a&draft=b&id=c&version=1&enabled=1&destination=picker"))))) (expected (bool true)))

  (test create duplicate-query (visibility private)
    (actual (call admission::optional-fields (call util::parse (call std::bytes-from-text (text "id=a&id=b"))) (list Text (text "id")))) (expected (bool false)))

  (test create empty-query (visibility private)
    (actual (call admission::optional-fields (call util::parse (call std::bytes-from-text (text ""))) (list Text (text "id")))) (expected (bool true)))

  (test create file-context-complete (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=file&csrf=a&id=b&version=1&name=photo&alt=&folder=&sensitive=no&draft="))))) (expected (bool true)))

  (test create file-duplicate-context-denied (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=file&csrf=a&id=b&version=1&name=photo&alt=&folder=&sensitive=no&draft=c&draft=d"))))) (expected (bool false)))

  (test create file-delete-context-complete (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=delete-file&csrf=a&id=b&version=1&confirm=delete&draft="))))) (expected (bool true)))
  (test create attach-composer-destination (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=attach&csrf=a&draft=b&id=c&version=1&enabled=1&destination=compose"))))) (expected (bool true)))
  (test create attach-destination-required (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=attach&csrf=a&draft=b&id=c&version=1&enabled=1"))))) (expected (bool false)))
  (test create attach-duplicate-destination-denied (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=attach&csrf=a&draft=b&id=c&version=1&enabled=1&destination=picker&destination=compose"))))) (expected (bool false)))
  (test create reaction-keeps-reading-context (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=eyes&csrf=a&id=b&enabled=1&place=attention&cursor=30"))))) (expected (bool true)))
  (test create reaction-refuses-external-return (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=bookmark&csrf=a&id=b&enabled=1&place=%2F%2Fexample.invalid&cursor="))))) (expected (bool false)))
  (test create reaction-requires-reading-context (visibility private)
    (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=eyes&csrf=a&id=b&enabled=1"))))) (expected (bool false)))
  (test create attention-valid (visibility private) (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=attention&csrf=a&handle=bravo&enabled=1&subject=alice&direction=from&cursor=20&trail=_.50"))))) (expected (bool true)))
  (test create attention-missing-context (visibility private) (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=attention&csrf=a&handle=bravo&enabled=1"))))) (expected (bool false)))
  (test create attention-no-external-return (visibility private) (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=attention&csrf=a&handle=bravo&enabled=1&subject=%2F%2Fevil.test&direction=from&cursor=&trail="))))) (expected (bool false)))
  (test create attention-no-duplicate-direction (visibility private) (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=attention&csrf=a&handle=bravo&enabled=1&subject=alice&direction=from&direction=to&cursor=&trail="))))) (expected (bool false)))
  (test create legacy-action-is-not-a-toggle (visibility private) (actual (call admission::valid (call util::parse (call std::bytes-from-text (text "intent=follow&csrf=a&handle=bravo&enabled=1"))))) (expected (bool false)))
)
