(module create attachments
  (function create draft (visibility public)
    (parameter create ctx (type Context))
    (parameter create note (type Note))
    (returns Bool) (effect pure)
    (body (if (call util::signed (local ctx)) (if (call util::token (field (local note) (name id))) (if (call std::text-equal (field (local note) (name author)) (field (local ctx) (name user))) (if (call std::bool-not (field (local note) (name deleted))) (if (call std::bool-not (field (local note) (name published))) (if (call std::less-equal (i64 0) (field (local note) (name version))) (if (call std::less-equal (field (local note) (name version)) (i64 2147483646)) (bool true) (bool false)) (bool false)) (bool false)) (bool false)) (bool false)) (bool false)) (bool false))))

  (function create location (visibility public)
    (parameter create draft (type Text))
    (parameter create destination (type Text))
    (returns Text) (effect pure)
    (body (call paths::canonical (if (call util::token (local draft))
      (call std::text-join (list Text
        (if (call std::text-equal (local destination) (text "compose"))
          (text "/compose?id=") (text "/pick?draft="))
        (local draft) (text "&saved=1")) (text ""))
      (text "/drive")))))

  (function create destination (visibility public)
    (parameter create value (type Text))
    (returns Bool) (effect pure)
    (body (call util::has (list Text (text "picker") (text "compose")) (local value) (i64 0))))

