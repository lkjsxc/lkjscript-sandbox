  (test create return-to-composer-is-local (visibility private)
    (actual (call attachments::location
      (text "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee") (text "compose")))
    (expected (text "/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee/edit?saved=1")))

