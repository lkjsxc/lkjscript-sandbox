(module create mediaui
  (function create url (visibility public)
    (parameter create media (type Media))
    (parameter create note-id (type Text))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "/media?id=") (field (local media) (name id)) (text "&note=") (local note-id)) (text ""))))

  (function create original (visibility public)
    (parameter create media (type Media))
    (parameter create note-id (type Text))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "<figure class=\"media-original\">") (if (call std::text-starts-with (field (local media) (name mime)) (text "image/")) (call std::text-join (list Text (text "<a class=\"image-original\" target=\"_blank\" rel=\"noopener\" href=\"") (call std::html-escape-text (call mediaui::url (local media) (local note-id))) (text "\" aria-label=\"") (call std::html-escape-text (call std::text-join (list Text (text "View original: ") (field (local media) (name name))) (text ""))) (text "\"><img loading=\"lazy\" decoding=\"async\" src=\"") (call std::html-escape-text (call mediaui::url (local media) (local note-id))) (text "\" alt=\"") (call std::html-escape-text (if (call std::text-equal (field (local media) (name alt)) (text "")) (field (local media) (name name)) (field (local media) (name alt)))) (text "\"></a>")) (text "")) (if (call std::text-starts-with (field (local media) (name mime)) (text "video/")) (call std::text-join (list Text (text "<video controls playsinline preload=\"metadata\" src=\"") (call std::html-escape-text (call mediaui::url (local media) (local note-id))) (text "\" aria-label=\"") (call std::html-escape-text (if (call std::text-equal (field (local media) (name alt)) (text "")) (field (local media) (name name)) (field (local media) (name alt)))) (text "\">Your browser cannot play this file.</video>")) (text "")) (call std::text-join (list Text (text "<audio controls preload=\"none\" src=\"") (call std::html-escape-text (call mediaui::url (local media) (local note-id))) (text "\" aria-label=\"") (call std::html-escape-text (if (call std::text-equal (field (local media) (name alt)) (text "")) (field (local media) (name name)) (field (local media) (name alt)))) (text "\">Your browser cannot play this file.</audio>")) (text "")))) (if (call std::text-equal (field (local media) (name alt)) (text "")) (text "") (call std::text-join (list Text (text "<figcaption>") (call std::html-escape-text (field (local media) (name alt))) (text "</figcaption>")) (text ""))) (text "<a class=\"media-download\" href=\"") (call std::html-escape-text (call std::text-join (list Text (call mediaui::url (local media) (local note-id)) (text "&download=yes")) (text ""))) (text "\">") (call std::html-escape-text (field (local media) (name name))) (text " · ") (call page::bytes (field (local media) (name size))) (text " ↗</a></figure>")) (text ""))))

  (function create render (visibility public)
    (parameter create media (type Media))
    (parameter create note-id (type Text))
    (returns Text) (effect pure)
    (body (if (field (local media) (name sensitive)) (call std::text-join (list Text (text "<details class=\"sensitive-media\"><summary>Reveal sensitive media</summary>") (call mediaui::original (local media) (local note-id)) (text "</details>")) (text "")) (call mediaui::original (local media) (local note-id)))))

  (function create thumbnail (visibility public)
    (parameter create media (type Media))
    (returns Text) (effect pure)
    (body (if (if (call std::text-equal (field (local media) (name state)) (text "ready")) (if (call std::bool-not (field (local media) (name sensitive))) (if (call std::text-starts-with (field (local media) (name mime)) (text "image/")) (bool true) (bool false)) (bool false)) (bool false)) (call std::text-join (list Text (text "<img loading=\"lazy\" decoding=\"async\" src=\"") (call std::html-escape-text (call mediaui::url (local media) (text ""))) (text "\" alt=\"\">")) (text "")) (call std::text-join (list Text (call page::icon (if (call std::text-starts-with (field (local media) (name mime)) (text "video/")) (text "video") (if (call std::text-starts-with (field (local media) (name mime)) (text "audio/")) (text "audio") (text "image")))) (text "<span>") (if (call std::text-equal (field (local media) (name state)) (text "ready")) (if (field (local media) (name sensitive)) (text "Sensitive") (if (call std::text-starts-with (field (local media) (name mime)) (text "video/")) (text "Video") (text "Audio"))) (if (call std::text-equal (field (local media) (name state)) (text "uploading")) (text "Incomplete") (text "Deleting"))) (text "</span>")) (text "")))))

  (function create attachments (visibility public)
    (parameter create ctx (type Context))
    (parameter create note (type Note))
    (parameter create index (type I64))
    (parameter create out (type Text))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (if (call std::less (local index) (call std::list-length (types Text) (field (local note) (name media)))) (let (binding media (call db::media (call std::list-get (types Text) (field (local note) (name media)) (local index)))) (in (call mediaui::attachments (local ctx) (local note) (call std::add (local index) (i64 1)) (call std::text-join (list Text (local out) (if (call access::media (local ctx) (local media) (local note)) (call mediaui::render (local media) (field (local note) (name id))) (text "<p class=\"field-help\">This attachment is currently unavailable.</p>"))) (text ""))))) (local out))))

  (function create fixture-media (visibility private)
    (parameter create state (type Text))
    (returns Media) (effect pure)
    (body (record structural
      (field id (text "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"))
      (field owner (text "alice")) (field name (text "sample.png"))
      (field mime (text "image/png")) (field alt (text "")) (field folder (text ""))
      (field size (i64 100)) (field created (i64 1)) (field sensitive (bool false))
      (field state (local state)) (field digest (text "")) (field refs (list Text))
      (field version (i64 1)) (field offset (i64 50)) (field stored (i64 200)))))

  (function create fixture-note (visibility private)
    (parameter create audience (type Text))
    (parameter create published (type Bool))
    (parameter create deleted (type Bool))
    (parameter create attached (type Bool))
    (returns Note) (effect pure)
    (body (record structural
      (field id (text "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"))
      (field author (text "alice")) (field body (text "")) (field cw (text ""))
      (field audience (local audience)) (field reply (text ""))
      (field media (if (local attached)
        (list Text (text "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"))
        (list Text)))
      (field eyes (list Text)) (field created (i64 1)) (field edited (i64 1))
      (field version (i64 0)) (field published (local published))
      (field deleted (local deleted)))))

  (function create fixture-viewer (visibility private)
    (parameter create user (type Text))
    (returns Context) (effect pure)
    (body (record structural (field user (local user))
      (field csrf (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
      (field session (text "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"))
      (field now (i64 1)))))

  (test create owner-url-has-no-session (visibility private)
    (actual (call mediaui::url (call mediaui::fixture-media (text "ready")) (text "")))
    (expected (text "/media?id=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff&note=")))

  (test create private-owner-can-open (visibility private)
    (actual (call access::media (call mediaui::fixture-viewer (text "alice"))
      (call mediaui::fixture-media (text "ready")) (call db::empty-note)))
    (expected (bool true)))

  (test create private-guest-cannot-open (visibility private)
    (actual (call access::media (call auth::guest (i64 1))
      (call mediaui::fixture-media (text "ready")) (call db::empty-note)))
    (expected (bool false)))

  (test create private-other-cannot-open (visibility private)
    (actual (call access::media (call mediaui::fixture-viewer (text "bob"))
      (call mediaui::fixture-media (text "ready")) (call db::empty-note)))
    (expected (bool false)))

  (test create public-link-can-open (visibility private)
    (actual (call access::media (call auth::guest (i64 1))
      (call mediaui::fixture-media (text "ready"))
      (call mediaui::fixture-note (text "public") (bool true) (bool false) (bool true))))
    (expected (bool true)))

  (test create unrelated-public-note-denied (visibility private)
    (actual (call access::media (call auth::guest (i64 1))
      (call mediaui::fixture-media (text "ready"))
      (call mediaui::fixture-note (text "public") (bool true) (bool false) (bool false))))
    (expected (bool false)))

  (test create draft-link-denied (visibility private)
    (actual (call access::media (call mediaui::fixture-viewer (text "bob"))
      (call mediaui::fixture-media (text "ready"))
      (call mediaui::fixture-note (text "public") (bool false) (bool false) (bool true))))
    (expected (bool false)))

  (test create members-guest-denied (visibility private)
    (actual (call access::media (call auth::guest (i64 1))
      (call mediaui::fixture-media (text "ready"))
      (call mediaui::fixture-note (text "members") (bool true) (bool false) (bool true))))
    (expected (bool false)))

  (test create members-signed-can-open (visibility private)
    (actual (call access::media (call mediaui::fixture-viewer (text "bob"))
      (call mediaui::fixture-media (text "ready"))
      (call mediaui::fixture-note (text "members") (bool true) (bool false) (bool true))))
    (expected (bool true)))

  (test create uploading-owner-denied (visibility private)
    (actual (call access::media (call mediaui::fixture-viewer (text "alice"))
      (call mediaui::fixture-media (text "uploading")) (call db::empty-note)))
    (expected (bool false)))

  (test create deleting-owner-denied (visibility private)
    (actual (call access::media (call mediaui::fixture-viewer (text "alice"))
      (call mediaui::fixture-media (text "deleting")) (call db::empty-note)))
    (expected (bool false)))

  (test create deleted-note-link-denied (visibility private)
    (actual (call access::media (call auth::guest (i64 1))
      (call mediaui::fixture-media (text "ready"))
      (call mediaui::fixture-note (text "public") (bool true) (bool true) (bool true))))
    (expected (bool false)))
)
