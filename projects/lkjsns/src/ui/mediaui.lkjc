(module create mediaui
  (function create url (visibility public)
    (parameter create media (type Media))
    (parameter create note-id (type Text))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "/media?id=") (field (local media) (name id)) (text "&note=") (local note-id)) (text ""))))

  (function create original (visibility public)
    (parameter create media (type Media))
    (parameter create note-id (type Text))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "<figure class=\"media-original\">") (if (call std::text-starts-with (field (local media) (name mime)) (text "image/")) (call std::text-join (list Text (text "<a class=\"image-original\" target=\"_blank\" rel=\"noopener\" href=\"") (call std::html-escape-text (call mediaui::url (local media) (local note-id))) (text "\" aria-label=\"") (call std::html-escape-text (call std::text-join (list Text (text "原寸で表示：") (field (local media) (name name))) (text ""))) (text "\"><img loading=\"lazy\" decoding=\"async\" src=\"") (call std::html-escape-text (call mediaui::url (local media) (local note-id))) (text "\" alt=\"") (call std::html-escape-text (if (call std::text-equal (field (local media) (name alt)) (text "")) (field (local media) (name name)) (field (local media) (name alt)))) (text "\"></a>")) (text "")) (if (call std::text-starts-with (field (local media) (name mime)) (text "video/")) (call std::text-join (list Text (text "<video controls playsinline preload=\"metadata\" src=\"") (call std::html-escape-text (call mediaui::url (local media) (local note-id))) (text "\" aria-label=\"") (call std::html-escape-text (if (call std::text-equal (field (local media) (name alt)) (text "")) (field (local media) (name name)) (field (local media) (name alt)))) (text "\">このブラウザでは再生できません。</video>")) (text "")) (call std::text-join (list Text (text "<audio controls preload=\"none\" src=\"") (call std::html-escape-text (call mediaui::url (local media) (local note-id))) (text "\" aria-label=\"") (call std::html-escape-text (if (call std::text-equal (field (local media) (name alt)) (text "")) (field (local media) (name name)) (field (local media) (name alt)))) (text "\">このブラウザでは再生できません。</audio>")) (text "")))) (if (call std::text-equal (field (local media) (name alt)) (text "")) (text "") (call std::text-join (list Text (text "<figcaption>") (call std::html-escape-text (field (local media) (name alt))) (text "</figcaption>")) (text ""))) (text "<a class=\"media-download\" href=\"") (call std::html-escape-text (call std::text-join (list Text (call mediaui::url (local media) (local note-id)) (text "&download=yes")) (text ""))) (text "\">") (call std::html-escape-text (field (local media) (name name))) (text " · ") (call page::bytes (field (local media) (name size))) (text " ↗</a></figure>")) (text ""))))

  (function create render (visibility public)
    (parameter create media (type Media))
    (parameter create note-id (type Text))
    (returns Text) (effect pure)
    (body (if (field (local media) (name sensitive)) (call std::text-join (list Text (text "<details class=\"sensitive-media\"><summary>センシティブなファイルを表示</summary>") (call mediaui::original (local media) (local note-id)) (text "</details>")) (text "")) (call mediaui::original (local media) (local note-id)))))

  (function create thumbnail (visibility public)
    (parameter create media (type Media))
    (returns Text) (effect pure)
    (body (if (if (call std::text-equal (field (local media) (name state)) (text "ready")) (if (call std::bool-not (field (local media) (name sensitive))) (if (call std::text-starts-with (field (local media) (name mime)) (text "image/")) (bool true) (bool false)) (bool false)) (bool false)) (call std::text-join (list Text (text "<img loading=\"lazy\" decoding=\"async\" src=\"") (call std::html-escape-text (call mediaui::url (local media) (text ""))) (text "\" alt=\"\">")) (text "")) (call std::text-join (list Text (call page::icon (if (call std::text-starts-with (field (local media) (name mime)) (text "video/")) (text "video") (if (call std::text-starts-with (field (local media) (name mime)) (text "audio/")) (text "audio") (text "image")))) (text "<span>") (if (call std::text-equal (field (local media) (name state)) (text "ready")) (if (field (local media) (name sensitive)) (text "センシティブ") (if (call std::text-starts-with (field (local media) (name mime)) (text "video/")) (text "動画") (text "音声"))) (if (call std::text-equal (field (local media) (name state)) (text "uploading")) (text "未完了") (text "削除処理中"))) (text "</span>")) (text "")))))

  (function create attachments (visibility public)
    (parameter create ctx (type Context))
    (parameter create note (type Note))
    (parameter create index (type I64))
    (parameter create out (type Text))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (if (call std::less (local index) (call std::list-length (types Text) (field (local note) (name media)))) (let (binding media (call db::media (call std::list-get (types Text) (field (local note) (name media)) (local index)))) (in (call mediaui::attachments (local ctx) (local note) (call std::add (local index) (i64 1)) (call std::text-join (list Text (local out) (if (call access::media (local ctx) (local media) (local note)) (call mediaui::render (local media) (field (local note) (name id))) (text "<p class=\"field-help\">この添付は現在利用できません。</p>"))) (text ""))))) (local out))))

  (test create owner-url-has-no-session (visibility private)
    (actual (call mediaui::url (record structural (field id (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")) (field owner (field (call db::empty-media) (name owner))) (field name (field (call db::empty-media) (name name))) (field mime (field (call db::empty-media) (name mime))) (field alt (field (call db::empty-media) (name alt))) (field folder (field (call db::empty-media) (name folder))) (field size (field (call db::empty-media) (name size))) (field created (field (call db::empty-media) (name created))) (field sensitive (field (call db::empty-media) (name sensitive))) (field state (field (call db::empty-media) (name state))) (field digest (field (call db::empty-media) (name digest))) (field refs (field (call db::empty-media) (name refs))) (field version (field (call db::empty-media) (name version))) (field offset (field (call db::empty-media) (name offset))) (field stored (field (call db::empty-media) (name stored)))) (text ""))) (expected (text "/media?id=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa&note=")))

  (test create private-owner-can-open (visibility private)
    (actual (call access::media (record structural (field user (text "alice")) (field csrf (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")) (field session (text "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")) (field now (i64 1))) (record structural (field id (text "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")) (field owner (text "alice")) (field name (field (call db::empty-media) (name name))) (field mime (field (call db::empty-media) (name mime))) (field alt (field (call db::empty-media) (name alt))) (field folder (field (call db::empty-media) (name folder))) (field size (i64 100)) (field created (field (call db::empty-media) (name created))) (field sensitive (field (call db::empty-media) (name sensitive))) (field state (text "ready")) (field digest (field (call db::empty-media) (name digest))) (field refs (field (call db::empty-media) (name refs))) (field version (i64 1)) (field offset (i64 50)) (field stored (i64 200))) (call db::empty-note))) (expected (bool true)))

