    (returns I64) (effect (task (requirement service::app::store) (requirement service::app::config) (requirement service::app::clock)))
    (body (let (binding ctx (call auth::context (local request))) (binding media (call db::media (call util::value (local form) (text "id")))) (in (if (if (call auth::write-ok (local request)) (if (call util::csrf (local ctx) (local form)) (if (call admission::valid (local form)) (if (call std::text-equal (call util::value (local form) (text "intent")) (text "delete-file")) (if (call std::text-equal (call util::value (local form) (text "confirm")) (text "delete")) (if (call util::token (call util::value (local form) (text "id"))) (if (call std::text-equal (field (local media) (name owner)) (field (local ctx) (name user))) (if (call std::less-equal (i64 0) (field (local media) (name version))) (if (call std::less-equal (field (local media) (name version)) (i64 2147483646)) (bool true) (bool false)) (bool false)) (bool false)) (bool false)) (bool false)) (bool false)) (bool false)) (bool false)) (bool false)) (if (call std::text-equal (field (local media) (name state)) (text "deleted")) (i64 2) (if (if (call std::text-equal (field (local media) (name state)) (text "deleting")) (if (call std::i64-equal (call std::list-length (types Text) (field (local media) (name refs))) (i64 0)) (bool true) (bool false)) (bool false)) (i64 1) (if (call drive::deleting (local ctx) (local form)) (i64 1) (i64 0)))) (i64 0))))))

  (function create remove (visibility public)
    (parameter create request (type Request))
    (parameter create form (type Form))
    (returns Response) (effect (task (requirement service::app::store) (requirement service::app::objects) (requirement service::app::config) (requirement service::app::clock)))
    (body (match (transaction-outcome service::app::store (types I64) (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict) (binding action) (call mediaflow::mark (local request) (local form))) (arm std::TransactionOutcome::Committed (payload decision I64) (if (call std::i64-equal (local decision) (i64 0)) (call page::error (i64 409) (text "使用中のファイルは削除できません。未完了の転送は5分後に整理できます。ログイン状態、削除の確認、現在のファイル情報を確認してください。")) (if (call std::i64-equal (local decision) (i64 2)) (call page::redirect (text "/drive")) (sequence (capability-call service::app::objects std::ObjectStorage::delete (call drive::key (call util::value (local form) (text "id")))) (match (transaction-outcome service::app::store (types Response) (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict) (binding action) (if (call drive::finish-delete (call util::value (local form) (text "id"))) (let (binding ctx (call auth::context (local request))) (binding draft (call driveview::draft-id (local ctx) (call util::value (local form) (text "draft")))) (in (call page::redirect (if (call util::token (local draft)) (call std::text-join (list Text (text "/pick?draft=") (local draft)) (text "")) (text "/drive"))))) (call page::error (i64 503) (text "削除後の保存情報を確定できませんでした。ドライブの現在の状態を確認してください。")))) (arm std::TransactionOutcome::Committed (payload response Response) (local response)) (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason) (call page::error (i64 409) (text "別の操作と重なりました。現在の状態を確認してください。")))))))) (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason) (call page::error (i64 409) (text "別の操作と重なり、削除は開始されませんでした。ファイルの状態を確認してください。"))))))
)
