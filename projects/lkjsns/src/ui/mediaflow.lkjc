(module create mediaflow
  (function create file-location (visibility public)
    (parameter create ctx (type Context))
    (parameter create id (type Text))
    (parameter create draft (type Text))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (call paths::canonical (call std::text-join (list Text (text "/file?id=") (local id) (text "&draft=") (call driveview::draft-id (local ctx) (local draft))) (text "")))))

  (function create upload (visibility public)
    (parameter create request (type Request))
    (returns Response) (effect (task (requirement service::app::store) (requirement service::app::config) (requirement service::app::clock) (requirement service::app::objects) (requirement service::app::streams)))
    (body (let (binding result (call drive::upload (local request))) (in (if (call std::i64-equal (field (local result) (name status)) (i64 303)) (let (binding ctx (call auth::context (local request))) (binding media (call db::media (call util::query (local request) (text "id")))) (in (if (if (call util::signed (local ctx)) (if (call std::text-equal (field (local media) (name owner)) (field (local ctx) (name user))) (if (call std::text-equal (field (local media) (name state)) (text "ready")) (bool true) (bool false)) (bool false)) (bool false)) (match (transaction-outcome service::app::store (types Response) (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict) (binding action) (call mediaflow::finish-upload (local ctx) (local media) (local request))) (arm std::TransactionOutcome::Committed (payload response Response) (local response)) (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason) (call page::redirect (call std::text-join (list Text (call std::text-join (list Text (call mediaflow::file-location (local ctx) (field (local media) (name id)) (call util::query (local request) (text "draft"))) (text "&uploaded=1")) (text "")) (text "&attachment=changed")) (text ""))))) (call page::error (i64 409) (text "Your sign-in changed. Check Drive to see what was saved."))))) (local result))))))

  (function create recover (visibility public)
    (parameter create ctx (type Context))
    (parameter create form (type Form))
    (parameter create status (type I64))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (let (binding media (call db::media (call util::value (local form) (text "id")))) (in (if (if (call util::signed (local ctx)) (if (call util::token (field (local media) (name id))) (if (call std::text-equal (field (local media) (name owner)) (field (local ctx) (name user))) (if (call std::text-equal (field (local media) (name state)) (text "ready")) (bool true) (bool false)) (bool false)) (bool false)) (bool false)) (let (binding submitted (record structural (field id (field (local media) (name id))) (field owner (field (local media) (name owner))) (field name (call util::value (local form) (text "name"))) (field mime (field (local media) (name mime))) (field alt (call util::value (local form) (text "alt"))) (field folder (if (call access::folder (local ctx) (call util::value (local form) (text "folder"))) (call util::value (local form) (text "folder")) (field (local media) (name folder)))) (field size (field (local media) (name size))) (field created (field (local media) (name created))) (field sensitive (call std::text-equal (call util::value (local form) (text "sensitive")) (text "yes"))) (field state (field (local media) (name state))) (field digest (field (local media) (name digest))) (field refs (field (local media) (name refs))) (field version (field (local media) (name version))) (field offset (field (local media) (name offset))) (field stored (field (local media) (name stored))))) (in (call page::reply (local status) (call page::frame (local ctx) (text "Review file details") (call std::text-join (list Text (call controls::message (text "This file changed in another tab, or some details are invalid. Compare the current version with your submitted details.")) (text "<details class=\"panel\" open><summary>Currently saved tags</summary><p>") (call std::html-escape-text (call tags::read (field (local media) (name id)))) (text "</p><pre class=\"conflict\">") (text "") (text "</pre></details><section class=\"panel\">") (call driveview::editor-value (loca