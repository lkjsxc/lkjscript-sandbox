  (function create edit (visibility public)
    (parameter create ctx (type Context))
    (parameter create form (type Form))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (let (binding tags (call mediaflow::tag-input (local form))) (in (if (if (call util::token (call util::value (local form) (text "id"))) (if (call tags::valid (local tags)) (if (call util::has (list Text (text "yes") (text "no")) (call util::value (local form) (text "sensitive")) (i64 0)) (bool true) (bool false)) (bool false)) (bool false)) (let (binding result (call drive::edit (local ctx) (local form))) (in (if (call std::i64-equal (field (local result) (name status)) (i64 303)) (sequence (call tags::save (local ctx) (call util::value (local form) (text "id")) (local tags)) (call page::redirect (call mediaflow::saved-location (local ctx) (local form)))) (call mediaflow::recover (local ctx) (local form) (field (local result) (name status)))))) (call mediaflow::recover (local ctx) (local form) (i64 422)))))))

  (function create mark (visibility public)
    (parameter create request (type Request))
    (parameter create form (type Form))
    (returns I64) (effect (task (requirement service::app::store) (requirement service::app::config) (requirement service::app::clock)))
    (body (let (binding ctx (call auth::context (local request))) (binding media (call db::media (call util::value (local form) (text "id")))) (in (if (if (call auth::write-ok (local request)) (if (call util::csrf (local ctx) (local form)) (if (call admission::valid (local form)) (if (call std::text-equal (call util::value (local form) (text "intent")) (text "delete-file")) (if (call std::text-equal (call util::value (local form) (text "confirm")) (text "delete")) (if (call util::token (call util::value (local form) (text "id"))) (if (call std::text-equal (field (local media) (name owner)) (field (local ctx) (name user))) (if (call std::less-equal (i64 0) (field (local media) (name version))) (if (call std::less-equal (field (local media) (name version)) (i64 2147483646)) (bool true) (bool false)) (bool false)) (bool false)) (bool false)) (bool false)) (bool false)) (bool false)) (bool false)) (bool false)) (if (call std::text-equal (field (local media) (name state)) (text "deleted")) (i64 2) (if (if (call std::text-equal (field (local media) (name state)) (text "deleting")) (if (call std::i64-equal (call std::list-length (types Text) (field (local media) (name refs))) (i64 0)) (bool true) (bool false)) (bool false)) (i64 1) (if (call drive::deleting (local ctx) (local form)) (i64 1) (i64 0)))) (i64 0))))))

  (function create remove (visibility public)
    (parameter create request (type Request))
    (parameter create form (type Form))
    (returns Response) (effect (task (requirement service::app::store) (requirement service::app::objects) (requirement service::app::config) (requirement service::app::clock)))
    (body (match (transaction-outcome service::app::store (types I64) (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict) (binding action) (call mediaflow::mark (local request) (local form))) (arm std::TransactionOutcome::Committed (payload decision I64) (if (call std::i64-equal (local decision) (i64 0)) (call page::error (i64 409) (text "Files in use cannot be deleted. Incomplete uploads can be removed after 5 minutes. Check your sign-in and the current file state.")) (if (call std::i64-equal (local decision) (i64 2)) (call page::redirect (text "/drive")) (sequence (call chunkio::erase (call db::media (call util::value (local form) (text "id")))) (match (transaction-outcome service::app::store (types Response) (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict) (binding action) (if (call drive::finish-delete (call util::value (local form) (text "id"))) (let (binding ctx (call auth::context (local request))) (binding draft (call driveview::draft-id (local ctx) (call util::value (local form) (text "draft")))) (in (call page::redirect (if (call util::post-id (local draft)) (call std::text-join (list Text (text "/pick?draft=") (local draft)) (text "")) (text "/drive"))))) (call page::error (i64 503) (text "Deletion metadata could not be finalized. Check the current state in Drive.")))) (arm std::TransactionOutcome::Committed (payload response Response) (local response)) (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason) (call page::error (i64 409) (text "Another action happened at the same time. Check the current state.")))))))) (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason) (call page::error (i64 409) (text "Another action happened at the same time; deletion did not begin. Check the file's current state."))))))
  (function create tag-input (visibility public)
    (parameter create form (type Form))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (if (call std::i64-equal (call std::list-length (types Text) (call util::values (field (local form) (name items)) (text "tags") (i64 0) (list Text))) (i64 0)) (call tags::read (call util::value (local form) (text "id"))) (call util::value (local form) (text "tags")))))

  (function create finish-upload (visibility public)
    (parameter create ctx (type Context))
    (parameter create media (type Media))
    (parameter create request (type Request))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (let (binding draft (call driveview::draft-id (local ctx) (call util::query (local request) (text "draft")))) (in (if (call util::post-id (local draft)) (let (binding note (call db::note (local draft))) (in (if (call util::has (field (local note) (name media)) (field (local media) (name id)) (i64 0)) (call page::redirect (call paths::canonical (call std::text-join (list Text (text "/compose?id=") (local draft)) (text "")))) (if (call std::less (call std::list-length (types Text) (field (local note) (name media))) (i64 4)) (call attachments::change (local ctx) (call util::parse (call std::bytes-from-text (call std::text-join (list Text (text "intent=attach&csrf=") (field (local ctx) (name csrf)) (text "&draft=") (local draft) (text "&id=") (field (local media) (name id)) (text "&version=") (call std::i64-to-text (field (local note) (name version))) (text "&enabled=1&destination=compose")) (text ""))))) (call page::redirect (call std::text-join (list Text (call std::text-join (list Text (call mediaflow::file-location (local ctx) (field (local media) (name id)) (call util::query (local request) (text "draft"))) (text "&uploaded=1")) (text "")) (text "&attachment=full")) (text ""))))))) (call page::redirect (call std::text-join (list Text (call mediaflow::file-location (local ctx) (field (local media) (name id)) (call util::query (local request) (text "draft"))) (text "&uploaded=1")) (text ""))))))))


  (function create saved-location (visibility public) (parameter create ctx (type Context)) (parameter create form (type Form))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (let (binding draft (call driveview::draft-id (local ctx) (call util::value (local form) (text "draft"))))
      (in (if (call util::post-id (local draft)) (call std::text-join (list Text (call paths::post (local draft)) (text "/edit")) (text ""))
        (call std::text-join (list Text (text "/drive#file-") (call util::value (local form) (text "id"))) (text "")))))))
)
