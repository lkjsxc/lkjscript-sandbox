    (body (if (if (call util::token (call util::value (local form) (text "id"))) (if (call util::has (list Text (text "yes") (text "no")) (call util::value (local form) (text "sensitive")) (i64 0)) (bool true) (bool false)) (bool false)) (let (binding result (call drive::edit (local ctx) (local form))) (in (if (call std::i64-equal (field (local result) (name status)) (i64 303)) (call page::redirect (call mediaflow::file-location (local ctx) (call util::value (local form) (text "id")) (call util::value (local form) (text "draft")))) (call mediaflow::recover (local ctx) (local form) (field (local result) (name status)))))) (call mediaflow::recover (local ctx) (local form) (i64 422)))))

  (function create mark (visibility public)
