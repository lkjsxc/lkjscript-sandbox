    (body (let (binding result (call drive::upload (local request))) (in (if (call std::i64-equal (field (local result) (name status)) (i64 303)) (let (binding ctx (call auth::context (local request))) (binding media (call db::media (call util::query (local request) (text "id")))) (in (if (if (call util::signed (local ctx)) (if (call std::text-equal (field (local media) (name owner)) (field (local ctx) (name user))) (if (call std::text-equal (field (local media) (name state)) (text "ready")) (bool true) (bool false)) (bool false)) (bool false)) (call page::redirect (call mediaflow::file-location (local ctx) (field (local media) (name id)) (call util::query (local request) (text "draft")))) (call page::error (i64 409) (text "ログイン状態が変わりました。保存結果をドライブで確認してください。"))))) (local result))))))

