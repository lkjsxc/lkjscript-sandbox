(module create fileactions
  (function create receipt (visibility public)
    (parameter create ready (type Bool))
    (parameter create uploaded (type Bool))
    (parameter create saved (type Bool))
    (returns Text) (effect pure)
    (body (if (local ready)
      (if (local uploaded)
        (text "<div class=\"notice\" role=\"status\"><strong>Saved to Drive.</strong><p>This file is not posted.</p></div>")
        (if (local saved)
          (text "<div class=\"notice\" role=\"status\">Changes saved.</div>")
          (text "")))
      (text ""))))

  (function create selection (visibility public) (parameter create ctx (type Context)) (parameter create media (type Media)) (parameter create draft (type Note)) (returns Text) (effect pure) (body (if (if (call attachments::draft (local ctx) (local draft)) (if (call std::text-equal (field (local media) (name owner)) (field (local ctx) (name user))) (if (call std::text-equal (field (local media) (name state)) (text "ready")) (if (call util::token (field (local media) (name id))) (bool true) (bool false)) (bool false)) (bool false)) (bool false)) (call std::text-join (list Text (text "<div class=\"file-writing-return\" id=\"attachment-next\">") (if (call util::has (field (local draft) (name media)) (field (local media) (name id)) (i64 0)) (call std::text-join (list Text (text "<a class=\"button primary\" href=\"/") (call util::short-id (field (local draft) (name id))) (text "/edit\">Back to writing</a>")) (text "")) (if (call std::less (call std::list-length (types Text) (field (local draft) (name media))) (i64 4)) (call std::text-join (list Text (call page::begin (local ctx) (text "attach")) (call page::hidden (text "draft") (field (local draft) (name id))) (call page::hidden (text "id") (field (local media) (name id))) (call page::hidden (text "version") (call std::i64-to-text (field (local draft) (name version)))) (call page::hidden (text "enabled") (text "1")) (call page::hidden (text "destination") (text "compose")) (text "<button class=\"primary\">Attach file</button></form>")) (text "")) (call std::text-join (list Text (text "<a class=\"button\" href=\"/pick?draft=") (field (local draft) (name id)) (text "\">Choose attachments</a>")) (text "")))) (text "</div>")) (text "")) (text ""))))

  (function create sample-viewer (visibility private)
    (returns Context) (effect pure)
    (body (record structural (field user (text "alice"))
      (field csrf (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
      (field session (text "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"))
      (field now (i64 1)))))

  (function create sample-file (visibility private)
    (parameter create owner (type Text))
    (parameter create state (type Text))
    (returns Media) (effect pure)
    (body (record structural
      (field id (text "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"))
      (field owner (local owner)) (field name (text "photo.png"))
      (field mime (text "image/png")) (field alt (text "")) (field folder (text ""))
      (field size (i64 10)) (field created (i64 1)) (field sensitive (bool false))
      (field state (local state)) (field digest (text "")) (field refs (list Text))
      (field version (i64 1)) (field offset (i64 100)) (field stored (i64 110)))))

  (test create unfinished-is-not-saved (visibility private)
    (actual (call fileactions::receipt (bool false) (bool true) (bool true)))
    (expected (text "")))

  (test create saved-feedback-is-status (visibility private)
    (actual (call std::text-contains
      (call fileactions::receipt (bool true) (bool false) (bool true))
      (text "role=\"status\""))) (expected (bool true)))

  (test create upload-distinguishes-posting (visibility private)
    (actual (call std::text-contains
      (call fileactions::receipt (bool true) (bool true) (bool false))
      (text "This file is not posted"))) (expected (bool true)))

  (test create no-unearned-feedback (visibility private)
    (actual (call fileactions::receipt (bool true) (bool false) (bool false)))
    (expected (text "")))

  (test create owned-ready-file-can-return-to-writing (visibility private)
    (actual (call std::text-contains
      (call fileactions::selection (call fileactions::sample-viewer)
        (call fileactions::sample-file (text "alice") (text "ready"))
        (call journal::blank (call fileactions::sample-viewer)
          (text "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee")))
      (text "name=\"destination\" value=\"compose\""))) (expected (bool true)))

  (test create other-owner-has-no-attachment-shortcut (visibility private)
    (actual (call fileactions::selection (call fileactions::sample-viewer)
      (call fileactions::sample-file (text "bob") (text "ready"))
      (call journal::blank (call fileactions::sample-viewer)
        (text "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"))))
    (expected (text "")))

  (test create incomplete-file-has-no-attachment-shortcut (visibility private)
    (actual (call fileactions::selection (call fileactions::sample-viewer)
      (call fileactions::sample-file (text "alice") (text "uploading"))
      (call journal::blank (call fileactions::sample-viewer)
        (text "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"))))
    (expected (text "")))
  (function create privacy (visibility public) (parameter create profile (type Bool)) (parameter create used (type Bool)) (returns Text) (effect pure) (body (if (local profile) (text "<p class=\"field-help usage-status\">Used as your public profile image.</p>") (if (local used) (text "") (text "<p class=\"field-help usage-status\">Not used yet.</p>")))))

  (test create profile-image-is-public (visibility private) (actual (call std::text-contains (call fileactions::privacy (bool true) (bool false)) (text "public profile image"))) (expected (bool true)))

  (test create profile-image-does-not-claim-private (visibility private) (actual (call std::text-contains (call fileactions::privacy (bool true) (bool false)) (text "Only you"))) (expected (bool false)))

  (test create unused-image-is-not-in-use (visibility private) (actual (call std::text-contains (call fileactions::privacy (bool false) (bool false)) (text "Not used yet."))) (expected (bool true)))

)
