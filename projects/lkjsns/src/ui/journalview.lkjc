    (body (if (call util::signed (local ctx)) (let (binding id (call util::query (local request) (text "id"))) (binding fresh (call std::text-equal (local id) (text ""))) (binding note (if (local fresh) (let (binding blank (call journal::blank (local ctx) (call util::random))) (in (record structural (field id (field (local blank) (name id))) (field author (field (local blank) (name author))) (field body (field (local blank) (name body))) (field cw (field (local blank) (name cw))) (field audience (field (local blank) (name audience))) (field reply (call util::query (local request) (text "reply"))) (field media (field (local blank) (name media))) (field eyes (field (local blank) (name eyes))) (field created (field (local blank) (name created))) (field edited (field (local blank) (name edited))) (field version (field (local blank) (name version))) (field published (field (local blank) (name published))) (field deleted (field (local blank) (name deleted)))))) (call db::note (local id)))) (in (if (if (call access::visible (local ctx) (local note)) (if (call std::text-equal (field (local note) (name author)) (field (local ctx) (name user))) (bool true) (bool false)) (bool false)) (call page::reply (i64 200) (call page::frame (local ctx) (text "書く") (call std::text-join (list Text (if (if (call std::less (i64 0) (field (local note) (name version))) (if (call std::bool-not (field (local note) (name published))) (call std::text-equal (call util::query (local request) (text "saved")) (text "1")) (bool false)) (bool false)) (text "<p class=\"notice\" role=\"status\">この下書きは保存済みです。編集内容は、次の保存で反映されます。</p>") (text "")) (call journalview::editor (local ctx) (local note) (bool false))) (text ""))) (text "") (text "")) (call page::error (i64 404) (text "このノートは編集できません。"))))) (call page::error (i64 403) (text "ログイン状態と操作対象を確認してください。")))))

