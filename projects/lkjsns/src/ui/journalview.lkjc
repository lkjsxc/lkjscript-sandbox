    (body (if (call util::signed (local ctx)) (let (binding viewer (call db::user (field (local ctx) (name user)))) (binding items (field (local viewer) (name saved))) (binding offset (call util::number (call util::query (local request) (text "cursor")) (call std::list-length (types Text) (local items)))) (binding start (if (call std::less (local offset) (i64 0)) (i64 0) (local offset))) (binding window (call std::list-window (types Text) (local items) (local start) (i64 30))) (binding rows (call journalview::rows (local ctx) (local window) (i64 0) (text "everyone") (local viewer) (text ""))) (in (call page::reply (i64 200) (call page::frame (local ctx) (text "しおり") (call std::text-join (list Text (text "<p class=\"context-hint\">しおりは自分だけに表示されます。</p><div class=\"feed\">") (if (call std::text-equal (local rows) (text "")) (call page::empty (text "しおりはまだありません") (text "読み返したいノートの「しおり」を押すと、ここに残せます。") (text "/") (text "ホームを開く")) (local rows)) (text "</div>") (call page::pager (if (call std::less (call std::add (local start) (i64 30)) (call std::list-length (types Text) (local items))) (call std::add (local start) (i64 30)) (i64 -1)) (text "/saved?"))) (text ""))) (text "") (text "")))) (call page::error (i64 403) (text "ログイン状態と操作対象を確認してください。")))))
)
