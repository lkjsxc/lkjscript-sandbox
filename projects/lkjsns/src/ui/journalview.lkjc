  ;; Return query value; each dynamic component is validated as an unreserved URL token.
  (function create shared-thread-return (visibility public)
    (parameter create place (type Text)) (parameter create cursor (type Text))
    (parameter create trail (type Text)) (parameter create share (type Text)) (returns Text) (effect pure)
    (body (if (if (call std::text-starts-with (local place) (text "thread:"))
      (if (call navigation::reading-place (local place)) (call util::token (local share)) (bool false)) (bool false))
      (call std::text-join (list Text (text "/")
        (call util::short-id (call util::slice (local place) (i64 7) (call util::size (local place))))
        (text "%3fshare%3d") (local share)
        (if (if (call std::bool-not (call std::text-equal (local cursor) (text "")))
          (call navigation::reading-cursor (local cursor)) (bool false))
          (call std::text-join (list Text (text "%26cursor%3d") (local cursor)) (text "")) (text ""))
        (if (if (call std::bool-not (call std::text-equal (local trail) (text "")))
          (call paging::valid-trail (local trail)) (bool false))
          (call std::text-join (list Text (text "%26trail%3d") (local trail)) (text "")) (text ""))) (text ""))
      (text "%2f"))))

  (test create shared-thread-return-keeps-page (visibility private)
    (actual (call journalview::shared-thread-return (text "thread:0123456789abcdef") (text "30") (text "_.5") (text "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")))
    (expected (text "/0123456789abcdef%3fshare%3dbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb%26cursor%3d30%26trail%3d_.5")))
  (test create shared-thread-return-rejects-invalid-place (visibility private)
    (actual (call journalview::shared-thread-return (text "thread:bad") (text "") (text "") (text "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")))
    (expected (text "%2f")))
  (test create shared-thread-return-drops-invalid-history (visibility private)
    (actual (call journalview::shared-thread-return (text "thread:0123456789abcdef") (text "1&bad") (text "_.-1") (text "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")))
    (expected (text "/0123456789abcdef%3fshare%3dbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")))

