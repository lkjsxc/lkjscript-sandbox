    (body (call std::text-join (list Text (text "<section class=\"panel composer\">") (call page::begin (local ctx) (text "note")) (call page::hidden (text "id") (field (local note) (name id))) (call page::hidden (text "version") (call std::i64-to-text (field (local note) (name version)))) (call page::hidden (text "reply") (field (local note) (name reply))) (if (call util::token (field (local note) (name reply))) (call std::text-join (list Text (text "<p class=\"reply-context\">返信先の <a href=\"/note?id=") (call std::html-escape-text (field (local note) (name reply))) (text "\">ノート</a> に返信しています。</p>")) (text "")) (text "")) (text "<div class=\"stack\">") (call controls::area (text "body") (text "ノートの本文") (field (local note) (name body))) (text "<details") (if (call std::bool-not (call std::text-equal (field (local note) (name cw)) (text ""))) (text " open") (text "")) (text "><summary>注意書きを付ける</summary>") (call controls::input (text "cw") (text "注意書き（本文を開く前に表示）") (field (local note) (name cw)) (text "text")) (text "</details>") (if (field (local note) (name published)) (call std::text-join (list Text (call page::hidden (text "audience") (field (local note) (name audience))) (text "<p class=\"field-help\">公開範囲：") (if (call std::text-equal (field (local note) (name audience)) (text "public")) (text "公開（誰でも閲覧）") (text "メンバー限定")) (text "。公開後の範囲と返信先は変更できません。</p>")) (text "")) (call controls::audience (field (local note) (name audience)))) (text "<div class=\"form-actions row spread\"><span class=\"field-help\">") (if (call std::less (i64 0) (field (local note) (name version))) (if (field (local note) (name published)) (text "変更は保存するまで公開されません。") (text "下書きはこのアカウントに保存されます。")) (text "保存ボタンを押すまで、内容は保存されません。")) (text "</span><div class=\"row\">") (if (field (local note) (name published)) (text "") (call std::text-join (list Text (text "<button name=\"mode\" value=\"draft\">") (if (local recovery) (text "比較した内容を下書き保存") (text "下書き保存")) (text "</button>")) (text ""))) (text "<butt