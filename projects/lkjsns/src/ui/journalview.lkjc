    (returns Text) (effect pure)
    (body (call std::text-join (list Text (call page::begin (local ctx) (local intent)) (call page::hidden (text "id") (field (local note) (name id))) (call page::hidden (text "enabled") (if (local enabled) (text "0") (text "1"))) (text "<button aria-pressed=\"") (if (local enabled) (text "true") (text "false")) (text "\">") (call std::html-escape-text (local label)) (text "</button></form>")) (text ""))))

