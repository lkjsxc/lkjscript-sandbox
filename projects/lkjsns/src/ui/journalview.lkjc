    (body (let (binding submitted (record structural (field id (field (local note) (name id))) (field author (field (local note) (name author))) (field body (call util::value (local form) (text "body"))) (field cw (call util::value (local form) (text "cw"))) (field audience (call util::value (local form) (text "audience"))) (field reply (call util::value (local form) (text "reply"))) (field media (field (local note) (name media))) (field eyes (field (local note) (name eyes))) (field created (field (local note) (name created))) (field edited (field (local note) (name edited))) (field version (field (local note) (name version))) (field published (field (local note) (name published))) (field deleted (field (local note) (name deleted))))) (in (call page::reply (local status) (call page::frame (local ctx) (text "保存の確認") (call std::text-join (list Text (call controls::message (local message)) (if (call std::i64-equal (local status) (i64 409)) (call std::text-join (list Text (text "<details class=\"panel\" open><summary>現在保存されている内容</summary><p class=\"field-help\">注意書き：") (call std::html-escape-text (field (local note) (name cw))) (text "</p><pre class=\"conflict\">") (call std::html-escape-text (field (local note) (name body))) (text "</pre></details>")) (text "")) (text "")) (call journalview::editor (local ctx) (local submitted) (bool true))) (text ""))) (text "") (text ""))))))

