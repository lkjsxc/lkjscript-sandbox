(module create social
  (function create notify
    (visibility public) (parameter create ctx (type Context)) (parameter create owner (type Text)) (parameter create kind (type Text)) (parameter create note (type Text))
    (returns Unit) (effect (task (requirement service::app::store) (requirement service::app::entropy)))
    (body (let (binding user (call db::user (local owner))) (in (if (if (call util::handle (local owner)) (if (call std::bool-not (call std::text-equal (local owner) (field (local ctx) (name user)))) (if (call std::bool-not (call util::has (field (local user) (name muted)) (field (local ctx) (name user)) (i64 0))) (bool true) (bool false)) (bool false)) (bool false)) (let (binding id (call util::random)) (in (sequence (call db::put (text "notice") (local id) (call std::data-encode (types Notice) (record structural (field actor (field (local ctx) (name user))) (field kind (local kind)) (field note (local note)) (field at (field (local ctx) (name now)))))) (call db::index (call std::text-join (list Text (text "notice/") (local owner)) (text "")) (local id))))) (unit))))))

  (function create reaction
    (visibility public) (parameter create ctx (type Context)) (parameter create form (type Form))
    (returns Response) (effect (task (requirement service::app::store) (requirement service::app::entropy)))
    (body (let (binding note (call db::note (call util::value (local form) (text "id")))) (in (if (if (call access::visible (local ctx) (local note)) (if (field (local note) (name published)) (if (if (call util::has (field (local note) (name eyes)) (field (local ctx) (name user)) (i64 0)) (bool true) (if (call std::less (call std::list-length (types Text) (field (local note) (name eyes))) (i64 1024)) (bool true) (bool false))) (bool true) (bool false)) (bool false)) (bool false)) (sequence (call db::save-note (record structural (field id (field (local note) (name id))) (field author (field (local note) (name author))) (field body (field (local note) (name body))) (field cw (field (local note) (name cw))) (field audience (field (local note) (name audience))) (field reply (field (local note) (name reply))) (field media (field (local note) (name media))) (field eyes (call util::toggle (field (local note) (name eyes)) (field (local ctx) (name user)))) (field created (field (local note) (name created))) (field edited (field (local note) (name edited))) (field version (field (local note) (name version))) (field published (field (local note) (name published))) (field deleted (field (local note) (name deleted))))) (if (call util::has (field (local note) (name eyes)) (field (local ctx) (name user)) (i64 0)) (unit) (call social::notify (local ctx) (field (local note) (name author)) (text "eyes") (field (local note) (name id)))) (call page::redirect (call paths::canonical (call std::text-join (list Text (text "/note?id=") (field (local note) (name id))) (text ""))))) (call page::error (i64 404) (text "Post not found.")))))))

  (function create bookmark
    (visibility public) (parameter create ctx (type Context)) (parameter create form (type Form))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (let (binding note (call db::note (call util::value (local form) (text "id")))) (binding user (call db::user (field (local ctx) (name user)))) (in (if (if (call access::visible (local ctx) (local note)) (if (field (local note) (name published)) (if (if (call util::has (field (local user) (name saved)) (field (local note) (name id)) (i64 0)) (bool true) (if (call std::less (call std::list-length (types Text) (field (local user) (name saved))) (i64 512)) (bool true) (bool false))) (bool true) (bool false)) (bool false)) (bool false)) (sequence (call db::save-user (record structural (field handle (field (local user) (name handle))) (field password (field (local user) (name password))) (field display (field (local user) (name display))) (field bio (field (local user) (name bio))) (field admin (field (local user) (name admin))) (field suspended (field (local user) (name suspended))) (field created (field (local user) (name created))) (field failures (field (local user) (name failures))) (field locked (field (local user) (name locked))) (field sessions (field (local user) (name sessions))) (field attention (field (local user) (name attention))) (field muted (field (local user) (name muted))) (field saved (call util::toggle (field (local user) (name saved)) (field (local note) (name id)))) (field used (field (local user) (name used))) (field version (field (local user) (name version))))) (call page::redirect (call paths::canonical (call std::text-join (list Text (text "/note?id=") (field (local note) (name id))) (text ""))))) (call page::error (i64 422) (text "This post is unavailable, or you have reached the limit of 512 bookmarks.")))))))



  (function create suspend
    (visibility public) (parameter create ctx (type Context)) (parameter create form (type Form))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (let (binding admin (call db::user (field (local ctx) (name user)))) (binding user (call db::user (call util::value (local form) (text "handle")))) (in (if (if (field (local admin) (name admin)) (if (call util::handle (field (local user) (name handle))) (if (call std::bool-not (call std::text-equal (field (local user) (name handle)) (field (local ctx) (name user)))) (if (call std::bool-not (field (local user) (name admin))) (bool true) (bool false)) (bool false)) (bool false)) (bool false)) (sequence (call db::save-user (record structural (field handle (field (local user) (name handle))) (field password (field (local user) (name password))) (field display (field (local user) (name display))) (field bio (field (local user) (name bio))) (field admin (field (local user) (name admin))) (field suspended (call std::bool-not (field (local user) (name suspended)))) (field created (field (local user) (name created))) (field failures (field (local user) (name failures))) (field locked (field (local user) (name locked))) (field sessions (list Text)) (field attention (field (local user) (name attention))) (field muted (field (local user) (name muted))) (field saved (field (local user) (name saved))) (field used (field (local user) (name used))) (field version (call std::add (field (local user) (name version)) (i64 1))))) (call page::redirect (text "/admin"))) (call page::error (i64 403) (text "This member cannot be suspended.")))))))
)
