(module create icons
  (function create svg (visibility public)
    (returns Bytes) (effect pure)
    (body (call std::bytes-from-text (text "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"64\" viewBox=\"0 0 256 256\" role=\"img\" aria-labelledby=\"title\"><title id=\"title\">lkjsns</title><desc>Four blue and periwinkle panels behind a white circle and dark lkjsns lettering, adapted from lkjsxc's profile icon.</desc><path fill=\"#2589ca\" d=\"M0 0h128v128H0z\"/><path fill=\"#51aad7\" d=\"M128 0h128v128H128z\"/><path fill=\"#526fd5\" d=\"M0 128h128v128H0z\"/><path fill=\"#8388e0\" d=\"M128 128h128v128H128z\"/><circle cx=\"128\" cy=\"128\" r=\"100\" fill=\"#fff\"/><path id=\"wordmark-lkjsns\" aria-label=\"lkjsns\" fill=\"#0b1020\" d=\"M35 98.935H45.416V144.206H35ZM55.424 98.935H65.84V123.578L77.827 111.62H89.93L74.015 126.574L91.181 144.206H78.554L65.84 130.618V144.206H55.424ZM95.051 111.62H105.466V143.624Q105.466 150.17 102.324 153.618Q99.182 157.065 93.218 157.065H88.068V150.228H89.872Q92.84 150.228 93.945 148.89Q95.051 147.551 95.051 143.624ZM95.051 98.935H105.466V107.43H95.051ZM140.932 112.638V120.552Q137.587 119.155 134.473 118.457Q131.36 117.759 128.596 117.759Q125.629 117.759 124.189 118.501Q122.748 119.243 122.748 120.785Q122.748 122.036 123.84 122.705Q124.931 123.374 127.753 123.694L129.586 123.956Q137.587 124.974 140.351 127.302Q143.115 129.629 143.115 134.604Q143.115 139.812 139.274 142.431Q135.434 145.049 127.811 145.049Q124.581 145.049 121.134 144.54Q117.686 144.031 114.049 143.013V135.099Q117.162 136.612 120.435 137.368Q123.709 138.125 127.084 138.125Q130.138 138.125 131.68 137.281Q133.222 136.437 133.222 134.779Q133.222 133.382 132.16 132.699Q131.099 132.015 127.927 131.637L126.094 131.404Q119.141 130.531 116.348 128.175Q113.555 125.818 113.555 121.017Q113.555 115.839 117.104 113.336Q120.654 110.834 127.985 110.834Q130.866 110.834 134.037 111.271Q137.208 111.707 140.932 112.638ZM183.701 124.363V144.206H173.227V140.976V129.018Q173.227 124.8 173.038 123.199Q172.849 121.599 172.383 120.843Q171.772 119.824 170.725 119.257Q169.678 118.69 168.339 118.69Q165.081 118.69 163.219 121.206Q161.357 123.723 161.357 128.175V144.206H150.941V111.62H161.357V116.391Q163.713 113.54 166.361 112.187Q169.008 110.834 172.209 110.834Q177.853 110.834 180.777 114.297Q183.701 117.759 183.701 124.363ZM218.818 112.638V120.552Q215.472 119.155 212.359 118.457Q209.246 117.759 206.482 117.759Q203.514 117.759 202.074 118.501Q200.634 119.243 200.634 120.785Q200.634 122.036 201.725 122.705Q202.816 123.374 205.638 123.694L207.471 123.956Q215.472 124.974 218.236 127.302Q221 129.629 221 134.604Q221 139.812 217.16 142.431Q213.319 145.049 205.696 145.049Q202.467 145.049 199.019 144.54Q195.572 144.031 191.935 143.013V135.099Q195.048 136.612 198.321 137.368Q201.594 138.125 204.969 138.125Q208.024 138.125 209.566 137.281Q211.108 136.437 211.108 134.779Q211.108 133.382 210.046 132.699Q208.984 132.015 205.813 131.637L203.98 131.404Q197.026 130.531 194.233 128.175Q191.44 125.818 191.44 121.017Q191.44 115.839 194.99 113.336Q198.539 110.834 205.871 110.834Q208.751 110.834 211.923 111.271Q215.094 111.707 218.818 112.638Z\"/></svg>\n"))))

  (test create svg-has-payload (visibility private) (actual (call std::less (i64 0) (call std::bytes-length (call icons::svg)))) (expected (bool true)))

  (function create ico (visibility public)
    (returns Bytes) (effect pure)
    (body (call iconico::read)))

  (test create ico-has-payload (visibility private) (actual (call std::less (i64 0) (call std::bytes-length (call icons::ico)))) (expected (bool true)))

  (function create png (visibility public)
    (returns Bytes) (effect pure)
    (body (call iconpng::read)))

  (test create png-has-payload (visibility private) (actual (call std::less (i64 0) (call std::bytes-length (call icons::png)))) (expected (bool true)))

  (function create touch (visibility public)
    (returns Bytes) (effect pure)
    (body (call icontouch::read)))

  (test create touch-has-payload (visibility private) (actual (call std::less (i64 0) (call std::bytes-length (call icons::touch)))) (expected (bool true)))

  (function create app192 (visibility public)
    (returns Bytes) (effect pure)
    (body (call iconapp192::read)))

  (test create app192-has-payload (visibility private) (actual (call std::less (i64 0) (call std::bytes-length (call icons::app192)))) (expected (bool true)))

  (function create app512 (visibility public)
    (returns Bytes) (effect pure)
    (body (call iconapp512::read)))

  (test create app512-has-payload (visibility private) (actual (call std::less (i64 0) (call std::bytes-length (call icons::app512)))) (expected (bool true)))

  (function create manifest (visibility public)
    (returns Bytes) (effect pure)
    (body (call std::bytes-from-text (text "{\n  \"id\": \"/\",\n  \"name\": \"lkjsns\",\n  \"short_name\": \"lkjsns\",\n  \"start_url\": \"/\",\n  \"scope\": \"/\",\n  \"display\": \"standalone\",\n  \"lang\": \"en\",\n  \"icons\": [\n    {\n      \"src\": \"/app-icon-9ef7b4ce01bf-192.png\",\n      \"sizes\": \"192x192\",\n      \"type\": \"image/png\",\n      \"purpose\": \"any\"\n    },\n    {\n      \"src\": \"/app-icon-9ef7b4ce01bf-512.png\",\n      \"sizes\": \"512x512\",\n      \"type\": \"image/png\",\n      \"purpose\": \"any\"\n    },\n    {\n      \"src\": \"/favicon-9ef7b4ce01bf.svg\",\n      \"sizes\": \"any\",\n      \"type\": \"image/svg+xml\",\n      \"purpose\": \"any\"\n    }\n  ]\n}\n"))))

  (function create links (visibility public)
    (returns Text) (effect pure)
    (body (text "<link rel=\"icon\" href=\"/favicon-9ef7b4ce01bf.ico\" sizes=\"16x16 32x32\"><link rel=\"icon\" href=\"/favicon-9ef7b4ce01bf-32.png\" type=\"image/png\" sizes=\"32x32\"><link rel=\"icon\" href=\"/favicon-9ef7b4ce01bf.svg\" type=\"image/svg+xml\" sizes=\"any\"><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon-9ef7b4ce01bf.png\" sizes=\"180x180\"><link rel=\"manifest\" href=\"/manifest.webmanifest\"><meta name=\"application-name\" content=\"lkjsns\"><meta name=\"apple-mobile-web-app-title\" content=\"lkjsns\">")))

  (function create revision (visibility public)
    (returns Text) (effect pure)
    (body (text "9ef7b4ce01bf")))

  (function create mark (visibility public)
    (returns Text) (effect pure)
    (body (text "<img class=\"brand-mark\" src=\"/favicon-9ef7b4ce01bf.svg\" width=\"32\" height=\"32\" alt=\"\" aria-hidden=\"true\" decoding=\"async\">")))

  (function create brand (visibility public)
    (returns Text) (effect pure)
    (body (text "<a href=\"/\" class=\"brand\" aria-label=\"lkjsns home\"><img class=\"brand-mark\" src=\"/favicon-9ef7b4ce01bf.svg\" width=\"32\" height=\"32\" alt=\"\" aria-hidden=\"true\" decoding=\"async\"><span>lkjsns</span></a>")))

  (function create known (visibility public)
    (parameter create path (type Text))
    (returns Bool) (effect pure)
    (body (call util::has (list Text (text "/favicon.svg") (text "/favicon-9ef7b4ce01bf.svg") (text "/favicon-b7cf1e2c2a49.svg") (text "/favicon.ico") (text "/favicon-9ef7b4ce01bf.ico") (text "/favicon-b7cf1e2c2a49.ico") (text "/favicon-32.png") (text "/favicon-9ef7b4ce01bf-32.png") (text "/favicon-b7cf1e2c2a49-32.png") (text "/apple-touch-icon.png") (text "/apple-touch-icon-9ef7b4ce01bf.png") (text "/apple-touch-icon-b7cf1e2c2a49.png") (text "/app-icon-192.png") (text "/app-icon-9ef7b4ce01bf-192.png") (text "/app-icon-512.png") (text "/app-icon-9ef7b4ce01bf-512.png") (text "/manifest.webmanifest") (text "/site.webmanifest") (text "/apple-touch-icon-precomposed.png")) (local path) (i64 0))))

  (function create data (visibility public)
    (parameter create path (type Text))
    (returns Bytes) (effect pure)
    (body (if (call util::has (list Text (text "/manifest.webmanifest") (text "/site.webmanifest")) (local path) (i64 0)) (call icons::manifest) (if (call util::has (list Text (text "/apple-touch-icon-precomposed.png")) (local path) (i64 0)) (call icons::touch) (if (call util::has (list Text (text "/favicon.svg") (text "/favicon-9ef7b4ce01bf.svg") (text "/favicon-b7cf1e2c2a49.svg")) (local path) (i64 0)) (call icons::svg) (if (call util::has (list Text (text "/favicon.ico") (text "/favicon-9ef7b4ce01bf.ico") (text "/favicon-b7cf1e2c2a49.ico")) (local path) (i64 0)) (call icons::ico) (if (call util::has (list Text (text "/favicon-32.png") (text "/favicon-9ef7b4ce01bf-32.png") (text "/favicon-b7cf1e2c2a49-32.png")) (local path) (i64 0)) (call icons::png) (if (call util::has (list Text (text "/apple-touch-icon.png") (text "/apple-touch-icon-9ef7b4ce01bf.png") (text "/apple-touch-icon-b7cf1e2c2a49.png")) (local path) (i64 0)) (call icons::touch) (if (call util::has (list Text (text "/app-icon-192.png") (text "/app-icon-9ef7b4ce01bf-192.png")) (local path) (i64 0)) (call icons::app192) (if (call util::has (list Text (text "/app-icon-512.png") (text "/app-icon-9ef7b4ce01bf-512.png")) (local path) (i64 0)) (call icons::app512) (call std::bytes-from-text (text ""))))))))))))

  (function create mime (visibility public)
    (parameter create path (type Text))
    (returns Text) (effect pure)
    (body (if (call util::has (list Text (text "/manifest.webmanifest") (text "/site.webmanifest")) (local path) (i64 0)) (text "application/manifest+json; charset=utf-8") (if (call util::has (list Text (text "/apple-touch-icon-precomposed.png")) (local path) (i64 0)) (text "image/png") (if (call util::has (list Text (text "/favicon.svg") (text "/favicon-9ef7b4ce01bf.svg") (text "/favicon-b7cf1e2c2a49.svg")) (local path) (i64 0)) (text "image/svg+xml") (if (call util::has (list Text (text "/favicon.ico") (text "/favicon-9ef7b4ce01bf.ico") (text "/favicon-b7cf1e2c2a49.ico")) (local path) (i64 0)) (text "image/x-icon") (if (call util::has (list Text (text "/favicon-32.png") (text "/favicon-9ef7b4ce01bf-32.png") (text "/favicon-b7cf1e2c2a49-32.png")) (local path) (i64 0)) (text "image/png") (if (call util::has (list Text (text "/apple-touch-icon.png") (text "/apple-touch-icon-9ef7b4ce01bf.png") (text "/apple-touch-icon-b7cf1e2c2a49.png")) (local path) (i64 0)) (text "image/png") (if (call util::has (list Text (text "/app-icon-192.png") (text "/app-icon-9ef7b4ce01bf-192.png")) (local path) (i64 0)) (text "image/png") (if (call util::has (list Text (text "/app-icon-512.png") (text "/app-icon-9ef7b4ce01bf-512.png")) (local path) (i64 0)) (text "image/png") (text "application/octet-stream")))))))))))

  (test create ico-header (visibility private) (actual (call std::bytes-to-hex (call std::bytes-slice (call icons::ico) (i64 0) (i64 6)))) (expected (text "000001000200")))

  (test create png-header (visibility private) (actual (call std::bytes-to-hex (call std::bytes-slice (call icons::png) (i64 0) (i64 8)))) (expected (text "89504e470d0a1a0a")))

  (test create wordmark-is-lkjsns (visibility private) (actual (call std::text-contains (call std::bytes-to-text (call icons::svg)) (text "id=\"wordmark-lkjsns\""))) (expected (bool true)))

  (test create svg-is-font-independent (visibility private) (actual (call std::text-contains (call std::bytes-to-text (call icons::svg)) (text "<text"))) (expected (bool false)))

  (test create svg-alias-0 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/favicon.svg")) (call icons::svg))) (expected (bool true)))

  (test create svg-alias-1 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/favicon-9ef7b4ce01bf.svg")) (call icons::svg))) (expected (bool true)))

  (test create svg-alias-2 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/favicon-b7cf1e2c2a49.svg")) (call icons::svg))) (expected (bool true)))

  (test create ico-alias-0 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/favicon.ico")) (call icons::ico))) (expected (bool true)))

  (test create ico-alias-1 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/favicon-9ef7b4ce01bf.ico")) (call icons::ico))) (expected (bool true)))

  (test create ico-alias-2 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/favicon-b7cf1e2c2a49.ico")) (call icons::ico))) (expected (bool true)))

  (test create png-alias-0 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/favicon-32.png")) (call icons::png))) (expected (bool true)))

  (test create png-alias-1 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/favicon-9ef7b4ce01bf-32.png")) (call icons::png))) (expected (bool true)))

  (test create png-alias-2 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/favicon-b7cf1e2c2a49-32.png")) (call icons::png))) (expected (bool true)))

  (test create touch-alias-0 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/apple-touch-icon.png")) (call icons::touch))) (expected (bool true)))

  (test create touch-alias-1 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/apple-touch-icon-9ef7b4ce01bf.png")) (call icons::touch))) (expected (bool true)))

  (test create touch-alias-2 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/apple-touch-icon-b7cf1e2c2a49.png")) (call icons::touch))) (expected (bool true)))

  (test create app192-alias-0 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/app-icon-192.png")) (call icons::app192))) (expected (bool true)))

  (test create app192-alias-1 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/app-icon-9ef7b4ce01bf-192.png")) (call icons::app192))) (expected (bool true)))

  (test create app512-alias-0 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/app-icon-512.png")) (call icons::app512))) (expected (bool true)))

  (test create app512-alias-1 (visibility private) (actual (call std::bytes-equal (call icons::data (text "/app-icon-9ef7b4ce01bf-512.png")) (call icons::app512))) (expected (bool true)))

  (test create brand-uses-current-mark (visibility private) (actual (call std::text-contains (call icons::brand) (call icons::mark))) (expected (bool true)))

  (test create brand-has-no-old-glyph (visibility private) (actual (call std::text-contains (call icons::brand) (text "lk/"))) (expected (bool false)))

  (test create manifest-media-type (visibility private) (actual (call icons::mime (text "/manifest.webmanifest"))) (expected (text "application/manifest+json; charset=utf-8")))

  (test create unknown-path-is-not-an-icon (visibility private) (actual (call icons::known (text "/icon/anything"))) (expected (bool false)))

)
