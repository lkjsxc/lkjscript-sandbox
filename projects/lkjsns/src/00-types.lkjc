(use std builtin)
(type-alias Header (record (name Text) (value Bytes)))
(type-alias Request (record (body (stream Bytes)) (headers (list Header)) (method Text) (path Text) (query Text) (query_parameters (map Text (list Text)))))
(type-alias Response (record (status I64) (headers (list Header)) (body Bytes)))
(type-alias Form (record (valid Bool) (items (list forms::field))))
(type-alias Context (record (user Text) (csrf Text) (session Text) (now I64) (share Text)))
(type-alias User (record (handle Text) (password Text) (display Text) (bio Text) (admin Bool) (suspended Bool) (created I64) (failures I64) (locked I64) (sessions (list Text)) (attention (list Text)) (muted (list Text)) (saved (list Text)) (used I64) (version I64)))
(type-alias Session (record (user Text) (csrf Text) (expires I64)))
(type-alias Invite (record (id Text) (label Text) (expires I64) (remaining I64) (revoked Bool)))
(type-alias Note (record (id Text) (author Text) (body Text) (cw Text) (audience Text) (reply Text) (media (list Text)) (eyes (list Text)) (created I64) (edited I64) (version I64) (published Bool) (deleted Bool)))
(type-alias Media (record (id Text) (owner Text) (name Text) (mime Text) (alt Text) (folder Text) (size I64) (created I64) (sensitive Bool) (state Text) (digest Text) (refs (list Text)) (version I64) (offset I64) (stored I64)))
(type-alias Folder (record (id Text) (owner Text) (name Text) (deleted Bool) (version I64)))
(type-alias Notice (record (actor Text) (kind Text) (note Text) (at I64)))
(type-alias Listing (record (ids (list Text)) (next I64)))
(type-alias Upload (record (valid Bool) (fields (list forms::field)) (data Bytes)))
(type-alias Part (record (valid Bool) (start I64) (end I64) (next I64) (name Text) (file Bool)))
(type-alias Range (record (valid Bool) (partial Bool) (start I64) (length I64)))
(type-alias LibraryWindow (record (rows Text) (next I64)))
(type-alias ChunkPlan (record (total I64) (hashes (list Text))))
(type-alias PutReceipt (record (blake3 Text) (cleanup_pending Bool) (key Text) (size I64) (version Text)))

(type-alias LegacyUser (record (handle Text) (password Text) (display Text) (bio Text) (admin Bool) (suspended Bool) (created I64) (failures I64) (locked I64) (sessions (list Text)) (following (list Text)) (muted (list Text)) (saved (list Text)) (used I64) (version I64)))
(type-alias AttentionEvent (record (id Text) (owner Text) (target Text)))
(type-alias AttentionProgress (record (user I64) (edge I64) (done Bool)))

(type-alias PostIndexProgress (record (phase I64) (user I64) (index I64) (done Bool) (valid Bool)))
