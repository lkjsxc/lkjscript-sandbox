(module create postquota
  ;; Charge logical bytes: encoded values and their attributable encoded keys.
  (function create bytes (visibility public)
    (parameter create kind (type Text)) (parameter create id (type Text))
    (parameter create value (type Bytes)) (returns I64) (effect pure)
    (body (call std::add (call std::bytes-length (local value))
      (call std::bytes-length (call std::data-encode
        (types (list std::DataKeyPart)) (call db::key (local kind) (local id)))))))

  (function create stored (visibility public)
    (parameter create kind (type Text)) (parameter create id (type Text))
    (returns I64) (effect (task (requirement service::app::store)))
    (body (let (binding entries (call db::read (local kind) (local id)))
      (in (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local entries)) (i64 0))
        (i64 0)
        (call postquota::bytes (local kind) (local id)
          (field (call std::list-get (types std::DataEntry) (local entries) (i64 0)) std::DataEntry::value))))))

  )
  (function create used (visibility public)
    (parameter create owner (type Text)) (returns I64)
    (effect (task (requirement service::app::store)))
    (body (let (binding entries (call db::read (text "post-used") (local owner)))
      (in (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local entries)) (i64 0))
        (i64 0) (call std::data-decode-or (types I64)
          (field (call std::list-get (types std::DataEntry) (local entries) (i64 0)) std::DataEntry::value) (i64 -1)))))))

  (function create user-used (visibility private)
    (parameter create user (type User)) (parameter create used (type I64))
    (returns User) (effect pure) (body (record structural (field handle (field (local user) (name handle))) (field password (field (local user) (name password))) (field display (field (local user) (name display))) (field bio (field (local user) (name bio))) (field admin (field (local user) (name admin))) (field suspended (field (local user) (name suspended))) (field created (field (local user) (name created))) (field failures (field (local user) (name failures))) (field locked (field (local user) (name locked))) (field sessions (field (local user) (name sessions))) (field attention (field (local user) (name attention))) (field muted (field (local user) (name muted))) (field saved (field (local user) (name saved))) (field version (field (local user) (name version))) (field used (local used)))))

  (function create adjust (visibility public)
    (parameter create owner (type Text)) (parameter create delta (type I64))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (if (call std::i64-equal (local delta) (i64 0)) (bool true)
      (let (binding user (call db::user (local owner)))
        (binding old (call postquota::used (local owner)))
        (binding used (call std::add (field (local user) (name used)) (local delta)))
        (binding posts (call std::add (local old) (local delta)))
        (in (if (if (call std::text-equal (field (local user) (name handle)) (local owner))
          (if (call std::less-equal (i64 0) (local used))
            (call std::less-equal (i64 0) (local posts)) (bool false)) (bool false))
          (sequence (call db::save-user (call postquota::user-used (local user) (local used)))
            (call db::put (text "post-used") (local owner) (call std::data-encode (types I64) (local posts))))
          ;; A failed condition aborts the surrounding transaction instead of
          ;; allowing a post or index update with an inconsistent ledger.
          (capability-call service::app::store std::DataStore::delete (static-text "lkjsns-v1")
            (call db::key (text "post-used") (local owner))
            (variant std::DataExpectation::Exact (call std::bytes-from-text (text "")))))))))

  )
  (function create allowed (visibility public)
    (parameter create owner (type Text)) (parameter create delta (type I64))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (if (call std::less-equal (local delta) (i64 0)) (bool true)
      (call std::less-equal (call std::add (field (call db::user (local owner)) (name used)) (local delta))
        (i64 2147483648)))))

  (function create note-delta (visibility public)
    (parameter create note (type Note)) (returns I64)
    (effect (task (requirement service::app::store)))
    (body (call std::subtract
      (call postquota::bytes (text "note") (field (local note) (name id))
        (call std::data-encode (types Note) (local note)))
      (call postquota::stored (text "note") (field (local note) (name id))))))

  (function create save-note (visibility public)
    (parameter create note (type Note)) (returns Bool)
    (effect (task (requirement service::app::store)))
    (body (let (binding delta (call postquota::note-delta (local note)))
      (in (if (call postquota::adjust (field (local note) (name author)) (local delta))
        (call db::save-note (local note)) (bool false))))))

  (function create pref-delta (visibility public)
    (parameter create kind (type Text)) (parameter create id (type Text))
    (parameter create value (type Text)) (returns I64)
    (effect (task (requirement service::app::store)))
    (body (call std::subtract
      (call postquota::bytes (local kind) (local id) (call std::data-encode (types Text) (local value)))
      (call postquota::stored (local kind) (local id)))))

  (function create save-pref (visibility public)
    (parameter create owner (type Text)) (parameter create kind (type Text))
    (parameter create id (type Text)) (parameter create value (type Text))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (let (binding delta (call postquota::pref-delta (local kind) (local id) (local value)))
      (in (if (call postquota::adjust (local owner) (local delta))
        (call db::put (local kind) (local id) (call std::data-encode (types Text) (local value)))
        (bool false))))))

  (function create delete-pref (visibility public)
    (parameter create owner (type Text)) (parameter create kind (type Text)) (parameter create id (type Text))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (let (binding entries (call db::read (local kind) (local id)))
      (in (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local entries)) (i64 0))
        (bool true) (if (call postquota::adjust (local owner)
          (call std::subtract (i64 0) (call postquota::stored (local kind) (local id))))
          (capability-call service::app::store std::DataStore::delete (static-text "lkjsns-v1")
            (call db::key (local kind) (local id)) (call db::expected (local entries)))
          (bool false))))))

  ;; Attribute the encoded ID entry in shared index pages to this post.
  )
  (function create index-bytes (visibility public)
    (parameter create id (type Text)) (returns I64) (effect pure)
    (body (call std::subtract
      (call std::bytes-length (call std::data-encode (types (list Text)) (list Text (local id))))
      (call std::bytes-length (call std::data-encode (types (list Text)) (list Text))))))

  (function create index (visibility public)
    (parameter create owner (type Text)) (parameter create name (type Text)) (parameter create id (type Text))
    (returns Unit) (effect (task (requirement service::app::store)))
    (body (sequence (call postquota::adjust (local owner) (call postquota::index-bytes (local id)))
      (call db::index (local name) (local id)))))

  (test create index-bytes-positive (visibility private)
    (actual (call std::less (i64 0) (call postquota::index-bytes (text "0123456789abcdef"))))
    (expected (bool true)))
)
