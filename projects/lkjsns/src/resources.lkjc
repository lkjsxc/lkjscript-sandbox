=") (call navigation::encode (call util::query (local request) (text "preview")))) (text ""))) (if (call std::text-equal (call util::query (local request) (text "note")) (text "")) (text "") (call std::text-join (list Text (text "&note=") (call navigation::encode (call util::query (local request) (text "note")))) (text ""))) (if (call std::text-equal (call util::query (local request) (text "download")) (text "")) (text "") (call std::text-join (list Text (text "&download=") (call navigation::encode (call util::query (local request) (text "download")))) (text "")))) (text ""))) (text ""))))

