  (function create member-request (visibility public) (parameter create request (type Request)) (returns Request) (effect pure)
    (body (let (binding direction (call paths::member-direction (field (local request) (name path))))
      (binding values (call std::map-insert (types Text (list Text)) (field (local request) (name query_parameters)) (text "user")
        (list Text (call paths::member-id (field (local request) (name path))))))
      (in (record structural (field body (field (local request) (name body))) (field headers (field (local request) (name headers)))
        (field method (field (local request) (name method))) (field query (field (local request) (name query)))
        (field path (if (call std::text-equal (local direction) (text "")) (text "/profile") (text "/attention")))
        (field query_parameters (if (call std::text-equal (local direction) (text "")) (local values)
          (call std::map-insert (types Text (list Text)) (local values) (text "direction") (list Text (local direction))))))))))
  (function create member-legacy (visibility public) (parameter create request (type Request)) (returns Text) (effect pure)
    (body (let (binding path (field (local request) (name path))) (binding user (call util::query (local request) (text "user")))
      (binding direction (call util::query (local request) (text "direction")))
      (in (if (if (call util::handle (local user))
        (if (call std::text-equal (local path) (text "/profile")) (bool true)
          (if (call std::text-equal (local path) (text "/attention")) (call attentionnav::direction (local direction)) (bool false))) (bool false))
        (call paging::with-trail (call std::text-join (list Text (call paths::profile (local user))
          (if (call std::text-equal (local path) (text "/attention")) (call std::text-join (list Text (text "/attention/") (local direction)) (text "")) (text ""))
          (if (call std::text-equal (call util::query (local request) (text "cursor")) (text "")) (text "")
            (call std::text-join (list Text (text "?cursor=") (call navigation::encode (call util::query (local request) (text "cursor")))) (text "")))) (text ""))
          (call util::query (local request) (text "trail"))) (text ""))))))


  (function create legacy-post (visibility public) (parameter create ctx (type Context)) (parameter create request (type Request))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (let (binding note (call db::note (call util::query (local request) (text "id"))))
      (in (if (if (call util::post-id (field (local note) (name id)))
        (if (call access::visible (local ctx) (local note))
          (if (call std::text-equal (field (local request) (name path)) (text "/compose"))
            (call std::text-equal (field (local note) (name author)) (field (local ctx) (name user))) (bool true)) (bool false)) (bool false))
        (call page::redirect (call resources::legacy (local request)))
        (call page::error (i64 404) (text "Post not found.")))))))
