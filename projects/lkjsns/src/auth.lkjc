(module create auth
  (function create origin
    (visibility public)
    (returns Text) (effect (task (requirement service::app::config)))
    (body (capability-call service::app::config std::Configuration::text (static-text "origin"))))

  (function create secure
    (visibility public)
    (returns Bool) (effect (task (requirement service::app::config)))
    (body (call std::text-starts-with (call auth::origin) (text "https://"))))

  (function create cookie-name
    (visibility public)
    (returns Text) (effect (task (requirement service::app::config)))
    (body (if (call auth::secure) (text "__Host-lkjsns=") (text "lkjsns-dev="))))

