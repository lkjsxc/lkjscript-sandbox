(module create searchtext
  (function create boundary (visibility public)
    (parameter create bytes (type Bytes))
    (parameter create end (type I64))
    (returns I64) (effect pure)
    (body (if (call std::less (local end) (call std::bytes-length (local bytes))) (if (if (call std::less-equal (i64 128) (call std::bytes-get (local bytes) (local end))) (if (call std::less (call std::bytes-get (local bytes) (local end)) (i64 192)) (bool true) (bool false)) (bool false)) (call searchtext::boundary (local bytes) (call std::add (local end) (i64 1))) (local end)) (local end))))

  (function create chunks (visibility public)
    (parameter create value (type Text))
    (parameter create start (type I64))
    (parameter create out (type Text))
    (returns Text) (effect pure)
    (body (if (call std::less (local start) (call util::size (local value))) (let (binding end (call searchtext::boundary (call std::bytes-from-text (local value)) (call codec::min (call util::size (local value)) (call std::add (local start) (i64 256))))) (in (call searchtext::chunks (local value) (local end) (call std::text-join (list Text (local out) (call librarypath::lower (call util::slice (local value) (local start) (local end)))) (text ""))))) (local out))))

  (function create fold (visibility public)
    (parameter create value (type Text))
    (returns Text) (effect pure)
    (body (call searchtext::chunks (local value) (i64 0) (text ""))))

  (test create fold-preserves-multibyte (visibility private) (actual (call searchtext::fold (text "Hello 世界 ÉCOLE"))) (expected (text "hello 世界 École")))

  (test create fold-across-chunk-boundary (visibility private) (actual (call searchtext::fold (text "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA日本語Z"))) (expected (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa日本語z")))

)
