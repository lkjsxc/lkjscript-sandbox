(module create paths
  (function create end (visibility public) (parameter create value (type Text)) (parameter create index (type I64))
    (returns I64) (effect pure)
    (body (if (call std::less (local index) (call util::size (local value)))
      (if (call util::has (list Text (text "/") (text "?") (text "&") (text "#"))
        (call util::slice (local value) (local index) (call std::add (local index) (i64 1))) (i64 0))
        (local index) (call paths::end (local value) (call std::add (local index) (i64 1)))) (local index))))
  (function create id (visibility public) (parameter create path (type Text)) (returns Text) (effect pure)
    (body (if (if (call std::text-starts-with (local path) (text "/")) (call std::less-equal (call util::size (local path)) (i64 73)) (bool false))
      (let (binding end (call paths::end (local path) (i64 1))) (binding id (call util::slice (local path) (i64 1) (local end)))
        (binding suffix (call util::slice (local path) (local end) (call util::size (local path))))
        (in (if (call util::post-id (local id))
          (if (call util::has (list Text (text "") (text "/edit") (text "/preview") (text "/raw")) (local suffix) (i64 0)) (local id) (text "")) (text "")))) (text ""))))
  (function create suffix (visibility public) (parameter create path (type Text)) (returns Text) (effect pure)
    (body (let (binding id (call paths::id (local path)))
      (in (if (call std::text-equal (local id) (text "")) (text "")
        (call util::slice (local path) (call std::add (call util::size (local id)) (i64 1)) (call util::size (local path))))))))
  (function create resource (visibility public) (parameter create id (type Text)) (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "/") (local id)) (text ""))))
  (function create post (visibility public) (parameter create id (type Text)) (returns Text) (effect pure)
    (body (call paths::resource (call util::short-id (local id)))))
  (function create profile (visibility public) (parameter create handle (type Text)) (returns Text) (effect pure)
    (body (if (call util::handle (local handle)) (call std::text-join (list Text (text "/@") (local handle)) (text "")) (text "/"))))
  (function create member-id (visibility public) (parameter create path (type Text)) (returns Text) (effect pure)
    (body (if (if (call std::text-starts-with (local path) (text "/@")) (call std::less-equal (call util::size (local path)) (i64 42)) (bool false))
      (let (binding end (call paths::end (local path) (i64 2))) (binding handle (call util::slice (local path) (i64 2) (local end)))
        (binding suffix (call util::slice (local path) (local end) (call util::size (local path))))
        (in (if (call util::handle (local handle)) (if (call util::has (list Text (text "") (text "/attention/to") (text "/attention/from")) (local suffix) (i64 0))
          (local handle) (text "")) (text "")))) (text ""))))
  (function create member-direction (visibility public) (parameter create path (type Text)) (returns Text) (effect pure)
    (body (let (binding handle (call paths::member-id (local path)))
      (in (if (call util::handle (local handle))
        (let (binding suffix (call util::slice (local path) (call std::add (call util::size (local handle)) (i64 2)) (call util::size (local path))))
          (in (if (call std::text-equal (local suffix) (text "/attention/to")) (text "to")
            (if (call std::text-equal (local suffix) (text "/attention/from")) (text "from") (text ""))))) (text ""))))))
  (function create tail (visibility public) (parameter create value (type Text)) (returns Text) (effect pure)
    (body (if (call std::text-starts-with (local value) (text "&"))
      (call std::text-join (list Text (text "?") (call util::slice (local value) (i64 1) (call util::size (local value)))) (text "")) (local value))))
  (function create convert (visibility public) (parameter create value (type Text)) (parameter create prefix (type Text))
    (parameter create suffix (type Text)) (returns Text) (effect pure)
    (body (if (call std::text-starts-with (local value) (local prefix))
      (let (binding end (call paths::end (local value) (call util::size (local prefix))))
        (binding id (call util::slice (local value) (call util::size (local prefix)) (local end)))
        (binding rest (call util::slice (local value) (local end) (call util::size (local value))))
        (binding post (call util::has (list Text (text "/note?id=") (text "/compose?id=")) (local prefix) (i64 0)))
        (in (if (if (local post) (call util::post-id (local id)) (call util::token (local id)))
          (if (if (call std::text-equal (local rest) (text "")) (bool true)
            (if (call std::text-starts-with (local rest) (text "&")) (bool true) (call std::text-starts-with (local rest) (text "#"))))
            (call std::text-join (list Text (if (local post) (call paths::post (local id)) (call paths::resource (local id)))
              (local suffix) (call paths::tail (local rest))) (text "")) (local value)) (local value)))) (local value))))
  (function create canonical-profile (visibility public) (parameter create value (type Text)) (returns Text) (effect pure)
    (body (if (call std::text-starts-with (local value) (text "/profile?user="))
      (let (binding end (call paths::end (local value) (i64 14))) (binding handle (call util::slice (local value) (i64 14) (local end)))
        (binding rest (call util::slice (local value) (local end) (call util::size (local value))))
        (in (if (call util::handle (local handle))
          (call std::text-join (list Text (call paths::profile (local handle)) (call paths::tail (local rest))) (text "")) (local value)))) (local value))))
  (function create canonical (visibility public) (parameter create value (type Text)) (returns Text) (effect pure)
    (body (call paths::canonical-profile (call paths::convert (call paths::convert (call paths::convert
      (call paths::convert (local value) (text "/note?id=") (text "")) (text "/file?id=") (text ""))
      (text "/compose?id=") (text "/edit")) (text "/media?id=") (text "/raw")))))
  (test create root-id (visibility private) (actual (call paths::id (text "/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))) (expected (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))
  (test create short-resource (visibility private) (actual (call paths::id (text "/0123456789abcdef"))) (expected (text "0123456789abcdef")))
  (test create short-edit (visibility private) (actual (call paths::suffix (text "/0123456789abcdef/edit"))) (expected (text "/edit")))
  (test create reject-reserved (visibility private) (actual (call paths::id (text "/settings"))) (expected (text "")))
  (test create reject-suffix (visibility private) (actual (call paths::id (text "/0123456789abcdef/missing"))) (expected (text "")))
  (test create note-query (visibility private) (actual (call paths::canonical (text "/note?id=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff&cursor=30#conversation"))) (expected (text "/zzzzzzzzzzzzzzzz?cursor=30#conversation")))
  (test create media-id-not-shortened (visibility private) (actual (call paths::canonical (text "/file?id=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa&draft=0123456789abcdef"))) (expected (text "/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa?draft=0123456789abcdef")))
  (test create short-edit-query (visibility private) (actual (call paths::canonical (text "/compose?id=0123456789abcdef&preview=1"))) (expected (text "/0123456789abcdef/edit?preview=1")))
  (test create profile-query (visibility private) (actual (call paths::canonical (text "/profile?user=alice&cursor=30&trail=_"))) (expected (text "/@alice?cursor=30&trail=_")))
  (test create profile-path-handle (visibility private) (actual (call paths::member-id (text "/@alice"))) (expected (text "alice")))
  (test create attention-path (visibility private) (actual (call paths::member-id (text "/@alice/attention/from"))) (expected (text "alice")))
  (test create attention-direction (visibility private) (actual (call paths::member-direction (text "/@alice/attention/from"))) (expected (text "from")))
  (test create profile-reject-tail (visibility private) (actual (call paths::member-id (text "/@alice/settings"))) (expected (text "")))
  (test create profile-reject-query-in-path (visibility private) (actual (call paths::member-id (text "/@alice?user=bravo"))) (expected (text "")))
  (test create profile-reject-network-path (visibility private) (actual (call paths::member-id (text "//@alice"))) (expected (text "")))
  (test create invalid-id-unchanged (visibility private) (actual (call paths::canonical (text "/note?id=bad"))) (expected (text "/note?id=bad")))

(test create edit-id (visibility private) (actual (call paths::id (text "/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/edit"))) (expected (text "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")))

(test create file-context (visibility private) (actual (call paths::canonical (text "/file?id=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa&draft=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"))) (expected (text "/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa?draft=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")))

(test create edit-query (visibility private) (actual (call paths::canonical (text "/compose?id=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa&preview=1"))) (expected (text "/nananananananana/edit?preview=1")))

(test create non-resource-unchanged (visibility private) (actual (call paths::canonical (text "/pick?draft=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))) (expected (text "/pick?draft=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))
)
