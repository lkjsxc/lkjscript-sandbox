(module create postsearch
  (function create candidate (visibility private) (parameter create request (type Request))
    (parameter create index (type I64)) (parameter create query (type Text)) (returns PostSearchCandidate)
    (effect (task (requirement service::app::store) (requirement service::app::config) (requirement service::app::clock)))
    (body (let (binding ctx (call auth::context (local request)))
      (binding viewer (if (call util::signed (local ctx)) (call db::user (field (local ctx) (name user))) (call db::empty-user)))
      (binding id (if (if (call std::less-equal (i64 0) (local index))
          (call std::less (local index) (call db::count (text "timeline"))) (bool false))
        (call postindex::item (text "timeline") (local index)) (text "")))
      (binding note (call db::note (local id))) (binding ref (call postblob::reference (field (local note) (name id))))
      (binding stage (call postblob::read (local ref)))
      (binding indexed (call preferences::read (text "search-text") (field (local note) (name id))))
      (binding preview (if (call std::text-equal (local indexed) (text ""))
        (call searchtext::fold (call std::text-join (list Text (field (local note) (name body)) (text " ") (field (local note) (name cw))) (text "")))
        (local indexed)))
      (binding valid (if (if (field (local note) (name published))
        (call std::bool-not (call std::text-starts-with (field (local note) (name audience)) (text "link:"))) (bool false))
        (if (call access::visible (local ctx) (local note))
          (if (call std::bool-not (call util::has (field (local viewer) (name muted)) (field (local note) (name author)) (i64 0)))
            (if (call std::text-equal (field (local stage) (name state)) (text "linked"))
              (if (call std::text-equal (field (local stage) (name post)) (field (local note) (name id)))
                (if (call std::text-equal (field (local stage) (name owner)) (field (local note) (name author)))
                  (call std::bool-not (call std::text-contains (local preview) (local query))) (bool false))
                (bool false)) (bool false)) (bool false)) (bool false)) (bool false)))
      (in (record structural (field valid (local valid)) (field note (local note)) (field stage (local stage))
        (field ctx (local ctx)) (field viewer (local viewer))))))

  )
  (function create inspect (visibility private) (parameter create request (type Request))
    (parameter create index (type I64)) (parameter create query (type Text)) (parameter create blob (type Text))
    (parameter create version (type I64)) (parameter create found (type Bool)) (returns PostSearchCheck)
    (effect (task (requirement service::app::store) (requirement service::app::config) (requirement service::app::clock)))
    (body (let (binding current (call postsearch::candidate (local request) (local index) (local query)))
      (binding note (field (local current) (name note))) (binding stage (field (local current) (name stage)))
      (binding valid (if (field (local current) (name valid))
        (if (call std::text-equal (field (local stage) (name id)) (local blob))
          (call std::i64-equal (field (local note) (name version)) (local version)) (bool false)) (bool false)))
      (in (record structural (field valid (local valid))
        (field rows (if (if (local valid) (local found) (bool false))
          (call journalview::card (field (local current) (name ctx)) (local note) (field (local current) (name viewer))
            (call std::text-join (list Text (text "thread:") (field (local note) (name id))) (text "")) (text "") (text ""))
          (text "")))))))

  )
  (function create next-url (visibility private) (parameter create query (type Text))
    (parameter create index (type I64)) (parameter create offset (type I64)) (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "/search-long?q=") (call navigation::encode (local query))
      (text "&cursor=") (call std::i64-to-text (local index)) (text "&offset=") (call std::i64-to-text (local offset))) (text ""))))

  (function create page (visibility private) (parameter create ctx (type Context)) (parameter create query (type Text))
    (parameter create rows (type Text)) (parameter create index (type I64)) (parameter create offset (type I64))
    (returns Response) (effect pure)
    (body (call page::ok (local ctx) (text "Search")
      (call std::text-join (list Text
        (text "<section class=\"search-results long-post-search\"><h2>Search long posts</h2><p class=\"field-help\">")
        (text "Searching for ") (call std::html-escape-text (local query)) (text "</p><div class=\"feed\">")
        (if (call std::text-equal (local rows) (text ""))
          (if (call std::less-equal (i64 0) (local index)) (text "<p class=\"empty\">Continue searching through long posts.</p>")
            (text "<p class=\"empty\">No more long posts to search.</p>")) (local rows))
        (text "</div><nav class=\"pagination\" aria-label=\"Long post search\">")
        (if (call std::less-equal (i64 0) (local index))
          (call std::text-join (list Text (text "<a class=\"button\" rel=\"next\" href=\"")
            (call std::html-escape-text (call postsearch::next-url (local query) (local index) (local offset)))
            (text "\">Continue searching</a>")) (text "")) (text ""))
        (text "<a class=\"button\" href=\"/search?q=") (call std::html-escape-text (call navigation::encode (local query)))
        (text "\">Back to search</a></nav></section>")) (text "")))))

  (function create walk (visibility private) (parameter create request (type Request))
    (parameter create query (type Text)) (parameter create folded (type Text)) (parameter create index (type I64))
    (parameter create offset (type I64)) (parameter create budget (type I64)) (parameter create skips (type I64))
    (returns Response) (effect (task (requirement service::app::store) (requirement service::app::config)
      (requirement service::app::clock) (requirement service::app::objects)))
    (body (if (if (call std::less-equal (i64 0) (local index))
      (if (call std::less (i64 0) (local budget)) (call std::less (i64 0) (local skips)) (bool false)) (bool false))
      (match (transaction-outcome service::app::store (types PostSearchCandidate)
        (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
          std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
        (binding transaction) (call postsearch::candidate (local request) (local index) (local folded)))
        (arm std::TransactionOutcome::Committed (payload item PostSearchCandidate)
          (if (field (local item) (name valid))
            (let (binding stage (field (local item) (name stage))) (binding note (field (local item) (name note)))
              (in (if (call std::less (local offset) (field (local stage) (name size)))
                (let (binding start (if (call std::less (i64 123) (local offset)) (call std::subtract (local offset) (i64 123)) (i64 0)))
                  (binding end (call codec::min (field (local stage) (name size))
                    (call std::add (local offset) (i64 65659))))
                  (binding data (call postread::range (local stage) (local start) (call std::subtract (local end) (local start))))
                  (binding first (call searchtext::boundary (local data) (i64 0)))
                  (binding last (if (call std::i64-equal (local end) (field (local stage) (name size)))
                    (call std::bytes-length (local data))
                    (call searchtext::boundary (local data) (call std::subtract (call std::bytes-length (local data)) (i64 3)))))
                  (binding decoded (call std::bytes-to-text-result (call std::bytes-slice (local data) (local first) (local last))))
                  (in (if (field (local decoded) (name valid))
                    (let (binding text (call std::text-join (list Text (field (local decoded) (name value))
                        (if (call std::i64-equal (local end) (field (local stage) (name size)))
                          (call std::text-join (list Text (text " ") (field (local note) (name cw))) (text "")) (text ""))) (text "")))
                      (binding found (call std::text-contains (call searchtext::fold (local text)) (local folded)))
                      (in (match (transaction-outcome service::app::store (types PostSearchCheck)
                        (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
                          std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
                        (binding transaction) (call postsearch::inspect (local request) (local index) (local folded)
                          (field (local stage) (name id)) (field (local note) (name version)) (local found)))
                        (arm std::TransactionOutcome::Committed (payload check PostSearchCheck)
                          (if (field (local check) (name valid))
                            (if (local found)
                              (call postsearch::page (field (local item) (name ctx)) (local query) (field (local check) (name rows))
                                (call std::subtract (local index) (i64 1)) (i64 0))
                              (if (call std::less (call std::add (local offset) (i64 65536)) (field (local stage) (name size)))
                                (call postsearch::walk (local request) (local query) (local folded) (local index)
                                  (call std::add (local offset) (i64 65536)) (call std::subtract (local budget) (i64 1)) (local skips))
                                (call postsearch::walk (local request) (local query) (local folded) (call std::subtract (local index) (i64 1))
                                  (i64 0) (call std::subtract (local budget) (i64 1)) (call std::subtract (local skips) (i64 1)))))
                            (call postsearch::page (field (local item) (name ctx)) (local query) (text "") (local index) (i64 0))))
                        (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason)
                          (call page::error (i64 409) (text "The search changed while loading. Try again."))))))
                    (call page::error (i64 503) (text "A post body could not be verified.")))))
                (call postsearch::walk (local request) (local query) (local folded) (call std::subtract (local index) (i64 1))
                  (i64 0) (local budget) (call std::subtract (local skips) (i64 1))))))
            (call postsearch::walk (local request) (local query) (local folded) (call std::subtract (local index) (i64 1))
              (i64 0) (local budget) (call std::subtract (local skips) (i64 1)))))
        (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason)
          (call page::error (i64 409) (text "The search changed while loading. Try again."))))
      (call postsearch::page (call auth::context (local request)) (local query) (text "") (local index) (local offset)))))

  (function create view (visibility public) (parameter create request (type Request)) (returns Response)
    (effect (task (requirement service::app::store) (requirement service::app::config)
      (requirement service::app::clock) (requirement service::app::objects)))
    (body (let (binding trimmed (call util::trim (call util::query (local request) (text "q")) (i64 0)))
      (binding query (call tags::trim-end (local trimmed) (call util::size (local trimmed))))
      (binding index (if (call std::text-equal (call util::query (local request) (text "cursor")) (text ""))
        (call std::subtract (call db::count (text "timeline")) (i64 1))
        (call util::number (call util::query (local request) (text "cursor")) (i64 2147483647))))
      (binding offset (if (call std::text-equal (call util::query (local request) (text "offset")) (text "")) (i64 0)
        (call util::number (call util::query (local request) (text "offset")) (i64 2147483648))))
      (in (if (if (call util::clean (local query) (i64 1) (i64 120))
          (call std::less-equal (i64 0) (local offset)) (bool false))
        (call postsearch::walk (local request) (local query) (call searchtext::fold (local query)) (local index) (local offset) (i64 4) (i64 30))
        (call page::error (i64 400) (text "Use a search query of up to 120 bytes.")))))))
)
