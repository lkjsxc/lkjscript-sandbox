(module create textinput
  (function create allowed (visibility private)
    (parameter create byte (type I64))
    (returns Bool) (effect pure)
    (body (if (call std::i64-equal (local byte) (i64 127)) (bool false)
      (if (call std::less-equal (i64 32) (local byte)) (bool true)
        (if (call std::i64-equal (local byte) (i64 9)) (bool true)
          (if (call std::i64-equal (local byte) (i64 10)) (bool true)
            (call std::i64-equal (local byte) (i64 13))))))))

  (function create valid-walk (visibility private)
    (parameter create data (type Bytes)) (parameter create index (type I64))
    (returns Bool) (effect pure)
    (body (if (call std::less (local index) (call std::bytes-length (local data)))
      (if (call textinput::allowed (call std::bytes-get (local data) (local index)))
        (call textinput::valid-walk (local data) (call std::add (local index) (i64 1)))
        (bool false))
      (bool true))))

  ;; Search for the small forbidden ASCII set in native text operations. This
  ;; avoids an interpreter call for every byte of an otherwise valid long post.
  (function create forbidden (visibility private)
    (parameter create value (type Text)) (parameter create byte (type I64))
    (returns Bool) (effect pure)
    (body (if (call std::less (local byte) (i64 32))
      (if (call textinput::allowed (local byte))
        (call textinput::forbidden (local value) (call std::add (local byte) (i64 1)))
        (if (call std::text-contains (local value)
              (call std::bytes-to-text (call std::bytes-from-list (list I64 (local byte)))))
          (bool true) (call textinput::forbidden (local value) (call std::add (local byte) (i64 1)))))
      (call std::text-contains (local value)
        (call std::bytes-to-text (call std::bytes-from-list (list I64 (i64 127))))))))

  (function create valid (visibility public)
    (parameter create data (type Bytes))
    (returns Bool) (effect pure)
    (body (let (binding decoded (call std::bytes-to-text-result (local data)))
      (in (if (field (local decoded) (name valid))
        (call std::bool-not (call textinput::forbidden (field (local decoded) (name value)) (i64 0)))
        (bool false))))))

  (function create normal-walk (visibility private)
    (parameter create data (type Bytes)) (parameter create index (type I64))
    (parameter create start (type I64)) (parameter create out (type (list Text)))
    (returns Text) (effect pure)
    (body (if (call std::less (local index) (call std::bytes-length (local data)))
      (if (call std::i64-equal (call std::bytes-get (local data) (local index)) (i64 13))
        (let (binding next (if (call std::less (call std::add (local index) (i64 1))
              (call std::bytes-length (local data)))
            (if (call std::i64-equal
                (call std::bytes-get (local data) (call std::add (local index) (i64 1)))
                (i64 10))
              (call std::add (local index) (i64 2)) (call std::add (local index) (i64 1)))
            (call std::add (local index) (i64 1))))
          (in (call textinput::normal-walk (local data) (local next) (local next)
            (call std::list-append (types Text)
              (call std::list-append (types Text) (local out)
                (call std::bytes-to-text (call std::bytes-slice (local data) (local start) (local index))))
              (text "\n")))))
        (call textinput::normal-walk (local data) (call std::add (local index) (i64 1))
          (local start) (local out)))
      (call std::text-join (call std::list-append (types Text) (local out)
        (call std::bytes-to-text (call std::bytes-slice (local data) (local start)
          (call std::bytes-length (local data))))) (text "")))))

  (function create normalize (visibility public)
    (parameter create value (type Text))
    (returns Text) (effect pure)
    (body (let (binding data (call std::bytes-from-text (local value)))
      (in (if (call textinput::valid (local data))
        (if (call std::text-contains (local value) (text "\r"))
          (call textinput::normal-walk (local data) (i64 0) (i64 0) (list Text))
          (local value))
        (text ""))))))

  (function create sample (visibility private)
    (parameter create count (type I64))
    (returns Text) (effect pure)
    (body (if (call std::less-equal (local count) (i64 0)) (text "")
      (if (call std::i64-equal (local count) (i64 1)) (text "x")
        (let (binding half (call std::divide (local count) (i64 2)))
          (binding part (call textinput::sample (local half)))
          (in (call std::text-join (list Text (local part) (local part)
            (if (call std::i64-equal (call std::multiply (local half) (i64 2)) (local count))
              (text "") (text "x"))) (text ""))))))))

  (test create input-empty (visibility private)
    (actual (call textinput::valid (call std::bytes-from-text (text "")))) (expected (bool true)))
  (test create input-ascii (visibility private)
    (actual (call textinput::valid (call std::bytes-from-text (text "Plain text")))) (expected (bool true)))
  (test create input-unicode (visibility private)
    (actual (call textinput::valid (call std::bytes-from-text (text "日本語🌱")))) (expected (bool true)))
  (test create input-whitespace (visibility private)
    (actual (call textinput::valid (call std::bytes-from-text (text "a\r\nb\rc\nd\t")))) (expected (bool true)))
  (test create input-nul (visibility private)
    (actual (call textinput::valid (call std::bytes-from-list (list I64 (i64 97) (i64 0) (i64 98))))) (expected (bool false)))
  (test create input-del (visibility private)
    (actual (call textinput::valid (call std::bytes-from-list (list I64 (i64 97) (i64 127) (i64 98))))) (expected (bool false)))
  (test create input-escape (visibility private)
    (actual (call textinput::valid (call std::bytes-from-list (list I64 (i64 27) (i64 91) (i64 109))))) (expected (bool false)))
  (test create input-vertical-tab (visibility private)
    (actual (call textinput::valid (call std::bytes-from-list (list I64 (i64 97) (i64 11) (i64 98))))) (expected (bool false)))
  (test create input-actual-limit (visibility private)
    (actual (call textinput::valid (call std::bytes-from-text (call textinput::sample (i64 16000))))) (expected (bool true)))
  (test create input-over-previous-limit (visibility private)
    (actual (call textinput::valid (call std::bytes-from-text (call textinput::sample (i64 16001))))) (expected (bool true)))
  (test create input-invalid-utf8 (visibility private)
    (actual (call textinput::valid (call std::bytes-from-list (list I64 (i64 255))))) (expected (bool false)))
  (test create normalize-mixed (visibility private)
    (actual (call textinput::normalize (text "a\r\nb\rc\nd\t"))) (expected (text "a\nb\nc\nd\t")))
  (test create normalize-unicode (visibility private)
    (actual (call textinput::normalize (text "日本語\r\n🌱\r終"))) (expected (text "日本語\n🌱\n終")))
  (test create normalize-cr-boundary (visibility private)
    (actual (call textinput::normalize (call std::text-join (list Text (call textinput::sample (i64 4095)) (text "\r\n終")) (text ""))))
    (expected (call std::text-join (list Text (call textinput::sample (i64 4095)) (text "\n終")) (text ""))))
  (test create normalize-valid-long (visibility private)
    (actual (call textinput::normalize (call textinput::sample (i64 16000))))
    (expected (call textinput::sample (i64 16000))))
  (test create normalize-invalid (visibility private)
    (actual (call textinput::normalize (call std::bytes-to-text (call std::bytes-from-list (list I64 (i64 97) (i64 0) (i64 98))))))
    (expected (text "")))
)
