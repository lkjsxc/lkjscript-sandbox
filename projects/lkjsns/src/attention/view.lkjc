(module create attentionview
  (function create visible (visibility public) (parameter create viewer (type User)) (parameter create source (type User))
    (parameter create target (type User)) (parameter create subject (type Text)) (parameter create direction (type Text))
    (returns Bool) (effect pure)
    (body (if (call util::handle (field (local source) (name handle)))
      (if (call util::handle (field (local target) (name handle)))
        (if (field (local source) (name suspended)) (bool false)
          (if (field (local target) (name suspended)) (bool false)
            (let (binding person (if (call std::text-equal (local direction) (text "from"))
              (field (local source) (name handle)) (field (local target) (name handle))))
              (in (if (if (call std::text-equal (local subject) (field (local viewer) (name handle)))
                (call std::text-equal (local direction) (text "to")) (bool false)) (bool true)
                (call std::bool-not (call util::has (field (local viewer) (name muted)) (local person) (i64 0))))))))
        (bool false)) (bool false))))

  (function create rows (visibility public) (parameter create ctx (type Context)) (parameter create viewer (type User))
    (parameter create ids (type (list Text))) (parameter create index (type I64)) (parameter create subject (type Text))
    (parameter create direction (type Text)) (parameter create request (type Request)) (parameter create out (type Text))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (if (call std::less (local index) (call std::list-length (types Text) (local ids)))
      (let (binding event (call attentionstore::event (call std::list-get (types Text) (local ids) (local index))))
        (binding source (call db::user (field (local event) (name owner))))
        (binding target (call db::user (field (local event) (name target))))
        (binding correct (call std::text-equal (local subject) (if (call std::text-equal (local direction) (text "from"))
          (field (local event) (name target)) (field (local event) (name owner)))))
        (in (call attentionview::rows (local ctx) (local viewer) (local ids) (call std::add (local index) (i64 1))
          (local subject) (local direction) (local request)
          (if (if (local correct)
            (if (call attentionview::visible (local viewer) (local source) (local target) (local subject) (local direction))
              (call attentionstore::active (local event) (local source)) (bool false)) (bool false))
            (call std::text-join (list Text (local out) (call attentionui::row (local ctx) (local viewer)
              (if (call std::text-equal (local direction) (text "from")) (local source) (local target))
              (local subject) (local direction) (local request))) (text "")) (local out)))))
      (local out))))

  (function create collection (visibility public) (parameter create ctx (type Context)) (parameter create viewer (type User))
    (parameter create subject (type Text)) (parameter create direction (type Text)) (parameter create cursor (type Text))
    (parameter create remaining (type I64)) (parameter create request (type Request))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (let (binding listing (call db::listing (call attentionstore::index-name (local subject) (local direction)) (local cursor) (i64 30)))
      (binding rows (call attentionview::rows (local ctx) (local viewer) (field (local listing) (name ids)) (i64 0)
        (local subject) (local direction) (local request) (text "")))
      (binding base (call attentionnav::base (local subject) (local direction)))
      (in (if (call activity::scan-next (local rows) (field (local listing) (name next)) (local remaining))
        (call attentionview::collection (local ctx) (local viewer) (local subject) (local direction)
          (call std::i64-to-text (field (local listing) (name next))) (call std::subtract (local remaining) (i64 1)) (local request))
        (call std::text-join (list Text (call paging::previous (local request) (local base))
          (text "<section class=\"panel attention-list\" aria-label=\"") (call attentionnav::label (local direction)) (text "\">")
          (if (call std::text-equal (local rows) (text ""))
            (if (call std::less-equal (i64 0) (field (local listing) (name next)))
              (call page::empty (text "No people on this page") (text "Continue to the next page to see more attention relationships.") (text "") (text ""))
              (call page::empty (text "No people to show")
                (if (call std::text-equal (local direction) (text "from"))
                  (text "Attention from people will appear here.") (text "People given attention will appear here."))
                (text "/people") (text "Find people"))) (local rows))
          (text "</section>") (call paging::next (local request) (field (local listing) (name next)) (local base))) (text "")))))))

  (function create view (visibility public) (parameter create ctx (type Context)) (parameter create request (type Request))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (if (call util::signed (local ctx))
      (let (binding subject (call util::query (local request) (text "user")))
        (binding direction (call util::query (local request) (text "direction")))
        (in (if (if (call util::handle (local subject))
          (if (call attentionnav::direction (local direction))
            (call navigation::reading-cursor (call util::query (local request) (text "cursor"))) (bool false)) (bool false))
          (let (binding user (call db::user (local subject))) (binding viewer (call db::user (field (local ctx) (name user))))
            (in (if (if (call util::handle (field (local user) (name handle))) (call std::bool-not (field (local user) (name suspended))) (bool false))
              (if (field (call attentionmigration::progress) (name done))
                (call page::ok-at (local ctx)
                  (call std::text-join (list Text (call attentionnav::label (local direction)) (text " · @") (local subject)) (text ""))
                  (text "Profile")
                  (call std::text-join (list Text (text "<section class=\"panel attention-heading\">")
                    (call accounts::member (local user)) (text "</section><nav class=\"tabs attention-tabs\" aria-label=\"Attention direction\">")
                    (call page::link (call paging::root (call attentionnav::base (local subject) (text "to"))) (text "Attention to") (text "") (call std::text-equal (local direction) (text "to")))
                    (call page::link (call paging::root (call attentionnav::base (local subject) (text "from"))) (text "Attention from") (text "") (call std::text-equal (local direction) (text "from")))
                    (text "</nav>") (call attentionview::collection (local ctx) (local viewer) (local subject) (local direction)
                      (call util::query (local request) (text "cursor")) (i64 4) (local request))) (text "")))
                (call page::error (i64 503) (text "Attention lists are being prepared. Please try again shortly.")))
              (call page::error (i64 404) (text "Member not found.")))))
          (call page::error (i64 400) (text "Choose a member and an attention direction.")))))
      (call page::redirect (text "/login")))))
)
