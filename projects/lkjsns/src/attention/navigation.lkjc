(module create attentionnav
  (function create direction (visibility public) (parameter create value (type Text))
    (returns Bool) (effect pure)
    (body (call util::has (list Text (text "to") (text "from")) (local value) (i64 0))))

  (function create label (visibility public) (parameter create direction (type Text))
    (returns Text) (effect pure)
    (body (if (call std::text-equal (local direction) (text "from")) (text "Attention from") (text "Attention to"))))

  (function create base (visibility public) (parameter create subject (type Text)) (parameter create direction (type Text))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "/attention?user=") (local subject) (text "&direction=") (local direction) (text "&")) (text ""))))

  (function create valid (visibility public) (parameter create subject (type Text)) (parameter create direction (type Text))
    (parameter create cursor (type Text)) (parameter create trail (type Text)) (parameter create target (type Text))
    (returns Bool) (effect pure)
    (body (if (call util::handle (local subject))
      (if (call util::handle (local target))
        (if (call navigation::reading-cursor (local cursor))
          (if (call paging::valid-trail (local trail))
            (if (call attentionnav::direction (local direction)) (bool true)
              (if (call std::text-equal (local direction) (text "profile"))
                (if (call std::text-equal (local subject) (local target))
                  (if (call std::text-equal (local cursor) (text "")) (call std::text-equal (local trail) (text "")) (bool false))
                  (bool false)) (bool false)))
            (bool false)) (bool false)) (bool false)) (bool false))))

  (function create form-valid (visibility public) (parameter create form (type Form))
    (returns Bool) (effect pure)
    (body (call attentionnav::valid (call util::value (local form) (text "subject"))
      (call util::value (local form) (text "direction")) (call util::value (local form) (text "cursor"))
      (call util::value (local form) (text "trail")) (call util::value (local form) (text "handle")))))

  (function create return-to (visibility public) (parameter create subject (type Text)) (parameter create direction (type Text))
    (parameter create cursor (type Text)) (parameter create trail (type Text)) (parameter create target (type Text))
    (returns Text) (effect pure)
    (body (if (call attentionnav::valid (local subject) (local direction) (local cursor) (local trail) (local target))
      (if (call std::text-equal (local direction) (text "profile"))
        (call std::text-join (list Text (text "/profile?user=") (local subject)) (text ""))
        (call paging::with-trail (call std::text-join (list Text
          (call paging::root (call attentionnav::base (local subject) (local direction)))
          (if (call std::text-equal (local cursor) (text "")) (text "")
            (call std::text-join (list Text (text "&cursor=") (local cursor)) (text "")))
          (text "#attention-") (local target)) (text "")) (local trail)))
      (text "/"))))

  (function create form-return (visibility public) (parameter create form (type Form))
    (returns Text) (effect pure)
    (body (call attentionnav::return-to (call util::value (local form) (text "subject"))
      (call util::value (local form) (text "direction")) (call util::value (local form) (text "cursor"))
      (call util::value (local form) (text "trail")) (call util::value (local form) (text "handle")))))

  (test create preserve-direction-page-and-trail (visibility private)
    (actual (call attentionnav::return-to (text "alice") (text "from") (text "20") (text "_.50") (text "bravo")))
    (expected (text "/attention?user=alice&direction=from&cursor=20&trail=_.50#attention-bravo")))
  (test create profile-return (visibility private)
    (actual (call attentionnav::return-to (text "bravo") (text "profile") (text "") (text "") (text "bravo")))
    (expected (text "/profile?user=bravo")))
  (test create reject-external-subject (visibility private)
    (actual (call attentionnav::return-to (text "//evil.test") (text "from") (text "") (text "") (text "bravo"))) (expected (text "/")))
  (test create reject-direction-injection (visibility private)
    (actual (call attentionnav::valid (text "alice") (text "to&user=evil") (text "") (text "") (text "bravo"))) (expected (bool false)))
  (test create reject-negative-cursor (visibility private)
    (actual (call attentionnav::valid (text "alice") (text "to") (text "-1") (text "") (text "bravo"))) (expected (bool false)))
  (test create reject-profile-context-confusion (visibility private)
    (actual (call attentionnav::valid (text "alice") (text "profile") (text "") (text "") (text "bravo"))) (expected (bool false)))
  (test create reject-arbitrary-trail (visibility private)
    (actual (call attentionnav::valid (text "alice") (text "to") (text "") (text "https://evil.test") (text "bravo"))) (expected (bool false)))
)
