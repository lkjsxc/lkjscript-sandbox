(module create attentionstore
  (function create pair (visibility public) (parameter create owner (type Text)) (parameter create target (type Text))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (local owner) (text "/") (local target)) (text ""))))

  (function create index-name (visibility public) (parameter create owner (type Text)) (parameter create direction (type Text))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "attention-") (local direction) (text "/") (local owner)) (text ""))))

  (function create current (visibility public) (parameter create owner (type Text)) (parameter create target (type Text))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (let (binding rows (call db::read (text "attention-current") (call attentionstore::pair (local owner) (local target))))
      (in (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local rows)) (i64 0)) (text "")
        (call std::data-decode-or (types Text) (field (call std::list-get (types std::DataEntry) (local rows) (i64 0)) std::DataEntry::value) (text "")))))))

  (function create empty (visibility public) (returns AttentionEvent) (effect pure)
    (body (record structural (field id (text "")) (field owner (text "")) (field target (text "")))))

  (function create event (visibility public) (parameter create id (type Text))
    (returns AttentionEvent) (effect (task (requirement service::app::store)))
    (body (let (binding rows (call db::read (text "attention-event") (local id)))
      (in (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local rows)) (i64 0)) (call attentionstore::empty)
        (call std::data-decode-or (types AttentionEvent) (field (call std::list-get (types std::DataEntry) (local rows) (i64 0)) std::DataEntry::value) (call attentionstore::empty)))))))

  (function create valid-pair (visibility public) (parameter create owner (type Text)) (parameter create target (type Text))
    (returns Bool) (effect pure)
    (body (if (call util::handle (local owner)) (if (call util::handle (local target))
      (call std::bool-not (call std::text-equal (local owner) (local target))) (bool false)) (bool false))))

  (function create set (visibility public) (parameter create owner (type Text)) (parameter create target (type Text)) (parameter create enabled (type Bool))
    (returns Unit) (effect (task (requirement service::app::store)))
    (body (if (call attentionstore::valid-pair (local owner) (local target))
      (let (binding current (call attentionstore::current (local owner) (local target)))
        (in (if (local enabled)
          (if (call std::text-equal (local current) (text ""))
            (let (binding incoming (call attentionstore::index-name (local target) (text "from")))
              (binding id (call util::digest (call std::text-join (list Text (text "attention/v1/")
                (call attentionstore::pair (local owner) (local target)) (text "/")
                (call std::i64-to-text (call db::count (local incoming)))) (text ""))))
              (in (sequence
                (call db::put (text "attention-event") (local id) (call std::data-encode (types AttentionEvent)
                  (record structural (field id (local id)) (field owner (local owner)) (field target (local target)))))
                (call db::index (call attentionstore::index-name (local owner) (text "to")) (local id))
                (call db::index (local incoming) (local id))
                (call db::put (text "attention-current") (call attentionstore::pair (local owner) (local target)) (call std::data-encode (types Text) (local id)))
                (unit)))) (unit))
          (if (call std::text-equal (local current) (text "")) (unit)
            (sequence (call db::put (text "attention-current") (call attentionstore::pair (local owner) (local target)) (call std::data-encode (types Text) (text ""))) (unit))))))
      (unit))))

  (function create active (visibility public) (parameter create event (type AttentionEvent)) (parameter create source (type User))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (if (call util::token (field (local event) (name id)))
      (if (call std::text-equal (field (local source) (name handle)) (field (local event) (name owner)))
        (if (call util::has (field (local source) (name attention)) (field (local event) (name target)) (i64 0))
          (call std::text-equal (field (local event) (name id)) (call attentionstore::current (field (local event) (name owner)) (field (local event) (name target))))
          (bool false)) (bool false)) (bool false))))

  (test create direction-index-is-distinct (visibility private)
    (actual (call std::text-equal (call attentionstore::index-name (text "alice") (text "to")) (call attentionstore::index-name (text "alice") (text "from")))) (expected (bool false)))
  (test create reject-self-attention (visibility private)
    (actual (call attentionstore::valid-pair (text "alice") (text "alice"))) (expected (bool false)))
  (test create reject-path-injection (visibility private)
    (actual (call attentionstore::valid-pair (text "alice/target") (text "bravo"))) (expected (bool false)))
  (test create accept-directional-pair (visibility private)
    (actual (call attentionstore::valid-pair (text "alice") (text "bravo"))) (expected (bool true)))
)
