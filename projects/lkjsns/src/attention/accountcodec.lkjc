(module create accountcodec
  (function create empty (visibility public) (returns User) (effect pure)
    (body (record structural (field handle (text "")) (field password (text ""))
      (field display (text "")) (field bio (text "")) (field admin (bool false))
      (field suspended (bool false)) (field created (i64 0)) (field failures (i64 0))
      (field locked (i64 0)) (field sessions (list Text)) (field attention (list Text))
      (field muted (list Text)) (field saved (list Text)) (field used (i64 0)) (field version (i64 -1)))))

  (function create legacy-empty (visibility public) (returns LegacyUser) (effect pure)
    (body (record structural (field handle (text "")) (field password (text ""))
      (field display (text "")) (field bio (text "")) (field admin (bool false))
      (field suspended (bool false)) (field created (i64 0)) (field failures (i64 0))
      (field locked (i64 0)) (field sessions (list Text)) (field following (list Text))
      (field muted (list Text)) (field saved (list Text)) (field used (i64 0)) (field version (i64 -1)))))

  (function create convert (visibility public) (parameter create user (type LegacyUser))
    (returns User) (effect pure)
    (body (record structural (field handle (field (local user) (name handle)))
      (field password (field (local user) (name password))) (field display (field (local user) (name display)))
      (field bio (field (local user) (name bio))) (field admin (field (local user) (name admin)))
      (field suspended (field (local user) (name suspended))) (field created (field (local user) (name created)))
      (field failures (field (local user) (name failures))) (field locked (field (local user) (name locked)))
      (field sessions (field (local user) (name sessions))) (field attention (field (local user) (name following)))
      (field muted (field (local user) (name muted))) (field saved (field (local user) (name saved)))
      (field used (field (local user) (name used))) (field version (field (local user) (name version))))))

  (function create read (visibility public) (parameter create bytes (type Bytes))
    (returns User) (effect pure)
    (body (let (binding current (call std::data-decode-or (types User) (local bytes) (call accountcodec::empty)))
      (in (if (call util::handle (field (local current) (name handle))) (local current)
        (call accountcodec::convert (call std::data-decode-or (types LegacyUser) (local bytes) (call accountcodec::legacy-empty))))))))

  (function create notice (visibility public) (parameter create value (type Notice))
    (returns Notice) (effect pure)
    (body (record structural (field actor (field (local value) (name actor)))
      (field kind (if (call std::text-equal (field (local value) (name kind)) (text "follow"))
        (text "attention") (field (local value) (name kind))))
      (field note (field (local value) (name note))) (field at (field (local value) (name at))))))

  (function create fixture (visibility private) (returns LegacyUser) (effect pure)
    (body (record structural (field handle (text "alice")) (field password (text "synthetic-hash"))
      (field display (text "Alice")) (field bio (text "A profile")) (field admin (bool true))
      (field suspended (bool false)) (field created (i64 123)) (field failures (i64 2))
      (field locked (i64 99)) (field sessions (list Text (text "session-fixture")))
      (field following (list Text (text "bravo") (text "charlie")))
      (field muted (list Text (text "muted"))) (field saved (list Text (text "bookmark-fixture")))
      (field used (i64 456)) (field version (i64 7)))))

  (test create legacy-attention-preserved (visibility private)
    (actual (field (call accountcodec::read (call std::data-encode (types LegacyUser) (call accountcodec::fixture))) (name attention)))
    (expected (list Text (text "bravo") (text "charlie"))))
  (test create legacy-session-preserved (visibility private)
    (actual (field (call accountcodec::read (call std::data-encode (types LegacyUser) (call accountcodec::fixture))) (name sessions)))
    (expected (list Text (text "session-fixture"))))
  (test create canonical-roundtrip (visibility private)
    (actual (call std::bytes-equal
      (call std::data-encode (types User) (call accountcodec::read (call std::data-encode (types User) (call accountcodec::convert (call accountcodec::fixture)))))
      (call std::data-encode (types User) (call accountcodec::convert (call accountcodec::fixture)))))
    (expected (bool true)))
  (test create invalid-record-fails-closed (visibility private)
    (actual (field (call accountcodec::read (call std::bytes-from-text (text "invalid"))) (name handle))) (expected (text "")))
  (test create legacy-notice-normalized (visibility private)
    (actual (field (call accountcodec::notice (record structural (field actor (text "alice")) (field kind (text "follow")) (field note (text "")) (field at (i64 12)))) (name kind)))
    (expected (text "attention")))
  (test create post-attention-stays-distinct (visibility private)
    (actual (field (call accountcodec::notice (record structural (field actor (text "alice")) (field kind (text "eyes")) (field note (text "post")) (field at (i64 12)))) (name kind)))
    (expected (text "eyes")))
)
