(module create attentionmigration
  (function create progress (visibility public) (returns AttentionProgress)
    (effect (task (requirement service::app::store)))
    (body (let (binding rows (call db::read (text "attention-migration") (text "v1")))
      (binding empty (record structural (field user (i64 0)) (field edge (i64 0)) (field done (bool false))))
      (in (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local rows)) (i64 0)) (local empty)
        (call std::data-decode-or (types AttentionProgress) (field (call std::list-get (types std::DataEntry) (local rows) (i64 0)) std::DataEntry::value) (local empty)))))))

  (function create walk (visibility public) (parameter create count (type I64)) (parameter create user (type I64))
    (parameter create edge (type I64)) (parameter create budget (type I64))
    (returns AttentionProgress) (effect (task (requirement service::app::store)))
    (body (if (call std::less-equal (local count) (local user))
      (record structural (field user (local user)) (field edge (i64 0)) (field done (bool true)))
      (if (call std::less-equal (local budget) (i64 0))
        (record structural (field user (local user)) (field edge (local edge)) (field done (bool false)))
        (let (binding bucket (call db::bucket (text "users") (local user)))
          (binding offset (call std::subtract (local user) (call std::multiply (call std::divide (local user) (i64 32)) (i64 32))))
          (binding account (call db::user (call std::list-get (types Text) (local bucket) (local offset))))
          (binding targets (field (local account) (name attention)))
          (in (if (call std::less (local edge) (call std::list-length (types Text) (local targets)))
            (sequence
              (call attentionstore::set (field (local account) (name handle)) (call std::list-get (types Text) (local targets) (local edge)) (bool true))
              (call attentionmigration::walk (local count) (local user) (call std::add (local edge) (i64 1)) (call std::subtract (local budget) (i64 1))))
            (call attentionmigration::walk (local count) (call std::add (local user) (i64 1)) (i64 0) (call std::subtract (local budget) (i64 1))))))))))

  (function create step (visibility public) (returns I64)
    (effect (task (requirement service::app::store)))
    (body (let (binding previous (call attentionmigration::progress))
      (in (if (field (local previous) (name done)) (i64 0)
        (let (binding next (call attentionmigration::walk (call db::count (text "users"))
          (field (local previous) (name user)) (field (local previous) (name edge)) (i64 16)))
          (in (sequence
            (call db::put (text "attention-migration") (text "v1") (call std::data-encode (types AttentionProgress) (local next)))
            (if (field (local next) (name done)) (i64 0) (i64 1))))))))))

  (function create run (visibility public) (returns I64)
    (effect (task (requirement service::app::store)))
    (body (match
      (transaction-outcome service::app::store (types I64)
        (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
        (binding action) (call attentionmigration::step))
      (arm std::TransactionOutcome::Committed (payload result I64) (local result))
      (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason) (i64 -1)))))
)
