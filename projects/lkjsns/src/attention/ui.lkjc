(module create attentionui
  (function create toggle (visibility public) (parameter create ctx (type Context)) (parameter create target (type Text))
    (parameter create enabled (type Bool)) (parameter create subject (type Text)) (parameter create direction (type Text))
    (parameter create cursor (type Text)) (parameter create trail (type Text))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (call page::begin (local ctx) (text "attention"))
      (call page::hidden (text "handle") (local target))
      (call page::hidden (text "enabled") (if (local enabled) (text "0") (text "1")))
      (call page::hidden (text "subject") (local subject)) (call page::hidden (text "direction") (local direction))
      (call page::hidden (text "cursor") (local cursor)) (call page::hidden (text "trail") (local trail))
      (text "<button class=\"attention-toggle\" aria-label=\"Attention to @")
      (call std::html-escape-text (local target)) (text "\" aria-pressed=\"")
      (if (local enabled) (text "true") (text "false")) (text "\" title=\"")
      (if (local enabled) (text "Remove attention") (text "Give attention")) (text "\">")
      (if (local enabled)
        (text "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg>")
        (call page::icon (text "plus"))) (text "<span>Attention</span></button></form>")) (text ""))))

  (function create badge (visibility public) (parameter create viewer (type User)) (parameter create target (type User))
    (returns Text) (effect pure)
    (body (if (call util::handle (field (local viewer) (name handle)))
      (if (call std::text-equal (field (local viewer) (name handle)) (field (local target) (name handle)))
        (text "<span class=\"relation-badge\">You</span>")
        (if (call util::has (field (local target) (name attention)) (field (local viewer) (name handle)) (i64 0))
          (if (call util::has (field (local viewer) (name attention)) (field (local target) (name handle)) (i64 0))
            (text "<span class=\"relation-badge\">Mutual attention</span>")
            (text "<span class=\"relation-badge\">Attention to you</span>")) (text "")))
      (text ""))))

  (function create links (visibility public) (parameter create ctx (type Context)) (parameter create handle (type Text))
    (returns Text) (effect pure)
    (body (if (call util::signed (local ctx))
      (call std::text-join (list Text (text "<nav class=\"profile-relations\" aria-label=\"Attention relationships\">")
        (call page::link (call paging::root (call attentionnav::base (local handle) (text "to"))) (text "Attention to") (text "") (bool false))
        (call page::link (call paging::root (call attentionnav::base (local handle) (text "from"))) (text "Attention from") (text "") (bool false))
        (text "</nav>")) (text "")) (text ""))))

  (function create row (visibility public) (parameter create ctx (type Context)) (parameter create viewer (type User))
    (parameter create user (type User)) (parameter create subject (type Text)) (parameter create direction (type Text))
    (parameter create request (type Request))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "<div class=\"attention-row\" id=\"attention-")
      (call std::html-escape-text (field (local user) (name handle))) (text "\"><a class=\"attention-person\" href=\"/profile?user=")
      (call std::html-escape-text (field (local user) (name handle))) (text "\">")
      (call page::avatar (field (local user) (name handle)))
      (text "<span class=\"attention-identity\"><strong>") (call std::html-escape-text (field (local user) (name display)))
      (text "</strong><small>@") (call std::html-escape-text (field (local user) (name handle)))
      (text "</small>") (call attentionui::badge (local viewer) (local user))
      (if (call util::has (field (local viewer) (name muted)) (field (local user) (name handle)) (i64 0))
        (text "<span class=\"relation-badge\">Muted</span>") (text ""))
      (if (call std::text-equal (field (local user) (name bio)) (text "")) (text "")
        (call std::text-join (list Text (text "<span class=\"attention-bio\">")
          (call std::html-escape-text (field (local user) (name bio))) (text "</span>")) (text "")))
      (text "</span></a>")
      (if (call std::text-equal (field (local user) (name handle)) (field (local ctx) (name user))) (text "")
        (call attentionui::toggle (local ctx) (field (local user) (name handle))
          (call util::has (field (local viewer) (name attention)) (field (local user) (name handle)) (i64 0))
          (local subject) (local direction) (call util::query (local request) (text "cursor")) (call util::query (local request) (text "trail"))))
      (text "</div>")) (text ""))))

  (test create stable-toggle-label (visibility private)
    (actual (call std::text-contains (call attentionui::toggle
      (record structural (field user (text "alice")) (field csrf (text "fixture")) (field session (text "")) (field now (i64 0)))
      (text "bravo") (bool true) (text "bravo") (text "profile") (text "") (text ""))
      (text "aria-label=\"Attention to @bravo\" aria-pressed=\"true\""))) (expected (bool true)))
)
