(module create postflow
  (function create authorized (visibility public) (parameter create request (type Request))
    (returns Bool) (effect (task (requirement service::app::store) (requirement service::app::config) (requirement service::app::clock)))
    (body (let (binding ctx (call auth::context (local request)))
      (in (if (if (call std::text-equal (field (local request) (name method)) (text "POST"))
            (call auth::write-ok (local request)) (bool false))
        (if (call postusage::ready) (if (call util::signed (local ctx))
          (if (call util::token (call util::query (local request) (text "id")))
            (call std::text-equal (call util::header (local request) (text "x-csrf-token")) (field (local ctx) (name csrf)))
            (bool false)) (bool false)) (bool false)) (bool false))))))

  (function create start (visibility public) (parameter create request (type Request))
    (returns Response) (effect (task (requirement service::app::store) (requirement service::app::config)
      (requirement service::app::clock) (requirement service::app::streams)))
    (body (let (binding form (call util::parse (capability-call service::app::streams std::ByteStream::read-all
      (field (local request) (name body)) (i64 4096))))
      (in (if (call controls::schema (local form) (list Text (text "post") (text "version") (text "size")))
        (match (transaction-outcome service::app::store (types Response)
          (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
            std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
          (binding stage) (call postblob::start (call auth::context (local request))
            (call util::query (local request) (text "id")) (call util::value (local form) (text "post"))
            (call util::number (call util::value (local form) (text "version")) (i64 2147483647))
            (call util::number (call util::value (local form) (text "size")) (i64 2147483648))))
          (arm std::TransactionOutcome::Committed (payload result Response) (local result))
          (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason)
            (call page::error (i64 409) (text "The storage changed. Retry this post upload."))))
        (call page::error (i64 422) (text "The post upload information is incomplete."))))))

  )
  (function create put (visibility private) (parameter create request (type Request))
    (parameter create id (type Text)) (parameter create index (type I64)) (returns PutReceipt)
    (effect (task (requirement service::app::objects)))
    (body (let (binding key (call postblob::key (local id) (local index)))
      (binding receipts (capability-call service::app::objects std::ObjectStorage::reconcile-put (local key)))
      (in (if (call std::i64-equal (call std::list-length (types PutReceipt) (local receipts)) (i64 1))
        (call std::list-get (types PutReceipt) (local receipts) (i64 0))
        (capability-call service::app::objects std::ObjectStorage::put-new (local key)
          (field (local request) (name body)) (static-text "application/octet-stream")))))))

  (function create valid-part (visibility private) (parameter create data (type Bytes)) (returns Bool) (effect pure)
    (body (let (binding decoded (call std::bytes-to-text-result (local data)))
      (in (if (field (local decoded) (name valid))
        (if (call textinput::valid (local data))
          (call std::bool-not (call std::text-contains (field (local decoded) (name value)) (text "\r")))
          (bool false)) (bool false))))))

  (function create failed-part (visibility private)
    (parameter create id (type Text)) (parameter create index (type I64)) (returns Response)
    (effect (task (requirement service::app::store) (requirement service::app::objects)))
    (body (sequence
      (if (call util::has (list Text (text "missing") (text "retired")) (field (call postblob::read (local id)) (name state)) (i64 0))
        (capability-call service::app::objects std::ObjectStorage::delete (call postblob::key (local id) (local index))) (unit))
      (call page::error (i64 409) (text "The post upload changed. Retry this part.")))))

  (function create part (visibility public) (parameter create request (type Request)) (returns Response)
    (effect (task (requirement service::app::store) (requirement service::app::config)
      (requirement service::app::clock) (requirement service::app::objects)))
    (body (let (binding id (call util::query (local request) (text "id")))
      (binding index (call util::number (call util::query (local request) (text "part")) (i64 1024)))
      (binding size (call util::number (call util::header (local request) (text "content-length")) (i64 4194304)))
      (in (match (transaction-outcome service::app::store (types Bool)
        (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
          std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
        (binding stage) (call postblob::admit (call auth::context (local request)) (local id) (local index) (local size)))
        (arm std::TransactionOutcome::Committed (payload allowed Bool)
          (if (local allowed)
            (let (binding receipt (call postflow::put (local request) (local id) (local index)))
              (binding data (capability-call service::app::objects std::ObjectStorage::range
                (call postblob::key (local id) (local index)) (i64 0) (field (local receipt) (name size))))
              (in (if (call postflow::valid-part (local data))
                (let (binding text (call std::bytes-to-text (local data)))
                  (binding preview (if (call std::i64-equal (local index) (i64 0))
                    (call util::slice (local text) (i64 0) (call markdown::excerpt-end (local text))) (text "")))
                  (in (match (transaction-outcome service::app::store (types Bool)
                    (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
                      std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
                    (binding ack) (call postblob::ack (call auth::context (local request)) (local id) (local index) (local receipt) (local preview)))
                    (arm std::TransactionOutcome::Committed (payload saved Bool)
                      (if (local saved) (call page::raw (i64 204) (call std::bytes-from-text (text "")) (text "text/plain") (list Header))
                        (call postflow::failed-part (local id) (local index))))
                    (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason)
                      (call postflow::failed-part (local id) (local index))))))
                (sequence (capability-call service::app::objects std::ObjectStorage::delete (call postblob::key (local id) (local index)))
                  (call page::error (i64 422) (text "The post contains unsupported text or an incomplete UTF-8 character."))))))
            (call page::error (i64 409) (text "This part is out of order or the post upload has changed."))))
        (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason)
          (call page::error (i64 409) (text "The post upload changed. Retry this part.")))))))

  )
  (function create finish (visibility public) (parameter create request (type Request)) (returns Response)
    (effect (task (requirement service::app::store) (requirement service::app::config) (requirement service::app::clock)))
    (body (match (transaction-outcome service::app::store (types Response)
      (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
        std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
      (binding finish) (call postblob::finish (call auth::context (local request)) (call util::query (local request) (text "id"))))
      (arm std::TransactionOutcome::Committed (payload result Response) (local result))
      (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason)
        (call page::error (i64 409) (text "The post upload changed. Retry finishing it."))))))

  (function create cancel (visibility public) (parameter create request (type Request)) (returns Response)
    (effect (task (requirement service::app::store) (requirement service::app::config) (requirement service::app::clock)))
    (body (match (transaction-outcome service::app::store (types Bool)
      (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
        std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
      (binding cancel) (call postblob::cancel (call auth::context (local request)) (call util::query (local request) (text "id"))))
      (arm std::TransactionOutcome::Committed (payload result Bool)
        (if (local result) (call page::raw (i64 204) (call std::bytes-from-text (text "")) (text "text/plain") (list Header))
          (call page::error (i64 409) (text "This post upload is no longer available."))))
      (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason)
        (call page::error (i64 409) (text "The post upload changed. Retry cancellation."))))))

  (function create grant (visibility private) (parameter create request (type Request)) (returns PostBodyGrant)
    (effect (task (requirement service::app::store) (requirement service::app::config) (requirement service::app::clock)))
    (body (let (binding ctx (call util::sharing (call auth::context (local request)) (call util::query (local request) (text "share"))))
      (binding note (call db::note (call util::query (local request) (text "note"))))
      (binding ref (call postblob::reference (field (local note) (name id)))) (binding stage (call postblob::read (local ref)))
      (binding index (call util::number (call util::query (local request) (text "part")) (i64 1024)))
      (binding version (call util::number (call util::query (local request) (text "version")) (i64 2147483647)))
      (binding valid (if (call access::visible (local ctx) (local note))
        (if (call std::i64-equal (field (local note) (name version)) (local version))
          (if (call std::text-equal (field (local stage) (name state)) (text "linked"))
            (if (call std::text-equal (field (local stage) (name post)) (field (local note) (name id)))
              (if (if (call std::less-equal (i64 0) (local index))
                    (call std::less (local index) (call std::list-length (types I64) (field (local stage) (name lengths)))) (bool false))
                (bool true) (bool false)) (bool false)) (bool false)) (bool false)) (bool false)))
      (in (record structural (field valid (local valid)) (field blob (local ref)) (field part (local index))
        (field version (local version)) (field size (if (local valid)
          (call std::list-get (types I64) (field (local stage) (name lengths)) (local index)) (i64 0)))))))

  )
  (function create raw (visibility public) (parameter create request (type Request)) (returns Response)
    (effect (task (requirement service::app::store) (requirement service::app::config)
      (requirement service::app::clock) (requirement service::app::objects)))
    (body (match (transaction-outcome service::app::store (types PostBodyGrant)
      (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
        std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
      (binding read) (call postflow::grant (local request)))
      (arm std::TransactionOutcome::Committed (payload grant PostBodyGrant)
        (if (field (local grant) (name valid))
          (let (binding data (capability-call service::app::objects std::ObjectStorage::range
            (call postblob::key (field (local grant) (name blob)) (field (local grant) (name part)))
            (i64 0) (field (local grant) (name size))))
            (in (match (transaction-outcome service::app::store (types PostBodyGrant)
              (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
                std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
              (binding check) (call postflow::grant (local request)))
              (arm std::TransactionOutcome::Committed (payload after PostBodyGrant)
                (if (if (field (local after) (name valid))
                      (call std::text-equal (field (local after) (name blob)) (field (local grant) (name blob))) (bool false))
                  (call page::raw (i64 200) (local data) (text "text/plain; charset=utf-8") (list Header))
                  (call page::error (i64 404) (text "This post is unavailable."))))
              (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason)
                (call page::error (i64 409) (text "This post changed while loading."))))))
          (call page::error (i64 404) (text "This post is unavailable."))))
      (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason)
        (call page::error (i64 409) (text "This post changed while loading."))))))

  (function create route (visibility public) (parameter create request (type Request)) (returns Response)
    (effect (task (requirement service::app::store) (requirement service::app::config)
      (requirement service::app::clock) (requirement service::app::objects) (requirement service::app::streams)))
    (body (if (call postflow::authorized (local request))
      (if (call std::text-equal (field (local request) (name path)) (text "/post-body/start")) (call postflow::start (local request))
      (if (call std::text-equal (field (local request) (name path)) (text "/post-body/part")) (call postflow::part (local request))
      (if (call std::text-equal (field (local request) (name path)) (text "/post-body/finish")) (call postflow::finish (local request))
        (call postflow::cancel (local request)))))
      (call page::error (i64 403) (text "Check your sign-in and request origin.")))))
)
