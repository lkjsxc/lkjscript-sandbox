(module create searchview
  (function create posts (visibility public) (parameter create ctx (type Context)) (parameter create viewer (type User)) (parameter create ids (type (list Text))) (parameter create index (type I64)) (parameter create q (type Text)) (parameter create out (type Text)) (returns Text) (effect (task (requirement service::app::store))) (body (if (call std::less (local index) (call std::list-length (types Text) (local ids))) (let (binding note (call db::note (call std::list-get (types Text) (local ids) (local index)))) (in (call searchview::posts (local ctx) (local viewer) (local ids) (call std::add (local index) (i64 1)) (local q) (if (if (if (field (local note) (name published)) (if (call access::visible (local ctx) (local note)) (if (call std::bool-not (call util::has (field (local viewer) (name muted)) (field (local note) (name author)) (i64 0))) (bool true) (bool false)) (bool false)) (bool false)) (if (let (binding indexed (call preferences::read (text "search-text") (field (local note) (name id)))) (in (call std::text-contains (if (call std::text-equal (local indexed) (text "")) (call searchtext::fold (call std::text-join (list Text (field (local note) (name body)) (text " ") (field (local note) (name cw))) (text ""))) (local indexed)) (local q)))) (bool true) (bool false)) (bool false)) (call std::text-join (list Text (local out) (call journalview::card (local ctx) (local note) (local viewer) (call std::text-join (list Text (text "thread:") (field (local note) (name id))) (text "")) (text "") (text ""))) (text "")) (local out))))) (local out))))

