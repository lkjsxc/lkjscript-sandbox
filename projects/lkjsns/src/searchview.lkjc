  (function create window (visibility public)
    (parameter create ctx (type Context))
    (parameter create viewer (type User))
    (parameter create q (type Text))
    (parameter create cursor (type Text))
    (parameter create skipped (type I64))
    (returns LibraryWindow) (effect (task (requirement service::app::store)))
    (body (let (binding listing (call db::listing (text "timeline") (local cursor) (i64 30))) (binding rows (call searchview::posts (local ctx) (local viewer) (field (local listing) (name ids)) (i64 0) (local q) (text ""))) (in (if (if (call std::text-equal (local rows) (text "")) (if (call std::less-equal (i64 0) (field (local listing) (name next))) (if (call std::less (local skipped) (i64 3)) (bool true) (bool false)) (bool false)) (bool false)) (call searchview::window (local ctx) (local viewer) (local q) (call std::i64-to-text (field (local listing) (name next))) (call std::add (local skipped) (i64 1))) (record structural (field rows (local rows)) (field next (field (local listing) (name next)))))))))

  (function create view (visibility public) (parameter create ctx (type Context)) (parameter create request (type Request)) (returns Response) (effect (task (requirement service::app::store))) (body (if (call paging::valid-trail (call util::query (local request) (text "members-trail"))) (if (if (call util::clean (call util::query (local request) (text "q")) (i64 0) (i64 120)) (if (call navigation::reading-cursor (call util::query (local request) (text "cursor"))) (if (call navigation::reading-cursor (call util::query (local request) (text "members"))) (bool true) (bool false)) (bool false)) (bool false)) (let (binding q (call searchtext::fold (call tags::trim-end (call util::trim (call util::query (local request) (text "q")) (i64 0)) (call util::size (call util::trim (call util::query (local request) (text "q")) (i64 0)))))) (in (call page::ok (local ctx) (text "Search") (call std::text-join (list Text (call std::text-join (list Text (text "<form class=\"search-form panel\" action=\"/search\" method=\"get\"><label class=\"sr-only\" for=\"search-query\">Search posts and people</label><input id=\"search-query\" name=\"q\" type=\"search\" maxlength=\"120\" placeholder=\"Search posts and people\" value=\"") (call std::html-escape-text (call util::query (local request) (text "q"))) (text "\"") (if (if (call std::text-equal (call util::query (local request) (text "cursor")) (text "")) (call std::text-equal (call util::query (local request) (text "members")) (text "")) (bool false)) (text " autofocus") (text "")) (text "><button class=\"primary\">Search</button></form>")) (text "")) (if (call std::text-equal (local q) (text "")) (text "") (let (binding viewer (if (call util::signed (local ctx)) (call db::user (field (local ctx) (name user))) (call db::empty-user))) (binding posts (call searchview::window (local ctx) (local viewer) (local q) (call util::query (local request) (text "cursor")) (i64 0))) (binding members (call db::listing (text "users") (call util::query (local request) (text "members")) (i64 30))) (binding people (if (call util::signed (local ctx)) (call searchview::people (local ctx) (local viewer) (field (local members) (name ids)) (i64 0) (local q) (text "")) (text ""))) (in (call std::text-join (list Text (text "") (if (call util::signed (local ctx))
  (if (if (call std::bool-not (call std::text-equal (local people) (text ""))) (bool true)
    (if (call std::less-equal (i64 0) (field (local members) (name next))) (bool true)
      (call std::bool-not (call std::text-equal (call util::query (local request) (text "members")) (text "")))))
    (call std::text-join (list Text (text "<section class=\"panel member-list\"><h2>People</h2>")
      (if (call std::text-equal (local people) (text "")) (text "<p class=\"context-hint\">No matching people on this page.</p>") (local people))
      (text "</section>")) (text "")) (text "")) (text "")) (if (call util::signed (local ctx)) (call paging::render
   (call util::query (local request) (text "members")) (call util::query (local request) (text "members-trail"))
   (field (local members) (name next)) (call searchview::paging-base (local request) (bool true))
   (text "members") (text "members-trail") (text "People pagination") (text "More people")) (text "")) (text "<section class=\"search-results\"><h2 class=\"section-heading\">Posts</h2><div class=\"feed\">") (if (call std::text-equal (field (local posts) (name rows)) (text "")) (call page::empty (text "No matching posts") (if (call std::less-equal (i64 0) (field (local posts) (name next))) (text "There are older posts to search.") (text "Try another word or phrase.")) (text "") (text "")) (field (local posts) (name rows))) (text "</div>") (call paging::render (call util::query (local request) (text "cursor"))
   (call util::query (local request) (text "trail")) (field (local posts) (name next))
   (call searchview::paging-base (local request) (bool false))
   (text "cursor") (text "trail") (text "Post pagination") (text "Older")) (text "</section>")) (text "")))))) (text ""))))) (call page::error (i64 400) (text "Use a search query of up to 120 bytes."))) (call page::error (i64 400) (text "Check the people pagination history.")))))

  (function create paging-base (visibility public)
    (parameter create request (type Request)) (parameter create people (type Bool))
    (returns Text) (effect pure)
    (body (let (binding cursor-name (if (local people) (text "cursor") (text "members")))
      (binding trail-name (if (local people) (text "trail") (text "members-trail")))
      (in (call searchview::paging-base-values (call util::query (local request) (text "q"))
        (call util::query (local request) (local cursor-name)) (call util::query (local request) (local trail-name))
        (local cursor-name) (local trail-name))))))

  (function create paging-base-values (visibility public)
    (parameter create q (type Text)) (parameter create cursor (type Text)) (parameter create trail (type Text))
    (parameter create cursor-name (type Text)) (parameter create trail-name (type Text))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "/search?q=") (call navigation::encode (local q))
      (if (call std::text-equal (local cursor) (text "")) (text "")
        (call std::text-join (list Text (text "&") (local cursor-name) (text "=") (call navigation::encode (local cursor))) (text "")))
      (if (call std::text-equal (local trail) (text "")) (text "")
        (call std::text-join (list Text (text "&") (local trail-name) (text "=") (call navigation::encode (local trail))) (text "")))
      (text "&")) (text ""))))

  (test create people-page-retains-post-place (visibility private)
    (actual (call searchview::paging-base-values (text "a&b") (text "12") (text "_.42") (text "cursor") (text "trail")))
    (expected (text "/search?q=a%26b&cursor=12&trail=_.42&")))
  (test create post-page-retains-people-place (visibility private)
    (actual (call searchview::paging-base-values (text "alice") (text "10") (text "_") (text "members") (text "members-trail")))
    (expected (text "/search?q=alice&members=10&members-trail=_&")))

)
