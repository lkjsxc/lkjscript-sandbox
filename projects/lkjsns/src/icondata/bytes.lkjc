(module create iconbytes
  (external create concat (visibility private) (implementation core.bytes.concat)
    (parameter create left (type Bytes)) (parameter create right (type Bytes)) (returns Bytes))

  (function create nibble (visibility private)
    (parameter create byte (type I64)) (returns I64) (effect pure)
    (body (if (call std::less (local byte) (i64 48)) (i64 -1)
      (if (call std::less-equal (local byte) (i64 57)) (call std::subtract (local byte) (i64 48))
        (if (call std::less (local byte) (i64 65)) (i64 -1)
          (if (call std::less-equal (local byte) (i64 70)) (call std::subtract (local byte) (i64 55))
            (if (call std::less (local byte) (i64 97)) (i64 -1)
              (if (call std::less-equal (local byte) (i64 102)) (call std::subtract (local byte) (i64 87)) (i64 -1)))))))))

  (function create valid (visibility private)
    (parameter create data (type Bytes)) (parameter create index (type I64))
    (returns Bool) (effect pure)
    (body (if (call std::less (local index) (call std::bytes-length (local data)))
      (if (call std::less (call iconbytes::nibble (call std::bytes-get (local data) (local index))) (i64 0))
        (bool false) (call iconbytes::valid (local data) (call std::add (local index) (i64 1))))
      (bool true))))

  (function create block (visibility private)
    (parameter create data (type Bytes)) (parameter create index (type I64))
    (parameter create end (type I64)) (parameter create out (type (list I64)))
    (returns Bytes) (effect pure)
    (body (if (call std::less (local index) (local end))
      (call iconbytes::block (local data) (call std::add (local index) (i64 2)) (local end)
        (call std::list-append (types I64) (local out)
          (call std::add (call std::multiply (i64 16)
            (call iconbytes::nibble (call std::bytes-get (local data) (local index))))
            (call iconbytes::nibble (call std::bytes-get (local data) (call std::add (local index) (i64 1)))))))
      (call std::bytes-from-list (local out)))))

  (function create chunks (visibility private)
    (parameter create data (type Bytes)) (parameter create index (type I64))
    (parameter create out (type Bytes)) (returns Bytes) (effect pure)
    (body (if (call std::less (local index) (call std::bytes-length (local data)))
      (let (binding next (if (call std::less (call std::add (local index) (i64 256)) (call std::bytes-length (local data)))
        (call std::add (local index) (i64 256)) (call std::bytes-length (local data))))
        (in (call iconbytes::chunks (local data) (local next)
          (call iconbytes::concat (local out) (call iconbytes::block (local data) (local index) (local next) (list I64))))))
      (local out))))

  (function create decode (visibility public)
    (parameter create encoded (type Text)) (returns Bytes) (effect pure)
    (body (let (binding data (call std::bytes-from-text (local encoded)))
      (binding size (call std::bytes-length (local data)))
      (in (if (call std::less-equal (local size) (i64 32768))
        (if (call std::i64-equal (local size) (call std::multiply (i64 2) (call std::divide (local size) (i64 2))))
          (if (call iconbytes::valid (local data) (i64 0))
            (call iconbytes::chunks (local data) (i64 0) (call std::bytes-from-text (text "")))
            (call std::bytes-from-text (text "")))
          (call std::bytes-from-text (text "")))
        (call std::bytes-from-text (text "")))))))

  (test create empty (visibility private)
    (actual (call std::bytes-length (call iconbytes::decode (text "")))) (expected (i64 0)))
  (test create full-byte-range (visibility private)
    (actual (call std::bytes-to-hex (call iconbytes::decode (text "00017f80feff")))) (expected (text "00017f80feff")))
  (test create case-insensitive-hex (visibility private)
    (actual (call std::bytes-to-hex (call iconbytes::decode (text "AaBbcCDdeEFf")))) (expected (text "aabbccddeeff")))
  (test create odd-length (visibility private)
    (actual (call std::bytes-length (call iconbytes::decode (text "abc")))) (expected (i64 0)))
  (test create invalid-character (visibility private)
    (actual (call std::bytes-length (call iconbytes::decode (text "00fg")))) (expected (i64 0)))
  (test create no-whitespace (visibility private)
    (actual (call std::bytes-length (call iconbytes::decode (text "00 ff0")))) (expected (i64 0)))

  (test create crosses-output-block (visibility private) (actual (call std::bytes-to-hex (call iconbytes::decode (text "00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff")))) (expected (text "00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff")))

  (test create invalid-tail-never-returns-prefix (visibility private) (actual (call std::bytes-length (call iconbytes::decode (text "00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ffxy")))) (expected (i64 0)))
)
