  (test create normal-part-field-case (visibility private)
    (actual (call codec::part-header (call std::bytes-from-text (text "Content-Disposition: form-data; name=\"file\"; filename=\"Case.PNG\"\r\nContent-Type: image/png")) (i64 0) (i64 89)))
    (expected (text "Case.PNG")))

  (test create lower-part-field-case (visibility private)
    (actual (call codec::part-header (call std::bytes-from-text (text "content-disposition: form-data; name=\"file\"; filename=\"Case.PNG\"\r\ncontent-type: image/png")) (i64 0) (i64 89)))
    (expected (text "Case.PNG")))

  (test create mixed-part-field-case (visibility private)
    (actual (call codec::part-header (call std::bytes-from-text (text "cOnTeNt-DiSpOsItIoN: form-data; name=\"file\"; filename=\"Case.PNG\"\r\ncOnTeNt-TyPe: image/png")) (i64 0) (i64 89)))
    (expected (text "Case.PNG")))

  (test create field-value-stays-case-sensitive (visibility private)
    (actual (call codec::part-header (call std::bytes-from-text (text "content-disposition: form-data; name=\"FILE\"; filename=\"Case.PNG\"\r\ncontent-type: image/png")) (i64 0) (i64 89)))
    (expected (text "")))

  (test create unicode-file-name-kept (visibility private)
    (actual (call codec::part-header (call std::bytes-from-text (text "content-disposition: form-data; name=\"file\"; filename=\"Café.PNG\"\r\ncontent-type: image/png")) (i64 0) (i64 90)))
    (expected (text "Café.PNG")))

  (test create additional-lowercase-header-denied (visibility private)
    (actual (call codec::part-header (call std::bytes-from-text (text "content-disposition: form-data; name=\"file\"; filename=\"Case.PNG\"\r\ncontent-type: image/png\r\nx-extra: value")) (i64 0) (i64 105)))
    (expected (text "")))

  (test create header-name-suffix-denied (visibility private)
    (actual (call codec::part-header (call std::bytes-from-text (text "Content-DispositionX: form-data; name=\"file\"; filename=\"Case.PNG\"\r\nContent-Type: image/png")) (i64 0) (i64 90)))
    (expected (text "")))

  (test create missing-header-colon-denied (visibility private)
    (actual (call codec::part-header (call std::bytes-from-text (text "content-disposition: form-data; name=\"file\"; filename=\"Case.PNG\"\r\ncontent-type image/png")) (i64 0) (i64 88)))
    (expected (text "")))

  (test create negative-field-offset (visibility private)
    (actual (call codec::field-at (call std::bytes-from-text (text "short")) (i64 -1) (text "Content-Type")))
    (expected (bool false)))

  (test create field-offset-outside-data (visibility private)
    (actual (call codec::field-at (call std::bytes-from-text (text "short")) (i64 10) (text "Content-Type")))
    (expected (bool false)))
