c::bad-range)))))

  (test create boundary-unquoted (visibility private) (actual (call codec::boundary (text "multipart/form-data; boundary=----lkj123"))) (expected (text "----lkj123")))

  (test create boundary-quoted (visibility private) (actual (call codec::boundary (text "multipart/form-data; boundary=\"lkj123\""))) (expected (text "lkj123")))

  (test create boundary-injection (visibility private) (actual (call codec::boundary (text "multipart/form-data; boundary=a\r\nx"))) (expected (text "")))

