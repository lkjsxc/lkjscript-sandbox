  (test create multipart-single-file (visibility private) (actual (field (call codec::part (call std::bytes-from-text (text "--abc\r\nContent-Disposition: form-data; name=\"file\"; filename=\"photo.png\"\r\nContent-Type: image/png\r\n\r\nhello\r\n--abc--\r\n")) (text "abc")) (name valid))) (expected (bool true)))

  (test create multipart-filename (visibility private) (actual (field (call codec::part (call std::bytes-from-text (text "--abc\r\nContent-Disposition: form-data; name=\"file\"; filename=\"photo.png\"\r\nContent-Type: image/png\r\n\r\nhello\r\n--abc--\r\n")) (text "abc")) (name name))) (expected (text "photo.png")))

  (test create multipart-truncated (visibility private) (actual (field (call codec::part (call std::bytes-from-text (text "--abc\r\nContent-Disposition: form-data; name=\"file\"; filename=\"photo.png\"\r\nContent-Type: image/png\r\n\r\nhello\r\n--ab")) (text "abc")) (name valid))) (expected (bool false)))

  (test create multipart-extra-field (visibility private) (actual (field (call codec::part (call std::bytes-from-text (text "--abc\r\nContent-Disposition: form-data; name=\"file\"; filename=\"photo.png\"\r\nContent-Type: image/png\r\n\r\nhello\r\n--abc\r\nContent-Disposition: form-data; name=\"other\"\r\n\r\nvalue\r\n--abc--\r\n")) (text "abc")) (name valid))) (expected (bool false)))

