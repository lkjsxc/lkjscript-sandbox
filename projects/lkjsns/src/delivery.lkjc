(module create delivery
  (function create range-input (visibility public)
    (parameter create method (type Text))
    (parameter create range (type Text))
    (parameter create if-range (type Text))
    (returns Text) (effect pure)
    (body (if (call std::text-equal (local method) (text "GET"))
      (if (call std::text-equal (local if-range) (text ""))
        (if (call std::text-starts-with (local range) (text "bytes="))
          (local range) (text ""))
        (text ""))
      (text ""))))

  (function create file (visibility public)
    (parameter create ctx (type Context))
    (parameter create request (type Request))
    (returns Response) (effect (task (requirement service::app::store) (requirement service::app::objects)))
    (body (let (binding m (call db::media (call util::query (local request) (text "id")))) (binding note (call db::note (call util::query (local request) (text "note")))) (in (if (call access::media (local ctx) (local m) (local note)) (if (call std::text-equal (field (local request) (name method)) (text "HEAD")) (call delivery::head-unavailable) (if (if (call std::i64-equal (field (local m) (name size)) (i64 0)) (if (call std::text-equal (call util::header (local request) (text "range")) (text "")) (bool true) (bool false)) (bool false)) (call page::raw (i64 200) (call std::bytes-from-text (text "")) (field (local m) (name mime)) (list Header (call editor::header (text "accept-ranges") (text "bytes")) (call editor::header (text "content-disposition") (call std::text-join (list Text (if (if (call std::text-equal (field (local m) (name mime)) (text "application/octet-stream")) (bool true) (if (call std::text-equal (call util::query (local request) (text "download")) (text "yes")) (bool true) (bool false))) (text "attachment") (text "inline")) (text "; filename=\"download\"; filename*=UTF-8''") (call navigation::encode (field (local m) (name name)))) (text ""))))) (let (binding requested (call codec::range (call delivery::range-input (field (local request) (name method)) (call util::header (local request) (text "range")) (call util::header (local request) (text "if-range"))) (field (local m) (name size)))) (in (if (field (local requested) (name valid)) (if (if (call std::bool-not (field (local requested) (name partial))) (if (call std::less (i64 33554432) (field (local m) (name size))) (bool true) (bool false)) (bool false)) (call page::redirect (call std::text-join (list Text (text "/download?id=") (field (local m) (name id)) (text "&note=") (field (local note) (name id))
  (if (call util::token (field (local ctx) (name share)))
    (call std::text-join (list Text (text "&share=") (field (local ctx) (name share))) (text "")) (text ""))) (text ""))) (let (binding range (record structural (field valid (bool true)) (field partial (field (local requested) (name partial))) (field start (field (local requested) (name start))) (field length (if (field (local requested) (name partial)) (call codec::min (i64 8388608) (field (local requested) (name length))) (field (local requested) (name length)))))) (in (call page::raw (if (field (local range) (name partial)) (i64 206) (i64 200)) (call chunkio::read (local m) (field (local range) (name start)) (field (local range) (name length))) (field (local m) (name mime)) (call page::append-headers (list Header (call editor::header (text "accept-ranges") (text "bytes")) (call editor::header (text "content-disposition") (call std::text-join (list Text (if (if (call std::text-equal (field (local m) (name mime)) (text "application/octet-stream")) (bool true) (if (call std::text-equal (call util::query (local request) (text "download")) (text "yes")) (bool true) (bool false))) (text "attachment") (text "inline")) (text "; filename=\"download\"; filename*=UTF-8''") (call navigation::encode (field (local m) (name name)))) (text "")))) (if (field (local range) (name partial)) (list Header (call editor::header (text "content-range") (call std::text-join (list Text (text "bytes ") (call std::i64-to-text (field (local range) (name start))) (text "-") (call std::i64-to-text (call std::subtract (call std::add (field (local range) (name start)) (field (local range) (name length))) (i64 1))) (text "/") (call std::i64-to-text (field (local m) (name size)))) (text "")))) (list Header)) (i64 0)))))) (call page::raw (i64 416) (call std::bytes-from-text (text "")) (text "text/plain") (list Header (call editor::header (text "content-range") (call std::text-join (list Text (text "bytes */") (call std::i64-to-text (field (local m) (name size)))) (text "")))))))))) (call page::error (i64 404) (text "This file is unavailable.")))))))
  (test create get-retains-byte-range (visibility private)
    (actual (call delivery::range-input (text "GET") (text "bytes=1-3") (text "")))
    (expected (text "bytes=1-3")))
  (test create head-ignores-range (visibility private)
    (actual (call delivery::range-input (text "HEAD") (text "bytes=1-3") (text "")))
    (expected (text "")))
  (test create head-ignores-invalid-range (visibility private)
    (actual (call delivery::range-input (text "HEAD") (text "bytes=bad") (text "")))
    (expected (text "")))
  (test create unknown-range-unit-uses-full-representation (visibility private)
    (actual (call delivery::range-input (text "GET") (text "items=1-3") (text "")))
    (expected (text "")))
  (test create unverified-if-range-uses-full-representation (visibility private)
    (actual (call delivery::range-input (text "GET") (text "bytes=1-3") (text "unverified-validator")))
    (expected (text "")))
  (test create absent-range-stays-absent (visibility private)
    (actual (call delivery::range-input (text "GET") (text "") (text "")))
    (expected (text "")))
  (function create head-unavailable (visibility public)
    (returns Response) (effect pure)
    (body (call page::raw (i64 405) (call std::bytes-from-text (text ""))
      (text "text/plain; charset=utf-8")
      (list Header (call editor::header (text "allow") (text "GET"))))))
  (test create head-does-not-claim-zero-byte-file (visibility private)
    (actual (field (call delivery::head-unavailable) (name status))) (expected (i64 405)))
  (test create head-advertises-supported-method (visibility private)
    (actual (field (call editor::header-value (text "allow")
      (field (call delivery::head-unavailable) (name headers))) (name value)))
    (expected (call std::bytes-from-text (text "GET"))))
)
