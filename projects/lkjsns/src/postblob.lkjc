(module create postblob
  (function create empty (visibility public) (returns PostBodyStage) (effect pure) (body (record structural (field id (text "")) (field post (text "")) (field owner (text "")) (field version (i64 -1)) (field size (i64 -1)) (field written (i64 0)) (field lengths (list I64)) (field hashes (list Text)) (field preview (text "")) (field state (text "missing")) (field reserved (i64 0)) (field created (i64 0)))))

  (function create read (visibility public) (parameter create id (type Text)) (returns PostBodyStage)
    (effect (task (requirement service::app::store)))
    (body (let (binding rows (call db::read (text "post-body-blob") (local id)))
      (in (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local rows)) (i64 1))
        (call std::data-decode-or (types PostBodyStage)
          (field (call std::list-get (types std::DataEntry) (local rows) (i64 0)) std::DataEntry::value)
          (call postblob::empty)) (call postblob::empty))))))

  (function create save (visibility public) (parameter create stage (type PostBodyStage)) (returns Bool)
    (effect (task (requirement service::app::store)))
    (body (call db::put (text "post-body-blob") (field (local stage) (name id))
      (call std::data-encode (types PostBodyStage) (local stage)))))

  (function create text-record (visibility private) (parameter create kind (type Text)) (parameter create id (type Text))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (let (binding rows (call db::read (local kind) (local id)))
      (in (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local rows)) (i64 1))
        (call std::data-decode-or (types Text) (field (call std::list-get (types std::DataEntry) (local rows) (i64 0)) std::DataEntry::value) (text ""))
        (text ""))))))

  (function create reference (visibility public) (parameter create post (type Text)) (returns Text)
    (effect (task (requirement service::app::store)))
    (body (call postblob::text-record (text "post-body-ref") (local post))))

  (function create active (visibility public) (parameter create owner (type Text)) (returns Text)
    (effect (task (requirement service::app::store)))
    (body (call postblob::text-record (text "post-body-active") (local owner))))

  (function create stage-owner (visibility public) (parameter create ctx (type Context)) (parameter create stage (type PostBodyStage))
    (returns Bool) (effect pure)
    (body (if (call util::signed (local ctx))
      (if (call util::token (field (local stage) (name id)))
        (call std::text-equal (field (local ctx) (name user)) (field (local stage) (name owner))) (bool false)) (bool false))))

  (function create current-body-size (visibility public) (parameter create note (type Note)) (returns I64)
    (effect (task (requirement service::app::store)))
    (body (let (binding ref (call postblob::reference (field (local note) (name id))))
      (in (if (call std::text-equal (local ref) (text "")) (call util::size (field (local note) (name body)))
        (let (binding stage (call postblob::read (local ref)))
          (in (if (if (call std::text-equal (field (local stage) (name post)) (field (local note) (name id)))
                  (if (call std::text-equal (field (local stage) (name owner)) (field (local note) (name author)))
                    (call std::text-equal (field (local stage) (name state)) (text "linked")) (bool false)) (bool false))
            (field (local stage) (name size)) (i64 -1))))))))

  )
  (function create stage-note (visibility public) (parameter create ctx (type Context)) (parameter create post (type Text))
    (parameter create version (type I64)) (returns Bool)
    (effect (task (requirement service::app::store)))
    (body (let (binding rows (call db::read (text "note") (call db::post-key (local post))))
      (binding note (call db::note (local post)))
      (in (if (call util::post-id (local post))
        (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local rows)) (i64 0))
          (call std::i64-equal (local version) (i64 0))
          (if (call std::text-equal (field (local note) (name author)) (field (local ctx) (name user)))
            (if (call std::bool-not (field (local note) (name deleted)))
              (call std::i64-equal (field (local note) (name version)) (local version)) (bool false)) (bool false)))
        (bool false)))))

  )
  (function create start (visibility public)
    (parameter create ctx (type Context)) (parameter create id (type Text)) (parameter create post (type Text))
    (parameter create version (type I64)) (parameter create size (type I64)) (returns Response)
    (effect (task (requirement service::app::store)))
    (body (let (binding existing (call postblob::read (local id))) (binding active (call postblob::active (field (local ctx) (name user))))
      (binding note (call db::note (local post)))
      (binding old (if (call util::post-id (field (local note) (name id))) (call postblob::current-body-size (local note)) (i64 0)))
      (binding reserve (if (call std::less (local old) (local size)) (call std::subtract (local size) (local old)) (i64 0)))
      (in (if (if (call util::signed (local ctx)) (if (call util::token (local id))
        (if (call std::less (i64 65536) (local size)) (if (call std::less-equal (local size) (i64 2147483648))
          (if (call std::less-equal (i64 0) (local old)) (call postblob::stage-note (local ctx) (local post) (local version)) (bool false))
          (bool false)) (bool false)) (bool false)) (bool false))
        (if (call util::token (field (local existing) (name id)))
          (if (if (call postblob::stage-owner (local ctx) (local existing))
                (if (call std::text-equal (field (local existing) (name post)) (local post))
                  (if (call std::i64-equal (field (local existing) (name version)) (local version))
                    (if (call std::i64-equal (field (local existing) (name size)) (local size))
                      (call util::has (list Text (text "uploading") (text "ready")) (field (local existing) (name state)) (i64 0)) (bool false))
                    (bool false)) (bool false)) (bool false))
            (call page::raw (i64 200) (call std::bytes-from-text (call std::i64-to-text
              (call std::list-length (types Text) (field (local existing) (name hashes))))) (text "text/plain; charset=utf-8") (list Header))
            (call page::error (i64 409) (text "This upload no longer matches the current post.")))
          (if (call std::i64-equal (call std::list-length (types std::DataEntry) (call db::read (text "post-body-gc") (local id))) (i64 0))
 (if (call std::text-equal (local active) (text ""))
            (if (call postquota::allowed (field (local ctx) (name user)) (local reserve))
              (if (call postquota::adjust (field (local ctx) (name user)) (local reserve))
                (sequence (call postblob::save (record structural (field id (local id)) (field post (local post)) (field owner (field (local ctx) (name user))) (field version (local version)) (field size (local size)) (field written (i64 0)) (field lengths (list I64)) (field hashes (list Text)) (field preview (text "")) (field state (text "uploading")) (field reserved (local reserve)) (field created (field (local ctx) (name now)))))
                  (call db::put (text "post-body-active") (field (local ctx) (name user))
                    (call std::data-encode (types Text) (local id)))
                  (call page::raw (i64 200) (call std::bytes-from-text (text "0")) (text "text/plain; charset=utf-8") (list Header)))
                (call page::error (i64 409) (text "Storage accounting changed. Retry the upload.")))
              (call page::error (i64 422) (text "There is not enough free Drive storage.")))
            (call page::error (i64 409) (text "Another post upload is still in progress. Resume or cancel it first.")))
 (call page::error (i64 409) (text "This upload identifier is unavailable. Start again."))))
        (call page::error (i64 422) (text "The post or upload is invalid or has changed."))))))

  )
  (function create key (visibility public) (parameter create id (type Text)) (parameter create index (type I64)) (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "post-parts/") (local id) (text "/") (call std::i64-to-text (local index))) (text ""))))

  (function create admit (visibility public) (parameter create ctx (type Context)) (parameter create id (type Text))
    (parameter create index (type I64)) (parameter create size (type I64)) (returns Bool)
    (effect (task (requirement service::app::store)))
    (body (let (binding stage (call postblob::read (local id)))
      (binding count (call std::list-length (types Text) (field (local stage) (name hashes))))
      (in (if (call postblob::stage-owner (local ctx) (local stage))
        (if (call std::text-equal (field (local stage) (name state)) (text "uploading"))
          (if (if (call std::less-equal (i64 0) (local index)) (call std::less-equal (local index) (local count)) (bool false))
            (if (if (call std::less (i64 0) (local size)) (call std::less-equal (local size) (i64 4194304)) (bool false))
              (if (call std::i64-equal (local index) (local count))
                (if (call std::less-equal (call std::add (field (local stage) (name written)) (local size)) (field (local stage) (name size)))
                  (if (call std::less-equal (i64 4194301) (local size)) (bool true)
                    (call std::i64-equal (call std::add (field (local stage) (name written)) (local size)) (field (local stage) (name size))))
                  (bool false))
                (call std::i64-equal (local size) (call std::list-get (types I64) (field (local stage) (name lengths)) (local index))))
              (bool false)) (bool false)) (bool false)) (bool false))))))

  (function create ack (visibility public) (parameter create ctx (type Context)) (parameter create id (type Text))
    (parameter create index (type I64)) (parameter create receipt (type PutReceipt)) (parameter create preview (type Text))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (let (binding stage (call postblob::read (local id))) (binding size (field (local receipt) (name size)))
      (binding hash (field (local receipt) (name blake3)))
      (binding count (call std::list-length (types Text) (field (local stage) (name hashes))))
      (in (if (if (call postblob::admit (local ctx) (local id) (local index) (local size))
        (if (call util::token (local hash))
          (call std::text-equal (field (local receipt) (name key)) (call postblob::key (local id) (local index))) (bool false)) (bool false))
        (if (call std::i64-equal (local index) (local count))
          (call postblob::save (record structural (field id (field (local stage) (name id))) (field post (field (local stage) (name post))) (field owner (field (local stage) (name owner))) (field version (field (local stage) (name version))) (field size (field (local stage) (name size))) (field written (call std::add (field (local stage) (name written)) (local size))) (field lengths (call std::list-append (types I64) (field (local stage) (name lengths)) (local size))) (field hashes (call std::list-append (types Text) (field (local stage) (name hashes)) (local hash))) (field preview (if (call std::i64-equal (local index) (i64 0)) (local preview) (field (local stage) (name preview)))) (field state (field (local stage) (name state))) (field reserved (field (local stage) (name reserved))) (field created (field (local stage) (name created)))))
          (call std::text-equal (call std::list-get (types Text) (field (local stage) (name hashes)) (local index)) (local hash)))
        (bool false)))))

  )
  (function create finish (visibility public) (parameter create ctx (type Context)) (parameter create id (type Text))
    (returns Response) (effect (task (requirement service::app::store)))
    (body (let (binding stage (call postblob::read (local id)))
      (in (if (if (call postblob::stage-owner (local ctx) (local stage))
        (if (call std::i64-equal (field (local stage) (name written)) (field (local stage) (name size)))
          (if (call std::less (i64 0) (call std::list-length (types Text) (field (local stage) (name hashes))))
            (call util::has (list Text (text "uploading") (text "ready")) (field (local stage) (name state)) (i64 0)) (bool false))
          (bool false)) (bool false))
        (sequence (call postblob::save (record structural (field id (field (local stage) (name id))) (field post (field (local stage) (name post))) (field owner (field (local stage) (name owner))) (field version (field (local stage) (name version))) (field size (field (local stage) (name size))) (field written (field (local stage) (name written))) (field lengths (field (local stage) (name lengths))) (field hashes (field (local stage) (name hashes))) (field preview (field (local stage) (name preview))) (field state (text "ready")) (field reserved (field (local stage) (name reserved))) (field created (field (local stage) (name created)))))
          (call page::raw (i64 200) (call std::bytes-from-text (field (local stage) (name preview)))
            (text "text/plain; charset=utf-8") (list Header)))
        (call page::error (i64 409) (text "The post upload is incomplete or has changed."))))))

  )
  (function create linked (visibility public) (parameter create stage (type PostBodyStage)) (returns PostBodyStage) (effect pure) (body (record structural (field id (field (local stage) (name id))) (field post (field (local stage) (name post))) (field owner (field (local stage) (name owner))) (field version (field (local stage) (name version))) (field size (field (local stage) (name size))) (field written (field (local stage) (name written))) (field lengths (field (local stage) (name lengths))) (field hashes (field (local stage) (name hashes))) (field preview (field (local stage) (name preview))) (field state (text "linked")) (field reserved (i64 0)) (field created (field (local stage) (name created))))))

  (function create erase-record (visibility private) (parameter create kind (type Text)) (parameter create id (type Text))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (let (binding entries (call db::read (local kind) (local id)))
      (in (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local entries)) (i64 0))
        (bool true) (capability-call service::app::store std::DataStore::delete (static-text "lkjsns-v1")
          (call db::key (local kind) (local id)) (call db::expected (local entries)))))))

  )
  (function create abort (visibility private) (parameter create owner (type Text))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (capability-call service::app::store std::DataStore::delete (static-text "lkjsns-v1")
      (call db::key (text "post-body-corrupt") (local owner))
      (variant std::DataExpectation::Exact (call std::bytes-from-text (text ""))))))

  (function create source-cost (visibility public) (parameter create note (type Note)) (returns I64)
    (effect (task (requirement service::app::store)))
    (body (let (binding ref (call postblob::reference (field (local note) (name id))))
      (in (if (call std::text-equal (local ref) (text "")) (i64 0)
        (let (binding stage (call postblob::read (local ref)))
          (in (if (if (call std::text-equal (field (local stage) (name state)) (text "linked"))
                    (if (call std::text-equal (field (local stage) (name post)) (field (local note) (name id)))
                      (call std::text-equal (field (local stage) (name owner)) (field (local note) (name author))) (bool false))
                    (bool false))
            (call std::add (field (local stage) (name size))
              (call std::add (call postquota::stored (text "post-body-ref") (field (local note) (name id)))
                (call postquota::stored (text "post-body-blob") (local ref))))
            (i64 -1))))))))

  )
  (function create form-valid (visibility public)
    (parameter create ctx (type Context)) (parameter create note (type Note)) (parameter create form (type Form))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (let (binding blob (call util::value (local form) (text "blob")))
      (binding ref (call postblob::reference (field (local note) (name id))))
      (binding old (call postblob::source-cost (local note)))
      (in (if (call std::less (local old) (i64 0)) (bool false)
        (if (call std::text-equal (local blob) (text ""))
          (if (call std::text-equal (local ref) (text "")) (bool true)
            (call std::text-equal (call util::value (local form) (text "body-loaded")) (text "1")))
          (let (binding stage (call postblob::read (local blob)))
            (in (if (call postblob::stage-owner (local ctx) (local stage))
              (if (call std::text-equal (field (local stage) (name state)) (text "ready"))
                (if (call std::text-equal (field (local stage) (name post)) (field (local note) (name id)))
                  (if (call std::i64-equal (field (local stage) (name version)) (field (local note) (name version)))
                    (if (call std::text-equal (field (local stage) (name preview)) (call util::value (local form) (text "body")))
                      (call std::text-equal (call postblob::active (field (local ctx) (name user))) (local blob))
                      (bool false)) (bool false)) (bool false)) (bool false)) (bool false)))))))))

  )
  (function create delta (visibility public) (parameter create note (type Note)) (parameter create blob (type Text))
    (returns I64) (effect (task (requirement service::app::store)))
    (body (let (binding old (call postblob::source-cost (local note)))
      (in (if (call std::text-equal (local blob) (text "")) (call std::subtract (i64 0) (local old))
        (let (binding stage (call postblob::read (local blob))) (binding linked (call postblob::linked (local stage)))
          (binding cost (call std::add (field (local stage) (name size))
            (call std::add
              (call postquota::bytes (text "post-body-ref") (field (local note) (name id))
                (call std::data-encode (types Text) (local blob)))
              (call postquota::bytes (text "post-body-blob") (local blob)
                (call std::data-encode (types PostBodyStage) (local linked))))))
          (in (call std::subtract (call std::subtract (local cost) (local old)) (field (local stage) (name reserved)))))))))

  )
  ;; A retired identifier is never reused, including during concurrent cleanup.
  (function create retire (visibility private) (parameter create stage (type PostBodyStage)) (returns Bool)
    (effect (task (requirement service::app::store)))
    (body (call postblob::save (record structural
      (field id (field (local stage) (name id))) (field post (text "")) (field owner (field (local stage) (name owner)))
      (field version (i64 0)) (field size (i64 0)) (field written (i64 0)) (field lengths (list I64)) (field hashes (list Text))
      (field preview (text "")) (field state (text "retired")) (field reserved (i64 0)) (field created (field (local stage) (name created)))))))

  (function create queue (visibility private) (parameter create stage (type PostBodyStage)) (parameter create extra (type I64))
    (parameter create notbefore (type I64)) (returns Bool) (effect (task (requirement service::app::store)))
    (body (call db::put (text "post-body-gc") (field (local stage) (name id))
      (call std::data-encode (types PostBodyGarbage) (record structural
        (field id (field (local stage) (name id))) (field owner (field (local stage) (name owner)))
        (field next (i64 0)) (field notbefore (local notbefore)) (field count (call std::add (local extra)
          (call std::list-length (types I64) (field (local stage) (name lengths))))))))))

  (function create forget-old (visibility private) (parameter create ctx (type Context)) (parameter create note (type Note)) (returns Bool)
    (effect (task (requirement service::app::store)))
    (body (let (binding ref (call postblob::reference (field (local note) (name id))))
      (in (if (call std::text-equal (local ref) (text "")) (bool true)
        (let (binding stage (call postblob::read (local ref)))
          (in (sequence (call postblob::queue (local stage) (i64 0) (call std::add (field (local ctx) (name now)) (i64 360000)))
            (call postblob::erase-record (text "post-body-ref") (field (local note) (name id)))
            (call postblob::retire (local stage))))))))

  ))
  (function create commit (visibility public)
    (parameter create ctx (type Context)) (parameter create note (type Note)) (parameter create form (type Form))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (let (binding blob (call util::value (local form) (text "blob")))
      (binding delta (call postblob::delta (local note) (local blob)))
      (in (if (call postblob::form-valid (local ctx) (local note) (local form))
        (if (call postquota::adjust (field (local ctx) (name user)) (local delta))
          (sequence (call postblob::forget-old (local ctx) (local note))
            (if (call std::text-equal (local blob) (text "")) (bool true)
              (sequence
                (call db::put (text "post-body-ref") (field (local note) (name id)) (call std::data-encode (types Text) (local blob)))
                (call postblob::save (call postblob::linked (call postblob::read (local blob))))
                (call postblob::erase-record (text "post-body-active") (field (local ctx) (name user))))))
          (bool false)) (call postblob::abort (field (local ctx) (name user))))))))

  (function create remove (visibility public) (parameter create ctx (type Context)) (parameter create note (type Note)) (returns Bool)
    (effect (task (requirement service::app::store)))
    (body (let (binding old (call postblob::source-cost (local note)))
      (in (if (call std::less-equal (i64 0) (local old))
        (if (call postquota::adjust (field (local note) (name author)) (call std::subtract (i64 0) (local old)))
          (call postblob::forget-old (local ctx) (local note)) (bool false))
        (call postblob::abort (field (local note) (name author))))))))

  (function create cancel (visibility public) (parameter create ctx (type Context)) (parameter create id (type Text))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (let (binding stage (call postblob::read (local id)))
      (in (if (if (call postblob::stage-owner (local ctx) (local stage))
            (if (call util::has (list Text (text "uploading") (text "ready")) (field (local stage) (name state)) (i64 0))
              (call std::text-equal (call postblob::active (field (local ctx) (name user))) (local id)) (bool false)) (bool false))
        (if (call postquota::adjust (field (local ctx) (name user))
              (call std::subtract (i64 0) (field (local stage) (name reserved))))
          (sequence (call postblob::queue (local stage) (i64 1) (call std::add (field (local ctx) (name now)) (i64 360000)))
            (call postblob::erase-record (text "post-body-active") (field (local ctx) (name user)))
            (call postblob::retire (local stage)))
          (bool false)) (bool false))))))

)
