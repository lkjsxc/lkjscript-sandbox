(module create librarypath
  (function create filters (visibility public)
    (parameter create q (type Text)) (parameter create kind (type Text))
    (parameter create folder (type Text)) (parameter create cursor (type Text))
    (returns Bool) (effect pure)
    (body (if (call util::clean (local q) (i64 0) (i64 120))
      (if (call util::has (list Text (text "") (text "image") (text "video") (text "audio")) (local kind) (i64 0))
        (if (if (call std::text-equal (local folder) (text "")) (bool true)
          (if (call std::text-equal (local folder) (text "root")) (bool true) (call util::token (local folder))))
          (call navigation::reading-cursor (local cursor)) (bool false)) (bool false)) (bool false))))

  (function create core-fields (visibility public)
    (returns (list Text)) (effect pure)
    (body (list Text (text "intent") (text "csrf") (text "draft") (text "id")
      (text "version") (text "enabled") (text "destination"))))

  (function create form-valid (visibility public) (parameter create form (type Form)) (returns Bool) (effect pure) (body (if (call controls::schema (local form) (list Text (text "intent") (text "csrf") (text "draft") (text "id") (text "version") (text "enabled") (text "destination") (text "q") (text "kind") (text "folder") (text "cursor") (text "tag") (text "trail"))) (if (call paging::valid-trail (call util::value (local form) (text "trail"))) (if (call util::clean (call util::value (local form) (text "tag")) (i64 0) (i64 40)) (if (call librarypath::filters (call util::value (local form) (text "q")) (call util::value (local form) (text "kind")) (call util::value (local form) (text "folder")) (call util::value (local form) (text "cursor"))) (bool true) (bool false)) (bool false)) (bool false)) (if (call controls::schema (local form) (list Text (text "intent") (text "csrf") (text "draft") (text "id") (text "version") (text "enabled") (text "destination") (text "q") (text "kind") (text "folder") (text "cursor") (text "tag"))) (if (call util::clean (call util::value (local form) (text "tag")) (i64 0) (i64 40)) (call librarypath::filters (call util::value (local form) (text "q")) (call util::value (local form) (text "kind")) (call util::value (local form) (text "folder")) (call util::value (local form) (text "cursor"))) (bool false)) (if (if (call controls::schema (local form) (call librarypath::core-fields)) (bool true) (call controls::schema (local form) (list Text (text "intent") (text "csrf") (text "draft") (text "id") (text "version") (text "enabled") (text "destination") (text "q") (text "kind") (text "folder") (text "cursor")))) (call librarypath::filters (call util::value (local form) (text "q")) (call util::value (local form) (text "kind")) (call util::value (local form) (text "folder")) (call util::value (local form) (text "cursor"))) (bool false))))))

  (function create hidden (visibility public) (parameter create request (type Request)) (returns Text) (effect pure) (body (call std::text-join (list Text (call std::text-join (list Text (call page::hidden (text "tag") (call util::query (local request) (text "tag"))) (call page::hidden (text "q") (call util::query (local request) (text "q"))) (call page::hidden (text "kind") (call util::query (local request) (text "kind"))) (call page::hidden (text "folder") (call util::query (local request) (text "folder"))) (call page::hidden (text "cursor") (call util::query (local request) (text "cursor")))) (text "")) (call page::hidden (text "trail") (call util::query (local request) (text "trail")))) (text ""))))

  (function create return (visibility public) (parameter create form (type Form)) (returns Text) (effect pure) (body (call paging::with-trail (if (if (call librarypath::form-valid (local form)) (if (call util::token (call util::value (local form) (text "draft"))) (call util::token (call util::value (local form) (text "id"))) (bool false)) (bool false)) (if (call std::text-equal (call util::value (local form) (text "destination")) (text "compose")) (call paths::canonical (call std::text-join (list Text (text "/compose?id=") (call util::value (local form) (text "draft")) (text "&saved=1")) (text ""))) (if (call std::text-equal (call util::value (local form) (text "destination")) (text "picker")) (call std::text-join (list Text (text "/pick?draft=") (call util::value (local form) (text "draft")) (text "&saved=1&q=") (call navigation::encode (call util::value (local form) (text "q"))) (text "&kind=") (call navigation::encode (call util::value (local form) (text "kind"))) (text "&folder=") (call navigation::encode (call util::value (local form) (text "folder"))) (text "&cursor=") (call navigation::encode (call util::value (local form) (text "cursor"))) (call std::text-join (list Text (text "&tag=") (call navigation::encode (call util::value (local form) (text "tag")))) (text "")) (text "#file-") (call util::value (local form) (text "id"))) (text "")) (text "/drive"))) (text "/drive")) (call util::value (local form) (text "trail")))))

  (function create lower-bytes (visibility private)
    (parameter create bytes (type Bytes)) (parameter create index (type I64))
    (parameter create out (type (list I64)))
    (returns Bytes) (effect pure)
    (body (if (call std::less (local index) (call std::bytes-length (local bytes)))
      (let (binding byte (call std::bytes-get (local bytes) (local index)))
        (in (call librarypath::lower-bytes (local bytes) (call std::add (local index) (i64 1))
          (call std::list-append (types I64) (local out)
            (if (if (call std::less-equal (i64 65) (local byte))
              (call std::less-equal (local byte) (i64 90)) (bool false))
              (call std::add (local byte) (i64 32)) (local byte))))))
      (call std::bytes-from-list (local out)))))

  (function create lower (visibility public)
    (parameter create text (type Text))
    (returns Text) (effect pure)
    (body (call std::bytes-to-text (call librarypath::lower-bytes
      (call std::bytes-from-text (local text)) (i64 0) (list I64)))))

  (test create default-filters (visibility private)
    (actual (call librarypath::filters (text "") (text "") (text "") (text ""))) (expected (bool true)))
  (test create rejects-negative-page (visibility private)
    (actual (call librarypath::filters (text "") (text "image") (text "root") (text "-1"))) (expected (bool false)))
  (test create rejects-unknown-type (visibility private)
    (actual (call librarypath::filters (text "") (text "document") (text "") (text ""))) (expected (bool false)))
  (test create rejects-injected-folder (visibility private)
    (actual (call librarypath::filters (text "") (text "") (text "root&folder=other") (text ""))) (expected (bool false)))
  (test create accepts-normal-page (visibility private)
    (actual (call librarypath::filters (text "A&B") (text "video") (text "root") (text "30"))) (expected (bool true)))
  (test create attachment-without-filter-fields (visibility private)
    (actual (call librarypath::form-valid (call util::parse (call std::bytes-from-text
      (text "intent=attach&csrf=a&draft=b&id=c&version=1&enabled=1&destination=compose"))))) (expected (bool true)))
  (test create attachment-with-all-filter-fields (visibility private)
    (actual (call librarypath::form-valid (call util::parse (call std::bytes-from-text
      (text "intent=attach&csrf=a&draft=b&id=c&version=1&enabled=1&destination=picker&q=Photo&kind=image&folder=root&cursor=30"))))) (expected (bool true)))
  (test create partial-context-refused (visibility private)
    (actual (call librarypath::form-valid (call util::parse (call std::bytes-from-text
      (text "intent=attach&csrf=a&draft=b&id=c&version=1&enabled=1&destination=picker&q=Photo"))))) (expected (bool false)))
  (test create missing-csrf-refused (visibility private)
    (actual (call librarypath::form-valid (call util::parse (call std::bytes-from-text
      (text "intent=attach&draft=b&id=c&version=1&enabled=1&destination=picker&q=&kind=&folder=&cursor="))))) (expected (bool false)))
  (test create duplicate-context-refused (visibility private)
    (actual (call librarypath::form-valid (call util::parse (call std::bytes-from-text
      (text "intent=attach&csrf=a&draft=b&id=c&version=1&enabled=1&destination=picker&q=&kind=&folder=&cursor=&cursor=30"))))) (expected (bool false)))
  (test create case-independent-ascii-name (visibility private)
    (actual (call librarypath::lower (text "IMG_2026.PNG"))) (expected (text "img_2026.png")))
  (test create unicode-bytes-kept (visibility private)
    (actual (call librarypath::lower (text "Café-ÉCHO.PNG"))) (expected (text "café-Écho.png")))
  (test create empty-case-fold (visibility private)
    (actual (call librarypath::lower (text ""))) (expected (text "")))
)
