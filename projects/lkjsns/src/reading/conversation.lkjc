(module create conversation
  (function create summary (visibility public)
    (parameter create note (type Note))
    (returns Text) (effect pure)
    (body (call conversation::excerpt (if (call std::bool-not (call std::text-equal (field (local note) (name cw)) (text ""))) (call std::text-join (list Text (text "Content warning: ") (field (local note) (name cw))) (text "")) (if (call std::text-equal (field (local note) (name body)) (text "")) (if (call std::less (i64 0) (call std::list-length (types Text) (field (local note) (name media)))) (text "Media attachment") (text "Empty post")) (call markdown::preview (field (local note) (name body))))))))

  (function create destination (visibility public)
    (parameter create note (type Note))
    (parameter create place (type Text))
    (returns Text) (effect pure)
    (body (if (call util::post-id (field (local note) (name id)))
      (call std::text-join (list Text (text "/compose?reply=") (field (local note) (name id))) (text ""))
      (text "/"))))

  (function create readable (visibility public)
    (parameter create ctx (type Context))
    (parameter create note (type Note))
    (parameter create viewer (type User))
    (parameter create actor (type User))
    (returns Bool) (effect pure)
    (body (if (call access::visible (local ctx) (local note)) (if (field (local note) (name published)) (if (call util::handle (field (local actor) (name handle))) (if (call std::bool-not (field (local actor) (name suspended))) (if (call std::bool-not (call util::has (field (local viewer) (name muted)) (field (local note) (name author)) (i64 0))) (bool true) (bool false)) (bool false)) (bool false)) (bool false)) (bool false))))

  (function create context (visibility public)
    (parameter create ctx (type Context))
    (parameter create id (type Text))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (call conversation::parent (local ctx) (local id) (call db::user (field (local ctx) (name user))) (bool true) (bool false))))

  (test create warning-preview-never-includes-body (visibility private)
    (actual (call conversation::summary (record structural (field id (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")) (field author (text "alice")) (field body (text "Hidden body <script> & emoji 🌍")) (field cw (text "Spoilers <em>")) (field audience (text "public")) (field reply (text "")) (field media (list Text)) (field eyes (list Text)) (field created (i64 1)) (field edited (i64 1)) (field version (i64 1)) (field published (bool true)) (field deleted (bool false))))) (expected (text "Content warning: Spoilers <em>")))

  (test create plain-preview-preserves-unicode (visibility private)
    (actual (call conversation::summary (record structural (field id (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")) (field author (text "alice")) (field body (text "An intact 🌍, not a split byte.")) (field cw (text "")) (field audience (text "public")) (field reply (text "")) (field media (list Text)) (field eyes (list Text)) (field created (i64 1)) (field edited (i64 1)) (field version (i64 1)) (field published (bool true)) (field deleted (bool false))))) (expected (text "An intact 🌍, not a split byte.")))

  (test create media-only-preview (visibility private)
    (actual (call conversation::summary (record structural (field id (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")) (field author (text "alice")) (field body (text "")) (field cw (text "")) (field audience (text "public")) (field reply (text "")) (field media (list Text (text "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"))) (field eyes (list Text)) (field created (i64 1)) (field edited (i64 1)) (field version (i64 1)) (field published (bool true)) (field deleted (bool false))))) (expected (text "Media attachment")))

  (test create feed-reply-opens-editor (visibility private)
    (actual (call conversation::destination (record structural (field id (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")) (field author (text "alice")) (field body (text "Hidden body <script> & emoji 🌍")) (field cw (text "Spoilers <em>")) (field audience (text "public")) (field reply (text "")) (field media (list Text)) (field eyes (list Text)) (field created (i64 1)) (field edited (i64 1)) (field version (i64 1)) (field published (bool true)) (field deleted (bool false))) (text "home"))) (expected (text "/compose?reply=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))

  (test create parent-reply-opens-editor (visibility private)
    (actual (call conversation::destination (record structural (field id (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")) (field author (text "alice")) (field body (text "Hidden body <script> & emoji 🌍")) (field cw (text "Spoilers <em>")) (field audience (text "public")) (field reply (text "")) (field media (list Text)) (field eyes (list Text)) (field created (i64 1)) (field edited (i64 1)) (field version (i64 1)) (field published (bool true)) (field deleted (bool false))) (text "thread:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))) (expected (text "/compose?reply=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))

  (test create nested-reply-opens-editor (visibility private)
    (actual (call conversation::destination (record structural (field id (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")) (field author (text "alice")) (field body (text "Hidden body <script> & emoji 🌍")) (field cw (text "Spoilers <em>")) (field audience (text "public")) (field reply (text "")) (field media (list Text)) (field eyes (list Text)) (field created (i64 1)) (field edited (i64 1)) (field version (i64 1)) (field published (bool true)) (field deleted (bool false))) (text "thread:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"))) (expected (text "/compose?reply=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))

  (test create invalid-destination-fails-closed (visibility private)
    (actual (call conversation::destination (record structural (field id (text "bad&query")) (field author (text "alice")) (field body (text "Hidden body <script> & emoji 🌍")) (field cw (text "Spoilers <em>")) (field audience (text "public")) (field reply (text "")) (field media (list Text)) (field eyes (list Text)) (field created (i64 1)) (field edited (i64 1)) (field version (i64 1)) (field published (bool true)) (field deleted (bool false))) (text "home"))) (expected (text "/")))
  (function create empty-feed (visibility public)
    (parameter create kind (type Text)) (parameter create signed (type Bool))
    (parameter create more (type Bool)) (returns Text) (effect pure)
    (body (if (local more)
      (text "<div class=\"empty\"><h2>No matching posts on this page</h2><p>Older posts may match this view. Continue to the next page.</p></div>")
      (if (call std::text-equal (local kind) (text "drafts"))
        (call page::empty (text "No drafts to show")
          (text "Saved drafts are private. Start a post and save it to return later.")
          (text "/compose") (text "New post"))
        (if (call std::text-equal (local kind) (text "attention"))
          (call page::empty (text "No posts to show")
            (text "Give attention to people to see their posts here. Your own posts appear here too.")
            (text "/people") (text "Find members"))
          (if (local signed)
            (call page::empty (text "No posts to show")
              (text "Write a post to start a conversation.") (text "/compose") (text "New post"))
            (call page::empty (text "No public posts to show")
              (text "Public posts will appear here. Sign in to see members-only conversations.")
              (text "/login") (text "Sign in"))))))))

  (test create attention-empty-leads-to-members (visibility private)
    (actual (call std::text-contains (call conversation::empty-feed (text "attention") (bool true) (bool false)) (text "Find members"))) (expected (bool true)))
  (test create guest-empty-explains-public-view (visibility private)
    (actual (call std::text-contains (call conversation::empty-feed (text "everyone") (bool false) (bool false)) (text "No public posts to show"))) (expected (bool true)))
  (test create sparse-page-does-not-claim-global-emptiness (visibility private)
    (actual (call std::text-contains (call conversation::empty-feed (text "attention") (bool true) (bool true)) (text "on this page"))) (expected (bool true)))
  (function create excerpt (visibility public)
    (parameter create value (type Text))
    (returns Text) (effect pure)
    (body (if (call std::less (i64 360) (call util::size (local value))) (call std::text-join (list Text (call util::slice (local value) (i64 0) (call searchtext::boundary (call std::bytes-from-text (local value)) (i64 360))) (text "…")) (text "")) (local value))))

  (function create preview (visibility public) (parameter create note (type Note)) (parameter create composing (type Bool))
    (returns Text) (effect pure) (body (call conversation::preview-view (local note) (call db::empty-user) (field (local note) (name created)) (local composing) (text "") (bool false))))

  (function create parent (visibility public)
    (parameter create ctx (type Context))
    (parameter create id (type Text))
    (parameter create viewer (type User))
    (parameter create composing (type Bool))
    (parameter create absolute (type Bool))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (if (call util::post-id (local id)) (let (binding note (call db::note (local id))) (binding actor (call db::user (field (local note) (name author)))) (in (if (call conversation::readable (local ctx) (local note) (local viewer) (local actor)) (call conversation::preview-view (local note) (local actor) (field (local ctx) (name now)) (local composing)
  (if (call std::text-equal (field (local note) (name audience)) (call util::share-audience (field (local ctx) (name share)))) (field (local ctx) (name share)) (text "")) (local absolute)) (if (local composing) (text "<aside class=\"reply-preview parent-unavailable\" aria-label=\"Original post\"><p class=\"field-help\">Original post unavailable.</p></aside>") (text "<div class=\"reply-context parent-unavailable\" role=\"note\">Original post unavailable.</div>"))))) (text ""))))

  (function create show-parent (visibility public)
    (parameter create note (type Note))
    (parameter create place (type Text))
    (returns Bool) (effect pure)
    (body (if (call util::post-id (field (local note) (name reply))) (if (call std::bool-not (call std::text-equal (field (local note) (name reply)) (field (local note) (name id)))) (if (call std::bool-not (call std::text-equal (local place) (call std::text-join (list Text (text "thread:") (field (local note) (name reply))) (text "")))) (bool true) (bool false)) (bool false)) (bool false))))

  (test create short-excerpt-unchanged (visibility private) (actual (call conversation::excerpt (text "日本語 🌍"))) (expected (text "日本語 🌍")))

  (test create utf8-boundary-safe (visibility private) (actual (call conversation::excerpt (text "🌍tail"))) (expected (text "🌍…")))

  (test create long-excerpt-bounded (visibility private) (actual (call std::less-equal (call util::size (call conversation::excerpt (text "日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日"))) (i64 367))) (expected  (bool true)))


  (function create preview-view (visibility public) (parameter create note (type Note)) (parameter create actor (type User))
    (parameter create now (type I64)) (parameter create composing (type Bool)) (parameter create share (type Text)) (parameter create absolute (type Bool)) (returns Text) (effect pure)
    (body (call std::text-join (list Text
      (text "<a class=\"reply-preview parent-card\" href=\"")
      (call std::html-escape-text (call util::post-link (field (local note) (name id)) (local share))) (text "\"")
      (if (local composing) (text " target=\"_blank\" rel=\"noopener noreferrer\"") (text ""))
      (text "><span class=\"sr-only\">Original post by </span><span class=\"parent-identity\">") (call page::avatar (field (local note) (name author)))
      (text "<span class=\"parent-person\"><strong>")
      (call std::html-escape-text (if (call std::text-equal (field (local actor) (name display)) (text "")) (field (local note) (name author)) (field (local actor) (name display))))
      (text "</strong><span class=\"meta\">@") (call std::html-escape-text (field (local note) (name author)))
      (text " · ") (call page::post-time (local now) (field (local note) (name created)) (local absolute))
      (text "</span></span></span><span class=\"context-copy\">")
      (call std::html-escape-text (call conversation::summary (local note)))
      (text "</span>") (if (local composing) (text "<span class=\"sr-only\">Opens in a new tab</span>") (text "")) (text "</a>")) (text ""))))
)
