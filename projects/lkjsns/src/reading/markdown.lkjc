(module create markdown

  (function create block-at (visibility public) (parameter create value (type Text)) (parameter create data (type Bytes)) (parameter create at (type I64)) (parameter create mode (type I64)) (returns MarkdownBlock) (effect pure)
    (body (let (binding end (call mdline::line-end (local data) (local at)))
      (in (if (call mdline::fence-start (local data) (local at) (local end))
        (call mdline::fence-block (local value) (local data) (local at) (local end) (local mode))
      (if (call mdtable::table-start (local data) (local at) (local end))
        (call mdtable::table-block (local value) (local data) (local at) (local end) (local mode))
      (if (call mdline::rule (local data) (local at) (local end))
        (record structural (field html (if (call std::i64-equal (local mode) (i64 1)) (text "\n") (text "<hr>"))) (field next (call mdline::after-line (local data) (local end))))
      (if (field (call mdlists::item (local value) (local data) (local at)) (name valid))
        (call mdlists::list-group (local value) (local data) (local at) (i64 0) (local mode))
      (let (binding level (call mdline::heading-level (local data) (local at) (local end)))
        (in (if (call std::less (i64 0) (local level))
          (record structural (field html (call mdinline::join3
            (call mdinline::tag (call std::text-join (list Text (text "h") (call std::i64-to-text (if (call std::less (local level) (i64 6)) (call std::add (local level) (i64 1)) (i64 6)))) (text ""))
              (call mdinline::inline (call util::slice (local value) (call mdline::trim-left (local data) (call std::add (local at) (local level)) (local end)) (local end)) (i64 0) (local mode)) (local mode))
            (if (call std::i64-equal (local mode) (i64 1)) (text "\n") (text "")) (text ""))) (field next (call mdline::after-line (local data) (local end))))
          (if (call std::i64-equal (call mdinline::byte (local data) (local at)) (i64 62))
            (record structural (field html (call mdinline::join3
              (call mdinline::tag (text "blockquote") (call mdinline::inline (call util::slice (local value) (call mdline::trim-left (local data) (call std::add (local at) (i64 1)) (local end)) (local end)) (i64 0) (local mode)) (local mode))
              (if (call std::i64-equal (local mode) (i64 1)) (text "\n") (text "")) (text ""))) (field next (call mdline::after-line (local data) (local end))))
            (record structural (field html (call mdinline::join3 (call mdinline::inline (call util::slice (local value) (local at) (local end)) (i64 0) (local mode))
              (if (call std::less (local end) (call std::bytes-length (local data))) (text "\n") (text "")) (text ""))) (field next (call mdline::after-line (local data) (local end))))))))))))))

  ))

  (function create blocks (visibility public) (parameter create value (type Text)) (parameter create data (type Bytes)) (parameter create at (type I64)) (parameter create mode (type I64)) (parameter create fuel (type I64)) (parameter create out (type (list Text))) (returns Text) (effect pure)
    (body (if (if (call std::less (local at) (call std::bytes-length (local data))) (call std::less (i64 0) (local fuel)) (bool false))
      (let (binding block (call markdown::block-at (local value) (local data) (local at) (local mode)))
        (in (if (call std::less (local at) (field (local block) (name next)))
          (call markdown::blocks (local value) (local data) (field (local block) (name next)) (local mode) (call std::subtract (local fuel) (i64 1)) (call std::list-append (types Text) (local out) (field (local block) (name html))))
          (call std::text-join (call std::list-append (types Text) (local out) (call mdinline::emit (call util::slice (local value) (local at) (call std::bytes-length (local data))) (local mode))) (text "")))))
      (call std::text-join (call std::list-append (types Text) (local out) (call mdinline::emit (call util::slice (local value) (local at) (call std::bytes-length (local data))) (local mode))) (text "")))))

  ;; Skip token scanning when no supported markup can begin in the text.
  (function create special-start (visibility public) (parameter create value (type Text)) (returns Bool) (effect pure)
    (body (let (binding b (call mdinline::byte (call std::bytes-from-text (local value)) (i64 0)))
      (in (if (call std::i64-equal (local b) (i64 32)) (bool true)
        (if (call std::i64-equal (local b) (i64 9)) (bool true)
        (if (call std::i64-equal (local b) (i64 35)) (bool true)
        (if (call std::i64-equal (local b) (i64 62)) (bool true)
        (if (call std::i64-equal (local b) (i64 45)) (bool true)
        (if (call std::i64-equal (local b) (i64 43)) (bool true)
          (if (call std::less-equal (i64 48) (local b)) (call std::less-equal (local b) (i64 57)) (bool false))))))))))))

  (function create possible (visibility public) (parameter create value (type Text)) (returns Bool) (effect pure)
    (body (if (call std::text-contains (local value) (text "*")) (bool true)
        (if (call std::text-contains (local value) (text "_")) (bool true)
        (if (call std::text-contains (local value) (text "~")) (bool true)
        (if (call std::text-contains (local value) (text "`")) (bool true)
        (if (call std::text-contains (local value) (text "[")) (bool true)
        (if (call std::text-contains (local value) (text "\\")) (bool true)
        (if (call markdown::special-start (local value)) (bool true)
      (if (call std::text-contains (local value) (text "\n")) (if (call std::text-contains (local value) (text "|")) (bool true)
        (if (call std::text-contains (local value) (text "\n ")) (bool true)
        (if (call std::text-contains (local value) (text "\n\t")) (bool true)
        (if (call std::text-contains (local value) (text "\n#")) (bool true)
        (if (call std::text-contains (local value) (text "\n>")) (bool true)
        (if (call std::text-contains (local value) (text "\n-")) (bool true)
        (if (call std::text-contains (local value) (text "\n+")) (bool true)
        (if (call std::text-contains (local value) (text "\n0")) (bool true)
        (if (call std::text-contains (local value) (text "\n1")) (bool true)
        (if (call std::text-contains (local value) (text "\n2")) (bool true)
        (if (call std::text-contains (local value) (text "\n3")) (bool true)
        (if (call std::text-contains (local value) (text "\n4")) (bool true)
        (if (call std::text-contains (local value) (text "\n5")) (bool true)
        (if (call std::text-contains (local value) (text "\n6")) (bool true)
        (if (call std::text-contains (local value) (text "\n7")) (bool true)
        (if (call std::text-contains (local value) (text "\n8")) (bool true)
        (if (call std::text-contains (local value) (text "\n9")) (bool true)
        (bool false)))))))))))))))))) (bool false)))))))))))

  (function create render (visibility public) (parameter create value (type Text)) (returns Text) (effect pure)
    (body (if (call markdown::possible (local value))
      (call markdown::blocks (local value) (call std::bytes-from-text (local value)) (i64 0) (i64 0) (i64 2048) (list Text))
      (call links::render (local value)))))

  (function create plain (visibility public) (parameter create value (type Text)) (returns Text) (effect pure)
    (body (if (call markdown::possible (local value))
      (call markdown::blocks (local value) (call std::bytes-from-text (local value)) (i64 0) (i64 1) (i64 2048) (list Text))
      (local value))))

  ;; Excerpts have a small output limit, so bound the source parsed per parent.
  (function create preview (visibility public) (parameter create value (type Text)) (returns Text) (effect pure)
    (body (if (call std::less (i64 2048) (call util::size (local value)))
      (let (binding end (call searchtext::boundary (call std::bytes-from-text (local value)) (i64 2048)))
        (in (call mdinline::join3 (call markdown::plain (call util::slice (local value) (i64 0) (local end))) (text "…") (text ""))))
      (call markdown::plain (local value)))))

  (test create inline-emphasis (visibility private)
    (actual (call markdown::render (text "Hello **bold** and *soft* ~~old~~.")))
    (expected (text "Hello <strong>bold</strong> and <em>soft</em> <del>old</del>.")))
  (test create safe-html (visibility private)
    (actual (call markdown::render (text "<script>alert(1)</script> [bad](javascript:alert(1))")))
    (expected (text "&lt;script&gt;alert(1)&lt;/script&gt; [bad](javascript:alert(1))")))
  (test create inline-code-literal (visibility private)
    (actual (call markdown::render (text "`<x> **literal** https://example.test`")))
    (expected (text "<code>&lt;x&gt; **literal** https://example.test</code>")))
  (test create heading-and-quote (visibility private)
    (actual (call markdown::render (text "# Title\n> hello **world**")))
    (expected (text "<h2>Title</h2><blockquote>hello <strong>world</strong></blockquote>")))
  (test create nested-list (visibility private)
    (actual (call markdown::render (text "- one\n  - two\n- three")))
    (expected (text "<ul><li>one<ul><li>two</li></ul></li><li>three</li></ul>")))
  (test create fenced-code (visibility private)
    (actual (call markdown::render (text "```js\n<x>\n```")))
    (expected (text "<pre><code>&lt;x&gt;\n</code></pre>")))
  (test create plain-summary (visibility private)
    (actual (call markdown::plain (text "**Hello** [world](https://example.test)")))
    (expected (text "Hello world")))
  (test create image-does-not-fetch (visibility private)
    (actual (call std::text-contains (call markdown::render (text "![cat](https://example.test/cat.png)")) (text "<img")))
    (expected (bool false)))

  (test create markdown-table (visibility private)
    (actual (call std::text-contains (call markdown::render (text "| Name | Value |\n| --- | --- |\n| A | **B** |")) (text "<td><strong>B</strong></td>")))
    (expected (bool true)))
  (test create task-checkbox (visibility private)
    (actual (call std::text-contains (call markdown::render (text "- [x] done")) (text "checked disabled")))
    (expected (bool true)))
  (test create protocol-relative-link-rejected (visibility private)
    (actual (call std::text-contains (call markdown::render (text "[bad](//evil.test)")) (text "<a ")))
    (expected (bool false)))
  (test create nested-anchors-rejected (visibility private)
    (actual (call std::text-contains (call markdown::render (text "[https://a.test](https://b.test)")) (text "<a class=\"post-link\" href=\"https://a.test")))
    (expected (bool false)))

  (test create nested-emphasis (visibility private)
    (actual (call markdown::render (text "*soft **bold** soft* and ***both***")))
    (expected (text "<em>soft <strong>bold</strong> soft</em> and <strong><em>both</em></strong>")))

  (test create ordered-list-start (visibility private)
    (actual (call markdown::render (text "3. first\n4. next")))
    (expected (text "<ol start=\"3\"><li>first</li><li>next</li></ol>")))
  (test create preview-small-source (visibility private)
    (actual (call markdown::preview (text "**Hello** 🌍")))
    (expected (text "Hello 🌍")))

  (test create plain-multiline-fast-path (visibility private)
    (actual (call markdown::render (text "A plain line.\nAnother plain line.")))
    (expected (text "A plain line.\nAnother plain line.")))
  (test create markup-on-later-line (visibility private)
    (actual (call markdown::render (text "Ordinary text\n# Heading")))
    (expected (text "Ordinary text\n<h2>Heading</h2>")))

)
