  (function create render (visibility public) (parameter create value (type Text)) (returns Text) (effect pure) (body (call links::scan (local value) (call std::bytes-from-text (local value)) (i64 0) (i64 0) (list Text) (i64 128))))

  (test create link-plain (visibility private) (actual (call links::render (text "Nothing to link."))) (expected (text "Nothing to link.")))

  (test create link-simple (visibility private) (actual (call links::render (text "See https://example.test/path"))) (expected (text "See <a class=\"post-link\" href=\"https://example.test/path\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://example.test/path<span class=\"external-mark\" aria-hidden=\"true\">↗</span><span class=\"sr-only\"> (opens in a new tab)</span></a>")))

  (test create link-http-uppercase (visibility private) (actual (call links::render (text "HTTP://EXAMPLE.TEST"))) (expected (text "<a class=\"post-link\" href=\"HTTP://EXAMPLE.TEST\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">HTTP://EXAMPLE.TEST<span class=\"external-mark\" aria-hidden=\"true\">↗</span><span class=\"sr-only\"> (opens in a new tab)</span></a>")))

  (test create link-ampersand (visibility private) (actual (call links::render (text "https://example.test/?a=1&b=2"))) (expected (text "<a class=\"post-link\" href=\"https://example.test/?a=1&amp;b=2\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://example.test/?a=1&amp;b=2<span class=\"external-mark\" aria-hidden=\"true\">↗</span><span class=\"sr-only\"> (opens in a new tab)</span></a>")))

  (test create link-sentence (visibility private) (actual (call links::render (text "See (https://example.test/path)."))) (expected (text "See (<a class=\"post-link\" href=\"https://example.test/path\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://example.test/path<span class=\"external-mark\" aria-hidden=\"true\">↗</span><span class=\"sr-only\"> (opens in a new tab)</span></a>).")))

  (test create link-balanced-parentheses (visibility private) (actual (call links::render (text "https://example.test/wiki/Item_(term)"))) (expected (text "<a class=\"post-link\" href=\"https://example.test/wiki/Item_(term)\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://example.test/wiki/Item_(term)<span class=\"external-mark\" aria-hidden=\"true\">↗</span><span class=\"sr-only\"> (opens in a new tab)</span></a>")))

  (test create link-query-fragment (visibility private) (actual (call links::render (text "https://example.test/x?q=yes#part"))) (expected (text "<a class=\"post-link\" href=\"https://example.test/x?q=yes#part\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://example.test/x?q=yes#part<span class=\"external-mark\" aria-hidden=\"true\">↗</span><span class=\"sr-only\"> (opens in a new tab)</span></a>")))

  (test create link-multibyte (visibility private) (actual (call links::render (text "見る https://example.test/道。次"))) (expected (text "見る <a class=\"post-link\" href=\"https://example.test/道\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://example.test/道<span class=\"external-mark\" aria-hidden=\"true\">↗</span><span class=\"sr-only\"> (opens in a new tab)</span></a>。次")))

  (test create link-japanese-adjacent (visibility private) (actual (call links::render (text "案内https://example.test/入口です。"))) (expected (text "案内<a class=\"post-link\" href=\"https://example.test/入口です\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://example.test/入口です<span class=\"external-mark\" aria-hidden=\"true\">↗</span><span class=\"sr-only\"> (opens in a new tab)</span></a>。")))

  (test create link-ipv6 (visibility private) (actual (call links::render (text "http://[::1]:8080/a"))) (expected (text "<a class=\"post-link\" href=\"http://[::1]:8080/a\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">http://[::1]:8080/a<span class=\"external-mark\" aria-hidden=\"true\">↗</span><span class=\"sr-only\"> (opens in a new tab)</span></a>")))

  (test create link-two-lines (visibility private) (actual (call links::render (text "https://one.test\nhttps://two.test"))) (expected (text "<a class=\"post-link\" href=\"https://one.test\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://one.test<span class=\"external-mark\" aria-hidden=\"true\">↗</span><span class=\"sr-only\"> (opens in a new tab)</span></a>\n<a class=\"post-link\" href=\"https://two.test\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://two.test<span class=\"external-mark\" aria-hidden=\"true\">↗</span><span class=\"sr-only\"> (opens in a new tab)</span></a>")))

  (test create link-scheme-only (visibility private) (actual (call links::render (text "https://"))) (expected (text "https://")))

  (test create link-embedded-word (visibility private) (actual (call links::render (text "abchttps://example.test"))) (expected (text "abchttps://example.test")))

  (test create link-unsafe-scheme (visibility private) (actual (call links::render (text "javascript:alert(1) data:text/html,bad"))) (expected (text "javascript:alert(1) data:text/html,bad")))

  (test create link-markup (visibility private) (actual (call links::render (text "<img src=x onerror=alert(1)>"))) (expected (text "&lt;img src=x onerror=alert(1)&gt;")))

  (test create link-no-backslash (visibility private) (actual (call links::render (text "https://example.test/path\\more"))) (expected (text "<a class=\"post-link\" href=\"https://example.test/path\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://example.test/path<span class=\"external-mark\" aria-hidden=\"true\">↗</span><span class=\"sr-only\"> (opens in a new tab)</span></a>\\more")))

  (test create link-html-delimiter (visibility private) (actual (call links::render (text "https://example.test/<script>bad</script>"))) (expected (text "<a class=\"post-link\" href=\"https://example.test/\" target=\"_blank\" rel=\"noopener noreferrer nofollow ugc\">https://example.test/<span class=\"external-mark\" aria-hidden=\"true\">↗</span><span class=\"sr-only\"> (opens in a new tab)</span></a>&lt;script&gt;bad&lt;/script&gt;")))

  (test create link-empty-host (visibility private) (actual (call links::render (text "https://?bad"))) (expected (text "https://?bad")))

