(module create returnnav
  (function create path-end (visibility public) (parameter create url (type Text)) (parameter create index (type I64))
    (returns I64) (effect pure)
    (body (if (call std::less (local index) (call util::size (local url)))
      (if (call util::has (list Text (text "?") (text "#")) (call util::slice (local url) (local index) (call std::add (local index) (i64 1))) (i64 0))
        (local index) (call returnnav::path-end (local url) (call std::add (local index) (i64 1)))) (local index))))
  (function create characters (visibility private) (parameter create value (type Bytes)) (parameter create index (type I64))
    (returns Bool) (effect pure)
    (body (if (call std::less (local index) (call std::bytes-length (local value)))
      (let (binding byte (call std::bytes-get (local value) (local index)))
        (in (if (if (call std::less (local byte) (i64 32)) (bool true)
          (if (call std::i64-equal (local byte) (i64 127)) (bool true) (call std::i64-equal (local byte) (i64 92))))
          (bool false) (call returnnav::characters (local value) (call std::add (local index) (i64 1)))))) (bool true))))
  (function create readable (visibility public) (parameter create url (type Text)) (returns Bool) (effect pure)
    (body (if (if (call std::text-starts-with (local url) (text "/"))
      (if (call std::bool-not (call std::text-starts-with (local url) (text "//")))
        (if (call std::less-equal (call util::size (local url)) (i64 2048))
          (call returnnav::characters (call std::bytes-from-text (local url)) (i64 0)) (bool false)) (bool false)) (bool false))
      (let (binding path (call util::slice (local url) (i64 0) (call returnnav::path-end (local url) (i64 0))))
        (in (if (call util::has (list Text (text "/") (text "/saved") (text "/search") (text "/notifications") (text "/people")
          (text "/drive") (text "/link-posts") (text "/attention") (text "/profile") (text "/note") (text "/file") (text "/more")) (local path) (i64 0)) (bool true)
          (if (call util::handle (call paths::member-id (local path))) (bool true)
            (if (call util::post-id (call paths::id (local path))) (call std::text-equal (call paths::suffix (local path)) (text "")) (bool false)))))) (bool false))))
  (function create local-referrer (visibility public) (parameter create host (type Text)) (parameter create referrer (type Text))
    (returns Text) (effect pure)
    (body (let (binding secure (call std::text-join (list Text (text "https://") (local host)) (text "")))
      (binding plain (call std::text-join (list Text (text "http://") (local host)) (text "")))
      (binding prefix (if (call std::text-starts-with (local referrer) (call std::text-join (list Text (local secure) (text "/")) (text "")))
        (local secure) (if (call std::text-starts-with (local referrer) (call std::text-join (list Text (local plain) (text "/")) (text ""))) (local plain) (text ""))))
      (in (if (call std::text-equal (local prefix) (text "")) (text "/")
        (let (binding relative (call util::slice (local referrer) (call util::size (local prefix)) (call util::size (local referrer))))
          (in (if (call returnnav::readable (local relative)) (call paths::canonical (local relative)) (text "/")))))))))
  (function create destination (visibility public) (parameter create host (type Text)) (parameter create referrer (type Text))
    (parameter create id (type Text)) (returns Text) (effect pure)
    (body (let (binding relative (call returnnav::local-referrer (local host) (local referrer)))
      (binding path (call util::slice (local relative) (i64 0) (call returnnav::path-end (local relative) (i64 0))))
      (in (if (if (call std::text-equal (local path) (call paths::post (local id))) (bool true)
        (call std::text-equal (local path) (call paths::resource (local id)))) (text "/") (local relative))))))
  (function create back (visibility public) (parameter create request (type Request)) (parameter create id (type Text))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (text "<nav class=\"post-navigation\" aria-label=\"Post navigation\"><a class=\"back-link\" data-post-back href=\"")
      (call std::html-escape-text (call returnnav::destination (call util::header (local request) (text "host"))
        (call util::header (local request) (text "referer")) (local id)))
      (text "\">") (call page::icon (text "arrow")) (text "<span>Back</span></a></nav>")) (text ""))))
  (test create back-retains-filter-and-page (visibility private)
    (actual (call returnnav::destination (text "example.test") (text "https://example.test/?feed=attention&cursor=30&trail=_") (text "0123456789abcdef")))
    (expected (text "/?feed=attention&cursor=30&trail=_")))
  (test create back-no-external (visibility private)
    (actual (call returnnav::local-referrer (text "example.test") (text "https://evil.test/@alice"))) (expected (text "/")))
  (test create back-no-host-prefix-trick (visibility private)
    (actual (call returnnav::local-referrer (text "example.test") (text "https://example.test.evil.test/@alice"))) (expected (text "/")))
  (test create back-no-editor-loop (visibility private)
    (actual (call returnnav::local-referrer (text "example.test") (text "https://example.test/0123456789abcdef/edit"))) (expected (text "/")))
  (test create back-no-self-loop (visibility private)
    (actual (call returnnav::destination (text "example.test") (text "https://example.test/0123456789abcdef?cursor=30") (text "0123456789abcdef"))) (expected (text "/")))
  (test create back-no-backslash (visibility private) (actual (call returnnav::readable (text "/\\evil.test"))) (expected (bool false)))
  (test create back-no-network-path (visibility private) (actual (call returnnav::readable (text "//evil.test"))) (expected (bool false)))
  (test create back-keeps-profile (visibility private)
    (actual (call returnnav::local-referrer (text "example.test") (text "https://example.test/@alice?cursor=30"))) (expected (text "/@alice?cursor=30")))
)
