(module create postindex
  (function create state (visibility public) (parameter create phase (type I64)) (parameter create user (type I64))
    (parameter create index (type I64)) (parameter create done (type Bool)) (parameter create valid (type Bool))
    (returns PostIndexProgress) (effect pure)
    (body (record structural (field phase (local phase)) (field user (local user)) (field index (local index)) (field done (local done)) (field valid (local valid)))))
  (function create progress (visibility public) (returns PostIndexProgress) (effect (task (requirement service::app::store)))
    (body (let (binding rows (call db::read (text "post-index") (text "v1")))
      (in (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local rows)) (i64 0))
        (call postindex::state (i64 0) (i64 0) (i64 0) (bool false) (bool true))
        (call std::data-decode-or (types PostIndexProgress) (field (call std::list-get (types std::DataEntry) (local rows) (i64 0)) std::DataEntry::value)
          (call postindex::state (i64 0) (i64 0) (i64 0) (bool false) (bool false))))))))
  (function create item (visibility public) (parameter create name (type Text)) (parameter create index (type I64))
    (returns Text) (effect (task (requirement service::app::store)))
    (body (let (binding rows (call db::bucket (local name) (local index)))
      (binding offset (call std::subtract (local index) (call std::multiply (call std::divide (local index) (i64 32)) (i64 32))))
      (in (if (call std::less (local offset) (call std::list-length (types Text) (local rows)))
        (call std::list-get (types Text) (local rows) (local offset)) (text ""))))))
  (function create walk (visibility public) (parameter create phase (type I64)) (parameter create user (type I64))
    (parameter create index (type I64)) (parameter create budget (type I64))
    (returns PostIndexProgress) (effect (task (requirement service::app::store)))
    (body (if (call std::less-equal (local budget) (i64 0)) (call postindex::state (local phase) (local user) (local index) (bool false) (bool true))
      (if (if (call std::i64-equal (local phase) (i64 1)) (call std::less-equal (call db::count (text "users")) (local user)) (bool false))
        (call postindex::state (local phase) (local user) (local index) (bool true) (bool true))
        (let (binding name (if (call std::i64-equal (local phase) (i64 0)) (text "timeline")
          (call std::text-join (list Text (text "draft/") (call postindex::item (text "users") (local user))) (text ""))))
          (in (if (call std::less-equal (call db::count (local name)) (local index))
            (call postindex::walk (i64 1) (if (call std::i64-equal (local phase) (i64 0)) (i64 0) (call std::add (local user) (i64 1)))
              (i64 0) (call std::subtract (local budget) (i64 1)))
            (let (binding id (call postindex::item (local name) (local index))) (binding note (call db::note (local id)))
              (in (if (if (call util::post-id (field (local note) (name id))) (call postids::reserve (field (local note) (name id))) (bool true))
                (call postindex::walk (local phase) (local user) (call std::add (local index) (i64 1)) (call std::subtract (local budget) (i64 1)))
                (call postindex::state (local phase) (local user) (local index) (bool false) (bool false))))))))))))
  (function create step (visibility public) (returns I64) (effect (task (requirement service::app::store)))
    (body (let (binding previous (call postindex::progress))
      (in (if (field (local previous) (name valid))
        (if (field (local previous) (name done)) (i64 0)
          (let (binding next (call postindex::walk (field (local previous) (name phase)) (field (local previous) (name user))
            (field (local previous) (name index)) (i64 16)))
            (in (if (field (local next) (name valid))
              (sequence (call db::put (text "post-index") (text "v1") (call std::data-encode (types PostIndexProgress) (local next)))
                (if (field (local next) (name done)) (i64 0) (i64 1))) (i64 -2))))) (i64 -2))))))
  (function create run (visibility public) (returns I64) (effect (task (requirement service::app::store)))
    (body (match (transaction-outcome service::app::store (types I64)
      (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
      (binding action) (call postindex::step))
      (arm std::TransactionOutcome::Committed (payload result I64) (local result))
      (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason) (i64 -1)))))

  (function create ready (visibility public) (returns Bool) (effect (task (requirement service::app::store)))
    (body (let (binding progress (call postindex::progress)) (in (if (field (local progress) (name valid)) (field (local progress) (name done)) (bool false))))))
)
