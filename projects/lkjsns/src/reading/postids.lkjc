(module create postids
  (function create reserve (visibility public) (parameter create id (type Text))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (if (call util::short-valid (local id))
      (call std::text-equal (call db::post-key (local id)) (local id))
      (if (call util::token (local id))
        (let (binding short (call util::short-id (local id))) (binding existing (call db::post-key (local short)))
          (in (if (call std::text-equal (local existing) (local id)) (bool true)
            (if (call std::text-equal (local existing) (local short))
              (if (call std::i64-equal (call std::list-length (types std::DataEntry) (call db::read (text "note") (local short))) (i64 0))
                (call db::put (text "post-alias") (local short) (call std::data-encode (types Text) (local id))) (bool false))
              (bool false))))) (bool false)))))
  (function create fresh (visibility public) (parameter create remaining (type I64))
    (returns Text) (effect (task (requirement service::app::store) (requirement service::app::entropy)))
    (body (if (call std::less (i64 0) (local remaining))
      (let (binding id (call util::short-id (call util::random)))
        (in (if (if (call std::text-equal (call db::post-key (local id)) (local id))
          (call std::i64-equal (call std::list-length (types std::DataEntry) (call db::read (text "note") (local id))) (i64 0)) (bool false))
          (local id) (call postids::fresh (call std::subtract (local remaining) (i64 1)))))) (text ""))))
  (function create form-fields (visibility public) (parameter create items (type (list forms::field)))
    (parameter create index (type I64)) (parameter create post (type Bool)) (parameter create out (type (list forms::field)))
    (returns (list forms::field)) (effect (task (requirement service::app::store)))
    (body (if (call std::less (local index) (call std::list-length (types forms::field) (local items)))
      (let (binding item (call std::list-get (types forms::field) (local items) (local index)))
        (binding name (field (local item) forms::field::name))
        (binding resolve (if (call util::has (list Text (text "reply") (text "draft")) (local name) (i64 0))
          (bool true) (if (local post) (call std::text-equal (local name) (text "id")) (bool false))))
        (in (call postids::form-fields (local items) (call std::add (local index) (i64 1)) (local post)
          (call std::list-append (types forms::field) (local out)
            (record forms::field (field forms::field::name (local name))
              (field forms::field::value (if (local resolve) (call db::post-key (field (local item) forms::field::value))
                (field (local item) forms::field::value)))))))) (local out))))
  (function create form (visibility public) (parameter create form (type Form))
    (returns Form) (effect (task (requirement service::app::store)))
    (body (record structural (field valid (field (local form) (name valid)))
      (field items (call postids::form-fields (field (local form) (name items)) (i64 0)
        (call util::has (list Text (text "note") (text "eyes") (text "bookmark") (text "delete-note"))
          (call util::value (local form) (text "intent")) (i64 0)) (list forms::field))))))
  (function create query-field (visibility public) (parameter create parameters (type (map Text (list Text))))
    (parameter create name (type Text)) (returns (map Text (list Text))) (effect (task (requirement service::app::store)))
    (body (let (binding values (call std::map-get-or (types Text (list Text)) (local parameters) (local name) (list Text)))
      (in (if (call std::i64-equal (call std::list-length (types Text) (local values)) (i64 1))
        (call std::map-insert (types Text (list Text)) (local parameters) (local name)
          (list Text (call db::post-key (call std::list-get (types Text) (local values) (i64 0))))) (local parameters))))))
  (function create request (visibility public) (parameter create request (type Request))
    (returns Request) (effect (task (requirement service::app::store)))
    (body (let (binding parameters (call postids::query-field (call postids::query-field
      (call postids::query-field (field (local request) (name query_parameters)) (text "draft")) (text "reply")) (text "note")))
      (in (record structural (field body (field (local request) (name body))) (field headers (field (local request) (name headers)))
        (field method (field (local request) (name method))) (field path (field (local request) (name path)))
        (field query (field (local request) (name query)))
        (field query_parameters (if (if (call util::has (list Text (text "/note") (text "/compose")) (field (local request) (name path)) (i64 0)) (bool true)
          (if (call std::text-equal (field (local request) (name path)) (text "/delete")) (call std::text-equal (call util::query (local request) (text "kind")) (text "post")) (bool false)))
          (call postids::query-field (local parameters) (text "id")) (local parameters))))))))
)
