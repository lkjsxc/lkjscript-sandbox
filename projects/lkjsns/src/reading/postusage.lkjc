(module create postusage
  (function create ready (visibility public) (returns Bool)
    (effect (task (requirement service::app::store)))
    (body (let (binding rows (call db::read (text "post-usage-state") (text "v1")))
      (in (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local rows)) (i64 1))
        (call std::text-equal (call std::data-decode-or (types Text)
          (field (call std::list-get (types std::DataEntry) (local rows) (i64 0)) std::DataEntry::value)
          (text "")) (text "ready")) (bool false))))))

  (function create key-id (visibility private) (parameter create key (type (list std::DataKeyPart)))
    (returns Text) (effect pure)
    (body (if (call std::i64-equal (call std::list-length (types std::DataKeyPart) (local key)) (i64 2))
      (match (call std::list-get (types std::DataKeyPart) (local key) (i64 1))
        (arm std::DataKeyPart::Text (payload value Text) (local value))
        (arm std::DataKeyPart::Bytes (payload value Bytes) (text ""))
        (arm std::DataKeyPart::Bool (payload value Bool) (text ""))
        (arm std::DataKeyPart::I64 (payload value I64) (text ""))) (text ""))))

  (function create note-row (visibility private) (parameter create item (type std::DataScanItem))
    (returns PostUsageRow) (effect (task (requirement service::app::store)))
    (body (let (binding key (call postusage::key-id (field (local item) std::DataScanItem::key)))
      (binding note (call std::data-decode-or (types Note) (field (local item) std::DataScanItem::value) (call db::empty-note)))
      (binding id (field (local note) (name id))) (binding owner (field (local note) (name author)))
      (binding alias (if (call util::token (local id)) (call util::short-id (local id)) (text "")))
      (in (record structural
        (field id (local id)) (field owner (local owner))
        (field amount (call std::add
          (call std::add
            (call postquota::bytes (text "note") (local key) (field (local item) std::DataScanItem::value))
            (call postquota::stored (text "search-text") (local id)))
          (call std::add
            (call std::add (call postquota::stored (text "post-return") (local id))
              (call postquota::stored (text "post-share") (local id)))
            (if (call std::text-equal (local alias) (text "")) (i64 0)
              (call postquota::stored (text "post-alias") (local alias))))))
        (field valid (if (call std::text-equal (local key) (local id))
          (if (call util::post-id (local id))
            (call std::text-equal (field (call db::user (local owner)) (name handle)) (local owner))
            (bool false)) (bool false)))))))

  )
  (function create post-index (visibility private) (parameter create name (type Text)) (returns Bool) (effect pure)
    (body (if (call std::text-starts-with (local name) (text "timeline/")) (bool true)
      (if (call std::text-starts-with (local name) (text "author/")) (bool true)
      (if (call std::text-starts-with (local name) (text "draft/")) (bool true)
      (if (call std::text-starts-with (local name) (text "link-posts/")) (bool true)
      (if (call std::text-starts-with (local name) (text "replies/")) (bool true)
      (if (call std::text-starts-with (local name) (text "feed/")) (bool true)
      (if (call std::text-starts-with (local name) (text "drafts/")) (bool true)
      (call std::text-starts-with (local name) (text "reply/")))))))))))

  (function create index-rows (visibility private)
    (parameter create values (type (list Text))) (parameter create at (type I64))
    (parameter create out (type (list PostUsageRow))) (returns (list PostUsageRow))
    (effect (task (requirement service::app::store)))
    (body (if (call std::less (local at) (call std::list-length (types Text) (local values)))
      (let (binding id (call std::list-get (types Text) (local values) (local at)))
        (binding note (call db::note (local id))) (binding owner (field (local note) (name author)))
        (in (call postusage::index-rows (local values) (call std::add (local at) (i64 1))
          (call std::list-append (types PostUsageRow) (local out) (record structural
            (field id (local id)) (field owner (local owner))
            (field amount (call postquota::index-bytes (local id)))
            (field valid (if (call util::post-id (field (local note) (name id)))
              (call std::text-equal (field (call db::user (local owner)) (name handle)) (local owner)) (bool false))))))))
      (local out))))

  (function create auxiliary-row (visibility private)
    (parameter create mode (type Text)) (parameter create item (type std::DataScanItem))
    (returns PostUsageRow) (effect (task (requirement service::app::store)))
    (body (let (binding key (call postusage::key-id (field (local item) std::DataScanItem::key)))
      (binding id (if (call std::text-equal (local mode) (text "post-alias"))
        (call std::data-decode-or (types Text) (field (local item) std::DataScanItem::value) (text ""))
        (local key)))
      (binding note (call db::note (local id))) (binding owner (field (local note) (name author)))
      (in (record structural (field id (local id)) (field owner (local owner)) (field amount (i64 0))
        (field valid (if (call util::post-id (field (local note) (name id)))
          (if (call std::text-equal (field (call db::user (local owner)) (name handle)) (local owner))
            (if (call std::text-equal (local mode) (text "post-alias"))
              (call std::text-equal (call util::short-id (local id)) (local key)) (bool true))
            (bool false)) (bool false)))))))

  )

  (function create rows (visibility private) (parameter create mode (type Text))
    (parameter create items (type (list std::DataScanItem))) (parameter create at (type I64))
    (parameter create out (type (list PostUsageRow))) (returns (list PostUsageRow))
    (effect (task (requirement service::app::store)))
    (body (if (call std::less (local at) (call std::list-length (types std::DataScanItem) (local items)))
      (let (binding item (call std::list-get (types std::DataScanItem) (local items) (local at)))
        (binding name (call postusage::key-id (field (local item) std::DataScanItem::key)))
        (in (call postusage::rows (local mode) (local items) (call std::add (local at) (i64 1))
          (if (call std::text-equal (local mode) (text "note"))
            (call std::list-append (types PostUsageRow) (local out) (call postusage::note-row (local item)))
            (if (call std::text-equal (local mode) (text "index-page"))
              (if (call postusage::post-index (local name))
                (call postusage::index-rows
                  (call std::data-decode-or (types (list Text)) (field (local item) std::DataScanItem::value) (list Text (text "")))
                  (i64 0) (local out)) (local out))
              (call std::list-append (types PostUsageRow) (local out) (call postusage::auxiliary-row (local mode) (local item))))))))
      (local out))))

  (function create scan-body (visibility private) (parameter create mode (type Text)) (parameter create cursor (type Text))
    (returns PostUsagePage) (effect (task (requirement service::app::store)))
    (body (let (binding page (capability-call service::app::store std::DataStore::scan
        (static-text "lkjsns-v1") (list std::DataKeyPart (variant std::DataKeyPart::Text (local mode)))
        (variant std::DataScanDirection::Forward) (i64 16) (i64 4194304) (i64 100000)
        (call iconbytes::decode (local cursor))))
      (in (record structural
        (field rows (call postusage::rows (local mode) (field (local page) std::DataScanPage::items) (i64 0) (list PostUsageRow)))
        (field next (call std::bytes-to-hex (field (local page) std::DataScanPage::continuation)))
        (field valid (bool true))))))

  )
  (function create scan (visibility public) (returns PostUsagePage)
    (effect (task (requirement service::app::store) (requirement service::app::config)))
    (body (let (binding mode (capability-call service::app::config std::Configuration::text (static-text "post-usage-mode")))
      (binding cursor (capability-call service::app::config std::Configuration::text (static-text "post-usage-cursor")))
      (in (if (call util::has (list Text (text "note") (text "index-page") (text "search-text") (text "post-share") (text "post-return") (text "post-alias")) (local mode) (i64 0))
        (match (transaction-outcome service::app::store (types PostUsagePage)
          (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
            std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
          (binding scan) (call postusage::scan-body (local mode) (local cursor)))
          (arm std::TransactionOutcome::Committed (payload result PostUsagePage) (local result))
          (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason)
            (record structural (field rows (list PostUsageRow)) (field next (text "")) (field valid (bool false)))))
        (record structural (field rows (list PostUsageRow)) (field next (text "")) (field valid (bool false)))))))

  )
  (function create apply-body (visibility private) (parameter create owner (type Text)) (parameter create amount (type I64))
    (returns I64) (effect (task (requirement service::app::store)))
    (body (if (call std::text-equal (local owner) (text "@finish"))
      (if (call postusage::ready) (i64 0)
        (sequence (call db::put (text "post-usage-state") (text "v1") (call std::data-encode (types Text) (text "ready"))) (i64 0)))
      (let (binding marker (call db::read (text "post-usage-owner") (local owner)))
        (in (if (call util::handle (local owner))
          (if (call std::less-equal (i64 0) (local amount))
            (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local marker)) (i64 0))
              (if (call postquota::adjust (local owner) (local amount))
                (sequence (call db::put (text "post-usage-owner") (local owner) (call std::data-encode (types I64) (local amount))) (i64 0))
                (i64 -2))
              (if (call std::i64-equal
                (call std::data-decode-or (types I64) (field (call std::list-get (types std::DataEntry) (local marker) (i64 0)) std::DataEntry::value) (i64 -1))
                (local amount)) (i64 0) (i64 -2))) (i64 -2)) (i64 -2)))))))

  (function create apply (visibility public) (returns I64)
    (effect (task (requirement service::app::store) (requirement service::app::config)))
    (body (let (binding owner (capability-call service::app::config std::Configuration::text (static-text "post-usage-owner")))
      (binding amount (call std::i64-parse
        (capability-call service::app::config std::Configuration::text (static-text "post-usage-amount"))))
      (in (match (transaction-outcome service::app::store (types I64)
        (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
          std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
        (binding apply) (call postusage::apply-body (local owner) (local amount)))
        (arm std::TransactionOutcome::Committed (payload result I64) (local result))
        (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason) (i64 -1))))))

  )
)
