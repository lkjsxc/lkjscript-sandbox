(module create postgc
  (function create garbage (visibility private) (parameter create id (type Text)) (returns PostBodyGarbage)
    (effect (task (requirement service::app::store)))
    (body (let (binding rows (call db::read (text "post-body-gc") (local id)))
      (in (if (call std::i64-equal (call std::list-length (types std::DataEntry) (local rows)) (i64 1))
        (call std::data-decode-or (types PostBodyGarbage)
          (field (call std::list-get (types std::DataEntry) (local rows) (i64 0)) std::DataEntry::value)
          (record structural (field id (text "")) (field owner (text "")) (field next (i64 -1)) (field count (i64 -1)) (field notbefore (i64 0))))
        (record structural (field id (text "")) (field owner (text "")) (field next (i64 -1)) (field count (i64 -1)) (field notbefore (i64 0))))))))

  (function create delete-parts (visibility private) (parameter create id (type Text))
    (parameter create index (type I64)) (parameter create end (type I64)) (returns Unit)
    (effect (task (requirement service::app::objects)))
    (body (if (call std::less (local index) (local end))
      (sequence (capability-call service::app::objects std::ObjectStorage::delete (call postblob::key (local id) (local index)))
        (call postgc::delete-parts (local id) (call std::add (local index) (i64 1)) (local end))) (unit))))

  (function create advance-gc (visibility private) (parameter create ctx (type Context))
    (parameter create id (type Text)) (parameter create old (type I64)) (parameter create next (type I64))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (let (binding gc (call postgc::garbage (local id))) (binding entries (call db::read (text "post-body-gc") (local id)))
      (in (if (if (call std::text-equal (field (local gc) (name id)) (local id))
              (if (call std::text-equal (field (local gc) (name owner)) (field (local ctx) (name user)))
                (call std::i64-equal (field (local gc) (name next)) (local old)) (bool false)) (bool false))
        (if (call std::i64-equal (local next) (field (local gc) (name count)))
          (capability-call service::app::store std::DataStore::delete (static-text "lkjsns-v1") (call db::key (text "post-body-gc") (local id)) (call db::expected (local entries)))
          (call db::put (text "post-body-gc") (local id) (call std::data-encode (types PostBodyGarbage) (record structural
            (field id (local id)) (field owner (field (local gc) (name owner))) (field next (local next)) (field count (field (local gc) (name count))) (field notbefore (field (local gc) (name notbefore)))))))
        (bool false))))))

  (function create gc (visibility public) (parameter create request (type Request)) (returns Response)
    (effect (task (requirement service::app::store) (requirement service::app::config)
      (requirement service::app::clock) (requirement service::app::objects)))
    (body (let (binding ctx (call auth::context (local request))) (binding id (call util::query (local request) (text "id")))
      (binding gc (call postgc::garbage (local id)))
      (binding next (if (call std::less (call std::add (field (local gc) (name next)) (i64 64)) (field (local gc) (name count)))
        (call std::add (field (local gc) (name next)) (i64 64)) (field (local gc) (name count))))
      (in (if (if (call std::text-equal (field (local gc) (name id)) (local id))
        (if (call std::text-equal (field (local gc) (name owner)) (field (local ctx) (name user)))
          (if (call std::text-equal (field (call postblob::read (local id)) (name state)) (text "retired"))
            (if (call std::less-equal (i64 0) (field (local gc) (name next)))
              (if (call std::less-equal (field (local gc) (name next)) (field (local gc) (name count)))
                (call std::less-equal (field (local gc) (name count)) (i64 514)) (bool false))
              (bool false)) (bool false)) (bool false)) (bool false))
        (if (call std::less-equal (field (local gc) (name notbefore)) (field (local ctx) (name now)))
 (sequence (call postgc::delete-parts (local id) (field (local gc) (name next)) (local next))
          (match (transaction-outcome service::app::store (types Bool)
            (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
              std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
            (binding transaction) (call postgc::advance-gc (local ctx) (local id) (field (local gc) (name next)) (local next)))
            (arm std::TransactionOutcome::Committed (payload result Bool)
              (if (local result)
                (call page::raw (if (call std::i64-equal (local next) (field (local gc) (name count))) (i64 204) (i64 200))
                  (call std::bytes-from-text (text "")) (text "text/plain") (list Header))
                (call page::error (i64 409) (text "Cleanup changed. Retry."))))
            (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason)
              (call page::error (i64 409) (text "Cleanup changed. Retry.")))))
 (call page::raw (i64 202) (call std::bytes-from-text (text "")) (text "text/plain") (list Header)))
        (call page::error (i64 404) (text "Cleanup is unavailable.")))))))

  (function create choose (visibility private) (parameter create items (type (list std::DataScanItem)))
    (parameter create index (type I64)) (parameter create now (type I64)) (returns PostBodyGarbage)
    (effect (task (requirement service::app::store)))
    (body (if (call std::less (local index) (call std::list-length (types std::DataScanItem) (local items)))
      (let (binding item (call std::list-get (types std::DataScanItem) (local items) (local index)))
        (binding gc (call std::data-decode-or (types PostBodyGarbage) (field (local item) std::DataScanItem::value)
          (record structural (field id (text "!invalid")) (field owner (text "")) (field next (i64 -1)) (field count (i64 -1)) (field notbefore (i64 0)))))
        (in (if (call std::text-equal (field (local gc) (name id)) (text "!invalid")) (local gc)
          (if (call std::less-equal (field (local gc) (name notbefore)) (local now)) (local gc)
            (call postgc::choose (local items) (call std::add (local index) (i64 1)) (local now))))))
      (record structural (field id (text "")) (field owner (text "")) (field next (i64 0)) (field count (i64 0)) (field notbefore (i64 0))))))

  (function create scan (visibility private) (parameter create now (type I64)) (returns PostBodyGarbage)
    (effect (task (requirement service::app::store)))
    (body (let (binding page (capability-call service::app::store std::DataStore::scan (static-text "lkjsns-v1")
      (list std::DataKeyPart (variant std::DataKeyPart::Text (text "post-body-gc")))
      (variant std::DataScanDirection::Forward) (i64 64) (i64 4194304) (i64 100000)
      (call std::bytes-from-text (text ""))))
      (in (call postgc::choose (field (local page) std::DataScanPage::items) (i64 0) (local now))))))

  (function create run (visibility public) (returns I64)
    (effect (task (requirement service::app::store) (requirement service::app::clock) (requirement service::app::objects)))
    (body (let (binding now (capability-call service::app::clock std::WallClock::utc-milliseconds))
      (in (match (transaction-outcome service::app::store (types PostBodyGarbage)
        (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
          std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
        (binding transaction) (call postgc::scan (local now)))
        (arm std::TransactionOutcome::Committed (payload gc PostBodyGarbage)
          (if (call std::text-equal (field (local gc) (name id)) (text "")) (i64 0)
            (if (if (call util::token (field (local gc) (name id)))
              (if (call util::handle (field (local gc) (name owner)))
                (if (call std::less-equal (i64 0) (field (local gc) (name next)))
                  (if (call std::less-equal (field (local gc) (name next)) (field (local gc) (name count)))
                    (if (call std::less-equal (field (local gc) (name count)) (i64 514))
                      (call std::text-equal (field (call postblob::read (field (local gc) (name id))) (name state)) (text "retired")) (bool false))
                    (bool false)) (bool false)) (bool false)) (bool false))
              (let (binding next (if (call std::less (call std::add (field (local gc) (name next)) (i64 64)) (field (local gc) (name count)))
                (call std::add (field (local gc) (name next)) (i64 64)) (field (local gc) (name count))))
                (binding ctx (record structural (field user (field (local gc) (name owner))) (field csrf (text ""))
                  (field session (text "")) (field now (local now)) (field share (text ""))))
                (in (sequence (call postgc::delete-parts (field (local gc) (name id)) (field (local gc) (name next)) (local next))
                  (match (transaction-outcome service::app::store (types Bool)
                    (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
                      std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
                    (binding transaction) (call postgc::advance-gc (local ctx) (field (local gc) (name id)) (field (local gc) (name next)) (local next)))
                    (arm std::TransactionOutcome::Committed (payload ok Bool) (if (local ok) (i64 1) (i64 -1)))
                    (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason) (i64 -1))))))
              (i64 -2))))
        (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason) (i64 -1))))))
  )
)
