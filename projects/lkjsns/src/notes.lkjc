) (text "body")))) (field cw (call util::normal (call util::value (local form) (text "cw")))) (field audience (if (field (local before) (name published)) (field (local before) (name audience)) (if (call std::text-equal (local reply) (text "")) (call util::value (local form) (text "audience")) (field (local parent) (name audience))))) (field reply (local reply)) (field media (field (local before) (name media))) (field eyes (field (local before) (name eyes))) (field created (if (local first) (field (local ctx) (name now)) (field (local before) (name created)))) (field edited (field (local ctx) (name now))) (field version (call std::add (field (local before) (name version)) (i64 1))) (field published (if (field (local before) (name published)) (bool true) (if (call std::text-equal (call util::value (local form) (text "mode")) (text "publish")) (bool true) (bool false)))) (field deleted (bool false)))) (in (if (if (local first) (call std::text-equal (call util::value (local form) (text "version")) (text "-1")) (call std::i64-equal (call util::number (call util::value (local form) (text "version")) (i64 2147483647)) (field (local before) (name version)))) (call notes::persist (local ctx) (local before) (local next) (local first) (call util::value (local form) (text "mode"))) (call notes::conflict (local ctx) (local before) (local next))))) (call page::error (i64 422) (text "Check the content, audience, and reply target. The body supports up to 12,000 UTF-8 bytes, approximately 4,000 characters.")))))))

