(module create postread
  (function create grant (visibility public) (parameter create request (type Request)) (returns PostReadGrant)
    (effect (task (requirement service::app::store) (requirement service::app::config) (requirement service::app::clock)))
    (body (let (binding ctx (call util::sharing (call auth::context (local request)) (call util::query (local request) (text "share"))))
      (binding note (call db::note (call util::query (local request) (text "note"))))
      (binding ref (call postblob::reference (field (local note) (name id))))
      (binding stage (call postblob::read (local ref)))
      (binding version (call util::number (call util::query (local request) (text "version")) (i64 2147483647)))
      (in (record structural (field ctx (local ctx)) (field note (local note)) (field stage (local stage))
        (field valid (if (call access::visible (local ctx) (local note))
          (if (call std::i64-equal (field (local note) (name version)) (local version))
            (if (call std::text-equal (field (local stage) (name state)) (text "linked"))
              (if (call std::text-equal (field (local stage) (name post)) (field (local note) (name id)))
                (call std::text-equal (field (local stage) (name owner)) (field (local note) (name author))) (bool false))
              (bool false)) (bool false)) (bool false)))))))

  )
  (function create parts (visibility private) (parameter create stage (type PostBodyStage))
    (parameter create start (type I64)) (parameter create length (type I64)) (parameter create index (type I64))
    (parameter create origin (type I64)) (parameter create out (type Bytes)) (returns Bytes)
    (effect (task (requirement service::app::objects)))
    (body (if (call std::less (i64 0) (local length))
      (if (call std::less (local index) (call std::list-length (types I64) (field (local stage) (name lengths))))
        (let (binding size (call std::list-get (types I64) (field (local stage) (name lengths)) (local index)))
          (binding end (call std::add (local origin) (local size)))
          (in (if (call std::less-equal (local end) (local start))
            (call postread::parts (local stage) (local start) (local length) (call std::add (local index) (i64 1)) (local end) (local out))
            (let (binding take (call codec::min (local length) (call std::subtract (local end) (local start))))
              (binding data (capability-call service::app::objects std::ObjectStorage::range
                (call postblob::key (field (local stage) (name id)) (local index))
                (call std::subtract (local start) (local origin)) (local take)))
              (in (call postread::parts (local stage) (call std::add (local start) (local take))
                (call std::subtract (local length) (local take)) (call std::add (local index) (i64 1)) (local end)
                (call chunkio::concat (local out) (local data))))))))
        (local out)) (local out))))

  (function create range (visibility public) (parameter create stage (type PostBodyStage))
    (parameter create start (type I64)) (parameter create length (type I64)) (returns Bytes)
    (effect (task (requirement service::app::objects)))
    (body (call postread::parts (local stage) (local start) (local length) (i64 0) (i64 0) (call std::bytes-from-text (text "")))))

  ;; End on a complete line where practical and always on a UTF-8 boundary.
  (function create stop (visibility private) (parameter create data (type Bytes)) (parameter create index (type I64))
    (parameter create lines (type I64)) (parameter create last (type I64)) (returns I64) (effect pure)
    (body (if (if (call std::less (local index) (call std::bytes-length (local data)))
              (if (call std::less (local index) (i64 16384)) (call std::less (local lines) (i64 200)) (bool false)) (bool false))
      (if (call std::i64-equal (call std::bytes-get (local data) (local index)) (i64 10))
        (call postread::stop (local data) (call std::add (local index) (i64 1)) (call std::add (local lines) (i64 1)) (call std::add (local index) (i64 1)))
        (call postread::stop (local data) (call std::add (local index) (i64 1)) (local lines) (local last)))
      (if (call std::less (i64 0) (local last)) (local last) (call searchtext::boundary (local data) (local index))))))

  (function create fence-valid (visibility private) (parameter create value (type I64)) (returns Bool) (effect pure)
    (body (if (call std::i64-equal (local value) (i64 0)) (bool true)
      (if (if (call std::less-equal (i64 3) (local value)) (call std::less-equal (local value) (i64 16384)) (bool false)) (bool true)
        (if (call std::less-equal (i64 100003) (local value)) (call std::less-equal (local value) (i64 116384)) (bool false))))))

  (function create fence-marker (visibility private) (parameter create value (type I64)) (returns I64) (effect pure)
    (body (if (call std::i64-equal (local value) (i64 0)) (i64 0)
      (if (call std::less (local value) (i64 100000)) (i64 96) (i64 126)))))

  (function create fence-width (visibility private) (parameter create value (type I64)) (returns I64) (effect pure)
    (body (if (call std::less (local value) (i64 100000)) (local value) (call std::subtract (local value) (i64 100000)))))

  (function create fence-walk (visibility private) (parameter create data (type Bytes)) (parameter create at (type I64))
    (parameter create value (type I64)) (returns I64) (effect pure)
    (body (if (call std::less (local at) (call std::bytes-length (local data)))
      (let (binding end (call mdline::line-end (local data) (local at))) (binding marker (call postread::fence-marker (local value)))
        (in (if (call std::i64-equal (local marker) (i64 0))
          (if (call mdline::fence-start (local data) (local at) (local end))
            (let (binding b (call mdinline::byte (local data) (local at)))
              (binding width (call std::subtract (call mdline::repeat-end (local data) (local at) (local end) (local b)) (local at)))
              (in (call postread::fence-walk (local data) (call mdline::after-line (local data) (local end))
                (if (call std::i64-equal (local b) (i64 96)) (local width) (call std::add (i64 100000) (local width))))))
            (call postread::fence-walk (local data) (call mdline::after-line (local data) (local end)) (local value)))
          (let (binding endmark (call mdline::repeat-end (local data) (local at) (local end) (local marker)))
            (in (if (if (call std::less-equal (call std::add (local at) (call postread::fence-width (local value))) (local endmark))
                  (call std::i64-equal (call mdline::trim-left (local data) (local endmark) (local end)) (local end)) (bool false))
              (call postread::fence-walk (local data) (call mdline::after-line (local data) (local end)) (i64 0))
              (call postread::fence-walk (local data) (call mdline::after-line (local data) (local end)) (local value))))))))
      (local value))))

  (function create next-fence (visibility private) (parameter create data (type Bytes))
    (parameter create value (type I64)) (parameter create continued (type Bool)) (returns I64) (effect pure)
    (body (if (local continued)
      (let (binding end (call mdline::line-end (local data) (i64 0)))
        (in (if (call std::less (local end) (call std::bytes-length (local data)))
          (call postread::fence-walk (local data) (call std::add (local end) (i64 1)) (local value)) (local value))))
      (call postread::fence-walk (local data) (i64 0) (local value)))))

  (function create repeat (visibility private) (parameter create token (type Text)) (parameter create n (type I64)) (returns Text) (effect pure)
    (body (if (call std::less-equal (local n) (i64 0)) (text "")
      (if (call std::i64-equal (local n) (i64 1)) (local token)
        (let (binding part (call postread::repeat (local token) (call std::divide (local n) (i64 2))))
          (in (call std::text-join (list Text (local part) (local part)
            (if (call std::i64-equal (call std::multiply (call std::divide (local n) (i64 2)) (i64 2)) (local n))
              (text "") (local token))) (text ""))))))))

  (function create render (visibility private) (parameter create value (type Text)) (parameter create fence (type I64))
    (parameter create continued (type Bool)) (returns Text) (effect pure)
    (body (if (call std::i64-equal (local fence) (i64 0))
      (if (local continued)
        (let (binding data (call std::bytes-from-text (local value)))
          (binding end (call mdline::line-end (local data) (i64 0)))
          (in (call std::text-join (list Text
            (call mdinline::inline (call util::slice (local value) (i64 0) (local end)) (i64 0) (i64 0))
            (if (call std::less (local end) (call std::bytes-length (local data)))
              (call std::text-join (list Text (text "\n")
                (call markdown::render (call util::slice (local value) (call std::add (local end) (i64 1))
                  (call std::bytes-length (local data))))) (text "")) (text ""))) (text ""))))
        (call markdown::render (local value)))
      (call markdown::render (call std::text-join (list Text
        (call postread::repeat (if (call std::less (local fence) (i64 100000)) (text "`") (text "~"))
          (call postread::fence-width (local fence))) (text "\n")
        (if (local continued) (text "x") (text "")) (local value)) (text ""))))))


  ;; A response stops at a stored part boundary, keeping object calls bounded.
  (function create part-end (visibility private) (parameter create stage (type PostBodyStage))
    (parameter create start (type I64)) (parameter create index (type I64)) (parameter create origin (type I64))
    (returns I64) (effect pure)
    (body (if (call std::less (local index) (call std::list-length (types I64) (field (local stage) (name lengths))))
      (let (binding end (call std::add (local origin) (call std::list-get (types I64) (field (local stage) (name lengths)) (local index))))
        (in (if (call std::less (local start) (local end)) (local end)
          (call postread::part-end (local stage) (local start) (call std::add (local index) (i64 1)) (local end)))))
      (local start))))

  ;; Render at most sixteen of the existing bounded Markdown slices per response.
  (function create batch (visibility private) (parameter create data (type Bytes))
    (parameter create at (type I64)) (parameter create fence (type I64)) (parameter create line (type Bool))
    (parameter create remaining (type I64)) (parameter create out (type (list Text))) (returns PostReadBatch) (effect pure)
    (body (if (if (call std::less (local at) (call std::bytes-length (local data)))
                    (call std::less (i64 0) (local remaining)) (bool false))
      (let (binding rest (call std::bytes-slice (local data) (local at) (call std::bytes-length (local data))))
        (binding end (call postread::stop (local rest) (i64 0) (i64 0) (i64 0)))
        (binding slice (call std::bytes-slice (local rest) (i64 0) (local end)))
        (binding decoded (call std::bytes-to-text-result (local slice)))
        (in (if (if (call std::less (i64 0) (local end)) (field (local decoded) (name valid)) (bool false))
          (let (binding nextf (call postread::next-fence (local slice) (local fence) (local line)))
            (binding nextline (call std::bool-not (call std::i64-equal
              (call std::bytes-get (local slice) (call std::subtract (local end) (i64 1))) (i64 10))))
            (binding piece (call std::text-join (list Text
              (text "<div data-post-piece=\"1\" data-fence-in=\"") (call std::i64-to-text (local fence))
              (text "\" data-fence-out=\"") (call std::i64-to-text (local nextf))
              (text "\" data-sentinel=\"") (if (if (local line) (call std::bool-not (call std::i64-equal (local fence) (i64 0))) (bool false)) (text "1") (text "0"))
              (text "\">") (call postread::render (field (local decoded) (name value)) (local fence) (local line))
              (text "</div>")) (text "")))
            (in (call postread::batch (local data) (call std::add (local at) (local end)) (local nextf) (local nextline)
              (call std::subtract (local remaining) (i64 1)) (call std::list-append (types Text) (local out) (local piece)))))
          (record structural (field valid (bool false)) (field used (local at)) (field fence (local fence))
            (field line (local line)) (field html (text ""))))))
      (record structural (field valid (bool true)) (field used (local at)) (field fence (local fence))
        (field line (local line)) (field html (call std::text-join (local out) (text "")))))))

  (function create shell (visibility private) (parameter create grant (type PostReadGrant)) (returns Response) (effect pure)
    (body (let (binding ctx (field (local grant) (name ctx))) (binding note (field (local grant) (name note)))
      (binding stage (field (local grant) (name stage)))
      (binding content (call std::text-join (list Text
        (text "<div data-post-reader=\"1\" data-note=\"") (call std::html-escape-text (field (local note) (name id)))
        (text "\" data-version=\"") (call std::i64-to-text (field (local note) (name version)))
        (text "\" data-size=\"") (call std::i64-to-text (field (local stage) (name size)))
        (text "\" data-share=\"") (call std::html-escape-text (field (local ctx) (name share)))
        (text "\"><div class=\"note-body markdown\" data-post-preview=\"1\">")
        (call markdown::render (field (local note) (name body))) (text "</div>")
        (text "<div class=\"note-body markdown\" data-post-complete=\"1\" hidden></div>")
        (text "<p class=\"field-help\" data-post-status=\"1\" role=\"status\" aria-live=\"polite\" hidden></p>")
        (text "<button type=\"button\" data-post-retry=\"1\" hidden>Retry</button>")
        (text "<noscript><p class=\"field-help\">JavaScript is required to read the full post.</p></noscript></div>")
        ) (text "")))
      (in (call page::ok (local ctx) (text "Post") (call std::text-join (list Text
        (text "<section class=\"panel post-body-page\"><a class=\"back-link\" href=\"")
        (call std::html-escape-text (call util::post-link (field (local note) (name id)) (field (local ctx) (name share))))
        (text "\">Back to post</a><h2>Post text</h2>")
        (if (call std::text-equal (field (local note) (name cw)) (text "")) (local content)
          (call std::text-join (list Text (text "<details class=\"cw\"><summary>")
            (call std::html-escape-text (field (local note) (name cw))) (text "</summary>") (local content) (text "</details>")) (text "")))
        (text "</section>")) (text "")))))))

  (function create fragment (visibility private) (parameter create request (type Request))
    (parameter create grant (type PostReadGrant)) (returns Response)
    (effect (task (requirement service::app::store) (requirement service::app::config)
      (requirement service::app::clock) (requirement service::app::objects)))
    (body (let (binding stage (field (local grant) (name stage)))
      (binding offset (if (call std::text-equal (call util::query (local request) (text "offset")) (text "")) (i64 0)
        (call util::number (call util::query (local request) (text "offset")) (i64 2147483648))))
      (binding fence (if (call std::text-equal (call util::query (local request) (text "fence")) (text "")) (i64 0)
        (call util::number (call util::query (local request) (text "fence")) (i64 116384))))
      (binding line (call std::text-equal (call util::query (local request) (text "line")) (text "1")))
      (in (if (if (call postread::fence-valid (local fence))
              (if (call util::has (list Text (text "") (text "0") (text "1")) (call util::query (local request) (text "line")) (i64 0))
                (if (call std::less-equal (i64 0) (local offset)) (call std::less (local offset) (field (local stage) (name size))) (bool false))
                (bool false)) (bool false))
        (let (binding partend (call postread::part-end (local stage) (local offset) (i64 0) (i64 0)))
          (binding length (call codec::min (i64 262195) (call std::subtract (local partend) (local offset))))
          (binding data (call postread::range (local stage) (local offset) (local length)))
          (in (if (if (call std::less (i64 0) (local length))
                    (call std::i64-equal (call std::bytes-length (local data)) (local length)) (bool false))
            (let (binding batch (call postread::batch (local data) (i64 0) (local fence) (local line) (i64 16) (list Text)))
              (in (if (if (field (local batch) (name valid)) (call std::less (i64 0) (field (local batch) (name used))) (bool false))
                (match (transaction-outcome service::app::store (types PostReadGrant)
                  (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
                    std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
                  (binding check) (call postread::grant (local request)))
                  (arm std::TransactionOutcome::Committed (payload after PostReadGrant)
                    (if (if (field (local after) (name valid))
                      (call std::text-equal (field (field (local after) (name stage)) (name id)) (field (local stage) (name id))) (bool false))
                      (call page::raw (i64 200) (call std::bytes-from-text (call std::text-join (list Text
                        (text "<div data-post-batch=\"1\" data-offset=\"") (call std::i64-to-text (local offset))
                        (text "\" data-next=\"") (call std::i64-to-text (call std::add (local offset) (field (local batch) (name used))))
                        (text "\" data-fence=\"") (call std::i64-to-text (field (local batch) (name fence)))
                        (text "\" data-line=\"") (if (field (local batch) (name line)) (text "1") (text "0"))
                        (text "\" data-size=\"") (call std::i64-to-text (field (local stage) (name size)))
                        (text "\">") (field (local batch) (name html)) (text "</div>")) (text "")))
                        (text "text/html; charset=utf-8") (list Header))
                      (call page::error (i64 404) (text "This post is unavailable."))))
                  (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason)
                    (call page::error (i64 409) (text "This post changed while loading."))))
                (call page::error (i64 400) (text "This text position is invalid.")))))
            (call page::error (i64 503) (text "This post text is temporarily unavailable.")))))
        (call page::error (i64 400) (text "The text position is invalid.")))))))

  (function create view (visibility public) (parameter create request (type Request)) (returns Response)
    (effect (task (requirement service::app::store) (requirement service::app::config)
      (requirement service::app::clock) (requirement service::app::objects)))
    (body (if (call util::has (list Text (text "") (text "1")) (call util::query (local request) (text "fragment")) (i64 0))
      (match (transaction-outcome service::app::store (types PostReadGrant)
        (outcome std::TransactionOutcome std::TransactionAbortReason std::TransactionOutcome::Committed
          std::TransactionOutcome::Aborted std::TransactionAbortReason::ConditionFailed std::TransactionAbortReason::Conflict)
        (binding read) (call postread::grant (local request)))
        (arm std::TransactionOutcome::Committed (payload grant PostReadGrant)
          (if (field (local grant) (name valid))
            (if (call std::text-equal (call util::query (local request) (text "fragment")) (text "1"))
              (call postread::fragment (local request) (local grant))
              (call postread::shell (local grant)))
            (call page::error (i64 404) (text "This post is unavailable."))))
        (arm std::TransactionOutcome::Aborted (payload reason std::TransactionAbortReason)
          (call page::error (i64 409) (text "This post changed while loading."))))
      (call page::error (i64 400) (text "The text request is invalid.")))))

  (test create batch-preserves-multibyte-text (visibility private)
    (actual (field (call postread::batch (call std::bytes-from-text (text "alpha\n🌱\n"))
      (i64 0) (i64 0) (bool false) (i64 16) (list Text)) (name used)))
    (expected (i64 11)))

  (test create batch-does-not-close-a-split-fence-line (visibility private)
    (actual (call std::text-contains
      (field (call postread::batch (call std::bytes-from-text (text "```\ninside\n```\nafter"))
        (i64 0) (i64 3) (bool true) (i64 16) (list Text)) (name html))
      (text "<pre><code>x```\ninside\n</code></pre>")))
    (expected (bool true)))

  (test create continuation-renders-following-markdown (visibility private)
    (actual (call std::text-contains
      (call postread::render (text "tail **inline**\n# Heading\n**bold**") (i64 0) (bool true))
      (text "<h2>Heading</h2>")))
    (expected (bool true)))

  (test create continuation-renders-inline-markdown (visibility private)
    (actual (call std::text-contains
      (call postread::render (text "tail **inline**") (i64 0) (bool true))
      (text "<strong>inline</strong>")))
    (expected (bool true)))

  (test create fence-opens-across-pages (visibility private)
    (actual (call postread::next-fence (call std::bytes-from-text (text "```\ncode\n")) (i64 0) (bool false)))
    (expected (i64 3)))
  (test create fence-closes-across-pages (visibility private)
    (actual (call postread::next-fence (call std::bytes-from-text (text "more\n```\n")) (i64 3) (bool false)))
    (expected (i64 0)))
  (test create fence-continuation-does-not-start-new-fence (visibility private)
    (actual (call postread::next-fence (call std::bytes-from-text (text "``` still the same line\ntext")) (i64 0) (bool true)))
    (expected (i64 0)))
)
