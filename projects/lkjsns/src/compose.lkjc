(module create compose
  (function create label
    (visibility public) (parameter create audience (type Text))
    (returns Text) (effect pure)
    (body (if (call std::text-equal (local audience) (text "public")) (text "全体公開") (text "メンバー限定"))))

  (function create editor
    (visibility public) (parameter create ctx (type Context)) (parameter create note (type Note)) (parameter create message (type Text))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (if (call std::text-equal (local message) (text "")) (text "") (call std::text-join (list Text (text "<div class=\"notice\" role=\"status\">") (call std::html-escape-text (local message)) (text "</div>")) (text ""))) (text "<section class=\"panel composer\">") (call page::begin (local ctx) (text "note-save")) (call page::hidden (text "id") (field (local note) (name id))) (call page::hidden (text "version") (call std::i64-to-text (field (local note) (name version)))) (call page::hidden (text "reply") (field (local note) (name reply))) (if (call std::text-equal (field (local note) (name reply)) (text "")) (text "") (call std::text-join (list Text (text "<p class=\"reply-context\"><a href=\"/note?id=") (call std::html-escape-text (field (local note) (name reply))) (text "\">返信先のノートを見る</a></p>")) (text ""))) (text "<div class=\"stack\"><label class=\"body-label\">ノート<textarea name=\"body\" maxlength=\"4000\" placeholder=\"いま、話したいこと。\" autofocus>") (call std::html-escape-text (field (local note) (name body))) (text "</textarea></label><label>公開範囲") (if (field (local note) (name published)) (call std::text-join (list Text (call page::hidden (text "audience") (field (local note) (name audience))) (text "<span class=\"field-help\">") (call compose::label (field (local note) (name audience))) (text " · 公開後の範囲は変更できません。</span>")) (text "")) (call std::text-join (list Text (text "<select name=\"audience\"><option value=\"members\"") (if (call std::text-equal (field (local note) (name audience)) (text "public")) (text "") (text " selected")) (text ">メンバー限定</option><option value=\"public\"") (if (call std::text-equal (field (local note) (name audience)) (text "public")) (text " selected") (text "")) (text ">全体公開</option></select><span class=\"field-help\">全体公開は、ログインしていない人も読めます。返信は返信先と同じ範囲になります。</span>")) (text ""))) (text "</label><details") (if (call std::text-equal (field (local note) (name cw)) (text "")) (text "") (text " open")) (text "><summary>内容の注意書き</summary><label>最初に表示する説明<input name=\"cw\" maxlength=\"120\" value=\"") (call std::html-escape-text (field (local note) (name cw))) (text "\" placeholder=\"例：映画のネタバレ\"><span class=\"field-help\">本文を折りたたんで表示します。</span></label></details></div><div class=\"row spread form-actions\"><div class=\"row\">") (if (field (local note) (name published)) (text "") (text "<button name=\"mode\" value=\"draft\" class=\"subtle\" type=\"submit\">下書きを保存</button>")) (text "</div><button name=\"mode\" value=\"publish\" class=\"primary\" type=\"submit\">") (if (field (local note) (name published)) (text "変更を保存") (text "投稿する")) (text "</button></div><p class=\"field-help\">写真・動画の添付は、この検証版ではまだ利用できません。画面を離れる前に下書きを保存してください。</p></form></section>")) (text ""))))

  (function create show
    (visibility public) (parameter create ctx (type Context)) (parameter create request (type Request))
    (returns Response) (effect (task (requirement service::app::store) (requirement service::app::entropy)))
    (body (let (binding id (call util::query (local request) (text "id"))) (binding note (call db::note (call util::query (local request) (text "id")))) (binding parent (call db::note (call util::query (local request) (text "reply")))) (in (if (call std::text-equal (local id) (text "")) (if (if (call std::text-equal (call util::query (local request) (text "reply")) (text "")) (bool true) (if (if (call access::visible (local ctx) (local parent)) (if (field (local parent) (name published)) (bool true) (bool false)) (bool false)) (bool true) (bool false))) (let (binding id (call util::random)) (binding new (record structural (field id (local id)) (field author (field (local ctx) (name user))) (field body (field (call db::empty-note) (name body))) (field cw (field (call db::empty-note) (name cw))) (field audience (if (call std::text-equal (call util::query (local request) (text "reply")) (text "")) (text "members") (field (local parent) (name audience)))) (field reply (call util::query (local request) (text "reply"))) (field media (field (call db::empty-note) (name media))) (field eyes (field (call db::empty-note) (name eyes))) (field created (field (call db::empty-note) (name created))) (field edited (field (call db::empty-note) (name edited))) (field version (field (call db::empty-note) (name version))) (field published (field (call db::empty-note) (name published))) (field deleted (bool false)))) (in (call page::ok (local ctx) (text "ノートを書く") (call compose::editor (local ctx) (local new) (text ""))))) (call page::error (i64 404) (text "返信先のノートは見つかりません。"))) (if (if (call std::text-equal (field (local note) (name author)) (field (local ctx) (name user))) (if (call std::bool-not (field (local note) (name deleted))) (bool true) (bool false)) (bool false)) (call page::ok (local ctx) (text "ノートを編集") (call compose::editor (local ctx) (local note) (if (call std::text-equal (call util::query (local request) (text "saved")) (text "yes")) (text "下書きを保存しました。") (text "")))) (call page::error (i64 404) (text "このノートは編集できません。"))))))))

  (test create public-label (visibility private) (actual (call compose::label (text "public"))) (expected (text "全体公開")))

  (test create default-label (visibility private) (actual (call compose::label (text "members"))) (expected (text "メンバー限定")))
)
