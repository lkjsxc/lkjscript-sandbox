(module create compose
  (function create label
    (visibility public) (parameter create audience (type Text))
    (returns Text) (effect pure)
    (body (if (call std::text-equal (local audience) (text "public")) (text "Public") (text "Members"))))

  (function create editor
    (visibility public) (parameter create ctx (type Context)) (parameter create note (type Note)) (parameter create message (type Text))
    (returns Text) (effect pure)
    (body (call std::text-join (list Text (if (call std::text-equal (local message) (text "")) (text "") (call std::text-join (list Text (text "<div class=\"notice\" role=\"status\">") (call std::html-escape-text (local message)) (text "</div>")) (text ""))) (text "<section class=\"panel composer\">") (call page::begin (local ctx) (text "note-save")) (call page::hidden (text "id") (field (local note) (name id))) (call page::hidden (text "version") (call std::i64-to-text (field (local note) (name version)))) (call page::hidden (text "reply") (field (local note) (name reply))) (if (call std::text-equal (field (local note) (name reply)) (text "")) (text "") (call std::text-join (list Text (text "<p class=\"reply-context\"><a href=\"/") (call std::html-escape-text (field (local note) (name reply))) (text "\">View the original post</a></p>")) (text ""))) (text "<div class=\"stack\"><label class=\"body-label\">Post<textarea name=\"body\" maxlength=\"4000\" placeholder=\"What would you like to share?\" autofocus>") (call std::html-escape-text (field (local note) (name body))) (text "</textarea></label><label>Audience") (if (field (local note) (name published)) (call std::text-join (list Text (call page::hidden (text "audience") (field (local note) (name audience))) (text "<span class=\"field-help\">") (call compose::label (field (local note) (name audience))) (text " · The audience cannot be changed after posting.</span>")) (text "")) (call std::text-join (list Text (text "<select name=\"audience\"><option value=\"members\"") (if (call std::text-equal (field (local note) (name audience)) (text "public")) (text "") (text " selected")) (text ">Members</option><option value=\"public\"") (if (call std::text-equal (field (local note) (name audience)) (text "public")) (text " selected") (text "")) (text ">Public</option></select><span class=\"field-help\">Public posts can be read without signing in. Replies use the original post's audience.</span>")) (text ""))) (text "</label><details") (if (call std::text-equal (field (local note) (name cw)) (text "")) (text "") (text " open")) (text "><summary>Content warning</summary><label>Shown before the content<input name=\"cw\" maxlength=\"120\" value=\"") (call std::html-escape-text (field (local note) (name cw))) (text "\" placeholder=\"For example: film spoilers\"><span class=\"field-help\">Readers choose when to reveal the content.</span></label></details></div><div class=\"row spread form-actions\"><div class=\"row\">") (if (field (local note) (name published)) (text "") (text "<button name=\"mode\" value=\"draft\" class=\"subtle\" type=\"submit\">Save draft</button>")) (text "</div><button name=\"mode\" value=\"publish\" class=\"primary\" type=\"submit\">") (if (field (local note) (name published)) (text "Save changes") (text "Post")) (text "</button></div><p class=\"field-help\">Save your draft before leaving this editor.</p></form></section>")) (text ""))))

  (function create show
    (visibility public) (parameter create ctx (type Context)) (parameter create request (type Request))
    (returns Response) (effect (task (requirement service::app::store) (requirement service::app::entropy)))
    (body (let (binding id (call util::query (local request) (text "id"))) (binding note (call db::note (call util::query (local request) (text "id")))) (binding parent (call db::note (call util::query (local request) (text "reply")))) (in (if (call std::text-equal (local id) (text "")) (if (if (call std::text-equal (call util::query (local request) (text "reply")) (text "")) (bool true) (if (if (call access::visible (local ctx) (local parent)) (if (field (local parent) (name published)) (bool true) (bool false)) (bool false)) (bool true) (bool false))) (let (binding id (call util::random)) (binding new (record structural (field id (local id)) (field author (field (local ctx) (name user))) (field body (field (call db::empty-note) (name body))) (field cw (field (call db::empty-note) (name cw))) (field audience (if (call std::text-equal (call util::query (local request) (text "reply")) (text "")) (text "members") (field (local parent) (name audience)))) (field reply (call util::query (local request) (text "reply"))) (field media (field (call db::empty-note) (name media))) (field eyes (field (call db::empty-note) (name eyes))) (field created (field (call db::empty-note) (name created))) (field edited (field (call db::empty-note) (name edited))) (field version (field (call db::empty-note) (name version))) (field published (field (call db::empty-note) (name published))) (field deleted (bool false)))) (in (call page::ok (local ctx) (text "New post") (call compose::editor (local ctx) (local new) (text ""))))) (call page::error (i64 404) (text "The original post could not be found."))) (if (if (call std::text-equal (field (local note) (name author)) (field (local ctx) (name user))) (if (call std::bool-not (field (local note) (name deleted))) (bool true) (bool false)) (bool false)) (call page::ok (local ctx) (text "Edit post") (call compose::editor (local ctx) (local note) (if (call std::text-equal (call util::query (local request) (text "saved")) (text "yes")) (text "Draft saved.") (text "")))) (call page::error (i64 404) (text "This post cannot be edited."))))))))

  (test create public-label (visibility private) (actual (call compose::label (text "public"))) (expected (text "Public")))

  (test create default-label (visibility private) (actual (call compose::label (text "members"))) (expected (text "Members")))
)
