ocal ctx) (name user))) (field (local media) (name id)))) (bool true) (bool false)) (bool false)) (call page::ok (local ctx) (text "Delete file") (call std::text-join (list Text (text "<section class=\"panel confirm-panel\"><h2>Delete this file?</h2><p>This cannot be undone.</p>") (call mediaui::render (local media) (text "")) (call page::begin (local ctx) (text "delete-file")) (call page::hidden (text "id") (field (local media) (name id))) (call page::hidden (text "version") (call std::i64-to-text (field (local media) (name version)))) (call page::hidden (text "confirm") (text "delete")) (call page::hidden (text "draft") (text "")) (text "<div class=\"row\"><a class=\"button\" href=\"/file?id=") (call std::html-escape-text (field (local media) (name id))) (text "\">Cancel</a><button class=\"danger\">Delete file</button></div></form></section>")) (text ""))) (call page::error (i64 409) (text "This file is used by a post or profile. Remove those references before deleting it."))) (call page::error (i64 404) (text "This file is unavailable."))))))))

