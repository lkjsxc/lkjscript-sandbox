(module create access
  (function create visible (visibility public)
    (parameter create ctx (type Context)) (parameter create note (type Note))
    (returns Bool) (effect pure)
    (body (if (call util::post-id (field (local note) (name id)))
      (if (call std::bool-not (field (local note) (name deleted)))
        (if (call std::text-equal (field (local ctx) (name user)) (field (local note) (name author)))
          (bool true)
          (if (field (local note) (name published))
            (if (call std::text-equal (field (local note) (name audience)) (text "public"))
              (bool true)
              (if (if (call util::token (field (local ctx) (name share)))
                    (call std::text-equal (field (local note) (name audience)) (call util::share-audience (field (local ctx) (name share))))
                    (bool false))
                (bool true)
                (if (call util::signed (local ctx))
                  (call std::text-equal (field (local note) (name audience)) (text "members")) (bool false))))
            (bool false)))
        (bool false))
      (bool false))))

  (function create media
    (visibility public) (parameter create ctx (type Context)) (parameter create media (type Media)) (parameter create note (type Note))
    (returns Bool) (effect pure)
    (body (if (call std::text-equal (field (local media) (name state)) (text "ready")) (if (if (call std::text-equal (field (local ctx) (name user)) (field (local media) (name owner))) (bool true) (if (if (call access::visible (local ctx) (local note)) (if (call util::has (field (local note) (name media)) (field (local media) (name id)) (i64 0)) (bool true) (bool false)) (bool false)) (bool true) (bool false))) (bool true) (bool false)) (bool false))))

  (function create owned-media
    (visibility public) (parameter create ctx (type Context)) (parameter create ids (type (list Text))) (parameter create index (type I64))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (if (call std::less (local index) (call std::list-length (types Text) (local ids))) (let (binding m (call db::media (call std::list-get (types Text) (local ids) (local index)))) (in (if (call std::text-equal (field (local m) (name owner)) (field (local ctx) (name user))) (if (call std::text-equal (field (local m) (name state)) (text "ready")) (if (call access::owned-media (local ctx) (local ids) (call std::add (local index) (i64 1))) (bool true) (bool false)) (bool false)) (bool false)))) (bool true))))

  (function create folder
    (visibility public) (parameter create ctx (type Context)) (parameter create id (type Text))
    (returns Bool) (effect (task (requirement service::app::store)))
    (body (if (call std::text-equal (local id) (text "")) (bool true) (if (let (binding folder (call db::folder (local id))) (in (if (call std::text-equal (field (local folder) (name owner)) (field (local ctx) (name user))) (if (call std::bool-not (field (local folder) (name deleted))) (bool true) (bool false)) (bool false)))) (bool true) (bool false)))))

  (test create unpublished-is-private (visibility private) (actual (call access::visible (record structural (field user (text "")) (field csrf (text "")) (field session (text "")) (field now (i64 0)) (field share (text ""))) (record structural (field id (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")) (field author (text "alice")) (field body (field (call db::empty-note) (name body))) (field cw (field (call db::empty-note) (name cw))) (field audience (text "public")) (field reply (field (call db::empty-note) (name reply))) (field media (field (call db::empty-note) (name media))) (field eyes (field (call db::empty-note) (name eyes))) (field created (field (call db::empty-note) (name created))) (field edited (field (call db::empty-note) (name edited))) (field version (field (call db::empty-note) (name version))) (field published (bool false)) (field deleted (bool false))))) (expected (bool false)))

  (test create public-note-is-readable (visibility private) (actual (call access::visible (record structural (field user (text "")) (field csrf (text "")) (field session (text "")) (field now (i64 0)) (field share (text ""))) (record structural (field id (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")) (field author (text "alice")) (field body (field (call db::empty-note) (name body))) (field cw (field (call db::empty-note) (name cw))) (field audience (text "public")) (field reply (field (call db::empty-note) (name reply))) (field media (field (call db::empty-note) (name media))) (field eyes (field (call db::empty-note) (name eyes))) (field created (field (call db::empty-note) (name created))) (field edited (field (call db::empty-note) (name edited))) (field version (field (call db::empty-note) (name version))) (field published (bool true)) (field deleted (bool false))))) (expected (bool true)))

  (test create members-note-denies-guest (visibility private) (actual (call access::visible (record structural (field user (text "")) (field csrf (text "")) (field session (text "")) (field now (i64 0)) (field share (text ""))) (record structural (field id (text "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")) (field author (text "alice")) (field body (field (call db::empty-note) (name body))) (field cw (field (call db::empty-note) (name cw))) (field audience (text "members")) (field reply (field (call db::empty-note) (name reply))) (field media (field (call db::empty-note) (name media))) (field eyes (field (call db::empty-note) (name eyes))) (field created (field (call db::empty-note) (name created))) (field edited (field (call db::empty-note) (name edited))) (field version (field (call db::empty-note) (name version))) (field published (bool true)) (field deleted (bool false))))) (expected (bool false)))
)
