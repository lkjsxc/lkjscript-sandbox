declarations.begin
(units
 (use std builtin)
 (type-alias MesoCohort (record (id I64) (population I64) (home I64) (queuedOut I64) (outbound I64) (work I64) (queuedBack I64) (inbound I64) (road I64) (rail I64) (travel I64) (requested I64) (arrived I64) (visits I64) (roadTrips I64) (railTrips I64) (waitTicks I64) (travelTicks I64)))
 (type-alias MesoCity (record (cohorts (list MesoCohort)) (tick I64) (population I64)))
 (type-alias MesoTotals (record (tick I64) (groups I64) (population I64) (home I64) (queued I64) (outbound I64) (work I64) (inbound I64) (requested I64) (arrived I64) (outstanding I64) (visits I64) (roadTrips I64) (railTrips I64) (waitTicks I64) (travelTicks I64) (massError I64) (journeyError I64)))
 (type-alias MesoInput (record (population I64) (groups I64) (ticks I64) (capacity I64) (rail I64) (closedFrom I64) (closedUntil I64)))
 (type-alias MesoResult (record (state MesoCity) (initial MesoTotals) (final MesoTotals)))
 (type-alias MesoView (record (x I64) (y I64) (w I64) (h I64)))
 (type-alias MesoRow (list I64))
 (type-alias MesoFrame (record (stats MesoTotals) (view MesoView) (level I64) (drawLimit I64) (rows (list MesoRow))))
 (type-alias MesoViewInput (record (model MesoInput) (view MesoView)))
 (type-alias MesoViewResult (record (frame MesoFrame) (city MesoCity)))
 (type-alias MetroCity (record (model MesoCity) (stats MesoTotals) (roads (list I64)) (rails (list I64)) (version I64) (cash I64) (spent I64) (revenue I64) (paused Bool)))
 (type-alias MetroCommand (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias MetroOutcome (record (city MetroCity) (notice Text) (changed Bool)))
 (type-alias MetroProbeInput (record (population I64) (ticks I64) (commands (list MetroCommand))))
 (module create metronetwork
  (function create axis (visibility public) (effect pure) (parameter create id (type I64)) (returns I64)
   (body (call mesomath::mod (call std::add (call mesomath::mod (local id) (i64 16)) (call std::divide (local id) (i64 16))) (i64 2))))
  (function create destination (visibility public) (effect pure) (parameter create id (type I64)) (returns I64)
   (body (if (call std::i64-equal (call mesomath::mod (call std::add (call mesomath::mod (local id) (i64 16)) (call std::divide (local id) (i64 16))) (i64 2)) (i64 0)) (call std::add (call std::multiply (call std::divide (local id) (i64 16)) (i64 16)) (call std::subtract (i64 15) (call mesomath::mod (local id) (i64 16)))) (call std::add (call std::multiply (call std::subtract (i64 15) (call std::divide (local id) (i64 16))) (i64 16)) (call mesomath::mod (local id) (i64 16))))))
  (function create line (visibility public) (effect pure) (parameter create id (type I64)) (returns I64)
   (body (if (call std::i64-equal (call mesomath::mod (call std::add (call mesomath::mod (local id) (i64 16)) (call std::divide (local id) (i64 16))) (i64 2)) (i64 0)) (call std::divide (local id) (i64 16)) (call std::add (i64 16) (call mesomath::mod (local id) (i64 16))))))
  (function create bottleneck (visibility public) (effect pure) (parameter create roads (type (list I64))) (parameter create cell (type I64)) (parameter create end (type I64)) (parameter create stride (type I64)) (parameter create capacity (type I64)) (returns I64)
   (body (let (binding next (call mesomath::min (local capacity) (call std::multiply (call std::list-get (types I64) (local roads) (local cell)) (i64 3)))) (in (if (if (call std::i64-equal (local cell) (local end)) (bool true) (call std::i64-equal (local next) (i64 0))) (local next) (call bottleneck (local roads) (call std::add (local cell) (local stride)) (local end) (local stride) (local next)))))))
  (function create bind (visibility public) (effect pure) (parameter create c (type MesoCohort)) (parameter create roads (type (list I64))) (parameter create rails (type (list I64))) (returns MesoCohort)
   (body (let (binding end (call destination (field (local c) (name id)))) (binding direction (if (call std::less (field (local c) (name id)) (local end)) (i64 1) (i64 -1))) (binding stride (call std::multiply (local direction) (if (call std::i64-equal (call mesomath::mod (call std::add (call mesomath::mod (field (local c) (name id)) (i64 16)) (call std::divide (field (local c) (name id)) (i64 16))) (i64 2)) (i64 0)) (i64 1) (i64 16)))) (binding distance (call std::divide (call std::subtract (local end) (field (local c) (name id))) (local stride))) (in (record structural (field id (field (local c) (name id))) (field population (field (local c) (name population))) (field home (field (local c) (name home))) (field queuedOut (field (local c) (name queuedOut))) (field outbound (field (local c) (name outbound))) (field work (field (local c) (name work))) (field queuedBack (field (local c) (name queuedBack))) (field inbound (field (local c) (name inbound))) (field road (call bottleneck (local roads) (field (local c) (name id)) (local end) (local stride) (i64 12))) (field rail (call std::multiply (call std::list-get (types I64) (local rails) (call line (field (local c) (name id)))) (i64 12))) (field travel (call std::add (i64 4) (call std::multiply (local distance) (i64 2)))) (field requested (field (local c) (name requested))) (field arrived (field (local c) (name arrived))) (field visits (field (local c) (name visits))) (field roadTrips (field (local c) (name roadTrips))) (field railTrips (field (local c) (name railTrips))) (field waitTicks (field (local c) (name waitTicks))) (field travelTicks (field (local c) (name travelTicks))))))))
  (function create bind-loop (visibility public) (effect pure) (parameter create cohorts (type (list MesoCohort))) (parameter create roads (type (list I64))) (parameter create rails (type (list I64))) (parameter create i (type I64)) (parameter create out (type (list MesoCohort))) (returns (list MesoCohort))
   (body (if (call std::less (local i) (call std::list-length (types MesoCohort) (local cohorts))) (call bind-loop (local cohorts) (local roads) (local rails) (call std::add (local i) (i64 1)) (call std::list-append (types MesoCohort) (local out) (call bind (call std::list-get (types MesoCohort) (local cohorts) (local i)) (local roads) (local rails)))) (local out))))
  (function create bind-city (visibility public) (effect pure) (parameter create city (type MetroCity)) (returns MetroCity)
   (body (record structural (field model (record structural (field cohorts (call bind-loop (field (field (local city) (name model)) (name cohorts)) (field (local city) (name roads)) (field (local city) (name rails)) (i64 0) (list MesoCohort))) (field tick (field (field (local city) (name model)) (name tick))) (field population (field (field (local city) (name model)) (name population))))) (field stats (field (local city) (name stats))) (field roads (field (local city) (name roads))) (field rails (field (local city) (name rails))) (field version (call std::add (field (local city) (name version)) (i64 1))) (field cash (field (local city) (name cash))) (field spent (field (local city) (name spent))) (field revenue (field (local city) (name revenue))) (field paused (field (local city) (name paused))))))
  (function create seed-list (visibility public) (effect pure) (parameter create i (type I64)) (parameter create end (type I64)) (parameter create rail (type Bool)) (parameter create out (type (list I64))) (returns (list I64))
   (body (if (call std::less (local i) (local end)) (call seed-list (call std::add (local i) (i64 1)) (local end) (local rail) (call std::list-append (types I64) (local out) (if (local rail) (if (call std::i64-equal (call mesomath::mod (local i) (i64 4)) (i64 2)) (i64 1) (i64 0)) (i64 1)))) (local out))))
  (test create destination-0 (visibility private) (actual (call destination (i64 0))) (expected (i64 15)))
  (test create line-0 (visibility private) (actual (call line (i64 0))) (expected (i64 0)))
  (test create destination-1 (visibility private) (actual (call destination (i64 1))) (expected (i64 241)))
  (test create line-1 (visibility private) (actual (call line (i64 1))) (expected (i64 17)))
  (test create destination-16 (visibility private) (actual (call destination (i64 16))) (expected (i64 224)))
  (test create line-16 (visibility private) (actual (call line (i64 16))) (expected (i64 16)))
  (test create destination-17 (visibility private) (actual (call destination (i64 17))) (expected (i64 30)))
  (test create line-17 (visibility private) (actual (call line (i64 17))) (expected (i64 1)))
  (test create destination-255 (visibility private) (actual (call destination (i64 255))) (expected (i64 240)))
  (test create line-255 (visibility private) (actual (call line (i64 255))) (expected (i64 15)))
)
)
declarations.end
