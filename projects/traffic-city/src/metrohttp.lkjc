declarations.begin
(units (use std builtin)
(type-alias Header (record (name Text) (value Bytes)))
(type-alias Request (record (body (stream Bytes)) (headers (list Header)) (method Text) (path Text) (query Text) (query_parameters (map Text (list Text)))))
(type-alias Response (record (body Bytes) (headers (list Header)) (status I64)))
(module create metrosite
 (function create html (visibility private) (effect (task)) (parameter create request (type Request)) (returns Response) (body (record structural (field status (i64 200)) (field body (call metroassets::html)) (field headers (list Header (record structural (field name (text "content-type")) (field value (call std::bytes-from-text (text "text/html; charset=utf-8")))) (record structural (field name (text "cache-control")) (field value (call std::bytes-from-text (text "no-store")))) (record structural (field name (text "x-content-type-options")) (field value (call std::bytes-from-text (text "nosniff")))))))))
 (function create app (visibility private) (effect (task)) (parameter create request (type Request)) (returns Response) (body (record structural (field status (i64 200)) (field body (call metroassets::app)) (field headers (list Header (record structural (field name (text "content-type")) (field value (call std::bytes-from-text (text "text/javascript; charset=utf-8")))) (record structural (field name (text "cache-control")) (field value (call std::bytes-from-text (text "no-store")))) (record structural (field name (text "x-content-type-options")) (field value (call std::bytes-from-text (text "nosniff")))))))))
 (function create render (visibility private) (effect (task)) (parameter create request (type Request)) (returns Response) (body (record structural (field status (i64 200)) (field body (call metroassets::render)) (field headers (list Header (record structural (field name (text "content-type")) (field value (call std::bytes-from-text (text "text/javascript; charset=utf-8")))) (record structural (field name (text "cache-control")) (field value (call std::bytes-from-text (text "no-store")))) (record structural (field name (text "x-content-type-options")) (field value (call std::bytes-from-text (text "nosniff")))))))))
 (function create address (visibility private) (effect (task)) (parameter create request (type Request)) (returns Response) (body (record structural (field status (i64 200)) (field body (call metroassets::address)) (field headers (list Header (record structural (field name (text "content-type")) (field value (call std::bytes-from-text (text "text/javascript; charset=utf-8")))) (record structural (field name (text "cache-control")) (field value (call std::bytes-from-text (text "no-store")))) (record structural (field name (text "x-content-type-options")) (field value (call std::bytes-from-text (text "nosniff")))))))))
 (function create css (visibility private) (effect (task)) (parameter create request (type Request)) (returns Response) (body (record structural (field status (i64 200)) (field body (call metroassets::css)) (field headers (list Header (record structural (field name (text "content-type")) (field value (call std::bytes-from-text (text "text/css; charset=utf-8")))) (record structural (field name (text "cache-control")) (field value (call std::bytes-from-text (text "no-store")))) (record structural (field name (text "x-content-type-options")) (field value (call std::bytes-from-text (text "nosniff")))))))))
 (function create icon (visibility private) (effect (task)) (parameter create request (type Request)) (returns Response) (body (record structural (field status (i64 200)) (field body (call metroassets::icon)) (field headers (list Header (record structural (field name (text "content-type")) (field value (call std::bytes-from-text (text "image/svg+xml")))) (record structural (field name (text "cache-control")) (field value (call std::bytes-from-text (text "no-store")))) (record structural (field name (text "x-content-type-options")) (field value (call std::bytes-from-text (text "nosniff")))))))))
(component create server (visibility private)
(requirement create streams (interface std::ByteStream) (operations std::ByteStream::read-all) (limits (maximum_calls 1 calls)))
 (port create html (type (task-function (Request) Response (row))) (function html))
 (port create app (type (task-function (Request) Response (row))) (function app))
 (port create render (type (task-function (Request) Response (row))) (function render))
 (port create address (type (task-function (Request) Response (row))) (function address))
 (port create css (type (task-function (Request) Response (row))) (function css))
 (port create icon (type (task-function (Request) Response (row))) (function icon))))
(target create metropolis-web (component metrosite::server) (runner http)
 (route create html (method GET) (path "/metropolis") (port metrosite::server::html))
 (route create app (method GET) (path "/metropolis/app.js") (port metrosite::server::app))
 (route create render (method GET) (path "/metropolis/render.js") (port metrosite::server::render))
 (route create address (method GET) (path "/metropolis/address.js") (port metrosite::server::address))
 (route create css (method GET) (path "/metropolis/style.css") (port metrosite::server::css))
 (route create icon (method GET) (path "/favicon.svg") (port metrosite::server::icon))
(route create slash (method GET) (path "/metropolis/") (port metrosite::server::html))))
declarations.end
