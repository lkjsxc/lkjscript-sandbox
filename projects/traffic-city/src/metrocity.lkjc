declarations.begin
(units
 (use std builtin)
 (type-alias MesoCohort (record (id I64) (population I64) (home I64) (queuedOut I64) (outbound I64) (work I64) (queuedBack I64) (inbound I64) (road I64) (rail I64) (travel I64) (requested I64) (arrived I64) (visits I64) (roadTrips I64) (railTrips I64) (waitTicks I64) (travelTicks I64)))
 (type-alias MesoCity (record (cohorts (list MesoCohort)) (tick I64) (population I64)))
 (type-alias MesoTotals (record (tick I64) (groups I64) (population I64) (home I64) (queued I64) (outbound I64) (work I64) (inbound I64) (requested I64) (arrived I64) (outstanding I64) (visits I64) (roadTrips I64) (railTrips I64) (waitTicks I64) (travelTicks I64) (massError I64) (journeyError I64)))
 (type-alias MesoInput (record (population I64) (groups I64) (ticks I64) (capacity I64) (rail I64) (closedFrom I64) (closedUntil I64)))
 (type-alias MesoResult (record (state MesoCity) (initial MesoTotals) (final MesoTotals)))
 (type-alias MesoView (record (x I64) (y I64) (w I64) (h I64)))
 (type-alias MesoRow (list I64))
 (type-alias MesoFrame (record (stats MesoTotals) (view MesoView) (level I64) (drawLimit I64) (rows (list MesoRow))))
 (type-alias MesoViewInput (record (model MesoInput) (view MesoView)))
 (type-alias MesoViewResult (record (frame MesoFrame) (city MesoCity)))
 (type-alias MetroCity (record (model MesoCity) (stats MesoTotals) (roads (list I64)) (rails (list I64)) (version I64) (cash I64) (spent I64) (revenue I64) (paused Bool)))
 (type-alias MetroCommand (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias MetroOutcome (record (city MetroCity) (notice Text) (changed Bool)))
 (type-alias MetroProbeInput (record (population I64) (ticks I64) (commands (list MetroCommand))))
 (module create metrocity
  (function create refresh (visibility public) (effect pure) (parameter create city (type MetroCity)) (returns MetroCity)
   (body (record structural (field model (field (local city) (name model))) (field stats (call mesoprobe::totals (field (local city) (name model)))) (field roads (field (local city) (name roads))) (field rails (field (local city) (name rails))) (field version (field (local city) (name version))) (field cash (field (local city) (name cash))) (field spent (field (local city) (name spent))) (field revenue (field (local city) (name revenue))) (field paused (field (local city) (name paused))))))
  (function create initial (visibility public) (effect pure) (parameter create population (type I64)) (returns MetroCity)
   (body (let (binding model (call mesocity::seed (record structural (field population (local population)) (field groups (i64 256)) (field ticks (i64 0)) (field capacity (i64 3)) (field rail (i64 0)) (field closedFrom (i64 0)) (field closedUntil (i64 0))))) (binding city (call metronetwork::bind-city (record structural (field model (local model)) (field stats (record structural (field tick (i64 0)) (field groups (i64 0)) (field population (i64 0)) (field home (i64 0)) (field queued (i64 0)) (field outbound (i64 0)) (field work (i64 0)) (field inbound (i64 0)) (field requested (i64 0)) (field arrived (i64 0)) (field outstanding (i64 0)) (field visits (i64 0)) (field roadTrips (i64 0)) (field railTrips (i64 0)) (field waitTicks (i64 0)) (field travelTicks (i64 0)) (field massError (i64 0)) (field journeyError (i64 0)))) (field roads (call metronetwork::seed-list (i64 0) (i64 256) (bool false) (list I64))) (field rails (call metronetwork::seed-list (i64 0) (i64 32) (bool true) (list I64))) (field version (i64 0)) (field cash (i64 50000)) (field spent (i64 0)) (field revenue (i64 0)) (field paused (bool false))))) (in (call refresh (local city))))))
  (function create tick (visibility public) (effect pure) (parameter create city (type MetroCity)) (returns MetroCity)
   (body (if (field (local city) (name paused)) (local city) (let (binding model (call mesocity::tick (field (local city) (name model)) (bool false))) (binding stats (call mesoprobe::totals (local model))) (binding income (call std::multiply (call std::subtract (field (local stats) (name visits)) (field (field (local city) (name stats)) (name visits))) (i64 2))) (in (record structural (field model (local model)) (field stats (local stats)) (field roads (field (local city) (name roads))) (field rails (field (local city) (name rails))) (field version (field (local city) (name version))) (field cash (call std::add (field (local city) (name cash)) (local income))) (field spent (field (local city) (name spent))) (field revenue (call std::add (field (local city) (name revenue)) (local income))) (field paused (field (local city) (name paused)))))))))
  (function create advance (visibility public) (effect pure) (parameter create city (type MetroCity)) (parameter create left (type I64)) (returns MetroCity)
   (body (if (call std::less (i64 0) (local left)) (call advance (call tick (local city)) (call std::subtract (local left) (i64 1))) (local city))))
  (function create selected (visibility public) (effect pure) (parameter create id (type I64)) (parameter create command (type MetroCommand)) (returns Bool)
   (body (if (call std::less-equal (call mesomath::min (field (local command) (name x)) (field (local command) (name x2))) (call mesomath::mod (local id) (i64 16))) (if (call std::less-equal (call mesomath::mod (local id) (i64 16)) (call mesomath::max (field (local command) (name x)) (field (local command) (name x2)))) (if (call std::less-equal (call mesomath::min (field (local command) (name y)) (field (local command) (name y2))) (call std::divide (local id) (i64 16))) (call std::less-equal (call std::divide (local id) (i64 16)) (call mesomath::max (field (local command) (name y)) (field (local command) (name y2)))) (bool false)) (bool false)) (bool false))))
  (function create road-cost (visibility public) (effect pure) (parameter create roads (type (list I64))) (parameter create command (type MetroCommand)) (parameter create i (type I64)) (parameter create cost (type I64)) (returns I64)
   (body (if (call std::less (local i) (i64 256)) (call road-cost (local roads) (local command) (call std::add (local i) (i64 1)) (call std::add (local cost) (if (call selected (local i) (local command)) (call std::multiply (call mesomath::max (i64 0) (call std::subtract (field (local command) (name kind)) (call std::list-get (types I64) (local roads) (local i)))) (i64 600)) (i64 0)))) (local cost))))
  (function create road-edit (visibility public) (effect pure) (parameter create roads (type (list I64))) (parameter create command (type MetroCommand)) (parameter create i (type I64)) (parameter create out (type (list I64))) (returns (list I64))
   (body (if (call std::less (local i) (i64 256)) (call road-edit (local roads) (local command) (call std::add (local i) (i64 1)) (call std::list-append (types I64) (local out) (if (call selected (local i) (local command)) (field (local command) (name kind)) (call std::list-get (types I64) (local roads) (local i))))) (local out))))
  (function create rail-edit (visibility public) (effect pure) (parameter create rails (type (list I64))) (parameter create line (type I64)) (parameter create kind (type I64)) (parameter create i (type I64)) (parameter create out (type (list I64))) (returns (list I64))
   (body (if (call std::less (local i) (i64 32)) (call rail-edit (local rails) (local line) (local kind) (call std::add (local i) (i64 1)) (call std::list-append (types I64) (local out) (if (call std::i64-equal (local i) (local line)) (local kind) (call std::list-get (types I64) (local rails) (local i))))) (local out))))
  (function create grow-loop (visibility public) (effect pure) (parameter create cohorts (type (list MesoCohort))) (parameter create id (type I64)) (parameter create i (type I64)) (parameter create out (type (list MesoCohort))) (returns (list MesoCohort))
   (body (if (call std::less (local i) (i64 256)) (let (binding c (call std::list-get (types MesoCohort) (local cohorts) (local i))) (in (call grow-loop (local cohorts) (local id) (call std::add (local i) (i64 1)) (call std::list-append (types MesoCohort) (local out) (if (call std::i64-equal (local i) (local id)) (record structural (field id (field (local c) (name id))) (field population (call std::add (field (local c) (name population)) (i64 1000))) (field home (call std::add (field (local c) (name home)) (i64 1000))) (field queuedOut (field (local c) (name queuedOut))) (field outbound (field (local c) (name outbound))) (field work (field (local c) (name work))) (field queuedBack (field (local c) (name queuedBack))) (field inbound (field (local c) (name inbound))) (field road (field (local c) (name road))) (field rail (field (local c) (name rail))) (field travel (field (local c) (name travel))) (field requested (field (local c) (name requested))) (field arrived (field (local c) (name arrived))) (field visits (field (local c) (name visits))) (field roadTrips (field (local c) (name roadTrips))) (field railTrips (field (local c) (name railTrips))) (field waitTicks (field (local c) (name waitTicks))) (field travelTicks (field (local c) (name travelTicks)))) (local c)))))) (local out))))
  (function create road (visibility public) (effect pure) (parameter create city (type MetroCity)) (parameter create command (type MetroCommand)) (returns MetroOutcome)
   (body (if (call std::bool-not (if (if (call std::less-equal (i64 0) (field (local command) (name x))) (call std::less-equal (field (local command) (name x)) (i64 15)) (bool false)) (if (if (call std::less-equal (i64 0) (field (local command) (name y))) (call std::less-equal (field (local command) (name y)) (i64 15)) (bool false)) (if (if (call std::less-equal (i64 0) (field (local command) (name x2))) (call std::less-equal (field (local command) (name x2)) (i64 15)) (bool false)) (if (if (call std::less-equal (i64 0) (field (local command) (name y2))) (call std::less-equal (field (local command) (name y2)) (i64 15)) (bool false)) (if (if (call std::less-equal (i64 0) (field (local command) (name kind))) (call std::less-equal (field (local command) (name kind)) (i64 4)) (bool false)) (if (call std::i64-equal (field (local command) (name x)) (field (local command) (name x2))) (bool true) (call std::i64-equal (field (local command) (name y)) (field (local command) (name y2)))) (bool false)) (bool false)) (bool false)) (bool false)) (bool false))) (record structural (field city (local city)) (field notice (text "Draw one straight corridor inside the city.")) (field changed (bool false))) (let (binding cost (call road-cost (field (local city) (name roads)) (local command) (i64 0) (i64 0))) (in (if (call std::less (field (local city) (name cash)) (local cost)) (record structural (field city (local city)) (field notice (text "Not enough funds; no part of the corridor was changed.")) (field changed (bool false))) (record structural (field city (call metronetwork::bind-city (record structural (field model (field (local city) (name model))) (field stats (field (local city) (name stats))) (field roads (call road-edit (field (local city) (name roads)) (local command) (i64 0) (list I64))) (field rails (field (local city) (name rails))) (field version (field (local city) (name version))) (field cash (call std::subtract (field (local city) (name cash)) (local cost))) (field spent (call std::add (field (local city) (name spent)) (local cost))) (field revenue (field (local city) (name revenue))) (field paused (field (local city) (name paused)))))) (field notice (text "Corridor updated. Commuter capacity has been recomputed.")) (field changed (bool true)))))))))
  (function create rail (visibility public) (effect pure) (parameter create city (type MetroCity)) (parameter create command (type MetroCommand)) (returns MetroOutcome)
   (body (if (call std::bool-not (if (if (call std::less-equal (i64 0) (field (local command) (name x))) (call std::less-equal (field (local command) (name x)) (i64 15)) (bool false)) (if (if (call std::less-equal (i64 0) (field (local command) (name y))) (call std::less-equal (field (local command) (name y)) (i64 15)) (bool false)) (if (call std::less-equal (i64 0) (field (local command) (name kind))) (call std::less-equal (field (local command) (name kind)) (i64 2)) (bool false)) (bool false)) (bool false))) (record structural (field city (local city)) (field notice (text "Invalid line setting.")) (field changed (bool false))) (let (binding line (if (call std::text-equal (field (local command) (name op)) (text "rail-h")) (field (local command) (name y)) (call std::add (i64 16) (field (local command) (name x))))) (binding cost (call std::multiply (call mesomath::max (i64 0) (call std::subtract (field (local command) (name kind)) (call std::list-get (types I64) (field (local city) (name rails)) (local line)))) (i64 2400))) (in (if (call std::less (field (local city) (name cash)) (local cost)) (record structural (field city (local city)) (field notice (text "Not enough funds; the line was not changed.")) (field changed (bool false))) (record structural (field city (call metronetwork::bind-city (record structural (field model (field (local city) (name model))) (field stats (field (local city) (name stats))) (field roads (field (local city) (name roads))) (field rails (call rail-edit (field (local city) (name rails)) (local line) (field (local command) (name kind)) (i64 0) (list I64))) (field version (field (local city) (name version))) (field cash (call std::subtract (field (local city) (name cash)) (local cost))) (field spent (call std::add (field (local city) (name spent)) (local cost))) (field revenue (field (local city) (name revenue))) (field paused (field (local city) (name paused)))))) (field notice (text "Rail service updated across the whole corridor.")) (field changed (bool true)))))))))
  (function create grow (visibility public) (effect pure) (parameter create city (type MetroCity)) (parameter create command (type MetroCommand)) (returns MetroOutcome)
   (body (if (call std::bool-not (if (if (call std::less-equal (i64 0) (field (local command) (name x))) (call std::less-equal (field (local command) (name x)) (i64 15)) (bool false)) (if (call std::less-equal (i64 0) (field (local command) (name y))) (call std::less-equal (field (local command) (name y)) (i64 15)) (bool false)) (bool false))) (record structural (field city (local city)) (field notice (text "Select a district inside the city.")) (field changed (bool false))) (if (if (call std::less (field (local city) (name cash)) (i64 1500)) (bool true) (call std::less (i64 1000000) (call std::add (field (field (local city) (name model)) (name population)) (i64 1000)))) (record structural (field city (local city)) (field notice (text "Growth requires $1,500 and space below one million people.")) (field changed (bool false))) (let (binding model (record structural (field cohorts (call grow-loop (field (field (local city) (name model)) (name cohorts)) (call std::add (field (local command) (name x)) (call std::multiply (field (local command) (name y)) (i64 16))) (i64 0) (list MesoCohort))) (field tick (field (field (local city) (name model)) (name tick))) (field population (call std::add (field (field (local city) (name model)) (name population)) (i64 1000))))) (in (record structural (field city (call refresh (record structural (field model (local model)) (field stats (field (local city) (name stats))) (field roads (field (local city) (name roads))) (field rails (field (local city) (name rails))) (field version (call std::add (field (local city) (name version)) (i64 1))) (field cash (call std::subtract (field (local city) (name cash)) (i64 1500))) (field spent (call std::add (field (local city) (name spent)) (i64 1500))) (field revenue (field (local city) (name revenue))) (field paused (field (local city) (name paused)))))) (field notice (text "Added 1,000 people without adding resident objects.")) (field changed (bool true)))))))))
  (function create apply (visibility public) (effect pure) (parameter create city (type MetroCity)) (parameter create command (type MetroCommand)) (returns MetroOutcome)
   (body (if (call std::text-equal (field (local command) (name op)) (text "pause")) (record structural (field city (record structural (field model (field (local city) (name model))) (field stats (field (local city) (name stats))) (field roads (field (local city) (name roads))) (field rails (field (local city) (name rails))) (field version (field (local city) (name version))) (field cash (field (local city) (name cash))) (field spent (field (local city) (name spent))) (field revenue (field (local city) (name revenue))) (field paused (call std::bool-not (field (local city) (name paused)))))) (field notice (text "")) (field changed (bool true))) (if (call std::text-equal (field (local command) (name op)) (text "road")) (call road (local city) (local command)) (if (if (call std::text-equal (field (local command) (name op)) (text "rail-h")) (bool true) (call std::text-equal (field (local command) (name op)) (text "rail-v"))) (call rail (local city) (local command)) (if (call std::text-equal (field (local command) (name op)) (text "grow")) (call grow (local city) (local command)) (record structural (field city (local city)) (field notice (text "Unknown edit; city unchanged.")) (field changed (bool false)))))))))
  (function create commands (visibility public) (effect pure) (parameter create city (type MetroCity)) (parameter create commands (type (list MetroCommand))) (parameter create i (type I64)) (returns MetroCity)
   (body (if (call std::less (local i) (call mesomath::min (i64 64) (call std::list-length (types MetroCommand) (local commands)))) (call commands (field (call apply (local city) (call std::list-get (types MetroCommand) (local commands) (local i))) (name city)) (local commands) (call std::add (local i) (i64 1))) (local city))))
  (function create run (visibility public) (effect pure) (parameter create input (type MetroProbeInput)) (returns MetroCity)
   (body (call advance (call commands (call initial (field (local input) (name population))) (field (local input) (name commands)) (i64 0)) (call mesomath::min (i64 1024) (call mesomath::max (i64 0) (field (local input) (name ticks)))))))
  (test create diagonal-edit-is-atomic (visibility private) (actual (let (binding city (call initial (i64 100000))) (in (field (call road (local city) (record structural (field op (text "road")) (field x (i64 0)) (field y (i64 0)) (field x2 (i64 1)) (field y2 (i64 1)) (field kind (i64 4)))) (name city))))) (expected (call initial (i64 100000))))
  (test create initial-population (visibility private) (actual (field (field (call initial (i64 100003)) (name stats)) (name population))) (expected (i64 100003)))
  (test create negative-edit-rejected (visibility private) (actual (field (call road (call initial (i64 0)) (record structural (field op (text "")) (field x (i64 -1)) (field y (i64 0)) (field x2 (i64 0)) (field y2 (i64 0)) (field kind (i64 0)))) (name changed))) (expected (bool false)))
(component create probe (visibility private) (port create run (type (function (MetroProbeInput) MetroCity)) (function run))))
 (target create metropolis-probe (component metrocity::probe) (runner command) (port metrocity::probe::run)))
declarations.end
