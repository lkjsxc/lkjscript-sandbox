declarations.begin
(units
 (use std builtin)
 (type-alias Header (record (name Text) (value Bytes)))
 (type-alias Request (record (body (stream Bytes)) (headers (list Header)) (method Text) (path Text) (query Text) (query_parameters (map Text (list Text)))))
 (type-alias Response (record (body Bytes) (headers (list Header)) (status I64)))
 (module create site
  (function create header (visibility private) (effect pure) (parameter create name (type Text)) (parameter create value (type Text)) (returns Header)
   (body (record structural (field name (local name)) (field value (call std::bytes-from-text (local value))))))
  (function create respond (visibility private) (effect pure) (parameter create mime (type Text)) (parameter create body (type Bytes)) (returns Response)
   (body (record structural (field status (i64 200)) (field body (local body))
    (field headers (list Header (call header (text "content-type") (local mime)) (call header (text "cache-control") (text "no-store")) (call header (text "x-content-type-options") (text "nosniff")))))))
  (function create home (visibility private) (effect (task)) (parameter create request (type Request)) (returns Response)
   (body (call respond (text "text/html; charset=utf-8") (call assets::html))))
  (function create javascript (visibility private) (effect (task)) (parameter create request (type Request)) (returns Response)
   (body (call respond (text "text/javascript; charset=utf-8") (call assets::javascript))))
  (function create motion (visibility private) (effect (task)) (parameter create request (type Request)) (returns Response)
   (body (call respond (text "text/javascript; charset=utf-8") (call assets::motion))))
  (function create css (visibility private) (effect (task)) (parameter create request (type Request)) (returns Response)
   (body (call respond (text "text/css; charset=utf-8") (call assets::css))))
  (function create icon (visibility private) (effect (task)) (parameter create request (type Request)) (returns Response)
   (body (call respond (text "image/svg+xml") (call assets::icon))))
  (function create health (visibility private) (effect (task)) (parameter create request (type Request)) (returns Response)
   (body (call respond (text "text/plain; charset=utf-8") (call std::bytes-from-text (text "Traffic City native HTTP ready\n")))))
  (test create response-status (visibility private) (actual (field (call respond (text "text/plain") (call std::bytes-from-text (text "ready"))) (name status))) (expected (i64 200)))
  (test create response-body-preserved (visibility private) (actual (field (call respond (text "text/plain") (call std::bytes-from-text (text "日本語 <>&"))) (name body))) (expected (call std::bytes-from-text (text "日本語 <>&"))))
  (component create server (visibility private)
   (requirement create streams (interface std::ByteStream) (operations std::ByteStream::read-all) (limits (maximum_calls 1 calls)))
   (port create home (type (task-function (Request) Response (row))) (function home))
   (port create javascript (type (task-function (Request) Response (row))) (function javascript))
   (port create motion (type (task-function (Request) Response (row))) (function motion))
   (port create css (type (task-function (Request) Response (row))) (function css))
   (port create icon (type (task-function (Request) Response (row))) (function icon))
   (port create health (type (task-function (Request) Response (row))) (function health))))
 (target create web (component site::server) (runner http)
  (route create home (method GET) (path "/") (port site::server::home))
  (route create javascript (method GET) (path "/app.js") (port site::server::javascript))
  (route create motion (method GET) (path "/motion.js") (port site::server::motion))
  (route create css (method GET) (path "/style.css") (port site::server::css))
  (route create icon (method GET) (path "/favicon.svg") (port site::server::icon))
  (route create favicon (method GET) (path "/favicon.ico") (port site::server::icon))
  (route create health (method GET) (path "/healthz") (port site::server::health))))
declarations.end
