declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy) (landscape I64)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (layer I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias Move (record (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (type-alias PlanningQuery (record (origin I64) (dest I64) (mode I64) (rail Bool)))
 (type-alias PlanningInput (record (city City) (queries (list PlanningQuery))))
 (type-alias PlanningDecision (record (mode I64) (line I64) (board I64) (alight I64) (eta I64) (access (list I64)) (egress (list I64))))
 (type-alias PlanningProof (record (expected PlanningDecision) (actual PlanningDecision) (referenceComplete Bool) (boundedComplete Bool) (referenceSearches I64) (boundedSearches I64)))
 (module create planningproof
  (function create reference-candidate (visibility public) (effect pure) (parameter create world (type World)) (parameter create q (type Numbers)) (parameter create origin (type I64)) (parameter create dest (type I64)) (parameter create l (type RailLine)) (parameter create out (type RailSearch)) (returns RailSearch)
   (body (let (binding pair (call railplan::pair (local l) (local origin) (local dest) (i64 0) (i64 0) (record structural (field board (field (local l) (name a))) (field alight (field (local l) (name b))) (field estimate (i64 1000000))))) (binding board (field (local pair) (name board))) (binding alight (field (local pair) (name alight))) (in (if (call std::bool-and (call std::less-equal (call game::manhattan (local origin) (local board)) (i64 12)) (call std::less-equal (call game::manhattan (local alight) (local dest)) (i64 12))) (let (binding access (call game::ensure-route (local world) (local q) (local origin) (local board) (i64 1) (field (local out) (name plan)))) (binding egress (call game::ensure-route (local world) (local q) (local alight) (local dest) (i64 1) (local access))) (binding a (call game::route (field (local egress) (name routes)) (field (local access) (name id)))) (binding b (call game::route (field (local egress) (name routes)) (field (local egress) (name id)))) (binding queue (call std::list-length (types I64) (call railpath::platform (local l) (local board) (call railpath::travel-direction (local l) (local board) (local alight))))) (binding eta (call std::add (call std::add (field (local a) (name cost)) (field (local b) (name cost))) (call std::add (call std::add (call railplan::ride-between (local l) (local board) (local alight)) (call std::divide (call rail::period (local l)) (i64 2))) (call std::multiply (call std::divide (local queue) (field (local l) (name capacity))) (call rail::period (local l)))))) (binding valid (call std::bool-and (call std::less (i64 0) (field (local access) (name id))) (call std::bool-and (call std::less (i64 0) (field (local egress) (name id))) (call std::bool-and (call std::less-equal (i64 0) (field (local a) (name cost))) (call std::less-equal (i64 0) (field (local b) (name cost))))))) (in (record structural (field plan (local egress)) (field complete (call std::bool-and (field (local out) (name complete)) (call std::bool-and (call std::less (i64 0) (field (local access) (name id))) (call std::less (i64 0) (field (local egress) (name id)))))) (field choice (if (call std::bool-and (local valid) (call std::bool-or (call std::i64-equal (field (field (local out) (name choice)) (name line)) (i64 0)) (call std::less (local eta) (field (field (local out) (name choice)) (name eta))))) (record structural (field line (field (local l) (name id))) (field board (local board)) (field alight (local alight)) (field accessRoute (field (local access) (name id))) (field egressRoute (field (local egress) (name id))) (field stage (i64 1)) (field eta (local eta))) (field (local out) (name choice))))))) (local out))))))
  (function create reference-search (visibility public) (effect pure) (parameter create city (type City)) (parameter create origin (type I64)) (parameter create dest (type I64)) (parameter create index (type I64)) (parameter create out (type RailSearch)) (returns RailSearch)
   (body (if (call std::less (local index) (call std::list-length (types I64) (field (field (field (local city) (name sim)) (name transit)) (name ids)))) (let (binding l (call rail::line (field (field (local city) (name sim)) (name transit)) (call std::list-get (types I64) (field (field (field (local city) (name sim)) (name transit)) (name ids)) (local index)))) (binding next (if (call std::bool-and (field (local l) (name enabled)) (call std::less-equal (call rail::expense (local l)) (field (local city) (name cash)))) (call reference-candidate (field (local city) (name world)) (field (field (local city) (name sim)) (name q)) (local origin) (local dest) (local l) (local out)) (local out))) (in (call reference-search (local city) (local origin) (local dest) (call std::add (local index) (i64 1)) (local next)))) (local out))))
  (function create decision (visibility public) (effect pure) (parameter create search (type RailSearch)) (parameter create mode (type I64)) (parameter create eta (type I64)) (parameter create surface (type Route)) (returns PlanningDecision)
   (body (let (binding p (field (local search) (name choice))) (binding rail (call std::bool-and (call std::less (i64 0) (field (local p) (name line))) (call std::bool-or (call std::less (local eta) (i64 0)) (call std::less (field (local p) (name eta)) (local eta))))) (in (if (local rail) (record structural (field mode (i64 3)) (field line (field (local p) (name line))) (field board (field (local p) (name board))) (field alight (field (local p) (name alight))) (field eta (field (local p) (name eta))) (field access (field (call game::route (field (field (local search) (name plan)) (name routes)) (field (local p) (name accessRoute))) (name path))) (field egress (field (call game::route (field (field (local search) (name plan)) (name routes)) (field (local p) (name egressRoute))) (name path)))) (record structural (field mode (if (call std::less (local eta) (i64 0)) (i64 0) (local mode))) (field line (i64 0)) (field board (i64 -1)) (field alight (i64 -1)) (field eta (local eta)) (field access (field (local surface) (name path))) (field egress (list I64))))))))
  (function create one (visibility public) (effect pure) (parameter create city (type City)) (parameter create query (type PlanningQuery)) (returns PlanningProof)
   (body (let (binding p0 (record structural (field routes (field (field (local city) (name sim)) (name routes))) (field lookup (field (field (local city) (name sim)) (name lookup))) (field nextRoute (field (field (local city) (name sim)) (name nextRoute))) (field budget (i64 10)) (field id (i64 0)))) (binding walk (if (call std::i64-equal (field (local query) (name mode)) (i64 2)) (local p0) (call game::ensure-route (field (local city) (name world)) (field (field (local city) (name sim)) (name q)) (field (local query) (name origin)) (field (local query) (name dest)) (i64 1) (local p0)))) (binding car (if (call std::i64-equal (field (local query) (name mode)) (i64 1)) (record structural (field routes (field (local walk) (name routes))) (field lookup (field (local walk) (name lookup))) (field nextRoute (field (local walk) (name nextRoute))) (field budget (field (local walk) (name budget))) (field id (i64 0))) (call game::ensure-route (field (local city) (name world)) (field (field (local city) (name sim)) (name q)) (field (local query) (name origin)) (field (local query) (name dest)) (i64 2) (local walk)))) (binding wr (call game::route (field (local car) (name routes)) (field (local walk) (name id)))) (binding cr (call game::route (field (local car) (name routes)) (field (local car) (name id)))) (binding ew (call game::estimate (field (local city) (name world)) (field (field (local city) (name sim)) (name q)) (local wr))) (binding ec (call game::estimate (field (local city) (name world)) (field (field (local city) (name sim)) (name q)) (local cr))) (binding mode (if (call std::less (i64 0) (field (local query) (name mode))) (field (local query) (name mode)) (call game::choose-mode (local ew) (local ec)))) (binding eta (if (call std::i64-equal (local mode) (i64 1)) (local ew) (local ec))) (binding surface (if (call std::i64-equal (local mode) (i64 1)) (local wr) (local cr))) (binding out (record structural (field plan (local car)) (field choice (record structural (field line (i64 0)) (field board (i64 0)) (field alight (i64 0)) (field accessRoute (i64 0)) (field egressRoute (i64 0)) (field stage (i64 0)) (field eta (i64 0)))) (field complete (bool true)))) (binding reference (if (field (local query) (name rail)) (call reference-search (local city) (field (local query) (name origin)) (field (local query) (name dest)) (i64 0) (local out)) (local out))) (binding bounded (if (field (local query) (name rail)) (call railplan::search-bounded (field (local city) (name world)) (field (field (local city) (name sim)) (name q)) (field (field (local city) (name sim)) (name transit)) (field (local city) (name cash)) (field (local query) (name origin)) (field (local query) (name dest)) (i64 0) (local eta) (local out)) (local out))) (in (record structural (field expected (call decision (local reference) (local mode) (local eta) (local surface))) (field actual (call decision (local bounded) (local mode) (local eta) (local surface))) (field referenceComplete (field (local reference) (name complete))) (field boundedComplete (field (local bounded) (name complete))) (field referenceSearches (call std::subtract (i64 10) (field (field (local reference) (name plan)) (name budget)))) (field boundedSearches (call std::subtract (i64 10) (field (field (local bounded) (name plan)) (name budget)))))))))
  (function create run-all (visibility public) (effect pure) (parameter create input (type PlanningInput)) (parameter create index (type I64)) (parameter create out (type (list PlanningProof))) (returns (list PlanningProof))
   (body (if (call std::less (local index) (call std::list-length (types PlanningQuery) (field (local input) (name queries)))) (call run-all (local input) (call std::add (local index) (i64 1)) (call std::list-append (types PlanningProof) (local out) (call one (field (local input) (name city)) (call std::list-get (types PlanningQuery) (field (local input) (name queries)) (local index))))) (local out))))
  (function create run (visibility public) (effect pure) (parameter create input (type PlanningInput)) (returns (list PlanningProof))
   (body (call run-all (local input) (i64 0) (list PlanningProof))))
(component create probe (visibility private) (port create run (type (function (PlanningInput) (list PlanningProof))) (function run))))
 (target create planning-proof (component planningproof::probe) (runner command) (port planningproof::probe::run)))
declarations.end
