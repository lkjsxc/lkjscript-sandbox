declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias Move (record (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (type-alias View (record (x I64) (y I64) (w I64) (h I64)))
 (type-alias Cell (record (id I64) (kind I64) (q I64) (walk I64) (flow I64) (inside I64) (junction I64) (control I64)))
 (type-alias Seen (map I64 Cell))
 (type-alias Picture (record (seen Seen) (changed (list Cell))))
 (type-alias RailView (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (occupancy I64) (waitingA I64) (waitingB I64) (expense I64) (enabled Bool) (path (list I64)) (stops (list I64)) (direction I64) (platforms (list RailPlatform))))
 (type-alias Actor (record (id I64) (home I64) (dest I64) (purpose I64) (state I64) (from I64) (to I64) (dir I64) (prior I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (mode I64) (wait I64) (reason I64) (ready I64) (out I64) (rank I64)))
 (type-alias Saved (record (format I64) (owner Text) (serial I64) (city City)))
 (type-alias Claim (record (status I64) (saved Saved)))
 (type-alias State (record (city City) (view View) (seen Seen) (seq I64) (ack I64) (saved I64) (token Text) (owner Text) (status I64) (mapVersion I64) (selection I64) (quote EditQuote) (management I64) (confirmation I64) (undo Bool) (lab Lab)))
 (type-alias Stats (record (tick I64) (cash I64) (level I64) (permits I64) (requested I64) (arrived I64) (population I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (moving I64) (waiting I64) (disconnected I64) (walkTrips I64) (carTrips I64) (average I64) (growthTarget I64) (growthCost I64) (progress I64) (healthy I64) (version I64) (tiles I64) (phase I64) (routes I64) (originX I64) (originY I64) (cancelled I64) (railLines I64) (railBoardings I64) (railCompleted I64) (railSpent I64) (railWaiting I64) (paused Bool) (growth Bool) (ecoHouseholds I64) (ecoBusinesses I64) (ecoOpening I64) (ecoGrants I64) (ecoExports I64) (ecoSalvage I64) (ecoConstruction I64) (ecoOperating I64) (ecoWithdrawn I64) (ecoWages I64) (ecoSales I64) (ecoTaxes I64) (ecoFares I64) (ecoConcessions I64) (ecoUpkeepDue I64) (ecoPeriodTaxes I64) (ecoPeriodFares I64) (ecoPeriodOperating I64) (ecoLastTaxes I64) (ecoLastFares I64) (ecoLastOperating I64) (wealthError I64)))
 (type-alias Frame (record (view View) (persistent Bool) (seq I64) (ack I64) (reset Bool) (cells (list Cell)) (actors (list Actor)) (overview (list I64)) (mapChanged Bool) (heat (list I64)) (stats Stats) (notice Text) (saved I64) (status I64) (inspect Resident) (detail Bool) (actorLimit I64) (quote EditQuote) (management I64) (confirmation I64) (undo Bool) (rails (list RailView)) (inspectRail RailPlan) (inspectFunds I64) (tracks (list I64)) (lab LabView)))
 (type-alias Input (record (id I64) (action Command) (token Text) (owner Text)))
 (type-alias Header (record (name Text) (value Bytes)))
 (type-alias HeaderValue (record (count I64) (value Text)))
 (type-alias Open (record (headers (list Header)) (path Text) (query Text)))
 (type-alias Message (record (body (stream Bytes)) (kind std::SessionMessageKind)))
 (type-alias PeerClose (record (code (option I64)) (reason Text)))
 (type-alias Decision (record (closing (option std::SessionClose)) (kind std::SessionDecisionKind) (messages (list std::SessionOutbound)) (rejection (option std::SessionReject)) (state (option State))))
 (type-alias RailPlatform (record (station I64) (forward I64) (reverse I64)))
 (type-alias LabMeasure (record (visits I64) (arrived I64) (duration I64) (waitCycles I64) (disconnectedCycles I64) (outstanding I64) (cancelled I64) (population I64) (netFunds I64) (operating I64) (boardings I64) (wealthError I64)))
 (type-alias Lab (record (phase I64) (horizon I64) (step I64) (disconnect I64) (plan City) (trial City) (control LabMeasure) (changed LabMeasure) (quote EditQuote) (confirmation I64)))
 (type-alias LabChange (record (lab Lab) (notice Text)))
 (type-alias LabView (record (phase I64) (horizon I64) (step I64) (realTick I64) (planCost I64) (newResidents I64) (moveouts I64) (cancelled I64) (confirmation I64) (control LabMeasure) (changed LabMeasure)))
 (module create viewdata
  (function create cell (visibility public) (effect pure) (parameter create city (type City)) (parameter create id (type I64)) (returns Cell)
   (body (record structural (field id (local id)) (field kind (call game::get (field (field (local city) (name world)) (name tiles)) (local id))) (field q (call game::get (field (field (local city) (name sim)) (name q)) (local id))) (field walk (call game::get (field (field (local city) (name sim)) (name walkq)) (local id))) (field flow (call game::get (field (field (local city) (name sim)) (name flow)) (local id))) (field inside (call game::get (field (field (local city) (name sim)) (name inside)) (local id))) (field junction (call game::get (field (field (local city) (name world)) (name junctions)) (local id))) (field control (call game::get (field (field (local city) (name world)) (name signals)) (local id))))))
  (function create same (visibility public) (effect pure) (parameter create a (type Cell)) (parameter create b (type Cell)) (returns Bool)
   (body (call std::bool-and (call std::i64-equal (field (local a) (name id)) (field (local b) (name id))) (call std::bool-and (call std::i64-equal (field (local a) (name kind)) (field (local b) (name kind))) (call std::bool-and (call std::i64-equal (field (local a) (name q)) (field (local b) (name q))) (call std::bool-and (call std::i64-equal (field (local a) (name walk)) (field (local b) (name walk))) (call std::bool-and (call std::i64-equal (field (local a) (name flow)) (field (local b) (name flow))) (call std::bool-and (call std::i64-equal (field (local a) (name inside)) (field (local b) (name inside))) (call std::bool-and (call std::i64-equal (field (local a) (name junction)) (field (local b) (name junction))) (call std::i64-equal (field (local a) (name control)) (field (local b) (name control))))))))))))
  (function create detail (visibility public) (effect pure) (parameter create view (type View)) (returns Bool)
   (body (call std::less-equal (call std::multiply (field (local view) (name w)) (field (local view) (name h))) (i64 1024))))
  (function create picture-loop (visibility public) (effect pure) (parameter create city (type City)) (parameter create view (type View)) (parameter create old (type Seen)) (parameter create index (type I64)) (parameter create picture (type Picture)) (returns Picture)
   (body (if (call std::less (local index) (call std::multiply (field (local view) (name w)) (field (local view) (name h)))) (let (binding id (call game::id (call std::add (field (local view) (name x)) (call game::mod (local index) (field (local view) (name w)))) (call std::add (field (local view) (name y)) (call std::divide (local index) (field (local view) (name w)))))) (binding cell (call cell (local city) (local id))) (binding previous (call std::map-get-or (types I64 Cell) (local old) (local id) (record structural (field id (local id)) (field kind (i64 0)) (field q (i64 0)) (field walk (i64 0)) (field flow (i64 0)) (field inside (i64 0)) (field junction (i64 0)) (field control (i64 0))))) (binding same (call same (local cell) (local previous))) (in (call picture-loop (local city) (local view) (local old) (call std::add (local index) (i64 1)) (record structural (field seen (if (call std::less (i64 0) (field (local cell) (name kind))) (call std::map-insert (types I64 Cell) (field (local picture) (name seen)) (local id) (local cell)) (field (local picture) (name seen)))) (field changed (if (local same) (field (local picture) (name changed)) (call std::list-append (types Cell) (field (local picture) (name changed)) (local cell)))))))) (local picture))))
  (function create picture (visibility public) (effect pure) (parameter create city (type City)) (parameter create view (type View)) (parameter create old (type Seen)) (returns Picture)
   (body (if (call detail (local view)) (call picture-loop (local city) (local view) (local old) (i64 0) (record structural (field seen (map I64 Cell)) (field changed (list Cell)))) (record structural (field seen (map I64 Cell)) (field changed (list Cell))))))
  (function create visible (visibility public) (effect pure) (parameter create view (type View)) (parameter create cell (type I64)) (returns Bool)
   (body (call std::bool-and (call std::less-equal (field (local view) (name x)) (call game::x (local cell))) (call std::bool-and (call std::less (call game::x (local cell)) (call std::add (field (local view) (name x)) (field (local view) (name w)))) (call std::bool-and (call std::less-equal (field (local view) (name y)) (call game::y (local cell))) (call std::less (call game::y (local cell)) (call std::add (field (local view) (name y)) (field (local view) (name h)))))))))
  (function create heat (visibility public) (effect pure) (parameter create pairs (type (list Pair))) (parameter create index (type I64)) (parameter create result (type (list I64))) (returns (list I64))
   (body (if (call std::bool-and (call std::less (local index) (call std::list-length (types Pair) (local pairs))) (call std::less (call std::list-length (types I64) (local result)) (i64 2048))) (let (binding p (call std::list-get (types Pair) (local pairs) (local index))) (in (call heat (local pairs) (call std::add (local index) (i64 1)) (call std::list-append (types I64) (local result) (call std::add (call std::multiply (field (local p) (name key)) (i64 32)) (call game::min (i64 31) (field (local p) (name value)))))))) (local result))))
  (function create platforms (visibility public) (effect pure) (parameter create l (type RailLine)) (parameter create stops (type (list I64))) (parameter create i (type I64)) (parameter create out (type (list RailPlatform))) (returns (list RailPlatform))
   (body (if (call std::less (local i) (call std::list-length (types I64) (local stops))) (let (binding id (call std::list-get (types I64) (local stops) (local i))) (in (call platforms (local l) (local stops) (call std::add (local i) (i64 1)) (call std::list-append (types RailPlatform) (local out) (record structural (field station (local id)) (field forward (if (call std::i64-equal (local id) (field (local l) (name b))) (i64 0) (call std::list-length (types I64) (call railpath::platform (local l) (local id) (i64 1))))) (field reverse (if (call std::i64-equal (local id) (field (local l) (name a))) (i64 0) (call std::list-length (types I64) (call railpath::platform (local l) (local id) (i64 -1)))))))))) (local out))))
  (function create rails (visibility public) (effect pure) (parameter create t (type Transit)) (parameter create index (type I64)) (parameter create out (type (list RailView))) (returns (list RailView))
   (body (if (call std::less (local index) (call std::list-length (types I64) (field (local t) (name ids)))) (let (binding l (call rail::line (local t) (call std::list-get (types I64) (field (local t) (name ids)) (local index)))) (in (call rails (local t) (call std::add (local index) (i64 1)) (call std::list-append (types RailView) (local out) (record structural (field id (field (local l) (name id))) (field a (field (local l) (name a))) (field b (field (local l) (name b))) (field from (field (local l) (name from))) (field to (field (local l) (name to))) (field elapsed (field (local l) (name elapsed))) (field duration (field (local l) (name duration))) (field dwell (field (local l) (name dwell))) (field status (field (local l) (name status))) (field cost (field (local l) (name cost))) (field capacity (field (local l) (name capacity))) (field rideTicks (field (local l) (name rideTicks))) (field departures (field (local l) (name departures))) (field boardings (field (local l) (name boardings))) (field spent (field (local l) (name spent))) (field enabled (field (local l) (name enabled))) (field path (field (local l) (name path))) (field stops (field (local l) (name stops))) (field direction (field (local l) (name direction))) (field platforms (call platforms (local l) (call railpath::stops (local l)) (i64 0) (list RailPlatform))) (field occupancy (call std::list-length (types I64) (field (local l) (name passengers)))) (field waitingA (call std::list-length (types I64) (field (local l) (name queueA)))) (field waitingB (call std::list-length (types I64) (field (local l) (name queueB)))) (field expense (call rail::expense (local l)))))))) (local out))))
  (function create rail-waiting (visibility public) (effect pure) (parameter create t (type Transit)) (parameter create index (type I64)) (returns I64)
   (body (if (call std::less (local index) (call std::list-length (types I64) (field (local t) (name ids)))) (let (binding l (call rail::line (local t) (call std::list-get (types I64) (field (local t) (name ids)) (local index)))) (in (call std::add (call railpath::waiting (local l)) (call rail-waiting (local t) (call std::add (local index) (i64 1)))))) (i64 0))))
  (function create stats (visibility public) (effect pure) (parameter create city (type City)) (returns Stats)
   (body (record structural (field ecoHouseholds (field (field (local city) (name economy)) (name households))) (field ecoBusinesses (field (field (local city) (name economy)) (name businesses))) (field ecoOpening (field (field (local city) (name economy)) (name opening))) (field ecoGrants (field (field (local city) (name economy)) (name grants))) (field ecoExports (field (field (local city) (name economy)) (name exports))) (field ecoSalvage (field (field (local city) (name economy)) (name salvage))) (field ecoConstruction (field (field (local city) (name economy)) (name construction))) (field ecoOperating (field (field (local city) (name economy)) (name operating))) (field ecoWithdrawn (field (field (local city) (name economy)) (name withdrawn))) (field ecoWages (field (field (local city) (name economy)) (name wages))) (field ecoSales (field (field (local city) (name economy)) (name sales))) (field ecoTaxes (field (field (local city) (name economy)) (name taxes))) (field ecoFares (field (field (local city) (name economy)) (name fares))) (field ecoConcessions (field (field (local city) (name economy)) (name concessions))) (field ecoUpkeepDue (field (field (local city) (name economy)) (name upkeepDue))) (field ecoPeriodTaxes (field (field (local city) (name economy)) (name periodTaxes))) (field ecoPeriodFares (field (field (local city) (name economy)) (name periodFares))) (field ecoPeriodOperating (field (field (local city) (name economy)) (name periodOperating))) (field ecoLastTaxes (field (field (local city) (name economy)) (name lastTaxes))) (field ecoLastFares (field (field (local city) (name economy)) (name lastFares))) (field ecoLastOperating (field (field (local city) (name economy)) (name lastOperating))) (field wealthError (call money::conservation (local city))) (field tick (field (field (local city) (name sim)) (name tick))) (field requested (field (field (local city) (name sim)) (name requested))) (field arrived (field (field (local city) (name sim)) (name arrived))) (field population (field (field (local city) (name sim)) (name population))) (field visits (field (field (local city) (name sim)) (name visits))) (field workVisits (field (field (local city) (name sim)) (name workVisits))) (field shopVisits (field (field (local city) (name sim)) (name shopVisits))) (field leisureVisits (field (field (local city) (name sim)) (name leisureVisits))) (field moving (field (field (local city) (name sim)) (name moving))) (field waiting (field (field (local city) (name sim)) (name waiting))) (field disconnected (field (field (local city) (name sim)) (name disconnected))) (field walkTrips (field (field (local city) (name sim)) (name walkTrips))) (field carTrips (field (field (local city) (name sim)) (name carTrips))) (field healthy (field (field (local city) (name sim)) (name healthy))) (field cancelled (field (field (local city) (name sim)) (name cancelled))) (field cash (field (local city) (name cash))) (field level (field (local city) (name level))) (field permits (field (local city) (name permits))) (field paused (field (local city) (name paused))) (field originX (field (local city) (name originX))) (field originY (field (local city) (name originY))) (field railLines (call std::list-length (types I64) (field (field (field (local city) (name sim)) (name transit)) (name ids)))) (field railBoardings (field (field (field (local city) (name sim)) (name transit)) (name boardings))) (field railCompleted (field (field (field (local city) (name sim)) (name transit)) (name completed))) (field railSpent (field (field (field (local city) (name sim)) (name transit)) (name spent))) (field railWaiting (call rail-waiting (field (field (local city) (name sim)) (name transit)) (i64 0))) (field average (if (call std::less (i64 0) (field (field (local city) (name sim)) (name arrived))) (call std::divide (field (field (local city) (name sim)) (name totalDuration)) (field (field (local city) (name sim)) (name arrived))) (i64 0))) (field growthTar