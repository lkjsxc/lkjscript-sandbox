  (function create selected (visibility public) (effect pure) (parameter create city (type City)) (parameter create cell (type I64)) (parameter create index (type I64)) (returns I64)
   (body (if (call std::less (local index) (call std::list-length (types I64) (field (field (local city) (name sim)) (name ids)))) (let (binding r (call game::agent (field (field (local city) (name sim)) (name agents)) (call std::list-get (types I64) (field (field (local city) (name sim)) (name ids)) (local index)))) (in (if (call std::bool-or (call std::i64-equal (field (local r) (name cell)) (local cell)) (call std::i64-equal (field (local r) (name home)) (local cell))) (field (local r) (name id)) (call selected (local city) (local cell) (call std::add (local index) (i64 1)))))) (i64 -1))))
  (function create view (visibility public) (effect pure) (parameter create command (type Command)) (returns View)
   (body (let (binding w (call game::min (i64 128) (call game::max (i64 1) (field (local command) (name x2))))) (binding h (call game::min (i64 128) (call game::max (i64 1) (field (local command) (name y2))))) (in (record structural (field x (call game::max (i64 0) (call game::min (call std::subtract (i64 128) (local w)) (field (local command) (name x))))) (field y (call game::max (i64 0) (call game::min (call std::subtract (i64 128) (local h)) (field (local command) (name y))))) (field w (local w)) (field h (local h)))))))
)
)
declarations.end
