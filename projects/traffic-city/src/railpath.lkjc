declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy) (landscape I64)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias Move (record (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (module create railpath
  (function create append-path (visibility public) (effect pure) (parameter create source (type (list I64))) (parameter create index (type I64)) (parameter create out (type (list I64))) (returns (list I64))
   (body (if (call std::less (local index) (call std::list-length (types I64) (local source))) (call append-path (local source) (call std::add (local index) (i64 1)) (call std::list-append (types I64) (local out) (call std::list-get (types I64) (local source) (local index)))) (local out))))
  (function create segment (visibility public) (effect pure) (parameter create a (type I64)) (parameter create b (type I64)) (parameter create out (type (list I64))) (returns (list I64))
   (body (let (binding next (call std::list-append (types I64) (local out) (local a))) (in (if (call std::i64-equal (local a) (local b)) (local next) (call segment (call game::neighbor (local a) (if (call std::bool-not (call std::i64-equal (call game::x (local a)) (call game::x (local b)))) (if (call std::less (call game::x (local a)) (call game::x (local b))) (i64 0) (i64 2)) (if (call std::less (local a) (local b)) (i64 1) (i64 3)))) (local b) (local next)))))))
  (function create path (visibility public) (effect pure) (parameter create l (type RailLine)) (returns (list I64))
   (body (if (call std::less (i64 0) (call std::list-length (types I64) (field (local l) (name path)))) (field (local l) (name path)) (call segment (field (local l) (name a)) (field (local l) (name b)) (list I64)))))
  (function create stops (visibility public) (effect pure) (parameter create l (type RailLine)) (returns (list I64))
   (body (if (call std::less (i64 1) (call std::list-length (types I64) (field (local l) (name stops)))) (field (local l) (name stops)) (list I64 (field (local l) (name a)) (field (local l) (name b))))))
  (function create index (visibility public) (effect pure) (parameter create items (type (list I64))) (parameter create id (type I64)) (parameter create i (type I64)) (returns I64)
   (body (if (call std::less (local i) (call std::list-length (types I64) (local items))) (if (call std::i64-equal (call std::list-get (types I64) (local items) (local i)) (local id)) (local i) (call index (local items) (local id) (call std::add (local i) (i64 1)))) (i64 -1))))
  (function create distance (visibility public) (effect pure) (parameter create l (type RailLine)) (parameter create a (type I64)) (parameter create b (type I64)) (returns I64)
   (body (let (binding p (call path (local l))) (binding a0 (call index (local p) (local a) (i64 0))) (binding b0 (call index (local p) (local b) (i64 0))) (in (call game::max (call std::subtract (local a0) (local b0)) (call std::subtract (local b0) (local a0)))))))
  (function create service-direction (visibility public) (effect pure) (parameter create l (type RailLine)) (returns I64)
   (body (if (call std::i64-equal (field (local l) (name from)) (field (local l) (name a))) (i64 1) (if (call std::i64-equal (field (local l) (name from)) (field (local l) (name b))) (i64 -1) (if (call std::i64-equal (field (local l) (name direction)) (i64 -1)) (i64 -1) (i64 1))))))
  (function create next-stop (visibility public) (effect pure) (parameter create l (type RailLine)) (returns I64)
   (body (let (binding s (call stops (local l))) (binding i (call index (local s) (field (local l) (name from)) (i64 0))) (in (call std::list-get (types I64) (local s) (call game::max (i64 0) (call game::min (call std::subtract (call std::list-length (types I64) (local s)) (i64 1)) (call std::add (local i) (call service-direction (local l))))))))))
  (function create ride (visibility public) (effect pure) (parameter create l (type RailLine)) (parameter create a (type I64)) (parameter create b (type I64)) (returns I64)
   (body (call game::max (i64 1) (call std::divide (call std::add (call distance (local l) (local a) (local b)) (i64 3)) (i64 4)))))
  (function create queue-key (visibility public) (effect pure) (parameter create station (type I64)) (parameter create direction (type I64)) (returns I64)
   (body (call std::add (call std::multiply (local station) (i64 2)) (if (call std::i64-equal (local direction) (i64 1)) (i64 1) (i64 0)))))
  (function create travel-direction (visibility public) (effect pure) (parameter create l (type RailLine)) (parameter create a (type I64)) (parameter create b (type I64)) (returns I64)
   (body (if (call std::less (call index (call stops (local l)) (local a) (i64 0)) (call index (call stops (local l)) (local b) (i64 0))) (i64 1) (i64 -1))))
  (function create platform (visibility public) (effect pure) (parameter create l (type RailLine)) (parameter create station (type I64)) (parameter create direction (type I64)) (returns (list I64))
   (body (call std::map-get-or (types I64 (list I64)) (field (local l) (name queues)) (call queue-key (local station) (local direction)) (if (call std::i64-equal (local station) (field (local l) (name a))) (field (local l) (name queueA)) (if (call std::i64-equal (local station) (field (local l) (name b))) (field (local l) (name queueB)) (list I64))))))
  (function create set-platform (visibility public) (effect pure) (parameter create l (type RailLine)) (parameter create station (type I64)) (parameter create direction (type I64)) (parameter create queue (type (list I64))) (returns RailLine)
   (body (record structural (field id (field (local l) (name id))) (field a (field (local l) (name a))) (field b (field (local l) (name b))) (field from (field (local l) (name from))) (field to (field (local l) (name to))) (field elapsed (field (local l) (name elapsed))) (field duration (field (local l) (name duration))) (field dwell (field (local l) (name dwell))) (field status (field (local l) (name status))) (field cost (field (local l) (name cost))) (field capacity (field (local l) (name capacity))) (field rideTicks (field (local l) (name rideTicks))) (field departures (field (local l) (name departures))) (field boardings (field (local l) (name boardings))) (field spent (field (local l) (name spent))) (field enabled (field (local l) (name enabled))) (field queueA (if (call std::i64-equal (local station) (field (local l) (name a))) (local queue) (field (local l) (name queueA)))) (field queueB (if (call std::i64-equal (local station) (field (local l) (name b))) (local queue) (field (local l) (name queueB)))) (field passengers (field (local l) (name passengers))) (field path (field (local l) (name path))) (field stops (field (local l) (name stops))) (field queues (call std::map-insert (types I64 (list I64)) (field (local l) (name queues)) (call queue-key (local station) (local direction)) (local queue))) (field direction (field (local l) (name direction))))))
  (function create waiting-loop (visibility public) (effect pure) (parameter create l (type RailLine)) (parameter create stops (type (list I64))) (parameter create i (type I64)) (returns I64)
   (body (if (call std::less (local i) (call std::list-length (types I64) (local stops))) (let (binding id (call std::list-get (types I64) (local stops) (local i))) (in (call std::add (call std::add (if (call std::i64-equal (local id) (field (local l) (name b))) (i64 0) (call std::list-length (types I64) (call platform (local l) (local id) (i64 1)))) (if (call std::i64-equal (local id) (field (local l) (name a))) (i64 0) (call std::list-length (types I64) (call platform (local l) (local id) (i64 -1))))) (call waiting-loop (local l) (local stops) (call std::add (local i) (i64 1)))))) (i64 0))))
  (function create waiting (visibility public) (effect pure) (parameter create l (type RailLine)) (returns I64)
   (body (call waiting-loop (local l) (call stops (local l)) (i64 0))))
  (function create track-put (visibility public) (effect pure) (parameter create path (type (list I64))) (parameter create i (type I64)) (parameter create tiles (type Numbers)) (returns Numbers)
   (body (if (call std::less (local i) (call std::list-length (types I64) (local path))) (call track-put (local path) (call std::add (local i) (i64 1)) (call game::put (local tiles) (call std::list-get (types I64) (local path) (local i)) (i64 2))) (local tiles))))
  (function create keys (visibility public) (effect pure) (parameter create pairs (type (list Pair))) (parameter create i (type I64)) (parameter create out (type (list I64))) (returns (list I64))
   (body (if (call std::less (local i) (call std::list-length (types Pair) (local pairs))) (call keys (local pairs) (call std::add (local i) (i64 1)) (call std::list-append (types I64) (local out) (field (call std::list-get (types Pair) (local pairs) (local i)) (name key)))) (local out))))
  (function create track-ids (visibility public) (effect pure) (parameter create t (type Transit)) (returns (list I64))
   (body (call keys (call std::map-entries (types I64 I64) (field (local t) (name tracks))) (i64 0) (list I64))))
  (function create path-slice (visibility public) (effect pure) (parameter create p (type (list I64))) (parameter create i (type I64)) (parameter create end (type I64)) (parameter create d (type I64)) (parameter create out (type (list I64))) (returns (list I64))
   (body (let (binding next (call std::list-append (types I64) (local out) (call std::list-get (types I64) (local p) (local i)))) (in (if (call std::i64-equal (local i) (local end)) (local next) (call path-slice (local p) (call std::add (local i) (local d)) (local end) (local d) (local next)))))))
  (function create leg (visibility public) (effect pure) (parameter create l (type RailLine)) (parameter create a (type I64)) (parameter create b (type I64)) (returns (list I64))
   (body (let (binding p (call path (local l))) (binding a0 (call index (local p) (local a) (i64 0))) (binding b0 (call index (local p) (local b) (i64 0))) (in (if (call std::bool-and (call std::less-equal (i64 0) (local a0)) (call std::less-equal (i64 0) (local b0))) (call path-slice (local p) (local a0) (local b0) (if (call std::less-equal (local a0) (local b0)) (i64 1) (i64 -1)) (list I64)) (list I64))))))
  (function create shares (visibility public) (effect pure) (parameter create path (type (list I64))) (parameter create i (type I64)) (parameter create occupied (type Numbers)) (returns Bool)
   (body (if (call std::less (local i) (call std::list-length (types I64) (local path))) (call std::bool-or (call std::less (i64 0) (call game::get (local occupied) (call std::list-get (types I64) (local path) (local i)))) (call shares (local path) (call std::add (local i) (i64 1)) (local occupied))) (bool false))))
  (function create blocked (visibility public) (effect pure) (parameter create t (type Transit)) (parameter create l (type RailLine)) (parameter create i (type I64)) (returns Bool)
   (body (if (call std::less (local i) (call std::list-length (types I64) (field (local t) (name ids)))) (let (binding other (call std::map-get-or (types I64 RailLine) (field (local t) (name lines)) (call std::list-get (types I64) (field (local t) (name ids)) (local i)) (record structural (field id (i64 0)) (field a (i64 0)) (field b (i64 0)) (field from (i64 0)) (field to (i64 0)) (field elapsed (i64 0)) (field duration (i64 0)) (field dwell (i64 0)) (field status (i64 0)) (field cost (i64 0)) (field capacity (i64 0)) (field rideTicks (i64 0)) (field departures (i64 0)) (field boardings (i64 0)) (field spent (i64 0)) (field enabled (bool false)) (field queueA (list I64)) (field queueB (list I64)) (field passengers (list I64)) (field path (list I64)) (field stops (list I64)) (field queues (map I64 (list I64))) (field direction (i64 0))))) (in (call std::bool-or (call std::bool-and (call std::bool-not (call std::i64-equal (field (local l) (name id)) (field (local other) (name id)))) (call std::bool-and (call std::less (field (local other) (name elapsed)) (field (local other) (name duration))) (call shares (call leg (local l) (field (local l) (name from)) (call next-stop (local l))) (i64 0) (call track-put (call leg (local other) (field (local other) (name from)) (field (local other) (name to))) (i64 0) (map I64 I64))))) (call blocked (local t) (local l) (call std::add (local i) (i64 1)))))) (bool false))))
)
)
