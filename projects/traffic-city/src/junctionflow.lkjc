declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy) (landscape I64)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (layer I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias MovementStep (record (city City) (arrivals (list I64))))
 (type-alias Move (record (arrivals (list I64)) (estimates Numbers) (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (type-alias EstimateMemo (record (values Numbers) (eta I64)))
 (module create junctionflow
  (function create flow-bit (visibility public) (effect pure) (parameter create mask (type I64)) (returns I64)
   (body (if (call std::i64-equal (local mask) (i64 1)) (i64 1) (if (call std::i64-equal (local mask) (i64 2)) (i64 2) (if (call std::i64-equal (local mask) (i64 3)) (i64 4) (if (call std::i64-equal (local mask) (i64 4)) (i64 8) (if (call std::i64-equal (local mask) (i64 5)) (i64 16) (if (call std::i64-equal (local mask) (i64 6)) (i64 32) (if (call std::i64-equal (local mask) (i64 7)) (i64 64) (if (call std::i64-equal (local mask) (i64 8)) (i64 128) (if (call std::i64-equal (local mask) (i64 9)) (i64 256) (if (call std::i64-equal (local mask) (i64 10)) (i64 512) (if (call std::i64-equal (local mask) (i64 11)) (i64 1024) (if (call std::i64-equal (local mask) (i64 12)) (i64 2048) (if (call std::i64-equal (local mask) (i64 13)) (i64 4096) (if (call std::i64-equal (local mask) (i64 14)) (i64 8192) (i64 16384)))))))))))))))))
  (function create flow-reserve (visibility public) (effect pure) (parameter create busy (type I64)) (parameter create mask (type I64)) (returns I64)
   (body (let (binding bits (call std::divide (local busy) (i64 16))) (binding bit (call flow-bit (local mask))) (binding new (if (call std::i64-equal (call game::mod (call std::divide (local bits) (local bit)) (i64 2)) (i64 0)) (call std::add (local bits) (local bit)) (local bits))) (in (call std::add (call game::mask-union (call game::mod (local busy) (i64 16)) (local mask) (i64 1)) (call std::multiply (local new) (i64 16)))))))
  (function create flow-put (visibility public) (effect pure) (parameter create values (type Numbers)) (parameter create key (type I64)) (parameter create mask (type I64)) (returns Numbers)
   (body (call game::put (local values) (local key) (call flow-reserve (call game::get (local values) (local key)) (local mask)))))
  (function create flow-other (visibility public) (effect pure) (parameter create bits (type I64)) (parameter create mask (type I64)) (parameter create i (type I64)) (parameter create bit (type I64)) (returns Bool)
   (body (if (call std::less-equal (local i) (i64 15)) (if (if (call std::bool-not (call std::i64-equal (local i) (local mask))) (if (call std::i64-equal (call game::mod (call std::divide (local bits) (local bit)) (i64 2)) (i64 1)) (call game::mask-conflict (local i) (local mask)) (bool false)) (bool false)) (bool true) (call flow-other (local bits) (local mask) (call std::add (local i) (i64 1)) (call std::multiply (local bit) (i64 2)))) (bool false))))
  (function create flow-conflict (visibility public) (effect pure) (parameter create busy (type I64)) (parameter create mask (type I64)) (returns Bool)
   (body (if (call game::mask-conflict (call game::mod (local busy) (i64 16)) (local mask)) (if (call std::i64-equal (local mask) (i64 15)) (bool true) (if (call std::i64-equal (call std::divide (local busy) (i64 16)) (i64 0)) (bool true) (if (call std::bool-not (call std::i64-equal (call std::divide (local busy) (i64 16)) (call flow-bit (local mask)))) (call flow-other (call std::divide (local busy) (i64 16)) (local mask) (i64 1) (i64 1)) (bool false)))) (bool false))))
  (function create flow-mask (visibility public) (effect pure) (parameter create world (type World)) (parameter create node (type I64)) (parameter create incoming (type I64)) (parameter create outgoing (type I64)) (returns I64)
   (body (if (call roads::portal (field (local world) (name tiles)) (local node)) (i64 15) (call game::movement-mask (local incoming) (local outgoing)))))
  (function create flow-key (visibility public) (effect pure) (parameter create zone (type I64)) (parameter create mask (type I64)) (returns I64)
   (body (call std::subtract (i64 -1) (call std::add (call std::multiply (local zone) (i64 16)) (local mask)))))
  (function create flow-older (visibility public) (effect pure) (parameter create ages (type Numbers)) (parameter create zone (type I64)) (parameter create mask (type I64)) (parameter create age (type I64)) (parameter create i (type I64)) (returns Bool)
   (body (if (call std::less-equal (local i) (i64 15)) (if (if (call std::bool-not (call std::i64-equal (local i) (local mask))) (if (call game::mask-conflict (local i) (local mask)) (let (binding older (call game::get (local ages) (call flow-key (local zone) (local i)))) (in (if (call std::less-equal (i64 5) (local older)) (call std::less (local age) (local older)) (bool false)))) (bool false)) (bool false)) (bool true) (call flow-older (local ages) (local zone) (local mask) (local age) (call std::add (local i) (i64 1)))) (bool false))))
  (function create flow-demand (visibility public) (effect pure) (parameter create world (type World)) (parameter create sim (type Sim)) (parameter create r (type Resident)) (parameter create f (type Facts)) (returns Facts)
   (body (if (if (call std::i64-equal (field (local r) (name mode)) (i64 2)) (if (call std::i64-equal (field (local r) (name state)) (i64 2)) (if (call std::less-equal (field (local r) (name duration)) (call std::add (field (local r) (name elapsed)) (i64 1))) (call std::i64-equal (call game::get (field (local f) (name heads)) (call game::lane-key (field (local r) (name cell)) (field (local r) (name dir)) (field (local r) (name lane)))) (field (local r) (name id))) (bool false)) (bool false)) (bool false)) (let (binding route (call game::route (field (local sim) (name routes)) (field (local r) (name route)))) (binding step (call std::add (field (local r) (name step)) (i64 1))) (in (if (if (call std::less (local step) (call std::list-length (types I64) (field (local route) (name path)))) (if (call std::less-equal (i64 0) (field (local r) (name step))) (call std::i64-equal (call std::list-get (types I64) (field (local route) (name path)) (field (local r) (name step))) (field (local r) (name cell))) (bool false)) (bool false)) (let (binding next (call std::list-get (types I64) (field (local route) (name path)) (local step))) (binding direction (if (call std::i64-equal (call roads::ground (field (local r) (name cell))) (call roads::ground (local next))) (field (local r) (name dir)) (call game::direction (field (local r) (name cell)) (local next)))) (binding beyond (if (call std::less (call std::add (local step) (i64 1)) (call std::list-length (types I64) (field (local route) (name path)))) (call std::list-get (types I64) (field (local route) (name path)) (call std::add (local step) (i64 1))) (local next))) (binding out (if (call std::i64-equal (call roads::ground (local next)) (call roads::ground (local beyond))) (local direction) (call game::direction (local next) (local beyond)))) (binding kind (call game::get (field (local world) (name tiles)) (local next))) (binding exitKind (call game::get (field (local world) (name tiles)) (local beyond))) (binding key (call game::lane-key (local next) (local direction) (call game::lane (local kind) (field (local r) (name id))))) (binding exit (call game::lane-key (local beyond) (local out) (call game::lane (local exitKind) (field (local r) (name id))))) (binding mask (call flow-mask (local world) (local next) (local direction) (local out))) (binding ageKey (call flow-key (call game::junction-key (local world) (local next)) (local mask))) (in (if (if (call std::less (i64 0) (call game::get (field (local world) (name junctions)) (local next))) (if (call game::can-step (field (local world) (name tiles)) (field (local r) (name cell)) (local next) (field (local r) (name cell)) (field (local route) (name dest)) (i64 2)) (if (call game::signal-allows (call game::get (field (local world) (name signals)) (local next)) (local direction) (field (local r) (name wait)) (call std::add (field (local sim) (name tick)) (i64 1))) (if (call std::less (call std::subtract (call game::get (field (local f) (name occ)) (local key)) (if (call std::i64-equal (field (local r) (name exitKey)) (call std::add (local key) (i64 1))) (i64 1) (i64 0))) (call game::storage (local kind))) (if (call game::building (local exitKind)) (bool true) (call std::less (call game::get (field (local f) (name occ)) (local exit)) (i64 2))) (bool false)) (bool false)) (bool false)) (bool false)) (record structural (field occ (field (local f) (name occ))) (field heads (field (local f) (name heads))) (field headReady (call game::put (field (local f) (name headReady)) (local ageKey) (call game::max (call game::get (field (local f) (name headReady)) (local ageKey)) (call std::add (field (local r) (name wait)) (i64 1))))) (field busy (field (local f) (name busy))) (field q (field (local f) (name q))) (field walkq (field (local f) (name walkq))) (field inside (field (local f) (name inside))) (field employment (field (local f) (name employment))) (field waiting (field (local f) (name waiting))) (field disconnected (field (local f) (name disconnected))) (field moving (field (local f) (name moving)))) (local f)))) (local f)))) (local f))))
  (function create flow-demands-scan (visibility public) (effect pure) (parameter create world (type World)) (parameter create sim (type Sim)) (parameter create i (type I64)) (parameter create f (type Facts)) (parameter create missing (type Resident)) (returns Facts)
   (body (if (call std::less (local i) (call std::list-length (types I64) (field (local sim) (name ids)))) (call flow-demands-scan (local world) (local sim) (call std::add (local i) (i64 1)) (call flow-demand (local world) (local sim) (call std::map-get-or (types I64 Resident) (field (local sim) (name agents)) (call std::list-get (types I64) (field (local sim) (name ids)) (local i)) (local missing)) (local f)) (local missing)) (local f))))
  (function create flow-demands (visibility public) (effect pure) (parameter create world (type World)) (parameter create sim (type Sim)) (parameter create f (type Facts)) (returns Facts)
   (body (call flow-demands-scan (local world) (local sim) (i64 0) (local f) (call game::empty-agent))))
  (test create flow-repeat-1 (visibility private) (actual (call flow-reserve (call flow-reserve (i64 0) (i64 1)) (i64 1))) (expected (call flow-reserve (i64 0) (i64 1))))
  (test create flow-headway-1 (visibility private) (actual (call flow-conflict (call flow-reserve (i64 0) (i64 1)) (i64 1))) (expected (bool false)))
  (test create flow-repeat-2 (visibility private) (actual (call flow-reserve (call flow-reserve (i64 0) (i64 2)) (i64 2))) (expected (call flow-reserve (i64 0) (i64 2))))
