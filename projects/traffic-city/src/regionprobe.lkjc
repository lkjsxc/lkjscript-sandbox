declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy) (landscape I64)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (layer I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias MovementStep (record (city City) (arrivals (list I64))))
 (type-alias Move (record (arrivals (list I64)) (estimates Numbers) (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (type-alias RegionRow (list I64))
 (type-alias RegionFrame (record (tick I64) (population I64) (born I64) (removed I64) (requested I64) (arrived I64) (cancelled I64) (active I64) (visits I64) (workVisits I64) (walking I64) (driving I64) (waiting I64) (disconnected I64) (boardings I64) (completed I64) (cash I64) (wealth I64) (expected I64)))
 (type-alias RegionRun (record (city City) (frames (list RegionFrame))))
 (type-alias RegionResult (record (columns (list Text)) (residents (list RegionRow)) (frames (list RegionFrame)) (tiles Numbers) (rails RailLines) (economy Economy) (spine (list I64)) (riverWidth I64) (tracks Numbers) (routeCount I64)))
 (module create regionprobe
  (function create active (visibility public) (effect pure) (parameter create sim (type Sim)) (parameter create i (type I64)) (parameter create total (type I64)) (returns I64)
   (body (if (call std::less (local i) (call std::list-length (types I64) (field (local sim) (name ids)))) (let (binding r (call game::agent (field (local sim) (name agents)) (call std::list-get (types I64) (field (local sim) (name ids)) (local i)))) (in (call active (local sim) (call std::add (local i) (i64 1)) (call std::add (local total) (if (if (call std::i64-equal (field (local r) (name state)) (i64 1)) (bool true) (if (call std::i64-equal (field (local r) (name state)) (i64 2)) (bool true) (if (call std::i64-equal (field (local r) (name state)) (i64 4)) (bool true) (if (call std::i64-equal (field (local r) (name state)) (i64 5)) (bool true) (call std::i64-equal (field (local r) (name state)) (i64 6)))))) (i64 1) (i64 0)))))) (local total))))
  (function create frame (visibility public) (effect pure) (parameter create c (type City)) (returns RegionFrame)
   (body (let (binding s (field (local c) (name sim))) (binding e (field (local c) (name economy))) (in (record structural (field tick (field (local s) (name tick))) (field population (field (local s) (name population))) (field born (field (local s) (name born))) (field removed (field (local s) (name removed))) (field requested (field (local s) (name requested))) (field arrived (field (local s) (name arrived))) (field cancelled (field (local s) (name cancelled))) (field visits (field (local s) (name visits))) (field workVisits (field (local s) (name workVisits))) (field waiting (field (local s) (name waiting))) (field disconnected (field (local s) (name disconnected))) (field active (call active (local s) (i64 0) (i64 0))) (field walking (field (local s) (name walkTrips))) (field driving (field (local s) (name carTrips))) (field boardings (field (field (local s) (name transit)) (name boardings))) (field completed (field (field (local s) (name transit)) (name completed))) (field cash (field (local c) (name cash))) (field wealth (call std::add (call std::add (field (local c) (name cash)) (field (local e) (name households))) (field (local e) (name businesses)))) (field expected (call std::subtract (call std::add (call std::add (call std::add (field (local e) (name opening)) (field (local e) (name grants))) (field (local e) (name exports))) (field (local e) (name salvage))) (call std::add (call std::add (field (local e) (name construction)) (field (local e) (name operating))) (field (local e) (name withdrawn))))))))))
  (function create advance (visibility public) (effect pure) (parameter create city (type City)) (parameter create ticks (type I64)) (parameter create frames (type (list RegionFrame))) (parameter create reference (type Bool)) (returns RegionRun)
   (body (if (call std::less (i64 0) (local ticks)) (let (binding next (if (local reference) (call moneyprobe::tick (local city)) (call traffic::tick (local city)))) (in (call advance (local next) (call std::subtract (local ticks) (i64 1)) (call std::list-append (types RegionFrame) (local frames) (call frame (local next))) (local reference)))) (record structural (field city (local city)) (field frames (local frames))))))
  (function create rows (visibility public) (effect pure) (parameter create sim (type Sim)) (parameter create i (type I64)) (parameter create out (type (list RegionRow))) (returns (list RegionRow))
   (body (if (call std::less (local i) (call std::list-length (types I64) (field (local sim) (name ids)))) (let (binding r (call game::agent (field (local sim) (name agents)) (call std::list-get (types I64) (field (local sim) (name ids)) (local i)))) (in (call rows (local sim) (call std::add (local i) (i64 1)) (call std::list-append (types RegionRow) (local out) (list I64 (field (local r) (name id)) (field (local r) (name home)) (field (local r) (name job)) (field (local r) (name dest)) (field (local r) (name purpose)) (field (local r) (name state)) (field (local r) (name cell)) (field (local r) (name from)) (field (local r) (name to)) (field (local r) (name mode)) (field (local r) (name wait)) (field (local r) (name reason)) (field (local r) (name journeys)) (field (local r) (name route)) (field (local r) (name dir)) (field (local r) (name lane)) (field (local r) (name exitKey)) (field (local r) (name elapsed)) (field (local r) (name duration)) (field (local r) (name ready))))))) (local out))))
  (function create observe (visibility public) (effect pure) (parameter create seed (type City)) (parameter create ticks (type I64)) (parameter create reference (type Bool)) (returns RegionResult)
   (body (let (binding result (call advance (local seed) (call game::min (i64 256) (call game::max (i64 0) (local ticks))) (list RegionFrame (call frame (local seed))) (local reference))) (binding city (field (local result) (name city))) (in (record structural (field columns (list Text (text "id") (text "home") (text "job") (text "dest") (text "purpose") (text "state") (text "cell") (text "from") (text "to") (text "mode") (text "wait") (text "reason") (text "journeys") (text "route") (text "dir") (text "lane") (text "exitKey") (text "elapsed") (text "duration") (text "ready"))) (field residents (call rows (field (local city) (name sim)) (i64 0) (list RegionRow))) (field frames (field (local result) (name frames))) (field tiles (field (field (local city) (name world)) (name tiles))) (field rails (field (field (field (local city) (name sim)) (name transit)) (name lines))) (field economy (field (local city) (name economy))) (field spine (call terrain::spine (local city) (i64 0) (list I64))) (field riverWidth (call terrain::width (local city))) (field tracks (field (field (field (local city) (name sim)) (name transit)) (name tracks))) (field routeCount (call std::map-length (types I64 Route) (field (field (local city) (name sim)) (name routes)))))))))
  (function create run (visibility public) (effect pure) (parameter create ticks (type I64)) (returns RegionResult)
   (body (call observe (call region::seed) (local ticks) (bool false))))
  (function create reference (visibility public) (effect pure) (parameter create ticks (type I64)) (returns RegionResult)
   (body (call observe (call region::seed) (local ticks) (bool true))))
  (function create commuter (visibility public) (effect pure) (parameter create ticks (type I64)) (returns RegionResult)
   (body (call observe (call commuter::seed) (local ticks) (bool false))))
  (function create commuter-edit (visibility public) (effect pure) (parameter create ticks (type I64)) (returns RegionResult)
   (body (call observe (field (call town::command (call commuter::seed) (record structural (field op (text "build")) (field x (i64 10)) (field y (i64 10)) (field x2 (i64 10)) (field y2 (i64 10)) (field kind (i64 1)))) (name city)) (local ticks) (bool false))))
(component create commuter-edit-probe (visibility private) (port create run (type (function (I64) RegionResult)) (function commuter-edit)))(component create commuter-probe (visibility private) (port create run (type (function (I64) RegionResult)) (function commuter)))(component create reference-probe (visibility private) (port create run (type (function (I64) RegionResult)) (function reference)))(component create probe (visibility private) (port create run (type (function (I64) RegionResult)) (function run))))
 (target create commuter-edit-probe (component regionprobe::commuter-edit-probe) (runner command) (port regionprobe::commuter-edit-probe::run)) (target create commuter-probe (component regionprobe::commuter-probe) (runner command) (port regionprobe::commuter-probe::run)) (target create region-probe (component regionprobe::probe) (runner command) (port regionprobe::probe::run)) (target create region-reference (component regionprobe::reference-probe) (runner command) (port regionprobe::reference-probe::run)))
declarations.end
