declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy) (landscape I64)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (layer I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias MovementStep (record (city City) (arrivals (list I64))))
 (type-alias Move (record (arrivals (list I64)) (estimates Numbers) (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (type-alias ScenarioTile (record (id I64) (kind I64)))
 (module create commuter
  (function create tiles (visibility public) (effect pure) (parameter create items (type (list ScenarioTile))) (parameter create i (type I64)) (parameter create out (type Numbers)) (returns Numbers)
   (body (if (call std::less (local i) (call std::list-length (types ScenarioTile) (local items))) (let (binding tile (call std::list-get (types ScenarioTile) (local items) (local i))) (in (call tiles (local items) (call std::add (local i) (i64 1)) (call game::put (local out) (field (local tile) (name id)) (field (local tile) (name kind)))))) (local out))))
  (function create base (visibility public) (effect pure)  (returns City)
   (body (let (binding c (call town::from-tiles (call tiles (field (call std::json-decode-or (types (list ScenarioTile)) (call std::bytes-from-text (text "[{\"id\":2067,\"kind\":3},{\"id\":2068,\"kind\":3},{\"id\":2069,\"kind\":3},{\"id\":2070,\"kind\":7},{\"id\":2071,\"kind\":3},{\"id\":2072,\"kind\":3},{\"id\":2073,\"kind\":3},{\"id\":2089,\"kind\":3},{\"id\":2090,\"kind\":3},{\"id\":2091,\"kind\":3},{\"id\":2092,\"kind\":7},{\"id\":2093,\"kind\":3},{\"id\":2094,\"kind\":3},{\"id\":2095,\"kind\":3},{\"id\":2130,\"kind\":4},{\"id\":2132,\"kind\":7},{\"id\":2134,\"kind\":4},{\"id\":2152,\"kind\":4},{\"id\":2154,\"kind\":7},{\"id\":2156,\"kind\":4},{\"id\":2194,\"kind\":3},{\"id\":2195,\"kind\":1},{\"id\":2196,\"kind\":1},{\"id\":2197,\"kind\":1},{\"id\":2198,\"kind\":1},{\"id\":2199,\"kind\":1},{\"id\":2200,\"kind\":1},{\"id\":2201,\"kind\":1},{\"id\":2202,\"kind\":3},{\"id\":2216,\"kind\":3},{\"id\":2217,\"kind\":1},{\"id\":2218,\"kind\":1},{\"id\":2219,\"kind\":1},{\"id\":2220,\"kind\":1},{\"id\":2221,\"kind\":1},{\"id\":2222,\"kind\":1},{\"id\":2223,\"kind\":1},{\"id\":2224,\"kind\":3},{\"id\":2256,\"kind\":4},{\"id\":2257,\"kind\":1},{\"id\":2258,\"kind\":1},{\"id\":2259,\"kind\":1},{\"id\":2260,\"kind\":1},{\"id\":2261,\"kind\":1},{\"id\":2262,\"kind\":1},{\"id\":2263,\"kind\":1},{\"id\":2264,\"kind\":4},{\"id\":2278,\"kind\":4},{\"id\":2279,\"kind\":1},{\"id\":2280,\"kind\":1},{\"id\":2281,\"kind\":1},{\"id\":2282,\"kind\":1},{\"id\":2283,\"kind\":1},{\"id\":2284,\"kind\":1},{\"id\":2285,\"kind\":1},{\"id\":2286,\"kind\":4},{\"id\":2322,\"kind\":3},{\"id\":2323,\"kind\":1},{\"id\":2324,\"kind\":3},{\"id\":2326,\"kind\":7},{\"id\":2328,\"kind\":3},{\"id\":2329,\"kind\":1},{\"id\":2330,\"kind\":3},{\"id\":2344,\"kind\":3},{\"id\":2345,\"kind\":1},{\"id\":2346,\"kind\":3},{\"id\":2348,\"kind\":7},{\"id\":2350,\"kind\":3},{\"id\":2351,\"kind\":1},{\"id\":2352,\"kind\":3},{\"id\":2384,\"kind\":4},{\"id\":2385,\"kind\":1},{\"id\":2388,\"kind\":7},{\"id\":2391,\"kind