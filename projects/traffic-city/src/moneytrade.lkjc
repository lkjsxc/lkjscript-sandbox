declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias Move (record (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (module create moneytrade
  (function create work (visibility public) (effect pure) (parameter create e (type Economy)) (parameter create r (type Resident)) (returns Economy)
   (body (let (binding value (call game::max (i64 30) (call std::subtract (i64 50) (call std::divide (call game::max (i64 0) (call std::subtract (field (local r) (name lastTime)) (field (local r) (name eta)))) (i64 4))))) (binding wage (call std::divide (call std::multiply (local value) (i64 3)) (i64 5))) (binding tax (call std::divide (local wage) (i64 3))) (binding net (call std::subtract (local wage) (local tax))) (binding profit (call std::subtract (local value) (local wage))) (in (record structural (field wallets (call game::put (field (local e) (name wallets)) (field (local r) (name id)) (call std::add (call game::get (field (local e) (name wallets)) (field (local r) (name id))) (local net)))) (field firms (call game::put (field (local e) (name firms)) (field (local r) (name dest)) (call std::add (call game::get (field (local e) (name firms)) (field (local r) (name dest))) (local profit)))) (field active (field (local e) (name active))) (field opening (field (local e) (name opening))) (field grants (field (local e) (name grants))) (field exports (call std::add (field (local e) (name exports)) (local value))) (field salvage (field (local e) (name salvage))) (field construction (field (local e) (name construction))) (field operating (field (local e) (name operating))) (field withdrawn (field (local e) (name withdrawn))) (field households (call std::add (field (local e) (name households)) (local net))) (field businesses (call std::add (field (local e) (name businesses)) (local profit))) (field wages (call std::add (field (local e) (name wages)) (local wage))) (field sales (field (local e) (name sales))) (field taxes (call std::add (field (local e) (name taxes)) (local tax))) (field fares (field (local e) (name fares))) (field concessions (field (local e) (name concessions))) (field upkeepDue (field (local e) (name upkeepDue))) (field periodTaxes (call std::add (field (local e) (name periodTaxes)) (local tax))) (field periodFares (field (local e) (name periodFares))) (field periodOperating (field (local e) (name periodOperating))) (field lastTaxes (field (local e) (name lastTaxes))) (field lastFares (field (local e) (name lastFares))) (field lastOperating (field (local e) (name lastOperating))))))))
  (function create purchase (visibility public) (effect pure) (parameter create e (type Economy)) (parameter create r (type Resident)) (returns Economy)
   (body (let (binding amount (call game::min (call game::get (field (local e) (name wallets)) (field (local r) (name id))) (if (call std::i64-equal (field (local r) (name purpose)) (i64 2)) (i64 10) (i64 4)))) (binding tax (call std::divide (local amount) (i64 4))) (binding net (call std::subtract (local amount) (local tax))) (in (record structural (field wallets (call game::put (field (local e) (name wallets)) (field (local r) (name id)) (call std::subtract (call game::get (field (local e) (name wallets)) (field (local r) (name id))) (local amount)))) (field firms (call game::put (field (local e) (name firms)) (field (local r) (name dest)) (call std::add (call game::get (field (local e) (name firms)) (field (local r) (name dest))) (local net)))) (field active (field (local e) (name active))) (field opening (field (local e) (name opening))) (field grants (field (local e) (name grants))) (field exports (field (local e) (name exports))) (field salvage (field (local e) (name salvage))) (field construction (field (local e) (name construction))) (field operating (field (local e) (name operating))) (field withdrawn (field (local e) (name withdrawn))) (field households (call std::subtract (field (local e) (name households)) (local amount))) (field businesses (call std::add (field (local e) (name businesses)) (local net))) (field wages (field (local e) (name wages))) (field sales (call std::add (field (local e) (name sales)) (local amount))) (field taxes (call std::add (field (local e) (name taxes)) (local tax))) (field fares (field (local e) (name fares))) (field concessions (field (local e) (name concessions))) (field upkeepDue (field (local e) (name upkeepDue))) (field periodTaxes (call std::add (field (local e) (name periodTaxes)) (local tax))) (field periodFares (field (local e) (name periodFares))) (field periodOperating (field (local e) (name periodOperating))) (field lastTaxes (field (local e) (name lastTaxes))) (field lastFares (field (local e) (name lastFares))) (field lastOperating (field (local e) (name lastOperating))))))))
  (function create fare (visibility public) (effect pure) (parameter create e (type Economy)) (parameter create id (type I64)) (returns Economy)
   (body (let (binding amount (call game::min (i64 1) (call game::get (field (local e) (name wallets)) (local id)))) (in (record structural (field wallets (call game::put (field (local e) (name wallets)) (local id) (call std::subtract (call game::get (field (local e) (name wallets)) (local id)) (local amount)))) (field firms (field (local e) (name firms))) (field active (field (local e) (name active))) (field opening (field (local e) (name opening))) (field grants (field (local e) (name grants))) (field exports (field (local e) (name exports))) (field salvage (field (local e) (name salvage))) (field construction (field (local e) (name construction))) (field operating (field (local e) (name operating))) (field withdrawn (field (local e) (name withdrawn))) (field households (call std::subtract (field (local e) (name households)) (local amount))) (field businesses (field (local e) (name businesses))) (field wages (field (local e) (name wages))) (field sales (field (local e) (name sales))) (field taxes (field (local e) (name taxes))) (field fares (call std::add (field (local e) (name fares)) (local amount))) (field concessions (call std::add (field (local e) (name concessions)) (call std::subtract (i64 1) (local amount)))) (field upkeepDue (field (local e) (name upkeepDue))) (field periodTaxes (field (local e) (name periodTaxes))) (field periodFares (call std::add (field (local e) (name periodFares)) (local amount))) (field periodOperating (field (local e) (name periodOperating))) (field lastTaxes (field (local e) (name lastTaxes))) (field lastFares (field (local e) (name lastFares))) (field lastOperating (field (local e) (name lastOperating))))))))
  (function create person (visibility public) (effect pure) (parameter create e (type Economy)) (parameter create old (type Resident)) (parameter create r (type Resident)) (returns Economy)
   (body (let (binding done (call std::less (field (local old) (name journeys)) (field (local r) (name journeys)))) (binding next (if (local done) (if (call std::i64-equal (field (local r) (name purpose)) (i64 1)) (call work (local e) (local r)) (if (call std::bool-or (call std::i64-equal (field (local r) (name purpose)) (i64 2)) (call std::i64-equal (field (local r) (name purpose)) (i64 3))) (call purchase (local e) (local r)) (local e))) (local e))) (in (if (call std::bool-and (call std::i64-equal (field (local r) (name state)) (i64 6)) (call std::bool-not (call std::i64-equal (field (local old) (name state)) (i64 6)))) (call fare (local next) (field (local r) (name id))) (local next))))))
)
)
declarations.end
