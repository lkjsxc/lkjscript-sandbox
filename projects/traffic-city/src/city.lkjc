declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy) (landscape I64)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias Move (record (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (module create town
  (function create line (visibility public) (effect pure) (parameter create tiles (type Numbers)) (parameter create x (type I64)) (parameter create y (type I64)) (parameter create x2 (type I64)) (parameter create y2 (type I64)) (parameter create kind (type I64)) (returns Numbers)
   (body (let (binding id (call game::id (local x) (local y))) (binding next (if (call std::i64-equal (local kind) (i64 0)) (call std::map-remove (types I64 I64) (local tiles) (local id)) (call game::put (local tiles) (local id) (local kind)))) (in (if (call std::less (local x) (local x2)) (call line (local next) (call std::add (local x) (i64 1)) (local y) (local x2) (local y2) (local kind)) (if (call std::less (local y) (local y2)) (call line (local next) (local x) (call std::add (local y) (i64 1)) (local x2) (local y2) (local kind)) (local next)))))))
  (function create from-tiles (visibility public) (effect pure) (parameter create tiles (type Numbers)) (parameter create cash (type I64)) (returns City)
   (body (let (binding world (call game::world (local tiles) (map I64 I64) (i64 1))) (binding sim (call people::spawn-homes (local world) (call game::empty-sim) (i64 0))) (in (call traffic::city (local world) (call traffic::refresh (local world) (local sim)) (local cash) (i64 1) (i64 4) (bool true) (i64 0))))))
  (function create initial (visibility public) (effect pure)  (returns City)
   (body (let (binding t0 (call line (map I64 I64) (i64 55) (i64 64) (i64 73) (i64 64) (i64 2))) (binding t1 (call line (local t0) (i64 55) (i64 60) (i64 55) (i64 68) (i64 2))) (binding t2 (call line (local t1) (i64 58) (i64 60) (i64 58) (i64 68) (i64 2))) (binding t3 (call line (local t2) (i64 73) (i64 61) (i64 73) (i64 67) (i64 2))) (binding t4 (call line (local t3) (i64 62) (i64 64) (i64 67) (i64 64) (i64 1))) (binding t5 (call line (local t4) (i64 54) (i64 62) (i64 55) (i64 62) (i64 7))) (binding t6 (call line (local t5) (i64 57) (i64 66) (i64 58) (i64 66) (i64 7))) (binding city (call from-tiles (call game::put (call game::put (call game::put (call game::put (call game::put (call game::put (call game::put (call game::put (call game::put (call game::put (local t6) (i64 7991) (i64 2)) (i64 8506) (i64 2)) (i64 7735) (i64 3)) (i64 7738) (i64 3)) (i64 8759) (i64 3)) (i64 8762) (i64 3)) (i64 7881) (i64 4)) (i64 8649) (i64 4)) (i64 7990) (i64 6)) (i64 8505) (i64 5)) (i64 900))) (in (record structural (field world (field (local city) (name world))) (field sim (field (local city) (name sim))) (field cash (field (local city) (name cash))) (field level (field (local city) (name level))) (field permits (field (local city) (name permits))) (field paused (field (local city) (name paused))) (field milestone (field (local city) (name milestone))) (field originX (i64 50)) (field originY (i64 54)) (field economy (field (local city) (name economy))) (field landscape (i64 1)))))))
  (function create outcome (visibility public) (effect pure) (parameter create city (type City)) (parameter create notice (type Text)) (returns Outcome)
   (body (record structural (field city (local city)) (field notice (local notice)))))
  (function create between (visibility public) (effect pure) (parameter create n (type I64)) (parameter create low (type I64)) (parameter create high (type I64)) (returns Bool)
   (body (call std::bool-and (call std::less-equal (local low) (local n)) (call std::less-equal (local n) (local high)))))
  (function create land (visibility public) (effect pure) (parameter create city (type City)) (parameter create x (type I64)) (parameter create y (type I64)) (parameter create kind (type I64)) (returns Bool)
   (body (call std::bool-or (call std::bool-not (call terrain::water (local city) (call game::id (local x) (local y)))) (call std::bool-or (call game::road (local kind)) (call std::bool-or (call std::i64-equal (local kind) (i64 0)) (call std::i64-equal (local kind) (i64 7)))))))
  (function create occupied (visibility public) (effect pure) (parameter create city (type City)) (parameter create cell (type I64)) (parameter create index (type I64)) (returns Bool)
   (body (if (call std::less (local index) (call std::list-length (types I64) (field (field (local city) (name sim)) (name ids)))) (let (binding r (call game::agent (field (field (local city) (name sim)) (name agents)) (call std::list-get (types I64) (field (field (local city) (name sim)) (name ids)) (local index)))) (in (call std::bool-or (call std::i64-equal (field (local r) (name cell)) (local cell)) (call std::bool-or (call std::bool-and (call std::i64-equal (field (local r) (name state)) (i64 2)) (call std::bool-or (call std::i64-equal (field (local r) (name from)) (local cell)) (call std::bool-or (call std::i64-equal (field (local r) (name to)) (local cell)) (call std::bool-and (call std::less (i64 0) (field (local r) (name exitKey))) (call std::i64-equal (call std::divide (call std::subtract (field (local r) (name exitKey)) (i64 1)) (i64 8)) (local cell)))))) (call occupied (local city) (local cell) (call std::add (local index) (i64 1))))))) (bool false))))
  (function create check-cell (visibility public) (effect pure) (parameter create city (type City)) (parameter create x (type I64)) (parameter create y (type I64)) (parameter create kind (type I64)) (returns Text)
   (body (let (binding id (call game::id (local x) (local y))) (binding old (call game::get (field (field (local city) (name world)) (name tiles)) (local id))) (in (if (call std::i64-equal (local old) (local kind)) (text "") (if (call std::bool-and (call game::building (local kind)) (call rail::overlap (field (field (local city) (name sim)) (name transit)) (local id) (i64 0))) (text "Buildings cannot overlap elevated rail. Use Remove to review the whole line first.") (if (call std::bool-not (call land (local city) (local x) (local y) (local kind))) (text "Buildings need dry land. Draw a road or footpath from bank to bank to build a bridge.") (if (call std::bool-or (call game::building (local old)) (call std::i64-equal (local old) (i64 8))) (text "Use Remove area to review and remove established buildings.") (if (call std::bool-and (call std::i64-equal (local kind) (i64 0)) (call occupied (local city) (local id) (i64 0))) (text "Use Remove area to review occupied tiles and return affected residents safely home.") (if (call std::bool-and (call std::less (i64 0) (local old)) (call std::bool-or (call game::building (local kind)) (call std::bool-and (call std::i64-equal (local kind) (i64 7)) (call game::road (local old))))) (text "Place buildings and footpaths on empty land.") (if (call std::bool-and (call std::i64-equal (local old) (i64 2)) (call std::bool-and (call std::i64-equal (local kind) (i64 1)) (call occupied (local city) (local id) (i64 0)))) (text "The avenue must be clear before narrowing it.") (text ""))))))))))))
  (function create scan-edit (visibility public) (effect pure) (parameter create city (type City)) (parameter create x (type I64)) (parameter create y (type I64)) (parameter create x2 (type I64)) (parameter create y2 (type I64)) (parameter create kind (type I64)) (returns Text)
   (body (let (binding error (call check-cell (local city) (local x) (local y) (local kind))) (in (if (call std::text-equal (local error) (text "")) (if (call std::less (local x) (local x2)) (call scan-edit (local city) (call std::add (local x) (i64 1)) (local y) (local x2) (local y2) (local kind)) (if (call std::less (local y) (local y2)) (call scan-edit (local city) (local x) (call std::add (local y) (i64 1)) (local x2) (local y2) (local kind)) (text ""))) (local error))))))
  (function create cost (visibility public) (effect pure) (parameter create tiles (type Numbers)) (parameter create x (type I64)) (parameter create y (type I64)) (parameter create x2 (type I64)) (parameter create y2 (type I64)) (parameter create kind (type I64)) (returns I64)
   (body (call std::add (if (call std::i64-equal (call game::get (local tiles) (call game::id (local x) (local y))) (local kind)) (i64 0) (call game::price (local kind))) (if (call std::less (local x) (local x2)) (call cost (local tiles) (call std::add (local x) (i64 1)) (local y) (local x2) (local y2) (local kind)) (if (call std::less (local y) (local y2)) (call cost (local tiles) (local x) (call std::add (local y) (i64 1)) (local x2) (local y2) (local kind)) (i64 0))))))
  (function create edit (visibility public) (effect pure) (parameter create city (type City)) (parameter create command (type Command)) (returns Outcome)
   (body (let (binding x (call game::min (field (local command) (name x)) (field (local command) (name x2)))) (binding y (call game::min (field (local command) (name y)) (field (local command) (name y2)))) (binding x2 (call game::max (field (local command) (name x)) (field (local command) (name x2)))) (binding y2 (call game::max (field (local command) (name y)) (field (local command) (name y2)))) (binding kind (field (local command) (name kind))) (in (if (call std::bool-and (call between (local x) (i64 0) (i64 127)) (call std::bool-and (call between (local y) (i64 0) (i64 127)) (call std::bool-and (call between (local x2) (i64 0) (i64 127)) (call std::bool-and (call between (local y2) (i64 0) (i64 127)) (call between (local kind) (i64 0) (i64 7)))))) (let (binding size (call std::add (i64 1) (call std::add (call std::subtract (local x2) (local x)) (call std::subtract (local y2) (local y))))) (in (if (call std::bool-and (call std::less-equal (local size) (i64 64)) (call std::bool-or (call std::i64-equal (local x) (local x2)) (call std::i64-equal (local y) (local y2)))) (if (call std::bool-and (call game::building (local kind)) (call std::less (i64 1) (local size))) (call outcome (local city) (text "Place one destination or home at a time.")) (let (binding bridgeError (call terrainbuild::bridge-error (local city) (local x) (local y) (local x2) (local y2) (local kind))) (binding error (if (call std::text-equal (local bridgeError) (text "")) (call scan-edit (local city) (local x) (local y) (local x2) (local y2) (local kind)) (local bridgeError))) (binding cost (call terrainbuild::cost (local city) (local x) (local y) (local x2) (local y2) (local kind))) (binding homes (if (call std::bool-and (call std::i64-equal (local kind) (i64 3)) (call std::less (i64 0) (local cost))) (i64 1) (i64 0))) (binding candidate (call line (field (field (local city) (name world)) (name tiles)) (local x) (local y) (local x2) (local y2) (local kind))) (in (if (call std::bool-not (call std::text-equal (local error) (text ""))) (call outcome (local city) (local error)) (if (call std::less (field (local city) (name cash)) (local cost)) (call outcome (local city) (text "Not enough funds. Completed visits earn income.")) (if (call std::less (field (local city) (name permits)) (local homes)) (call outcome (local city) (text "Complete the district goal to unlock home permits.")) (if (call std::bool-or (call std::less (i64 8192) (call std::map-length (types I64 I64) (local candidate))) (call std::bool-and (call std::less (i64 0) (local homes)) (call std::less-equal (i64 2048) (field (field (local city) (name sim)) (name population))))) (call outcome (local city) (text "Preview limit: 8,192 tiles and 2,048 residents.")) (if (call std::bool-and (call std::i64-equal (local cost) (i64 0)) (call std::i64-equal (call std::map-length (types I64 I64) (local candidate)) (call std::map-length (types I64 I64) (field (field (local city) (name world)) (name tiles))))) (call outcome (local city) (text "These tiles already match.")) (call outcome (call traffic::replace-world (local city) (local candidate) (field (field (local city) (name world)) (name signals)) (local cost) (local homes)) (if (call std::less (i64 0) (local homes)) (text "Eight new residents moved in. Give them jobs and useful nearby destinations.") (text "Network updated. New trips will compare walking and driving again."))))))))))) (call outcome (local city) (text "Drag a straight road or path, at most 64 tiles."))))) (call outcome (local city) (text "Invalid coordinates or tool; city unchanged.")))))))
  (function create signal (visibility public) (effect pure) (parameter create city (type City)) (parameter create command (type Command)) (returns Outcome)
   (body (if (call std::bool-and (call between (field (local command) (name x)) (i64 0) (i64 127)) (call std::bool-and (call between (field (local command) (name y)) (i64 0) (i64 127)) (call between (field (local command) (name kind)) (i64 0) (i64 3)))) (let (binding id (call game::id (field (local command) (name x)) (field (local command) (name y)))) (in (if (call std::i64-equal (call game::get (field (field (local city) (name world)) (name junctions)) (local id)) (i64 0)) (call outcome (local city) (text "Choose a junction with three or four road arms.")) (if (call std::i64-equal (call game::get (field (field (local city) (name world)) (name signals)) (local id)) (field (local command) (name kind))) (call outcome (local city) (text "That junction control is already in place.")) (if (call std::less (field (local city) (name cash)) (i64 40)) (call outcome (local city) (text "Junction control costs $40.")) (call outcome (call traffic::replace-world (local city) (field (field (local city) (name world)) (name tiles)) (call game::put (field (field (local city) (name world)) (name signals)) (local id) (field (local command) (name kind))) (i64 40) (i64 0)) (text "Junction updated. Watch its queues through a full signal cycle."))))))) (call outcome (local city) (text "Invalid junction control.")))))
  (function create set-running (visibility public) (effect pure) (parameter create city (type City)) (parameter create command (type Command)) (returns Outcome)
   (body (if (call std::bool-or (call std::i64-equal (field (local command) (name kind)) (i64 0)) (call std::i64-equal (field (local command) (name kind)) (i64 1))) (call outcome (record structural (field world (field (local city) (name world))) (field sim (field (local city) (name sim))) (field cash (field (local city) (name cash))) (field level (field (local city) (name level))) (field permits (field (local city) (name permits))) (field paused (call std::i64-equal (field (local command) (name kind)) (i64 0))) (field milestone (field (local city) (name milestone))) (field originX (field (local city) (name originX))) (field originY (field (local city) (name originY))) (field economy (field (local city) (name economy))) (field landscape (field (local city) (name landscape)))) (text "Simulation updated.")) (call outcome (local city) (text "Invalid simulation setting.")))))
  (function create legacy-dispatch (visibility public) (effect pure) (parameter create city (type City)) (parameter create command (type Command)) (returns Outcome)
   (body (if (call std::text-equal (field (local command) (name op)) (text "build-rail")) (call railbuild::build (local city) (local command)) (if (call std::text-equal (field (local command) (name op)) (text "rail-service")) (call railbuild::service (local city) (local command)) (if (call std::text-equal (field (local command) (name op)) (text "set-running")) (call set-running (local city) (local command)) (if (call std::text-equal (field (local command) (name op)) (text "build")) (call edit (local city) (local command)) (if (call std::text-equal (field (local command) (name op)) (text "signal")) (call signal (local city) (local command)) (if (call std::text-equal (field (local command) (name op)) (text "pause")) (call outcome (record structural (field world (field (local city) (name world))) (field sim (field (local city) (name sim))) (field cash (field (local city) (name cash))) (field level (field (local city) (name level))) (field permits (field (local city) (name permits))) (field paused (call std::bool-not (field (local city) (name paused)))) (field milestone (field (local city) (name milestone))) (field originX (field (local city) (name originX))) (field originY (field (local city) (name originY))) (field economy (field (local city) (name economy))) (field landscape (field (local city) (name landscape)))) (text "Simulation updated.")) (if (call std::text-equal (field (local command) (name op)) (text "grow")) (if (call traffic::growth-ready (local city)) (call outcome (record structural (field world (field (local city) (name world))) (field sim (field (local city) (name sim))) (field cash (call std::subtract (field (local city) (name cash)) (call traffic::growth-cost (field (local city) (name level))))) (field level (call std::add (field (local city) (name level)) (i64 1))) (field permits (call std::add (field (local city) (name permits)) (call std::divide (call traffic::growth-target (field (local city) (name level))) (i64 8)))) (field paused (field (local city) (name paused))) (field milestone (field (field (local city) (name sim)) (name visits))) (field originX (field (local city) (name originX))) (field originY (field (local city) (name originY))) (field economy (field (local city) (name economy))) (field landscape (field (local city) (name landscape)))) (text "District expanded. The next population and completed-visit targets have doubled.")) (call outcome (local city) (text "Meet the population, visits, budget and reliable-travel requirements to expand."))) (call outcome (local city) (text "Unsupported command; city unchanged.")))))))))))
  (function create dispatch (visibility public) (effect pure) (parameter create city (type City)) (parameter create command (type Command)) (returns Outcome)
   (body (if (call std::text-equal (field (local command) (name op)) (text "rail-stop")) (call railinfra::add-stop (local city) (local command)) (if (call std::text-equal (field (local command) (name op)) (text "create-service")) (call railinfra::create-service (local city) (local command)) (if (call std::text-equal (field (local command) (name op)) (text "build-station")) (call railinfra::station-build (local city) (local command)) (if (call std::text-equal (field (local command) (name op)) (text "build-track")) (call railinfra::track-build (local city) (local command)) (call legacy-dispatch (local city) (local command))))))))
  (function create command (visibility public) (effect pure) (parameter create city (type City)) (parameter create command (type Command)) (returns Outcome)
   (body (let (binding out (call dispatch (local city) (local command))) (in (record structural (field city (call moneyedit::command (local city) (field (local out) (name city)))) (field notice (field (local out) (name notice))))))))
)
)
declarations.end
