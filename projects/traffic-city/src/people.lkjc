  (function create find-job-sites (visibility public) (effect pure) (parameter create sites (type (list I64))) (parameter create employment (type Numbers)) (parameter create home (type I64)) (parameter create index (type I64)) (parameter create best (type I64)) (returns I64)
   (body (if (call std::less (local index) (call std::list-length (types I64) (local sites))) (let (binding site (call std::list-get (types I64) (local sites) (local index))) (in (call find-job-sites (local sites) (local employment) (local home) (call std::add (local index) (i64 1)) (if (if (call std::less (call game::get (local employment) (local site)) (i64 16)) (if (call std::less (local best) (i64 0)) (bool true) (call std::less (call game::manhattan (local home) (local site)) (call game::manhattan (local home) (local best)))) (bool false)) (local site) (local best))))) (local best))))
