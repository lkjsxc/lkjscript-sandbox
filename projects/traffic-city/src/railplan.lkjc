declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy) (landscape I64)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (layer I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias MovementStep (record (city City) (arrivals (list I64))))
 (type-alias Move (record (arrivals (list I64)) (estimates Numbers) (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (module create railplan
  (function create pair-positions (visibility public) (effect pure) (parameter create path (type (list I64))) (parameter create i (type I64)) (parameter create out (type Numbers)) (returns Numbers)
   (body (if (call std::less (local i) (call std::list-length (types I64) (local path))) (let (binding id (call std::list-get (types I64) (local path) (local i))) (in (call pair-positions (local path) (call std::add (local i) (i64 1)) (if (call std::i64-equal (call game::get (local out) (local id)) (i64 0)) (call game::put (local out) (local id) (call std::add (local i) (i64 1))) (local out))))) (local out))))
  (function create pair-scan (visibility public) (effect pure) (parameter create stops (type (list I64))) (parameter create positions (type Numbers)) (parameter create origin (type I64)) (parameter create dest (type I64)) (parameter create i (type I64)) (parameter create j (type I64)) (parameter create best (type RailPair)) (returns RailPair)
   (body (let (binding n (call std::list-length (types I64) (local stops))) (in (if (call std::less-equal (local n) (local i)) (local best) (if (call std::less-equal (local n) (local j)) (call pair-scan (local stops) (local positions) (local origin) (local dest) (call std::add (local i) (i64 1)) (i64 0) (local best)) (let (binding a (call std::list-get (types I64) (local stops) (local i))) (binding b (call std::list-get (types I64) (local stops) (local j))) (binding walkA (call game::manhattan (local origin) (local a))) (binding walkB (call game::manhattan (local b) (local dest))) (binding apart (call game::max (call std::subtract (local i) (local j)) (call std::subtract (local j) (local i)))) (binding a0 (call game::get (local positions) (local a))) (binding b0 (call game::get (local positions) (local b))) (binding distance (call game::max (call std::subtract (local a0) (local b0)) (call std::subtract (local b0) (local a0)))) (binding ride (call game::max (i64 1) (call std::divide (call std::add (local distance) (i64 3)) (i64 4)))) (binding estimate (call std::add (call std::multiply (call std::add (local walkA) (local walkB)) (i64 3)) (call std::add (local ride) (call std::multiply (call game::max (i64 0) (call std::subtract (local apart) (i64 1))) (i64 3))))) (in (call pair-scan (local stops) (local positions) (local origin) (local dest) (local i) (call std::add (local j) (i64 1)) (if (if (call std::bool-not (call std::i64-equal (local i) (local j))) (if (call std::less-equal (local walkA) (i64 12)) (if (call std::less-equal (local walkB) (i64 12)) (call std::less (local estimate) (field (local best) (name estimate))) (bool false)) (bool false)) (bool false)) (record structural (field board (local a)) (field alight (local b)) (field estimate (local estimate))) (local best)))))))))))
  (function create pair (visibility public) (effect pure) (parameter create l (type RailLine)) (parameter create origin (type I64)) (parameter create dest (type I64)) (parameter create i (type I64)) (parameter create j (type I64)) (parameter create best (type RailPair)) (returns RailPair)
   (body (let (binding stops (call railpath::stops (local l))) (in (if (call std::less-equal (call std::list-length (types I64) (local stops)) (local i)) (local best) (call pair-scan (local stops) (call pair-positions (call railpath::path (local l)) (i64 0) (map I64 I64)) (local origin) (local dest) (local i) (local j) (local best)))))))
  (function create ride-between (visibility public) (effect pure) (parameter create l (type RailLine)) (parameter create a (type I64)) (parameter create b (type I64)) (returns I64)
   (body (let (binding stops (call railpath::stops (local l))) (binding a0 (call railpath::index (local stops) (local a) (i64 0))) (binding b0 (call railpath::index (local stops) (local b) (i64 0))) (in (call std::add (call railpath::ride (local l) (local a) (local b)) (call std::multiply (call game::max (i64 0) (call std::subtract (call game::max (call std::subtract (local a0) (local b0)) (call std::subtract (local b0) (local a0))) (i64 1))) (i64 3)))))))
  (function create boarding-cost (visibility public) (effect pure) (parameter create l (type RailLine)) (parameter create board (type I64)) (parameter create alight (type I64)) (returns I64)
   (body (let (binding queue (call std::list-length (types I64) (call railpath::platform (local l) (local board) (call railpath::travel-direction (local l) (local board) (local alight))))) (in (call std::add (call std::add (call ride-between (local l) (local board) (local alight)) (call std::divide (call rail::period (local l)) (i64 2))) (call std::multiply (call std::divide (local queue) (field (local l) (name capacity))) (call rail::period (local l))))))))
  (function create lower-bound (visibility public) (effect pure) (parameter create l (type RailLine)) (parameter create origin (type I64)) (parameter create dest (type I64)) (parameter create pair (type RailPair)) (returns I64)
   (body (call std::add (call std::multiply (call std::add (call game::manhattan (local origin) (field (local pair) (name board))) (call game::manhattan (field (local pair) (name alight)) (local dest))) (i64 4)) (call boarding-cost (local l) (field (local pair) (name board)) (field (local pair) (name alight))))))
  (function create can-improve (visibility public) (effect pure) (parameter create lower (type I64)) (parameter create ceiling (type I64)) (parameter create choice (type RailPlan)) (returns Bool)
   (body (if (if (call std::less (local ceiling) (i64 0)) (bool true) (call std::less (local lower) (local ceiling))) (if (call std::i64-equal (field (local choice) (name line)) (i64 0)) (bool true) (call std::less (local lower) (field (local choice) (name eta)))) (bool false))))
  (function create candidate-pair (visibility public) (effect pure) (parameter create world (type World)) (parameter create q (type Numbers)) (parameter create origin (type I64)) (parameter create dest (type I64)) (parameter create l (type RailLine)) (parameter create pair (type RailPair)) (parameter create out (type RailSearch)) (returns RailSearch)
   (body (let (binding board (field (local pair) (name board))) (binding alight (field (local pair) (name alight))) (in (if (if (call std::less-equal (call game::manhattan (local origin) (local board)) (i64 12)) (call std::less-equal (call game::manhattan (local alight) (local dest)) (i64 12)) (bool false)) (let (binding access (call game::ensure-route (local world) (local q) (local origin) (local board) (i64 1) (field (local out) (name plan)))) (binding egress (call game::ensure-route (local world) (local q) (local alight) (local dest) (i64 1) (local access))) (binding a (call game::route (field (local egress) (name routes)) (field (local access) (name id)))) (binding b (call game::route (field (local egress) (name routes)) (field (local egress) (name id)))) (binding eta (call std::add (call std::add (field (local a) (name cost)) (field (local b) (name cost))) (call boarding-cost (local l) (local board) (local alight)))) (binding valid (if (call std::less (i64 0) (field (local access) (name id))) (if (call std::less (i64 0) (field (local egress) (name id))) (if (call std::less-equal (i64 0) (field (local a) (name cost))) (call std::less-equal (i64 0) (field (local b) (name cost))) (bool false)) (bool false)) (bool false))) (in (record structural (field plan (local egress)) (field complete (if (field (local out) (name complete)) (if (call std::less (i64 0) (field (local access) (name id))) (call std::less (i64 0) (field (local egress) (name id))) (bool false)) (bool false))) (field choice (if (if (local valid) (if (call std::i64-equal (field (field (local out) (name choice)) (name line)) (i64 0)) (bool true) (call std::less (local eta) (field (field (local out) (name choice)) (name eta)))) (bool false)) (record structural (field line (field (local l) (name id))) (field board (local board)) (field alight (local alight)) (field accessRoute (field (local access) (name id))) (field egressRoute (field (local egress) (name id))) (field stage (i64 1)) (field eta (local eta))) (field (local out) (name choice))))))) (local out))))))
  (function create candidate (visibility public) (effect pure) (parameter create world (type World)) (parameter create q (type Numbers)) (parameter create origin (type I64)) (parameter create dest (type I64)) (parameter create l (type RailLine)) (parameter create reverse (type Bool)) (parameter create out (type RailSearch)) (returns RailSearch)
   (body (call candidate-pair (local world) (local q) (local origin) (local dest) (local l) (call pair (local l) (local origin) (local dest) (i64 0) (i64 0) (record structural (field board (field (local l) (name a))) (field alight (field (local l) (name b))) (field estimate (i64 1000000)))) (local out))))
  (function create candidate-bounded (visibility public) (effect pure) (parameter create world (type World)) (parameter create q (type Numbers)) (parameter create origin (type I64)) (parameter create dest (type I64)) (parameter create l (type RailLine)) (parameter create ceiling (type I64)) (parameter create out (type RailSearch)) (returns RailSearch)
   (body (let (binding pair (call pair (local l) (local origin) (local dest) (i64 0) (i64 0) (record structural (field board (field (local l) (name a))) (field alight (field (local l) (name b))) (field estimate (i64 1000000))))) (in (if (call can-improve (call lower-bound (local l) (local origin) (local dest) (local pair)) (local ceiling) (field (local out) (name choice))) (call candidate-pair (local world) (local q) (local origin) (local dest) (local l) (local pair) (local out)) (local out))))))
  (function create search-bounded (visibility public) (effect pure) (parameter create world (type World)) (parameter create q (type Numbers)) (parameter create t (type Transit)) (parameter create cash (type I64)) (parameter create origin (type I64)) (parameter create dest (type I64)) (parameter create index (type I64)) (parameter create ceiling (type I64)) (parameter create out (type RailSearch)) (returns RailSearch)
   (body (if (call std::less (local index) (call std::list-length (types I64) (field (local t) (name ids)))) (let (binding l (call rail::line (local t) (call std::list-get (types I64) (field (local t) (name ids)) (local index)))) (binding next (if (if (field (local l) (name enabled)) (call std::less-equal (call rail::expense (local l)) (local cash)) (bool false)) (call candidate-bounded (local world) (local q) (local origin) (local dest) (local l) (local ceiling) (local out)) (local out))) (in (call search-bounded (local world) (local q) (local t) (local cash) (local origin) (local dest) (call std::add (local index) (i64 1)) (local ceiling) (local next)))) (local out))))
  (function create search (visibility public) (effect pure) (parameter create world (type World)) (parameter create q (type Numbers)) (parameter create t (type Transit)) (parameter create cash (type I64)) (parameter create origin (type I64)) (parameter create dest (type I64)) (parameter create index (type I64)) (parameter create out (type RailSearch)) (returns RailSearch)
   (body (if (call std::less (local index) (call std::list-length (types I64) (field (local t) (name ids)))) (let (binding l (call rail::line (local t) (call std::list-get (types I64) (field (local t) (name ids)) (local index)))) (binding next (if (if (field (local l) (name enabled)) (call std::less-equal (call rail::expense (local l)) (local cash)) (bool false)) (call candidate (local world) (local q) (local origin) (local dest) (local l) (bool false) (local out)) (local out))) (in (call search (local world) (local q) (local t) (local cash) (local origin) (local dest) (call std::add (local index) (i64 1)) (local next)))) (local out))))
)
)
declarations.end
