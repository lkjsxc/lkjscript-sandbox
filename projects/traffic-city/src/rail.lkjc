declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias Move (record (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (module create rail
  (function create line (visibility public) (effect pure) (parameter create t (type Transit)) (parameter create id (type I64)) (returns RailLine)
   (body (call std::map-get-or (types I64 RailLine) (field (local t) (name lines)) (local id) (record structural (field id (i64 0)) (field a (i64 0)) (field b (i64 0)) (field from (i64 0)) (field to (i64 0)) (field elapsed (i64 0)) (field duration (i64 0)) (field dwell (i64 0)) (field status (i64 0)) (field cost (i64 0)) (field capacity (i64 0)) (field rideTicks (i64 0)) (field departures (i64 0)) (field boardings (i64 0)) (field spent (i64 0)) (field enabled (bool false)) (field queueA (list I64)) (field queueB (list I64)) (field passengers (list I64)) (field path (list I64)) (field stops (list I64)) (field queues (map I64 (list I64))) (field direction (i64 0))))))
  (function create plan (visibility public) (effect pure) (parameter create t (type Transit)) (parameter create id (type I64)) (returns RailPlan)
   (body (call std::map-get-or (types I64 RailPlan) (field (local t) (name plans)) (local id) (record structural (field line (i64 0)) (field board (i64 0)) (field alight (i64 0)) (field accessRoute (i64 0)) (field egressRoute (i64 0)) (field stage (i64 0)) (field eta (i64 0))))))
  (function create period (visibility public) (effect pure) (parameter create l (type RailLine)) (returns I64)
   (body (call std::multiply (call std::add (field (local l) (name rideTicks)) (call std::multiply (call std::subtract (call std::list-length (types I64) (call railpath::stops (local l))) (i64 1)) (i64 3))) (i64 2))))
  (function create expense (visibility public) (effect pure) (parameter create l (type RailLine)) (returns I64)
   (body (call std::add (i64 2) (call std::divide (call std::add (call railpath::distance (local l) (field (local l) (name from)) (call railpath::next-stop (local l))) (i64 15)) (i64 16)))))
  (function create on-line (visibility public) (effect pure) (parameter create l (type RailLine)) (parameter create id (type I64)) (returns Bool)
   (body (call std::less-equal (i64 0) (call railpath::index (call railpath::path (local l)) (local id) (i64 0)))))
  (function create overlap (visibility public) (effect pure) (parameter create t (type Transit)) (parameter create id (type I64)) (parameter create index (type I64)) (returns Bool)
   (body (call std::bool-or (call std::less (i64 0) (call game::get (field (local t) (name tracks)) (local id))) (if (call std::less (local index) (call std::list-length (types I64) (field (local t) (name ids)))) (call std::bool-or (call on-line (call line (local t) (call std::list-get (types I64) (field (local t) (name ids)) (local index))) (local id)) (call overlap (local t) (local id) (call std::add (local index) (i64 1)))) (bool false)))))
  (function create water (visibility public) (effect pure) (parameter create city (type City)) (parameter create id (type I64)) (returns Bool)
   (body (call std::bool-and (call std::less-equal (call std::add (field (local city) (name originX)) (i64 14)) (call game::x (local id))) (call std::less-equal (call game::x (local id)) (call std::add (field (local city) (name originX)) (i64 15))))))
  (function create access (visibility public) (effect pure) (parameter create world (type World)) (parameter create id (type I64)) (parameter create d (type I64)) (returns Bool)
   (body (if (call std::less (local d) (i64 4)) (let (binding k (call game::get (field (local world) (name tiles)) (call game::neighbor (local id) (local d)))) (in (call std::bool-or (call game::road (local k)) (call std::bool-or (call std::i64-equal (local k) (i64 7)) (call access (local world) (local id) (call std::add (local d) (i64 1))))))) (bool false))))
  (function create corridor (visibility public) (effect pure) (parameter create city (type City)) (parameter create a (type I64)) (parameter create b (type I64)) (parameter create d (type I64)) (returns Bool)
   (body (call std::bool-and (call std::bool-not (call game::building (call game::get (field (field (local city) (name world)) (name tiles)) (local a)))) (call std::bool-and (call std::bool-not (call overlap (field (field (local city) (name sim)) (name transit)) (local a) (i64 0))) (if (call std::i64-equal (local a) (local b)) (bool true) (call corridor (local city) (call game::neighbor (local a) (local d)) (local b) (local d)))))))
  (function create water-count (visibility public) (effect pure) (parameter create city (type City)) (parameter create a (type I64)) (parameter create b (type I64)) (parameter create d (type I64)) (returns I64)
   (body (call std::add (if (call water (local city) (local a)) (i64 1) (i64 0)) (if (call std::i64-equal (local a) (local b)) (i64 0) (call water-count (local city) (call game::neighbor (local a) (local d)) (local b) (local d))))))
  (function create without (visibility public) (effect pure) (parameter create items (type (list I64))) (parameter create id (type I64)) (parameter create index (type I64)) (parameter create out (type (list I64))) (returns (list I64))
   (body (if (call std::less (local index) (call std::list-length (types I64) (local items))) (let (binding item (call std::list-get (types I64) (local items) (local index))) (in (call without (local items) (local id) (call std::add (local index) (i64 1)) (if (call std::i64-equal (local item) (local id)) (local out) (call std::list-append (types I64) (local out) (local item)))))) (local out))))
  (function create begin (visibility public) (effect pure) (parameter create t (type Transit)) (parameter create id (type I64)) (returns Transit)
   (body (let (binding cleaned (call forget (local t) (local id))) (in (record structural (field lines (field (local cleaned) (name lines))) (field ids (field (local cleaned) (name ids))) (field nextId (field (local cleaned) (name nextId))) (field plans (field (local cleaned) (name plans))) (field choices (call std::map-remove (types I64 I64) (field (local t) (name choices)) (local id))) (field boardings (field (local cleaned) (name boardings))) (field completed (field (local cleaned) (name completed))) (field spent (field (local cleaned) (name spent))) (field tracks (field (local cleaned) (name tracks))))))))
