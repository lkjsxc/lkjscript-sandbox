   (body (let (binding f (call facts::summary (local world) (field (local sim) (name agents)) (field (local sim) (name ids)) (i64 0) (record structural (field occ (map I64 I64)) (field heads (map I64 I64)) (field headReady (map I64 I64)) (field busy (map I64 I64)) (field q (map I64 I64)) (field walkq (map I64 I64)) (field inside (map I64 I64)) (field employment (map I64 I64)) (field waiting (i64 0)) (field disconnected (i64 0)) (field moving (i64 0))))) (in (record structural (field agents (field (local sim) (name agents))) (field ids (field (local sim) (name ids))) (field routes (field (local sim) (name routes))) (field lookup (field (local sim) (name lookup))) (field nextRoute (field (local sim) (name nextRoute))) (field nextId (field (local sim) (name nextId))) (field q (field (local f) (name q))) (field walkq (field (local f) (name walkq))) (field flow (field (local sim) (name flow))) (field inside (field (local f) (name inside))) (field employment (field (local f) (name employment))) (field transit (field (local sim) (name transit))) (field tick (field (local sim) (name tick))) (field requested (field (local sim) (name requested))) (field arrived (field (local sim) (name arrived))) (field visits (field (local sim) (name visits))) (field workVisits (field (local sim) (name workVisits))) (field shopVisits (field (local sim) (name shopVisits))) (field leisureVisits (field (local sim) (name leisureVisits))) (field walkTrips (field (local sim) (name walkTrips))) (field carTrips (field (local sim) (name carTrips))) (field waitTicks (field (local sim) (name waitTicks))) (field travelTicks (field (local sim) (name travelTicks))) (field totalDuration (field (local sim) (name totalDuration))) (field population (field (local sim) (name population))) (field waiting (field (local f) (name waiting))) (field disconnected (field (local f) (name disconnected))) (field moving (field (local f) (name moving))) (field healthy (field (local sim) (name healthy))) (field born (field (