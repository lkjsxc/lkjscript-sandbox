  (function create active-routes (visibility public) (effect pure) (parameter create sim (type Sim)) (parameter create index (type I64)) (parameter create routes (type Routes)) (returns Routes)
   (body (if (call std::less (local index) (call std::list-length (types I64) (field (local sim) (name ids)))) (let (binding r (call game::agent (field (local sim) (name agents)) (call std::list-get (types I64) (field (local sim) (name ids)) (local index)))) (in (call active-routes (local sim) (call std::add (local index) (i64 1)) (if (call std::bool-and (call std::i64-equal (field (local r) (name state)) (i64 2)) (call std::less (i64 0) (field (local r) (name route)))) (call std::map-insert (types I64 Route) (local routes) (field (local r) (name route)) (call game::route (field (local sim) (name routes)) (field (local r) (name route)))) (local routes))))) (local routes))))
  (function create retain-walking (visibility public) (effect pure) (parameter create world (type World)) (parameter create entries (type (list RoutePair))) (parameter create index (type I64)) (parameter create cache (type WalkCache)) (returns WalkCache)
   (body (if (call std::less-equal (i64 0) (local index)) (let (binding entry (call std::list-get (types RoutePair) (local entries) (local index))) (binding route (field (local entry) (name value))) (binding steps (call std::list-length (types I64) (field (local route) (name path)))) (binding keep (call std::bool-and (call std::i64-equal (field (local route) (name mode)) (i64 1)) (call std::bool-and (call std::i64-equal (field (local route) (name version)) (field (local world) (name version))) (call std::bool-and (call std::i64-equal (call game::get (field (local cache) (name lookup)) (call game::route-signature (field (local route) (name origin)) (field (local route) (name dest)) (i64 1))) (i64 0)) (call std::bool-and (call std::less (field (local cache) (name count)) (i64 512)) (call std::less-equal (call std::add (field (local cache) (name steps)) (local steps)) (i64 32768))))))) (in (call retain-walking (local world) (local entries) (call std::subtract (local index) (i64 1)) (if (local keep) (record structural (field routes (call std::map-insert (types I64 Route) (field (local cache) (name routes)) (field (local entry) (name key)) (local route))) (field lookup (call game::put (field (local cache) (name lookup)) (call game::route-signature (field (local route) (name origin)) (field (local route) (name dest)) (i64 1)) (field (local entry) (name key)))) (field count (call std::add (field (local cache) (name count)) (i64 1))) (field steps (call std::add (field (local cache) (name steps)) (local steps)))) (local cache))))) (local cache))))
