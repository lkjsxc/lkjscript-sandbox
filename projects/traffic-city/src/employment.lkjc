declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy) (landscape I64)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (layer I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias MovementStep (record (city City) (arrivals (list I64))))
 (type-alias Move (record (arrivals (list I64)) (estimates Numbers) (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (module create employment
  (function create sites-remain (visibility public) (effect pure) (parameter create tiles (type Numbers)) (parameter create jobs (type (list I64))) (parameter create i (type I64)) (returns Bool)
   (body (if (call std::less (local i) (call std::list-length (types I64) (local jobs))) (if (call std::i64-equal (call game::get (local tiles) (call std::list-get (types I64) (local jobs) (local i))) (i64 4)) (call sites-remain (local tiles) (local jobs) (call std::add (local i) (i64 1))) (bool false)) (bool true))))
  (function create same-sites (visibility public) (effect pure) (parameter create before (type World)) (parameter create after (type World)) (returns Bool)
   (body (if (call std::i64-equal (call std::list-length (types I64) (field (local before) (name jobs))) (call std::list-length (types I64) (field (local after) (name jobs)))) (call sites-remain (field (local after) (name tiles)) (field (local before) (name jobs)) (i64 0)) (bool false))))
  (function create counts (visibility public) (effect pure) (parameter create sim (type Sim)) (parameter create i (type I64)) (parameter create out (type Numbers)) (returns Numbers)
   (body (if (call std::less (local i) (call std::list-length (types I64) (field (local sim) (name ids)))) (let (binding r (call game::agent (field (local sim) (name agents)) (call std::list-get (types I64) (field (local sim) (name ids)) (local i)))) (in (call counts (local sim) (call std::add (local i) (i64 1)) (if (call std::less-equal (i64 0) (field (local r) (name job))) (call game::bump (local out) (field (local r) (name job)) (i64 1)) (local out))))) (local out))))
  (function create reset (visibility public) (effect pure) (parameter create sim (type Sim)) (parameter create i (type I64)) (returns Sim)
   (body (if (call std::less (local i) (call std::list-length (types I64) (field (local sim) (name ids)))) (let (binding id (call std::list-get (types I64) (field (local sim) (name ids)) (local i))) (binding r (call game::agent (field (local sim) (name agents)) (local id))) (in (call reset (record structural (field agents (call std::map-insert (types I64 Resident) (field (local sim) (name agents)) (local id) (record structural (field id (field (local r) (name id))) (field home (field (local r) (name home))) (field job (i64 -1)) (field dest (field (local r) (name dest))) (field purpose (field (local r) (name purpose))) (field cycle (field (local r) (name cycle))) (field state (field (local r) (name state))) (field cell (field (local r) (name cell))) (field from (field (local r) (name from))) (field to (field (local r) (name to))) (field step (field (local r) (name step))) (field route (field (local r) (name route))) (field mode (field (local r) (name mode))) (field prior (field (local r) (name prior))) (field dir (field (local r) (name dir))) (field lane (field (local r) (name lane))) (field slot (field (local r) (name slot))) (field elapsed (field (local r) (name elapsed))) (field duration (field (local r) (name duration))) (field wait (field (local r) (name wait))) (field ready (field (local r) (name ready))) (field departed (field (local r) (name departed))) (field etaWalk (field (local r) (name etaWalk))) (field etaCar (field (local r) (name etaCar))) (field eta (field (local r) (name eta))) (field journeys (field (local r) (name journeys))) (field lastTime (field (local r) (name lastTime))) (field reason (field (local r) (name reason))) (field exitKey (field (local r) (name exitKey))) (field zone (field (local r) (name zone))) (field mask (field (local r) (name mask)))))) (field ids (field (local sim) (name ids))) (field routes (field (local sim) (name routes))) (field lookup (field (local sim) (name lookup))) (field nextRoute (field (local sim) (name nextRoute))) (field nextId (field (local sim) (name nextId))) (field q (field (local sim) (name q))) (field walkq (field (local sim) (name walkq))) (field flow (field (local sim) (name flow))) (field inside (field (local sim) (name inside))) (field employment (field (local sim) (name employment))) (field transit (field (local sim) (name transit))) (field tick (field (local sim) (name tick))) (field requested (field (local sim) (name requested))) (field arrived (field (local sim) (name arrived))) (field visits (field (local sim) (name visits))) (field workVisits (field (local sim) (name workVisits))) (field shopVisits (field (local sim) (name shopVisits))) (field leisureVisits (field (local sim) (name leisureVisits))) (field walkTrips (field (local sim) (name walkTrips))) (field carTrips (field (local sim) (name carTrips))) (field waitTicks (field (local sim) (name waitTicks))) (field travelTicks (field (local sim) (name travelTicks))) (field totalDuration (field (local sim) (name totalDuration))) (field population (field (local sim) (name population))) (field waiting (field (local sim) (name waiting))) (field disconnected (field (local sim) (name disconnected))) (field moving (field (local sim) (name moving))) (field healthy (field (local sim) (name healthy))) (field born (field (local sim) (name born))) (field removed (field (local sim) (name removed))) (field cancelled (field (local sim) (name cancelled)))) (call std::add (local i) (i64 1))))) (record structural (field agents (field (local sim) (name agents))) (field ids (field (local sim) (name ids))) (field routes (field (local sim) (name routes))) (field lookup (field (local sim) (name lookup))) (field nextRoute (field (local sim) (name nextRoute))) (field nextId (field (local sim) (name nextId))) (field q (field (local sim) (name q))) (field walkq (field (local sim) (name walkq))) (field flow (field (local sim) (name flow))) (field inside (field (local sim) (name inside))) (field employment (map I64 I64)) (field transit (field (local sim) (name transit))) (field tick (field (local sim) (name tick))) (field requested (field (local sim) (name requested))) (field arrived (field (local sim) (name arrived))) (field visits (field (local sim) (name visits))) (field workVisits (field (local sim) (name workVisits))) (field shopVisits (field (local sim) (name shopVisits))) (field leisureVisits (field (local sim) (name leisureVisits))) (field walkTrips (field (local sim) (name walkTrips))) (field carTrips (field (local sim) (name carTrips))) (field waitTicks (field (local sim) (name waitTicks))) (field travelTicks (field (local sim) (name travelTicks))) (field totalDuration (field (local sim) (name totalDuration))) (field population (field (local sim) (name population))) (field waiting (field (local sim) (name waiting))) (field disconnected (field (local sim) (name disconnected))) (field moving (field (local sim) (name moving))) (field healthy (field (local sim) (name healthy))) (field born (field (local sim) (name born))) (field removed (field (local sim) (name removed))) (field cancelled (field (local sim) (name cancelled)))))))
  (function create prepare (visibility public) (effect pure) (parameter create before (type World)) (parameter create after (type World)) (parameter create sim (type Sim)) (returns Sim)
   (body (if (call same-sites (local before) (local after)) (record structural (field agents (field (local sim) (name agents))) (field ids (field (local sim) (name ids))) (field routes (field (local sim) (name routes))) (field lookup (field (local sim) (name lookup))) (field nextRoute (field (local sim) (name nextRoute))) (field nextId (field (local sim) (name nextId))) (field q (field (local sim) (name q))) (field walkq (field (local sim) (name walkq))) (field flow (field (local sim) (name flow))) (field inside (field (local sim) (name inside))) (field employment (call counts (local sim) (i64 0) (map I64 I64))) (field transit (field (local sim) (name transit))) (field tick (field (local sim) (name tick))) (field requested (field (local sim) (name requested))) (field arrived (field (local sim) (name arrived))) (field visits (field (local sim) (name visits))) (field workVisits (field (local sim) (name workVisits))) (field shopVisits (field (local sim) (name shopVisits))) (field leisureVisits (field (local sim) (name leisureVisits))) (field walkTrips (field (local sim) (name walkTrips))) (field carTrips (field (local sim) (name carTrips))) (field waitTicks (field (local sim) (name waitTicks))) (field travelTicks (field (local sim) (name travelTicks))) (field totalDuration (field (local sim) (name totalDuration))) (field population (field (local sim) (name population))) (field waiting (field (local sim) (name waiting))) (field disconnected (field (local sim) (name disconnected))) (field moving (field (local sim) (name moving))) (field healthy (field (local sim) (name healthy))) (field born (field (local sim) (name born))) (field removed (field (local sim) (name removed))) (field cancelled (field (local sim) (name cancelled)))) (call reset (local sim) (i64 0)))))
  (test create job-sites-empty (visibility private) (actual (call same-sites (record structural (field tiles (map I64 I64)) (field ids (list I64)) (field homes (list I64)) (field jobs (list I64)) (field shops (list I64)) (field parks (list I64)) (field junctions (map I64 I64)) (field signals (map I64 I64)) (field overview (list I64)) (field version (i64 0))) (record structural (field tiles (map I64 I64)) (field ids (list I64)) (field homes (list I64)) (field jobs (list I64)) (field shops (list I64)) (field parks (list I64)) (field junctions (map I64 I64)) (field signals (map I64 I64)) (field overview (list I64)) (field version (i64 0))))) (expected (bool true)))
  (test create job-sites-unchanged (visibility private) (actual (call same-sites (record structural (field tiles (map I64 I64)) (field ids (list I64)) (field homes (list I64)) (field jobs (list I64 (i64 129))) (field shops (list I64)) (field parks (list I64)) (field junctions (map I64 I64)) (field signals (map I64 I64)) (field overview (list I64)) (field version (i64 0))) (record structural (field tiles (call game::put (map I64 I64) (i64 129) (i64 4))) (field ids (list I64)) (field homes (list I64)) (field jobs (list I64 (i64 129))) (field shops (list I64)) (field parks (list I64)) (field junctions (map I64 I64)) (field signals (map I64 I64)) (field overview (list I64)) (field version (i64 0))))) (expected (bool true)))
  (test create job-sites-added (visibility private) (actual (call same-sites (record structural (field tiles (map I64 I64)) (field ids (list I64)) (field homes (list I64)) (field jobs (list I64 (i64 129))) (field shops (list I64)) (field parks (list I64)) (field junctions (map I64 I64)) (field signals (map I64 I64)) (field overview (list I64)) (field version (i64 0))) (record structural (field tiles (call game::put (call game::put (map I64 I64) (i64 129) (i64 4)) (i64 130) (i64 4))) (field ids (list I64)) (field homes (list I64)) (field jobs (list I64 (i64 129) (i64 130))) (field shops (list I64)) (field parks (list I64)) (field junctions (map I64 I64)) (field signals (map I64 I64)) (field overview (list I64)) (field version (i64 0))))) (expected (bool false)))
  (test create job-sites-removed (visibility private) (actual (call same-sites (record structural (field tiles (map I64 I64)) (field ids (list I64)) (field homes (list I64)) (field jobs (list I64 (i64 129))) (field shops (list I64)) (field parks (list I64)) (field junctions (map I64 I64)) (field signals (map I64 I64)) (field overview (list I64)) (field version (i64 0))) (record structural (field tiles (map I64 I64)) (field ids (list I64)) (field homes (list I64)) (field jobs (list I64)) (field shops (list I64)) (field parks (list I64)) (field junctions (map I64 I64)) (field signals (map I64 I64)) (field overview (list I64)) (field version (i64 0))))) (expected (bool false)))
  (test create job-sites-replaced (visibility private) (actual (call same-sites (record structural (field tiles (map I64 I64)) (field ids (list I64)) (field homes (list I64)) (field jobs (list I64 (i64 129))) (field shops (list I64)) (field parks (list I64)) (field junctions (map I64 I64)) (field signals (map I64 I64)) (field overview (list I64)) (field version (i64 0))) (record structural (field tiles (call game::put (map I64 I64) (i64 130) (i64 4))) (field ids (list I64)) (field homes (list I64)) (field jobs (list I64 (i64 130))) (field shops (list I64)) (field parks (list I64)) (field junctions (map I64 I64)) (field signals (map I64 I64)) (field overview (list I64)) (field version (i64 0))))) (expected (bool false)))
)
