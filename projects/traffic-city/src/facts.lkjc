declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy) (landscape I64)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (layer I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias MovementStep (record (city City) (arrivals (list I64))))
 (type-alias Move (record (arrivals (list I64)) (estimates Numbers) (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (type-alias EstimateMemo (record (values Numbers) (eta I64)))
 (module create facts
  (function create summary-agent (visibility public) (effect pure) (parameter create world (type World)) (parameter create r (type Resident)) (parameter create f (type Facts)) (returns Facts)
   (body (let (binding travelling (call std::i64-equal (field (local r) (name state)) (i64 2))) (binding driving (if (if (local travelling) (bool true) (if (call std::i64-equal (field (local r) (name state)) (i64 1)) (call game::road (call game::get (field (local world) (name tiles)) (field (local r) (name cell)))) (bool false))) (call std::i64-equal (field (local r) (name mode)) (i64 2)) (bool false))) (in (record structural (field occ (field (local f) (name occ))) (field heads (field (local f) (name heads))) (field headReady (field (local f) (name headReady))) (field busy (field (local f) (name busy))) (field q (if (local driving) (call game::bump (field (local f) (name q)) (field (local r) (name cell)) (i64 1)) (field (local f) (name q)))) (field walkq (if (if (local travelling) (call std::bool-not (call std::i64-equal (field (local r) (name mode)) (i64 2))) (bool false)) (call game::bump (field (local f) (name walkq)) (field (local r) (name cell)) (i64 1)) (field (local f) (name walkq)))) (field inside (if (if (call std::i64-equal (field (local r) (name state)) (i64 3)) (bool true) (if (call std::i64-equal (field (local r) (name state)) (i64 4)) (bool true) (if (call std::i64-equal (field (local r) (name state)) (i64 2)) (call game::building (call game::get (field (local world) (name tiles)) (field (local r) (name cell)))) (bool false)))) (call game::bump (field (local f) (name inside)) (field (local r) (name cell)) (i64 1)) (field (local f) (name inside)))) (field employment (if (call std::less-equal (i64 0) (field (local r) (name job))) (call game::bump (field (local f) (name employment)) (field (local r) (name job)) (i64 1)) (field (local f) (name employment)))) (field waiting (call std::add (field (local f) (name waiting)) (if (call std::less-equal (i64 8) (field (local r) (name wait))) (i64 1) (i64 0)))) (field disconnected (call std::add (field (local f) (name disconnected)) (if (if (call std::i64-equal (field (local r) (name state)) (i64 1)) (if (call std::i64-equal (field (local r) (name reason)) (i64 1)) (bool true) (call std::i64-equal (field (local r) (name reason)) (i64 9))) (bool false)) (i64 1) (i64 0)))) (field moving (call std::add (field (local f) (name moving)) (if (if (local travelling) (bool true) (call std::i64-equal (field (local r) (name state)) (i64 6))) (i64 1) (i64 0)))))))))
  (function create admission-agent (visibility public) (effect pure) (parameter create world (type World)) (parameter create r (type Resident)) (parameter create f (type Facts)) (returns Facts)
   (body (let (binding travelling (call std::i64-equal (field (local r) (name state)) (i64 2))) (binding driving (if (if (local travelling) (bool true) (if (call std::i64-equal (field (local r) (name state)) (i64 1)) (call game::road (call game::get (field (local world) (name tiles)) (field (local r) (name cell)))) (bool false))) (call std::i64-equal (field (local r) (name mode)) (i64 2)) (bool false))) (in (if (local driving) (let (binding key (call people::resident-lane (local r))) (binding oldhead (call game::get (field (local f) (name heads)) (local key))) (binding junction (if (call std::less (i64 0) (call game::get (field (local world) (name junctions)) (field (local r) (name cell)))) (call game::junction-key (local world) (field (local r) (name cell))) (if (if (call std::less (field (local r) (name elapsed)) (field (local r) (name duration))) (call std::less (i64 0) (call game::get (field (local world) (name junctions)) (field (local r) (name from)))) (bool false)) (call game::junction-key (local world) (field (local r) (name from))) (i64 -1)))) (in (record structural (field occ (call game::bump (if (call std::less (i64 0) (field (local r) (name exitKey))) (call game::bump (field (local f) (name occ)) (call std::subtract (field (local r) (name exitKey)) (i64 1)) (i64 1)) (field (local f) (name occ))) (local key) (i64 1))) (field heads (if (if (call std::i64-equal (local oldhead) (i64 0)) (bool true) (if (call std::less (field (local r) (name ready)) (call game::get (field (local f) (name headReady)) (local key))) (bool true) (if (call std::i64-equal (field (local r) (name ready)) (call game::get (field (local f) (name headReady)) (local key))) (call std::less (field (local r) (name id)) (local oldhead)) (bool false)))) (call game::put (field (local f) (name heads)) (local key) (field (local r) (name id))) (field (local f) (name heads)))) (field headReady (if (if (call std::i64-equal (local oldhead) (i64 0)) (bool true) (call std::less (field (local r) (name ready)) (call game::get (field (local f) (name headReady)) (local key)))) (call game::put (field (local f) (name headReady)) (local key) (field (local r) (name ready))) (field (local f) (name headReady)))) (field busy (if (if (call std::less-equal (i64 0) (local junction)) (call std::less (field (local r) (name elapsed)) (field (local r) (name duration))) (bool false)) (call game::mask-union-put (field (local f) (name busy)) (local junction) (if (call std::less (i64 0) (field (local r) (name mask))) (field (local r) (name mask)) (i64 15))) (field (local f) (name busy)))) (field q (field (local f) (name q))) (field walkq (field (local f) (name walkq))) (field inside (if (if (call std::i64-equal (field (local r) (name state)) (i64 3)) (bool true) (if (call std::i64-equal (field (local r) (name state)) (i64 4)) (bool true) (if (call std::i64-equal (field (local r) (name state)) (i64 2)) (call game::building (call game::get (field (local world) (name tiles)) (field (local r) (name cell)))) (bool false)))) (call game::bump (field (local f) (name inside)) (field (local r) (name cell)) (i64 1)) (field (local f) (name inside)))) (field employment (field (local f) (name employment))) (field waiting (field (local f) (name waiting))) (field disconnected (field (local f) (name disconnected))) (field moving (field (local f) (name moving)))))) (record structural (field occ (field (local f) (name occ))) (field heads (field (local f) (name heads))) (field headReady (field (local f) (name headReady))) (field busy (field (local f) (name busy))) (field q (field (local f) (name q))) (field walkq (field (local f) (name walkq))) (field inside (if (if (call std::i64-equal (field (local r) (name state)) (i64 3)) (bool true) (if (call std::i64-equal (field (local r) (name state)) (i64 4)) (bool true) (if (call std::i64-equal (field (local r) (name state)) (i64 2)) (call game::building (call game::get (field (local world) (name tiles)) (field (local r) (name cell)))) (bool false)))) (call game::bump (field (local f) (name inside)) (field (local r) (name cell)) (i64 1)) (field (local f) (name inside)))) (field employment (field (local f) (name employment))) (field waiting (field (local f) (name waiting))) (field disconnected (field (local f) (name disconnected))) (field moving (field (local f) (name moving)))))))))
  (function create summary-scan (visibility public) (effect pure) (parameter create world (type World)) (parameter create agents (type Residents)) (parameter create ids (type (list I64))) (parameter create index (type I64)) (parameter create f (type Facts)) (parameter create missing (type Resident)) (returns Facts)
   (body (if (call std::less (local index) (call std::list-length (types I64) (local ids))) (call summary-scan (local world) (local agents) (local ids) (call std::add (local index) (i64 1)) (call summary-agent (local world) (call std::map-get-or (types I64 Resident) (local agents) (call std::list-get (types I64) (local ids) (local index)) (local missing)) (local f)) (local missing)) (local f))))
  (function create summary (visibility public) (effect pure) (parameter create world (type World)) (parameter create agents (type Residents)) (parameter create ids (type (list I64))) (parameter create index (type I64)) (parameter create f (type Facts)) (returns Facts)
   (body (call summary-scan (local world) (local agents) (local ids) (local index) (local f) (call game::empty-agent))))
  (function create admission-scan (visibility public) (effect pure) (parameter create world (type World)) (parameter create agents (type Residents)) (parameter create ids (type (list I64))) (parameter create index (type I64)) (parameter create f (type Facts)) (parameter create missing (type Resident)) (returns Facts)
   (body (if (call std::less (local index) (call std::list-length (types I64) (local ids))) (call admission-scan (local world) (local agents) (local ids) (call std::add (local index) (i64 1)) (call admission-agent (local world) (call std::map-get-or (types I64 Resident) (local agents) (call std::list-get (types I64) (local ids) (local index)) (local missing)) (local f)) (local missing)) (local f))))
  (function create admission (visibility public) (effect pure) (parameter create world (type World)) (parameter create agents (type Residents)) (parameter create ids (type (list I64))) (parameter create index (type I64)) (parameter create f (type Facts)) (returns Facts)
   (body (call admission-scan (local world) (local agents) (local ids) (local index) (local f) (call game::empty-agent))))
)
)
declarations.end
