   (body (record structural (field id (local id)) (field home (i64 0)) (field job (if (call std::i64-equal (local mode) (i64 3)) (i64 -1) (i64 130))) (field dest (i64 0)) (field purpose (i64 0)) (field cycle (i64 0)) (field state (local state)) (field cell (if (call std::i64-equal (local mode) (i64 2)) (i64 129) (if (call std::i64-equal (local mode) (i64 1)) (i64 130) (i64 131)))) (field from (i64 128)) (field to (i64 0)) (field step (i64 0)) (field route (i64 0)) (field mode (local mode)) (field prior (i64 0)) (field dir (i64 0)) (field lane (i64 0)) (field slot (i64 0)) (field elapsed (if (call std::i64-equal (local mode) (i64 1)) (i64 1) (i64 0))) (field duration (i64 1)) (field wait (if (call std::i64-equal (local mode) (i64 1)) (i64 7) (i64 8))) (field ready (if (call std::i64-equal (local state) (i64 1)) (i64 7) (call std::subtract (i64 9) (local state)))) (field departed (i64 0)) (field etaWalk (i64 0)) (field etaCar (i64 0)) (field eta (i64 0)) (field journeys (i64 0)) (field lastTime (i64 0)) (field reason (if (call std::i64-equal (local mode) (i64 1)) (i64 1) (if (call std::i64-equal (local mode) (i64 2)) (i64 9) (i64 8)))) (field exitKey (if (call std::i64-equal (call game::mod (local state) (i64 2)) (i64 1)) (i64 1041) (i64 0))) (field zone (i64 0)) (field mask (call game::mod (local state) (i64 2))))))
  (function create facts-residents (visibility public) (effect pure)  (returns Residents)
   (body (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (call std::map-insert (types I64 Resident) (map I64 Resident) (i64 1) (call facts-resident (i64 1) (i64 0) (i64 1))) (i64 2) (call facts-resident (i64 2) (i64 0) (i64 2))) (i64 3) (call facts-resident (i64 3) (i64 0) (i64 3))) (i64 4) (call facts-resident (i64 4) (i64 1) (i64 1))) (i64 5) (call facts-resident (i64 5) (i64 1) (i64 2))) (i64 6) (call facts-resident (i64 6) (i64 1) (i64 3))) (i64 7) (call facts-resident (i64 7) (i64 2) (i64 1))) (i64 8) (call facts-resident (i64 8) (i64 2) (i64 2))) (i64 9) (call facts-resident (i64 9) (i64 2) (i64 3))) (i64 10) (call facts-resident (i64 10) (i64 3) (i64 1))) (i64 11) (call facts-resident (i64 11) (i64 3) (i64 2))) (i64 12) (call facts-resident (i64 12) (i64 3) (i64 3))) (i64 13) (call facts-resident (i64 13) (i64 4) (i64 1))) (i64 14) (call facts-resident (i64 14) (i64 4) (i64 2))) (i64 15) (call facts-resident (i64 15) (i64 4) (i64 3))) (i64 16) (call facts-resident (i64 16) (i64 5) (i64 1))) (i64 17) (call facts-resident (i64 17) (i64 5) (i64 2))) (i64 18) (call facts-resident (i64 18) (i64 5) (i64 3))) (i64 19) (call facts-resident (i64 19) (i64 6) (i64 1))) (i64