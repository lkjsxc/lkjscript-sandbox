declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy) (landscape I64)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (layer I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias Move (record (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (module create roadbuild
  (function create out (visibility public) (effect pure) (parameter create city (type City)) (parameter create notice (type Text)) (returns Outcome)
   (body (record structural (field city (local city)) (field notice (local notice)))))
  (function create valid-kind (visibility public) (effect pure) (parameter create kind (type I64)) (returns Bool)
   (body (call std::bool-or (call std::i64-equal (local kind) (i64 1)) (call std::bool-or (call std::i64-equal (local kind) (i64 2)) (call std::bool-or (call std::i64-equal (local kind) (i64 7)) (call roads::oneway (local kind)))))))
  (function create bounds (visibility public) (effect pure) (parameter create c (type Command)) (returns Bool)
   (body (call std::bool-and (call std::bool-and (call std::less-equal (i64 0) (field (local c) (name x))) (call std::less (field (local c) (name x)) (i64 128))) (call std::bool-and (call std::bool-and (call std::less-equal (i64 0) (field (local c) (name y))) (call std::less (field (local c) (name y)) (i64 128))) (call std::bool-and (call std::bool-and (call std::less-equal (i64 0) (field (local c) (name x2))) (call std::less (field (local c) (name x2)) (i64 128))) (call std::bool-and (call std::bool-and (call std::less-equal (i64 0) (field (local c) (name y2))) (call std::less (field (local c) (name y2)) (i64 128))) (call std::bool-and (call std::bool-or (call std::i64-equal (field (local c) (name x)) (field (local c) (name x2))) (call std::i64-equal (field (local c) (name y)) (field (local c) (name y2)))) (call std::less (call std::add (call game::abs (call std::subtract (field (local c) (name x)) (field (local c) (name x2)))) (call game::abs (call std::subtract (field (local c) (name y)) (field (local c) (name y2))))) (i64 64)))))))))
  (function create occupied (visibility public) (effect pure) (parameter create city (type City)) (parameter create cell (type I64)) (parameter create i (type I64)) (returns Bool)
   (body (if (call std::less (local i) (call std::list-length (types I64) (field (field (local city) (name sim)) (name ids)))) (let (binding r (call game::agent (field (field (local city) (name sim)) (name agents)) (call std::list-get (types I64) (field (field (local city) (name sim)) (name ids)) (local i)))) (in (call std::bool-or (call std::i64-equal (field (local r) (name cell)) (local cell)) (call std::bool-or (call std::bool-and (call std::i64-equal (field (local r) (name state)) (i64 2)) (call std::bool-or (call std::i64-equal (field (local r) (name from)) (local cell)) (call std::bool-or (call std::i64-equal (field (local r) (name to)) (local cell)) (call std::bool-and (call std::less (i64 0) (field (local r) (name exitKey))) (call std::i64-equal (call std::divide (call std::subtract (field (local r) (name exitKey)) (i64 1)) (i64 8)) (local cell)))))) (call occupied (local city) (local cell) (call std::add (local i) (i64 1))))))) (bool false))))
  (function create portal-safe (visibility public) (effect pure) (parameter create city (type City)) (parameter create id (type I64)) (returns Bool)
   (body (let (binding old (call game::get (field (field (local city) (name world)) (name tiles)) (local id))) (in (call std::bool-and (call std::bool-not (call terrain::water (local city) (local id))) (call std::bool-and (call std::bool-or (call std::i64-equal (local old) (i64 0)) (call std::bool-or (call game::road (local old)) (call std::i64-equal (local old) (i64 7)))) (if (call std::bool-and (call std::bool-not (call std::i64-equal (local old) (i64 13))) (call std::less (i64 0) (local old))) (call std::bool-not (call occupied (local city) (local id) (i64 0))) (bool true))))))))
  (function create stroke (visibility public) (effect pure) (parameter create city (type City)) (parameter create x (type I64)) (parameter create y (type I64)) (parameter create x2 (type I64)) (parameter create y2 (type I64)) (parameter create kind (type I64)) (parameter create b (type TrackBuild)) (returns TrackBuild)
   (body (let (binding id (call std::add (call game::id (local x) (local y)) (i64 16384))) (binding old (call game::get (field (field (local city) (name world)) (name tiles)) (local id))) (binding ok (call std::bool-or (call std::i64-equal (local old) (i64 0)) (call valid-kind (local old)))) (binding clear (if (call std::bool-and (call std::less (i64 0) (local old)) (call std::bool-not (call std::i64-equal (local old) (local kind)))) (call std::bool-not (call occupied (local city) (local id) (i64 0))) (bool true))) (binding next (record structural (field tiles (call game::put (field (local b) (name tiles)) (local id) (local kind))) (field cost (call std::add (field (local b) (name cost)) (if (call std::i64-equal (local old) (local kind)) (i64 0) (call roads::underground-price (local kind))))) (field valid (call std::bool-and (field (local b) (name valid)) (call std::bool-and (local ok) (local clear)))))) (in (if (call std::less (local x) (local x2)) (call stroke (local city) (call std::add (local x) (i64 1)) (local y) (local x2) (local y2) (local kind) (local next)) (if (call std::less (local y) (local y2)) (call stroke (local city) (local x) (call std::add (local y) (i64 1)) (local x2) (local y2) (local kind) (local next)) (local next)))))))
  (function create portal-signals (visibility public) (effect pure) (parameter create tiles (type Numbers)) (parameter create entries (type (list Pair))) (parameter create i (type I64)) (parameter create signals (type Numbers)) (returns Numbers)
   (body (if (call std::less (local i) (call std::list-length (types Pair) (local entries))) (let (binding id (field (call std::list-get (types Pair) (local entries) (local i)) (name key))) (in (call portal-signals (local tiles) (local entries) (call std::add (local i) (i64 1)) (if (call roads::portal (local tiles) (local id)) (call std::map-remove (types I64 I64) (local signals) (local id)) (local signals))))) (local signals))))
  (function create publish (visibility public) (effect pure) (parameter create city (type City)) (parameter create b (type TrackBuild)) (parameter create notice (type Text)) (returns Outcome)
   (body (if (call std::bool-not (field (local b) (name valid))) (call out (local city) (text "Tunnel portals need dry empty land or clear roads/paths. Changed underground tiles must be clear. Buildings and stations are never replaced.")) (if (call std::less (i64 8192) (call std::map-length (types I64 I64) (field (local b) (name tiles)))) (call out (local city) (text "The combined ground and underground network exceeds 8,192 tiles.")) (if (call std::less (field (local city) (name cash)) (field (local b) (name cost))) (call out (local city) (text "Not enough funds for the complete underground construction. Nothing was changed.")) (if (call std::i64-equal (field (local b) (name cost)) (i64 0)) (call out (local city) (text "This underground network already matches.")) (call out (call traffic::replace-world (local city) (field (local b) (name tiles)) (call portal-signals (field (local b) (name tiles)) (call std::map-entries (types I64 I64) (field (field (local city) (name world)) (name signals))) (i64 0) (field (field (local city) (name world)) (name signals))) (field (local b) (name cost)) (i64 0)) (local notice))))))))
  (function create line (visibility public) (effect pure) (parameter create city (type City)) (parameter create c (type Command)) (parameter create portals (type Bool)) (returns Outcome)
   (body (if (call std::bool-and (call bounds (local c)) (call valid-kind (field (local c) (name kind)))) (let (binding x (call game::min (field (local c) (name x)) (field (local c) (name x2)))) (binding y (call game::min (field (local c) (name y)) (field (local c) (name y2)))) (binding x2 (call game::max (field (local c) (name x)) (field (local c) (name x2)))) (binding y2 (call game::max (field (local c) (name y)) (field (local c) (name y2)))) (binding a (call game::id (local x) (local y))) (binding z (call game::id (local x2) (local y2))) (binding length (call std::add (i64 1) (call std::add (call std::subtract (local x2) (local x)) (call std::subtract (local y2) (local y))))) (binding b (call stroke (local city) (local x) (local y) (local x2) (local y2) (field (local c) (name kind)) (record structural (field tiles (field (field (local city) (name world)) (name tiles))) (field cost (i64 0)) (field valid (bool true))))) (binding complete (if (local portals) (record structural (field tiles (call game::put (call game::put (field (local b) (name tiles)) (local a) (i64 13)) (local z) (i64 13))) (field cost (call std::add (field (local b) (name cost)) (call std::add (if (call std::i64-equal (call game::get (field (field (local city) (name world)) (name tiles)) (local a)) (i64 13)) (i64 0) (i64 60)) (if (call std::i64-equal (call game::get (field (field (local city) (name world)) (name tiles)) (local z)) (i64 13)) (i64 0) (i64 60))))) (field valid (call std::bool-and (field (local b) (name valid)) (call std::bool-and (call std::less-equal (i64 3) (local length)) (call std::bool-and (call portal-safe (local city) (local a)) (call portal-safe (local city) (local z))))))) (local b))) (in (call publish (local city) (local complete) (if (local portals) (text "Tunnel built with two ground portals. Only the portals connect it to the surface.") (text "Underground network updated. Use a portal to connect it to the ground."))))) (call out (local city) (text "Draw a straight underground road or footpath inside the map, at most 64 tiles. A complete tunnel needs at least three tiles.")))))
  (function create portal (visibility public) (effect pure) (parameter create city (type City)) (parameter create c (type Command)) (returns Outcome)
   (body (if (call std::bool-and (call std::less-equal (i64 0) (field (local c) (name x))) (call std::bool-and (call std::less (field (local c) (name x)) (i64 128)) (call std::bool-and (call std::less-equal (i64 0) (field (local c) (name y))) (call std::less (field (local c) (name y)) (i64 128))))) (let (binding id (call game::id (field (local c) (name x)) (field (local c) (name y)))) (binding under (call game::get (field (field (local city) (name world)) (name tiles)) (call std::add (local id) (i64 16384)))) (in (call publish (local city) (record structural (field tiles (call game::put (field (field (local city) (name world)) (name tiles)) (local id) (i64 13))) (field cost (if (call std::i64-equal (call game::get (field (field (local city) (name world)) (name tiles)) (local id)) (i64 13)) (i64 0) (i64 60))) (field valid (call std::bool-and (call valid-kind (local under)) (call portal-safe (local city) (local id))))) (text "Portal built. This is the only connection between the ground and underground at this tile.")))) (call out (local city) (text "Choose a dry ground tile above an existing underground road or footpath.")))))
  (function create command (visibility public) (effect pure) (parameter create city (type City)) (parameter create c (type Command)) (returns Outcome)
   (body (if (call std::text-equal (field (local c) (name op)) (text "build-portal")) (call portal (local city) (local c)) (call line (local city) (local c) (call std::text-equal (field (local c) (name op)) (text "build-tunnel"))))))
)
)
declarations.end
