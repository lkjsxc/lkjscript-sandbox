  (function create fallback (visibility public) (effect pure) (parameter create t (type Transit)) (parameter create r (type Resident)) (returns Bool)
   (body (let (binding p (call rail::plan (local t) (field (local r) (name id)))) (binding l (call rail::line (local t) (field (local p) (name line)))) (in (call std::bool-or (call std::i64-equal (field (local l) (name id)) (i64 0)) (call std::bool-or (call std::bool-not (field (local l) (name enabled))) (call std::bool-and (call std::i64-equal (field (local l) (name status)) (i64 2)) (call std::less-equal (call rail::period (local l)) (field (local r) (name wait))))))))))
