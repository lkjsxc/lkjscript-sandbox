declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy) (landscape I64)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (layer I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias MovementStep (record (city City) (arrivals (list I64))))
 (type-alias Move (record (arrivals (list I64)) (estimates Numbers) (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (module create roads
  (function create ground (visibility public) (effect pure) (parameter create id (type I64)) (returns I64)
   (body (call std::subtract (local id) (call std::multiply (call std::divide (local id) (i64 16384)) (i64 16384)))))
  (function create layer (visibility public) (effect pure) (parameter create id (type I64)) (returns I64)
   (body (call std::divide (local id) (i64 16384))))
  (function create x (visibility public) (effect pure) (parameter create id (type I64)) (returns I64)
   (body (call std::subtract (local id) (call std::multiply (call std::divide (local id) (i64 128)) (i64 128)))))
  (function create y (visibility public) (effect pure) (parameter create id (type I64)) (returns I64)
   (body (call std::subtract (call std::divide (local id) (i64 128)) (call std::multiply (call std::divide (call std::divide (local id) (i64 128)) (i64 128)) (i64 128)))))
  (function create oneway (visibility public) (effect pure) (parameter create kind (type I64)) (returns Bool)
   (body (if (call std::less-equal (i64 9) (local kind)) (call std::less-equal (local kind) (i64 12)) (bool false))))
  (function create road (visibility public) (effect pure) (parameter create kind (type I64)) (returns Bool)
   (body (if (call std::i64-equal (local kind) (i64 1)) (bool true) (if (call std::i64-equal (local kind) (i64 2)) (bool true) (if (call std::less-equal (i64 9) (local kind)) (call std::less-equal (local kind) (i64 13)) (bool false))))))
  (function create building (visibility public) (effect pure) (parameter create kind (type I64)) (returns Bool)
   (body (if (call std::less-equal (i64 3) (local kind)) (call std::less-equal (local kind) (i64 6)) (bool false))))
  (function create facility (visibility public) (effect pure) (parameter create kind (type I64)) (returns Bool)
   (body (if (call building (local kind)) (bool true) (call std::i64-equal (local kind) (i64 8)))))
  (function create slow (visibility public) (effect pure) (parameter create kind (type I64)) (returns Bool)
   (body (if (call road (local kind)) (call std::bool-not (call std::i64-equal (local kind) (i64 2))) (bool false))))
  (function create neighbor (visibility public) (effect pure) (parameter create id (type I64)) (parameter create direction (type I64)) (returns I64)
   (body (if (call std::i64-equal (local direction) (i64 4)) (if (call std::less (local id) (i64 16384)) (call std::add (local id) (i64 16384)) (call std::subtract (local id) (i64 16384))) (if (call std::i64-equal (local direction) (i64 0)) (if (call std::less (call x (local id)) (i64 127)) (call std::add (local id) (i64 1)) (i64 -1)) (if (call std::i64-equal (local direction) (i64 1)) (if (call std::less (call y (local id)) (i64 127)) (call std::add (local id) (i64 128)) (i64 -1)) (if (call std::i64-equal (local direction) (i64 2)) (if (call std::less (i64 0) (call x (local id))) (call std::subtract (local id) (i64 1)) (i64 -1)) (if (call std::less (i64 0) (call y (local id))) (call std::subtract (local id) (i64 128)) (i64 -1))))))))
  (function create direction (visibility public) (effect pure) (parameter create a (type I64)) (parameter create b (type I64)) (returns I64)
   (body (if (call std::i64-equal (call std::add (local a) (i64 1)) (local b)) (i64 0) (if (call std::i64-equal (call std::add (local a) (i64 128)) (local b)) (i64 1) (if (call std::i64-equal (call std::subtract (local a) (i64 1)) (local b)) (i64 2) (i64 3))))))
  (function create portal (visibility public) (effect pure) (parameter create tiles (type Numbers)) (parameter create id (type I64)) (returns Bool)
   (body (call std::i64-equal (call std::map-get-or (types I64 I64) (local tiles) (call ground (local id)) (i64 0)) (i64 13))))
  (function create passable (visibility public) (effect pure) (parameter create tiles (type Numbers)) (parameter create id (type I64)) (parameter create origin (type I64)) (parameter create dest (type I64)) (parameter create mode (type I64)) (returns Bool)
   (body (if (if (call std::less-equal (i64 0) (local id)) (call std::less (local id) (i64 32768)) (bool false)) (let (binding kind (call std::map-get-or (types I64 I64) (local tiles) (local id) (i64 0))) (in (if (call std::i64-equal (local id) (local origin)) (bool true) (if (call std::i64-equal (local id) (local dest)) (bool true) (if (call road (local kind)) (bool true) (if (call std::i64-equal (local mode) (i64 1)) (call std::i64-equal (local kind) (i64 7)) (bool false))))))) (bool false))))
  (function create drive-edge (visibility public) (effect pure) (parameter create a (type I64)) (parameter create b (type I64)) (parameter create direction (type I64)) (returns Bool)
   (body (if (if (call oneway (local a)) (if (call std::i64-equal (local direction) (call std::subtract (local a) (i64 9))) (bool true) (if (call building (local b)) (bool true) (call std::i64-equal (local b) (i64 8)))) (bool true)) (if (call oneway (local b)) (if (call std::bool-not (call std::i64-equal (local direction) (call std::subtract (call std::subtract (local b) (i64 7)) (call std::multiply (call std::divide (call std::subtract (local b) (i64 7)) (i64 4)) (i64 4))))) (bool true) (if (call building (local a)) (bool true) (call std::i64-equal (local a) (i64 8)))) (bool true)) (bool false))))
  (function create can-step (visibility public) (effect pure) (parameter create tiles (type Numbers)) (parameter create from (type I64)) (parameter create to (type I64)) (parameter create origin (type I64)) (parameter create dest (type I64)) (parameter create mode (type I64)) (returns Bool)
   (body (if (if (call std::less-equal (i64 0) (local from)) (if (call std::less (local from) (i64 32768)) (call passable (local tiles) (local to) (local origin) (local dest) (local mode)) (bool false)) (bool false)) (if (call std::i64-equal (call layer (local from)) (call layer (local to))) (let (binding d (call direction (local from) (local to))) (in (if (if (call std::i64-equal (call neighbor (local from) (local d)) (local to)) (call std::bool-not (if (call facility (call std::map-get-or (types I64 I64) (local tiles) (local from) (i64 0))) (call facility (call std::map-get-or (types I64 I64) (local tiles) (local to) (i64 0))) (bool false))) (bool false)) (if (call std::i64-equal (local mode) (i64 2)) (call drive-edge (call std::map-get-or (types I64 I64) (local tiles) (local from) (i64 0)) (call std::map-get-or (types I64 I64) (local tiles) (local to) (i64 0)) (local d)) (bool true)) (bool false)))) (if (call std::i64-equal (call ground (local from)) (call ground (local to))) (if (call portal (local tiles) (local from)) (if (call std::less (i64 0) (call std::map-get-or (types I64 I64) (local tiles) (local from) (i64 0))) (call std::less (i64 0) (call std::map-get-or (types I64 I64) (local tiles) (local to) (i64 0))) (bool false)) (bool false)) (bool false))) (bool false))))
  (function create degree (visibility public) (effect pure) (parameter create tiles (type Numbers)) (parameter create id (type I64)) (returns I64)
   (body (call std::add (call std::add (if (call road (call std::map-get-or (types I64 I64) (local tiles) (call neighbor (local id) (i64 0)) (i64 0))) (i64 1) (i64 0)) (if (call road (call std::map-get-or (types I64 I64) (local tiles) (call neighbor (local id) (i64 1)) (i64 0))) (i64 1) (i64 0))) (call std::add (if (call road (call std::map-get-or (types I64 I64) (local tiles) (call neighbor (local id) (i64 2)) (i64 0))) (i64 1) (i64 0)) (if (call road (call std::map-get-or (types I64 I64) (local tiles) (call neighbor (local id) (i64 3)) (i64 0))) (i64 1) (i64 0))))))
  (function create junction (visibility public) (effect pure) (parameter create tiles (type Numbers)) (parameter create id (type I64)) (returns Bool)
   (body (if (call road (call std::map-get-or (types I64 I64) (local tiles) (local id) (i64 0))) (if (call std::less-equal (i64 3) (call degree (local tiles) (local id))) (bool true) (call portal (local tiles) (local id))) (bool false))))
  (function create underground-price (visibility public) (effect pure) (parameter create kind (type I64)) (returns I64)
   (body (if (call std::i64-equal (local kind) (i64 7)) (i64 24) (if (call std::i64-equal (local kind) (i64 2)) (i64 72) (if (call oneway (local kind)) (i64 60) (i64 48))))))
)
)
declarations.end
