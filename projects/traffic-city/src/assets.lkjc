ity:.4;pointer-events:none}.menu-content{border:0;padding:0}.menu-content h2{font-size:26px;margin:9px 0 13px}.menu-summary{font-size:12px;margin:0 0 18px}.primary.large{min-height:52px;font-size:14px}.save-caption{margin:8px 0 17px}.menu-links>button{min-height:45px;padding:11px 0;font-size:12px}.session-options{margin-top:17px}.menu-content .small{font-size:10px!important;margin-top:13px}.menu-footer{font-size:9px;padding-top:7px;padding-bottom:calc(15px + var(--safe-bottom))}.menu-screen:has(.menu-page:not(#menu-home):not([hidden])) .menu-story{display:none}.menu-screen:has(.menu-page:not(#menu-home):not([hidden])) .menu-layout{padding-top:16px}.back-link{margin-bottom:24px}.preference{padding:22px 0}}\n@media(max-height:540px) and (min-width:681px){.hud{top:10px}.identity{display:none}.readout{margin:0;padding:5px 16px}.readout strong{font-size:17px}.top-actions{margin-left:auto}.play,.menu-button{height:42px}.camera-tools{top:68px}.map-caption{top:71px}.bottom-ui{bottom:7px;gap:5px;width:420px}.objective{display:none}.dock button{height:50px}.notice{padding:6px 12px}.inspector{bottom:88px;max-height:calc(100dvh - 170px)}.menu-layout{padding:10px 0;min-height:0}.menu-story{min-height:300px}.menu-story h1{font-size:38px}.menu-story>p{display:none}.menu-content h2{font-size:24px}.menu-links>button{min-height:39px}.menu-top{padding-top:8px}.menu-content .small{display:none}.menu-footer{padding:9px}.menu-city-art{transform:scale(.75) rotate(-8deg);transform-origin:left bottom}.removal-sheet{max-height:calc(100dvh - 28px)}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;scroll-behavior:auto!important}}\n\n/* Toasts never reframe the map or move controls when they appear. */\n.notice{position:absolute;bottom:calc(100% + 10px);left:50%;width:max-content;max-width:min(460px,calc(100vw - 32px));transform:translate(-50%,4px)}.notice.visible{transform:translate(-50%,0)}\n\n.rail-help{padding:9px 8px 8px}.rail-help b{font-size:12px}.rail-help p{font-size:11px;line-height:1.6;margin:7px 0;color:var(--muted)}.rail-help span{font-size:10px;color:#6b6385}.rail-service{width:100%;min-height:42px;border:1px solid #c6bed2;border-radius:10px;background:#ece7f2;font-size:12px}.rail-card{border-top:1px solid var(--line);padding-top:12px;margin-top:14px}\n\n.rail-choices{display:flex;gap:6px}.rail-choices button{flex:1;padding:10px 5px;border-radius:10px;background:#eee9f1;font-size:11px}.rail-choices button.selected{background:#d5cce2;box-shadow:inset 0 0 0 1px #9686ad}.rail-choices small{display:block;font-size:8px;line-height:1.5;margin-top:4px}.rail-help .back-link{margin:0 0 8px;font-size:10px}.finance-ledger{display:grid;grid-template-columns:1fr auto;gap:9px;padding:16px 0;border-block:1px solid var(--line);font-size:13px}.finance-ledger dd{margin:0;font-variant-numeric:tabular-nums;font-weight:650}.finance-ledger dt{color:var(--muted)}#finance{max-width:540px}#finance p{font-size:12px;line-height:1.7}#menu-examples .management-choice{padding:15px;margin-bottom:9px}#menu-examples .management-choice span{line-height:1.5}\n\n/* A compact experiment tray shares the existing map/tool layout. */\n.in-lab .objective{display:none}.lab-bar{padding:13px 16px;border:1px solid #b9afcf;background:#f2eff7ed;border-radius:16px;box-shadow:0 4px 20px #29204415;backdrop-filter:blur(12px)}\n.lab-title{display:flex;justify-content:space-between;gap:12px;align-items:center;font-size:10px;letter-spacing:.6px;color:#615275}.lab-title span{letter-spacing:0;font-variant-numeric:tabular-nums}.lab-bar p{font-size:11px;line-height:1.5;margin:5px 0;color:#635d6f}.lab-bar #lab-anchor{font-size:10px}.lab-actions{display:flex;gap:7px;margin-top:9px;align-items:stretch}.lab-actions>*{flex:1;min-width:0;font-size:11px;padding:9px 10px;min-height:42px;border-radius:10px}.lab-actions select{border:1px solid #c6bad5;background:#faf8fd;color:#55456d;font:inherit;font-size:11px}.lab-bar progress{width:100%;height:7px;accent-color:#786291;margin:6px 0 0}.lab-results{width:550px;max-width:min(550px,calc(100% - 28px))}.lab-table{width:100%;border-collapse:collapse;margin:15px 0;font-size:12px;font-variant-numeric:tabular-nums}.lab-table th,.lab-table td{padding:9px 7px;border-bottom:1px solid #d6cfdf;text-align:right}.lab-table th:first-child{text-align:left;font-weight:500}.lab-table thead th{font-size:10px;color:#6b6176;white-space:nowrap}.lab-table td:last-child{background:#eae4f133;font-weight:650}.lab-results .primary{margin-top:16px}.in-lab .map-caption{color:#715788}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@media(max-width:680px){.lab-bar{padding:10px 12px}.lab-actions{gap:5px}.lab-actions>*{padding:8px 6px;font-size:10px}.lab-title{font-size:9px}.lab-bar p{font-size:10px}.lab-table{font-size:11px}.lab-table th,.lab-table td{padding:8px 5px}.lab-results{padding:22px 18px}.lab-results h2{font-size:23px;margin-right:20px}.in-lab:has(#inspector:not([hidden])) .lab-bar{display:none}}\n@media(max-height:540px) and (min-width:681px){.lab-bar{padding:8px 12px}.lab-bar #lab-anchor{display:none}.lab-bar p{margin:2px 0}.lab-actions{margin-top:6px}.lab-actions>*{min-height:36px}}\n\n/* Signed home markers and native counts: color is never the only distinction. */\n.atlas-summary{border-top:1px solid #d6cfdf;margin-top:20px;padding-top:4px}.atlas-summary h3{font-size:15px;line-height:1.4}.atlas-counts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.atlas-counts span{padding:12px 9px;background:#e8e7df;border:1px solid #d2d4c8;border-radius:10px}.atlas-counts strong,.atlas-counts small{display:block}.atlas-counts strong{font-size:23px;font-variant-numeric:tabular-nums}.atlas-counts small{font-size:10px;margin-top:4px}.atlas-counts .less{color:#23716e;background:#e1ede6}.atlas-counts .more{color:#9b4427;background:#f1e3d6}.atlas-controls{display:grid;grid-template-columns:auto minmax(0,1fr);gap:5px 9px;margin:8px 0}.atlas-controls label{font-size:10px;align-self:center}.atlas-controls select{min-height:42px;min-width:0;max-width:100%;font:inherit;font-size:11px;padding:6px;border:1px solid #c6bad5;border-radius:7px;background:#faf8fd;color:#55456d}.atlas-controls p{grid-column:1/-1;font-size:10px}.atlas-legend{display:flex;flex-wrap:wrap;gap:4px 12px;margin:0!important}.atlas-toggle{width:100%;min-height:40px;padding:8px;margin-top:5px;font-size:11px}.atlas-toggle[aria-pressed=true]{background:#ddd5e8}.atlas-visible .dock{display:none}.atlas-caution{padding:8px;border-left:3px solid #967645;background:#eee7d8}.atlas-visible #inspect-details dl{grid-template-columns:minmax(0,1fr) auto;font-size:11px}.atlas-visible #inspect-details dd{align-self:start}.atlas-visible .inspector{max-height:calc(100dvh - 250px)}\n@media(max-width:680px){.atlas-visible .inspector{bottom:calc(45px + var(--safe-bottom));max-height:calc(100dvh - 220px)}.atlas-controls select{font-size:10px}.atlas-counts{gap:6px}.atlas-counts span{padding:10px 7px}.atlas-counts strong{font-size:21px}.atlas-controls .atlas-legend{font-size:9px;gap:4px 9px}}\n\n/* Native viewport totals are separate from the bounded drawing sample. */\n.map-caption{flex-wrap:wrap;max-width:calc(100% - 230px);row-gap:3px}.street-readout{flex-basis:100%;display:flex;flex-direction:column;gap:1px;letter-spacing:0;font-size:10px;line-height:1.4;color:var(--ink);text-shadow:0 1px 2px var(--paper)}#street-sample{font-size:9px;color:var(--muted)}\n@media(max-width:680px){.map-caption{max-width:calc(100% - 158px)}.street-readout{font-size:9px;line-height:1.3}#street-sample{font-size:8px}}\n@media(max-height:540px) and (min-width:681px){.street-readout{flex-direction:row;gap:8px;font-size:9px}}\n\n/* Layer selection is a camera property; construction and removal name it explicitly. */\n.layer-switch{position:absolute;right:28px;top:calc(155px + var(--safe-top));display:flex;gap:3px;padding:3px;background:var(--glass);border:1px solid #c9d7c6;border-radius:12px}.layer-switch button{min-height:34px;padding:6px 12px;background:transparent;border-radius:9px;font-size:10px}.layer-switch [aria-pressed=true]{background:#d9e7d5;color:#225b47;font-weight:700}.road-settings{display:flex;gap:7px;padding-top:8px}.road-settings button,.road-settings select{min-height:36px;padding:6px 10px;border:1px solid #b8cdb7;background:#f4f7ed;border-radius:8px;color:#305c48;font:inherit;font-size:11px}.road-settings button{flex:1}.road-settings [aria-pressed=true]{background:#d0e3df;border-color:#699b90}#road-depth-note{font-size:10px;line-height:1.45;margin:7px 5px 1px;color:var(--muted)}#roads-palette button{min-width:0}#roads-palette small{font-size:8px}#roads-palette svg{width:22px;height:22px}body[data-layer=\"1\"] .map-caption{color:#345c54}\n@media(max-width:680px){.layer-switch{right:15px;top:calc(204px + var(--safe-top))}.layer-switch button{min-height:32px;padding:5px 9px}#roads-palette b{font-size:10px}#roads-palette small{font-size:7px;line-height:1.4}.palette{max-height:45dvh;overflow-y:auto}.road-settings button,.road-settings select{font-size:10px}}\n@media(max-height:540px) and (min-width:681px){.layer-switch{top:123px;right:28px}.palette{max-height:46dvh;overflow-y:auto}}\n\n/* A non-modal, keyed line manager keeps the map and native clock available. */\n#edit-delivery{position:fixed;top:108px;left:50%;transform:translateX(-50%);z-index:35;max-width:calc(100vw - 24px);padding:8px 14px;border-radius:14px;background:#23483ded;color:#fffcec;font:600 12px system-ui;pointer-events:none}\n#lines-panel{position:fixed;z-index:34;top:120px;right:18px;bottom:210px;width:350px;max-width:calc(100vw - 28px);padding:18px;overflow:auto;border:1px solid #b9c9b9;border-radius:20px;background:#f7f4e9;box-shadow:0 12px 40px #23483d24;color:#23483d}\n#lines-panel[hidden],#edit-delivery[hidden]{display:none}\n#lines-panel header{display:flex;align-items:center;justify-content:space-between;gap:10px}#lines-panel h2,#lines-panel h3{margin:0 0 8px}#lines-panel h4{margin:16px 0 8px}\n#lines-panel button,#lines-panel select{font:inherit;color:inherit;border:1px solid #bdcbbc;border-radius:10px;background:#fffdf4;padding:9px 11px;cursor:pointer}\n#lines-panel button:disabled,#lines-panel select:disabled{opacity:.5;cursor:not-allowed}#lines-close{font-size:24px!important;padding:2px 10px!important}\n#lines-list{display:grid;gap:6px;margin:12px 0}#lines-list button{display:grid;text-align:left;gap:3px;border-left:5px solid var(--line-color)}#lines-list button[aria-pressed=true]{background:#e2ebdc}#lines-list span{font-size:12px}\n.line-metrics{display:grid;grid-template-columns:1fr auto;gap:5px;font-size:13px}.line-metrics dd{margin:0;text-align:right}#line-status{font-weight:700}#line-stop-list{padding:0;list-style:none;display:grid;gap:5px}#line-stop-list button{display:flex;width:100%;justify-content:space-between;gap:8px;text-align:left}#line-stop-list small{white-space:nowrap}\n#line-toggle,#line-map-stop,#line-add-existing,#line-create,#line-stop-select{display:block;width:100%;margin-top:8px}#line-toggle{background:#23483d!important;color:#fffcec!important}#line-details label{display:block;margin-top:14px;font-size:12px}#line-create{margin-top:18px}\n@media(max-width:680px){#lines-panel{top:174px;bottom:192px;right:10px;width:calc(100vw - 20px);max-width:calc(100vw - 20px);padding:14px;box-sizing:border-box}#edit-delivery{top:148px;font-size:11px}}\n@media(max-height:540px){#lines-panel{top:90px;bottom:70px}#edit-delivery{top:82px}}\n"))))
