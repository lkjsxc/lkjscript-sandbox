}ctx.stroke();ctx.setLineDash([]);\n }\nfunction drawRoadMarkings(visible){ctx.save();for(const c of visible){const x=c.id%128+.5,y=gridY(c.id)+.5;if(c.kind>=9&&c.kind<=12){ctx.save();ctx.translate(x,y);ctx.rotate((c.kind-9)*Math.PI/2);ctx.strokeStyle='#f3ead0';ctx.lineWidth=.045;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(-.15,0);ctx.lineTo(.15,0);ctx.moveTo(.035,-.1);ctx.lineTo(.15,0);ctx.lineTo(.035,.1);ctx.stroke();ctx.restore()}if(c.kind===13||layer===1&&cells.get(c.id%16384)?.kind===13){ctx.fillStyle='#23494d';ctx.strokeStyle='#dcceaa';ctx.lineWidth=.06;ctx.beginPath();ctx.roundRect(x-.25,y-.25,.5,.5,.1);ctx.fill();ctx.stroke();ctx.strokeStyle='#f5eed8';ctx.lineWidth=.04;ctx.beginPath();for(let i=-1;i<=1;i++){ctx.moveTo(x-.12,y+i*.1);ctx.lineTo(x+.12,y+i*.1)}ctx.stroke()}}ctx.restore()}\nfunction drawRoadQueues(visible){ctx.save();ctx.lineCap='round';ctx.lineJoin='round';for(const c of visible){if(!isRoad(c.kind))continue;const storage=c.kind===2?12:6;if(c.q<storage*.6)continue;ctx.strokeStyle=c.q>=storage?'#cb694b':'#d6a65b';ctx.lineWidth=roadWidth(c)*.62;const arms=roadHeatSegments(c,cells);ctx.beginPath();if(!arms.length){const x=c.id%128+.5,y=gridY(c.id)+.5;ctx.moveTo(x,y);ctx.lineTo(x+.001,y)}for(const [a,b]of arms){ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y)}ctx.stroke()}ctx.restore()}\nfunction drawBridgeDecks(visible){ctx.save();ctx.lineCap='butt';ctx.lineJoin='round';for(const c of visible){if(!(isRoad(c.kind)||c.kind===7)||!waterAt(river,riverWidth,c.id))continue;const x=c.id%128+.5,y=gridY(c.id)+.5,w=c.kind===7?.38:roadWidth(c)+.24,arms=connections(c,cells).filter(a=>isRoad(a.next.kind)||a.next.kind===7);ctx.strokeStyle='#f1ebd9';ctx.lineWidth=w;ctx.beginPath();if(!arms.length){ctx.moveTo(x-.5,y);ctx.lineTo(x+.5,y)}for(const {d}of arms){ctx.moveTo(x,y);ctx.lineTo(x+d[0]*.55,y+d[1]*.55)}ctx.stroke();ctx.strokeStyle='#8b9f99';ctx.lineWidth=.045;ctx.beginPath();for(const {d}of arms)for(const side of [-1,1]){const nx=-d[1]*(w/2-.015)*side,ny=d[0]*(w/2-.0