declarations.begin
(units (use std builtin)
 (module create assets
  (function create html (visibility public) (effect pure) (returns Bytes)
   (body (call std::bytes-from-text (text "<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"><meta name=\"theme-color\" content=\"#e8eddf\"><link rel=\"icon\" href=\"/favicon.svg\"><title>Traffic City</title><link rel=\"stylesheet\" href=\"/style.css\"></head>\n<body><main id=\"game\" aria-label=\"Traffic City\">\n<canvas id=\"map\" tabindex=\"0\" aria-label=\"City map. Explore: drag to pan, tap to inspect. Roads draw straight lines. Remove draws a rectangle for review. Pinch or scroll to zoom; two fingers always move the map.\"></canvas>\n<header class=\"hud\">\n <div class=\"identity\"><span class=\"wordmark\">TRAFFIC <span>CITY</span></span><span class=\"district\">WILLOW · DISTRICT <span id=\"level\">01</span></span></div>\n <div class=\"readout\" aria-label=\"City statistics\"><button id=\"finance-open\" aria-label=\"Open city finances\"><span class=\"stat-label\">FUNDS ↗</span><strong id=\"cash\">$900</strong></button><div><span class=\"stat-label\">RESIDENTS</span><strong id=\"served\">32 people</strong></div><button id=\"queue-stat\" aria-label=\"Explain traffic\"><span class=\"stat-label\">LONG WAITS ↗</span><strong id=\"backlog\">0</strong></button></div>\n <div class=\"top-actions\"><button id=\"play\" class=\"play\" aria-label=\"Start traffic\"><span id=\"play-icon\" aria-hidden=\"true\"></span><span id=\"play-label\">Start</span></button><button id=\"menu-open\" class=\"menu-button\" aria-label=\"Open menu\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 8h14M5 16h14\"/></svg><span>Menu</span></button></div>\n</header>\n<div class=\"map-caption\"><span class=\"live-dot\"></span><span id=\"cycle\">PLANNING</span><span class=\"street-readout\" title=\"Actual street travellers in this viewport. At most 128 are drawn, with room for both walking and driving; counts include unshown people.\"><span id=\"street-counts\">Waiting for street data…</span><span id=\"street-sample\"></span></span></div>\n<div class=\"camera-tools\" aria-label=\"Camera controls\"><button id=\"zoom-in\" aria-label=\"Zoom in\">+</button><button id=\"zoom-out\" aria-label=\"Zoom out\">−</button><button id=\"fit\" aria-label=\"Fit city\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5\"/></svg></button><span id=\"zoom-label\">1×</span></div>\n<div class=\"layer-switch\" role=\"group\" aria-label=\"Map layer\"><button data-layer=\"0\" aria-pressed=\"true\">Ground</button><button data-layer=\"1\" aria-pressed=\"false\">Underground</button></div>\n<section id=\"inspector\" class=\"inspector\" aria-label=\"Selected tile\" hidden><button id=\"inspect-close\" class=\"close\" aria-label=\"Close tile details\">×</button><span class=\"eyebrow\">A CLOSER LOOK</span><h2 id=\"inspect-title\" tabindex=\"-1\"></h2><p id=\"inspect-body\"></p><div id=\"inspect-details\"></div></section>\n<div class=\"bottom-ui\">\n <div id=\"notice\" class=\"notice\" role=\"status\" aria-live=\"polite\"></div>\n <div id=\"edit-delivery\" role=\"status\" aria-live=\"polite\" hidden></div>\n <section id=\"lab-bar\" class=\"lab-bar\" aria-label=\"City Lab experiment\" hidden>\n <div class=\"lab-title\"><strong id=\"lab-heading\">CITY LAB · EDIT PLAN</strong><span id=\"lab-plan-cost\"></span></div>\n <p id=\"lab-anchor\"></p><p id=\"lab-caption\" role=\"status\"></p>\n <div id=\"atlas-controls\" class=\"atlas-controls\" hidden><p class=\"atlas-legend\"><span>− Less</span><span>+ More</span><span>± Mixed</span><span>= Same</span><span>× Roster changed</span></p><label for=\"atlas-home-select\">Inspect home</label><select id=\"atlas-home-select\"><option value=\"\">Choose a home…</option></select><p>Home-based journey time · no change versus plan</p></div>\n <button id=\"atlas-toggle\" class=\"atlas-toggle secondary\" aria-pressed=\"false\" aria-controls=\"atlas-controls\" hidden>Journey atlas</button>\n <progress id=\"lab-progress\" aria-label=\"Current comparison progress\" max=\"64\" value=\"0\" hidden></progress>\n <div class=\"lab-actions\"><select id=\"lab-horizon\" aria-label=\"Cycles per future\"><option value=\"64\">64 cycles</option><option value=\"128\">128 cycles</option><option value=\"256\">256 cycles</option></select><button id=\"lab-compare\" class=\"primary\">Compare</button><button id=\"lab-details\" class=\"primary\" hidden>See results</button><button id=\"lab-edit\" class=\"secondary\" hidden>Edit plan</button><button id=\"lab-exit\" class=\"secondary\">Discard…</button></div>\n</section>\n <section class=\"objective\" aria-label=\"Current objective\"><button id=\"goal-open\" aria-label=\"Show current objective\"><span class=\"chapter\" id=\"chapter\">01</span><span><span class=\"eyebrow\" id=\"mission-title\">ROOM TO GROW</span><strong id=\"mission-short\">32 / 32 people · 0 / 32 visits</strong></span><span class=\"goal-count\" id=\"target-text\">View goal →</span></button><div class=\"track\"><i id=\"progress\"></i></div><button id=\"grow\" class=\"growth\" disabled hidden>Expand district</button></section>\n <section id=\"palette\" class=\"palette\" aria-label=\"Construction choices\" hidden><div class=\"palette-heading\"><span id=\"palette-title\" class=\"eyebrow\">ROADS & PATHS</span><button id=\"palette-close\" aria-label=\"Close construction choices\">×</button></div><div id=\"roads-palette\" class=\"palette-tools\"><button data-tool=\"1\" aria-pressed=\"false\" aria-label=\"Local road, $8 on land or $32 over water\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 19 20 5M4 15 16 3M8 21 22 7\"/></svg><span><b>Local road</b><small>$8 land · $32 bridge</small></span></button><button data-tool=\"2\" aria-pressed=\"false\" aria-label=\"Avenue, $24 on land or $72 over water\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m3 18 15-15m-12 18 15-15M9 20l2-2m2-2 2-2m2-2 2-2\"/></svg><span><b>Avenue</b><small>$24 land · $72 bridge</small></span></button><button data-tool=\"7\" aria-pressed=\"false\" aria-label=\"Footpath, $4 on land or $16 over water\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 21 20 3M8 21 22 7M7 16l3 2m0-6 3 2m0-6 3 2\"/></svg><span><b>Footpath</b><small>$4 land · $16 bridge</small></span></button><button data-tool=\"20\" aria-pressed=\"false\" aria-label=\"One-way road\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 12h18m-7-7 7 7-7 7\"/></svg><span><b>One-way</b><small>$12 land · $48 bridge</small></span></button><button data-tool=\"22\" aria-pressed=\"false\" aria-label=\"Tunnel portal\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 20V10a8 8 0 0 1 16 0v10M8 20V10a4 4 0 0 1 8 0v10M8 15h8m-8 4h8\"/></svg><span><b>Portal</b><small>$60 · dry land</small></span></button></div><div id=\"road-options\" hidden><div class=\"road-settings\"><button id=\"tunnel-mode\" aria-pressed=\"false\">Surface construction</button><select id=\"oneway-direction\" aria-label=\"One-way direction\" disabled><option value=\"0\">East →</option><option value=\"1\">South ↓</option><option value=\"2\">West ←</option><option value=\"3\">North ↑</option></select></div><p id=\"road-depth-note\"></p></div><div id=\"places-palette\" class=\"palette-tools\" hidden><button data-tool=\"3\" aria-pressed=\"false\" aria-label=\"Home, $70 · 1 permit\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m3 11 9-8 9 8M6 10v11h12V10m-8 11v-7h4v7\"/></svg><span><b>Home</b><small>$70 · 1 permit</small></span></button><button data-tool=\"4\" aria-pressed=\"false\" aria-label=\"Workplace, $140 · 16 jobs\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 21V4h14v17M9 8h1m4 0h1m-6 4h1m4 0h1M10 21v-5h4v5\"/></svg><span><b>Workplace</b><small>$140 · 16 jobs</small></span></button><button data-tool=\"5\" aria-pressed=\"false\" aria-label=\"Shop, $110\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 9h18l-3-6H6zm2 0v12h14V9M9 21v-7h6v7\"/></svg><span><b>Shop</b><small>$110</small></span></button><button data-tool=\"6\" aria-pressed=\"false\" aria-label=\"Park, $90\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 21v-8M7 15C0 8 7 1 12 4c5-3 12 4 5 11Z\"/></svg><span><b>Park</b><small>$90</small></span></button></div><div id=\"rail-palette\" class=\"rail-help\" hidden><div class=\"rail-choices\"><button data-tool=\"8\">1 · Track<small>$12 / tile · bridges $36</small></button><button data-tool=\"9\">2 · Station<small>$90 · beside a road/path</small></button><button data-tool=\"10\">3 · Service<small>$120 · 16 seats</small></button></div><button id=\"lines-open\" class=\"rail-service\">Manage lines &amp; stops</button><p id=\"rail-instructions\">Drag a track. A diagonal drag makes a bend; change its order below.</p><button id=\"rail-bend\" class=\"back-link\">Bend: across, then down ↔</button><span>Build stations on track, then connect two stations with a service. Open Lines to start or stop departures, see waiting passengers, and manage the ordered stops.</span></div></section>\n <nav class=\"dock\" aria-label=\"City tools\"><button data-tool=\"-2\" class=\"selected\" aria-pressed=\"true\" aria-label=\"Explore city\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 12V5a2 2 0 0 1 4 0v6-5a2 2 0 0 1 4 0v6-3a2 2 0 0 1 4 0v6c0 5-3 7-7 7-3 0-4-2-6-4l-3-4a2 2 0 0 1 3-2l1 1\"/></svg><span>Explore</span></button><button data-palette=\"roads\" aria-expanded=\"false\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 19 20 5M4 15 16 3M8 21 22 7\"/></svg><span>Roads</span></button><button data-palette=\"places\" aria-expanded=\"false\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m3 11 9-8 9 8M6 10v11h12V10m-8 11v-7h4v7\"/></svg><span>Places</span></button><button data-tool=\"8\" aria-pressed=\"false\" aria-label=\"Build railway\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 3h12v14H6zM6 9h12M9 17l-3 4m9-4 3 4M8 20h8M9 13h.1m5.9 0h.1\"/></svg><span>Rail</span></button><button data-tool=\"0\" aria-pressed=\"false\" aria-label=\"Remove area\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m3 14 10-11 8 8-9 10H9zm5-5 8 8M12 21h10\"/></svg><span>Remove</span></button></nav>\n <div class=\"interaction-hint\"><span id=\"hint\">Drag to explore · scroll to zoom</span><span id=\"connection\" aria-label=\"Connection status\">Connecting</span></div>\n</div>\n<dialog id=\"menu\" class=\"menu-screen\" aria-labelledby=\"menu-title\">\n <div class=\"menu-top\"><span class=\"wordmark\">TRAFFIC <span>CITY</span></span><button id=\"menu-close\" class=\"menu-return\" aria-label=\"Return to city\">Back to city <span aria-hidden=\"true\">→</span></button></div>\n <div class=\"menu-layout\"><section class=\"menu-story\"><span class=\"eyebrow\">A CITY IN MOTION</span><h1 id=\"menu-title\">A place for<br>everyday life.</h1><p>Shorter journeys.<br>Quieter streets.<br>A little more room to grow.</p><div class=\"menu-city-art\" aria-hidden=\"true\"><i class=\"art-river\"></i><i class=\"art-road\"></i><i class=\"art-home a\"></i><i class=\"art-home b\"></i><i class=\"art-work\"></i><i class=\"art-tree a\"></i><i class=\"art-tree b\"></i><i class=\"art-car\"></i></div></section>\n <section class=\"menu-content\">\n  <div id=\"menu-home\" class=\"menu-page\"><span class=\"eyebrow\" id=\"menu-district\">WILLOW · DISTRICT 01</span><h2>Your city awaits.</h2><p id=\"menu-summary\" class=\"menu-summary\"></p><button id=\"continue\" class=\"primary large\">Continue city <span>→</span></button><p id=\"menu-saved\" class=\"save-caption\">Connecting…</p><div class=\"menu-links\"><button id=\"help-open\">How to play <span>→</span></button><button id=\"preferences-open\">Preferences <span>→</span></button><button id=\"lab-open\"><span id=\"lab-open-label\">City Lab · compare a plan</span><span>→</span></button><button id=\"examples-open\">City examples <span>→</span></button><button id=\"manage-open\">Manage city <span>→</span></button></div><div class=\"session-options\"><button id=\"save\" disabled>Save now</button><button id=\"resume\" hidden>Resume here</button><span id=\"saved\">Connecting…</span></div><p id=\"session-note\" class=\"small\">Your city autosaves in this browser.</p></div>\n  <div id=\"menu-preferences\" class=\"menu-page\" hidden><button class=\"back-link\" data-menu-back>← Menu</button><span class=\"eyebrow\">MAKE YOURSELF AT HOME</span><h2>Preferences</h2><label class=\"preference\"><span><b>Show grid</b><small>See tile boundaries while exploring.</small></span><input id=\"grid-setting\" type=\"checkbox\"></label><label class=\"preference\"><span><b>Reduce motion</b><small>Keep water still and trips unanimated.</small></span><input id=\"motion-setting\" type=\"checkbox\"></label><p class=\"small\">Saved on this device. Your system's reduced-motion preference is also respected.</p></div>\n  <div id=\"menu-manage\" class=\"menu-page\" hidden><button class=\"back-link\" data-menu-back>← Menu</button><span class=\"eyebrow\">YOUR SAVED CITY</span><h2>A fresh perspective.</h2><p>Start again at the center of the map. Your current city is kept as one recoverable backup.</p><button id=\"new-city\" class=\"management-choice\"><b>New city</b><span>A fresh district, $900 and 32 residents →</span></button><button id=\"restore-city\" class=\"management-choice\" disabled><b>Restore previous city</b><span id=\"restore-caption\">No previous city yet</span></button><p class=\"small\">Starting another new city replaces the previous backup. Restoring uses that backup once and replaces your current city.</p></div>\n  <div id=\"menu-examples\" class=\"menu-page\" hidden><button class=\"back-link\" data-menu-back>← Menu</button><span class=\"eyebrow\">SIX CITIES TO EXPLORE</span><h2>Find your next challenge.</h2><p>Load your own copy. Your current city becomes one recoverable backup after confirmation.</p><button class=\"management-choice\" data-scenario=\"1\"><b>Garden City · 384 residents</b><span>Balanced neighbourhoods. Keep short trips convenient as the city grows. →</span></button><button class=\"management-choice\" data-scenario=\"2\"><b>Crossing Challenge · 256 residents</b><span>One crowded bridge. Add another crossing and improve the approaches. →</span></button><button class=\"management-choice\" data-scenario=\"3\"><b>Willow Metro · 512 residents</b><span>Two rail services, six stations and a busy mixed city. Improve access and watch your finances. →</span></button><button class=\"management-choice\" data-scenario=\"4\"><b>River Boroughs · 1,024 residents</b><span>Sixteen walkable neighbourhoods, a broad winding river, four trains and sixteen stations. Connect the riverfront without flooding local streets with cars. →</span></button><button class=\"management-choice\" data-scenario=\"5\"><b>Twinbank Region · 2,048 residents</b><span>Thirty-two neighbourhoods, four eight-stop trains, paired one-way arterials and two underground crossings. Rebalance jobs and trips across an entire region. →</span></button><button class=\"management-choice\" data-scenario=\"6\"><b>Commuter Boroughs · 2,048 residents</b><span>Paired residential and employment districts with four east-west and four north-south lines, each serving four shared stations. →</span></button><p class=\"small\">Examples use generated game data. Loading another example replaces the previous backup.</p></div>\n  <div id=\"menu-confirm\" class=\"menu-page\" hidden><button id=\"confirm-back\" class=\"back-link\">← Manage city</button><span class=\"eyebrow\">ONE MOMENT</span><h2 id=\"confirm-title\">Start a new city?</h2><p id=\"confirm-copy\"></p><div class=\"confirmation-actions\"><button id=\"city-cancel\" class=\"secondary\">Keep playing</button><button id=\"city-confirm\" class=\"danger\" disabled>Start new city</button></div><p class=\"small\" id=\"confirm-status\">Waiting for city…</p></div>\n </section></div><div class=\"menu-footer\">Build connections. Give people choices.</div>\n</dialog>\n<dialog id=\"removal\" class=\"removal-sheet\" aria-labelledby=\"removal-title\"><span id=\"removal-mode\" class=\"eyebrow\">REVIEW AREA</span><h2 id=\"removal-title\">Remove this area?</h2><p id=\"removal-size\"></p><dl id=\"removal-details\"></dl><p id=\"removal-estimate\" class=\"small\"></p><p class=\"small\">Affected residents return home. Removing a home makes its residents move out. Cancelled journeys earn no income. Intersecting services are cancelled. Only the selected layer is removed. Ground removal affects surface track and stations; underground removal leaves every ground building, road and rail service intact. Removing a ground portal disconnects, but does not demolish, the tunnel below.</p><div class=\"confirmation-actions\"><button id=\"remove-cancel\" class=\"secondary\" autofocus>Keep area</button><button id=\"remove-confirm\" class=\"danger\">Remove area</button></div></dialog>\n<dialog id=\"help\" aria-labelledby=\"help-title\"><button class=\"close\" data-close=\"help\" aria-label=\"Close instructions\">×</button><span class=\"eyebrow\">HOW TO PLAY</span><h1 id=\"help-title\">Make everyday trips easier.</h1><ol><li><b>Observe.</b> Start traffic. Tap a resident, road or home to see a journey and the reason for a wait.</li><li><b>Connect.</b> Roads carry cars and walkers. Avenues have more lanes. Footpaths offer walking shortcuts. Draw a road or footpath from dry bank to dry bank to build a bridge. New bridges may cross anywhere; their full price appears while dragging. Cars use one-way roads only when a return route is available; walkers may go both ways. In Roads, choose Tunnel + two entrances to build below the city with dry-land portals. Switch to Underground to extend roads or footpaths without changing the ground. Use Portal to add a connection above an existing underground tile.</li><li><b>Bring places closer.</b> Homes add eight people; workplaces offer sixteen jobs. Nearby jobs, shops and parks can replace long drives with short walks.</li><li><b>Offer rail.</b> Build track with bends, place walkable stations, then connect stations with a service. Suspend an empty service to add more stops. People choose it when the whole journey is quicker. Each train holds sixteen people; each departure costs funds. Tap the line to inspect or suspend service.</li><li><b>Balance the budget.</b> Work creates business revenue and wages. Residents buy from local shops and pay fares. Taxes and fares fund construction and operation; the Funds button explains the flow.</li><li><b>Grow.</b> Complete visits, meet the population target and keep trips reliable to earn home permits. Each expansion doubles the next goal.</li></ol><p><b>Stuck?</b> Inspect a queue. A full exit needs more space or another route; a missing destination needs a connection or nearby place. Change junction controls to balance flows. Remove lets you review a rectangle, including occupied roads, before committing.</p><p class=\"small\">Drag to pan; pinch or scroll to zoom. Roads draw straight lines, Remove draws rectangles up to 256 tiles. A second finger cancels a stroke. Keyboard: arrows, +/−, F to fit, U to switch layers, R to rotate one-way direction, Space to start/pause, Escape to cancel or return.</p></dialog>\n<dialog id=\"goal\" aria-labelledby=\"goal-title\"><button class=\"close\" data-close=\"goal\" aria-label=\"Close objective\">×</button><span class=\"eyebrow\">ROOM TO GROW</span><h2 id=\"goal-title\">Make room for more.</h2><p id=\"mission-copy\"></p><p><strong id=\"arrived\">0</strong> destination visits · <span id=\"permits\">4 home permits</span></p><p id=\"travel-summary\"></p><p class=\"small\">Walking has no distance cutoff. Cars spend 12 cycles on access and another 12 parking, in addition to driving. Footpaths carry walkers only. Real street travellers remain visible at every zoom; at most 128 are drawn, with room for both modes. View counts include the people omitted from that drawing, including those waiting on the street.</p><h3>What is waiting?</h3><dl class=\"finance-ledger\"><dt>Long waits · 8+ cycles</dt><dd id=\"wait-total\">0</dd><dt>Of these: route planning</dt><dd id=\"wait-planning\">0</dd><dt>Other long waits</dt><dd id=\"wait-other\">0</dd><dt>All route-planning requests</dt><dd id=\"planning-total\">0</dd></dl><p class=\"small\">Route planning means the simulation is computing travel options, not a road queue. More road capacity does not directly clear it. This time still counts toward journeys and the growth goal.</p><p id=\"growth-note\"></p><p class=\"small\"><span id=\"disconnected\">0</span> trips currently have no route. They remain in the city until you connect them.</p><p id=\"cancelled-summary\" class=\"small\"></p></dialog>\n<dialog id=\"finance\" aria-labelledby=\"finance-title\"><button class=\"close\" data-close=\"finance\" aria-label=\"Close finances\">×</button><span class=\"eyebrow\">MONEY IN YOUR CITY</span><h2 id=\"finance-title\">Every journey has a purpose.</h2><div id=\"finance-details\"></div><p>Work brings outside revenue to businesses. Wages go to residents; payroll and sales taxes go to the city. Shopping and leisure move household money to local destinations. Boarding costs $1; residents with no savings receive a free ride.</p><p class=\"small\">Road and track upkeep is due every 64 cycles. Trains charge per departure. Unpaid upkeep carries forward without interest; trains finish paid legs before waiting for funds. New households bring $24 each in outside capital.</p></dialog><dialog id=\"lab-intro\" aria-labelledby=\"lab-intro-title\"><span class=\"eyebrow\">CITY LAB</span><h2 id=\"lab-intro-title\">Try a different future.</h2><p>Freeze your real city. Build roads, change a junction, add a walking shortcut or redesign a rail service in a temporary plan.</p><p>Compare <b>no change</b> and <b>your plan</b> from exactly the same starting cycle. Each future uses the real native simulation and the same time window.</p><p class=\"small\">Your original city is saved first. Experiments use no extra save slot and never replace your previous-city backup. Reconnecting or session expiry discards the experiment. Applying a plan brings only its edits, not simulated time or earnings.</p><div class=\"confirmation-actions\"><button id=\"lab-intro-cancel\" class=\"secondary\" autofocus>Keep playing</button><button id=\"lab-start\" class=\"primary\">Start experiment</button></div></dialog>\n<dialog id=\"lab-results\" class=\"lab-results\" aria-labelledby=\"lab-result-title\"><button id=\"lab-results-close\" class=\"close\" aria-label=\"Close experiment results\">×</button><span class=\"eyebrow\">CITY LAB · OBSERVED COMPARISON</span><h2 id=\"lab-result-title\">Two futures</h2><p id=\"lab-result-context\" class=\"small\"></p><table class=\"lab-table\"><caption class=\"sr-only\">Native measurements over equal simulation windows</caption><thead><tr><th scope=\"col\">Measure</th><th scope=\"col\">No change</th><th scope=\"col\">Your plan</th></tr></thead><tbody id=\"lab-comparison\"></tbody></table><p id=\"lab-result-note\" class=\"small\"></p><section class=\"atlas-summary\" aria-labelledby=\"atlas-title\"><h3 id=\"atlas-title\">Journey burden · who is affected?</h3><p id=\"atlas-cohort\" class=\"small\"></p><div id=\"atlas-counts\" class=\"atlas-counts\"></div><p class=\"small\">Time tied up in journeys, including planning, queues, parking and unfinished trips. Compared resident by resident, not just for those who arrived.</p><p id=\"atlas-warning\" class=\"small\"></p><button id=\"atlas-map-open\" class=\"secondary\">Show on map →</button></section><button id=\"lab-apply\" class=\"primary large\">Review applying plan →</button></dialog>\n<dialog id=\"lab-confirm\" aria-labelledby=\"lab-confirm-title\"><span class=\"eyebrow\">APPLY THE PLAN, NOT THE FUTURE</span><h2 id=\"lab-confirm-title\">Change your real city?</h2><p id=\"lab-commit-summary\"></p><p class=\"small\">The experiment's clock, arrivals, wages and fares are discarded. Only the planned edits are committed at the original cycle, using the original budget. Your previous-city backup is untouched.</p><div class=\"confirmation-actions\"><button id=\"lab-confirm-cancel\" class=\"secondary\" autofocus>Keep experimenting</button><button id=\"lab-confirm-apply\" class=\"primary\">Apply and save</button></div></dialog>\n<dialog id=\"lab-discard\" aria-labelledby=\"lab-discard-title\"><span class=\"eyebrow\">LEAVE CITY LAB</span><h2 id=\"lab-discard-title\">Discard this experiment?</h2><p>The temporary plan and comparison will be lost. Your original city returns exactly as it was when the experiment began.</p><div class=\"confirmation-actions\"><button id=\"lab-discard-no\" class=\"secondary\" autofocus>Keep experiment</button><button id=\"lab-discard-yes\" class=\"danger\">Discard experiment</button></div></dialog>\n</main><script type=\"module\" src=\"/app.js\"></script></body></html>"))))
  (function create javascript (visibility public) (effect pure) (returns Bytes)
   (body (call std::bytes-from-text (text "import {updateFinances} from './finances.js';\nimport {connections,entranceLinks,roadHeatSegments,riverPoints,waterAt,drawRiver,isRoad,layerOf,gridY,roadTool,roadKind,undergroundQuote} from './geometry.js';\nimport {createCityLab} from './lab.js';\nimport {CommandQueue,mapEdit,cityMutation} from './commands.js';\nimport {createLineManager,lineState,lineEditable,railColors} from './lines.js';\nimport {DemandPainter,SnapshotGate,TrafficMotion,actorPose,pedestrianSize,streetCaption,TileIndex,railPath,railGeometry,railProgress,railPose,railPresentation} from './motion.js';\nconst trafficMotion=new TrafficMotion(),tileIndex=new TileIndex();\nconst sceneGate=new SnapshotGate();let pendingPaint='';\nlet painter=null;function repaint(){painter?.invalidate()}\ntileIndex.rebuild(new Map());let railPaint=railPresentation([],[]),frameArea=null,drawCount=0;\n// Browser presentation and gestures only. lkjscript owns every city, rule, queue and tick.\nconst $=id=>document.getElementById(id),canvas=$('map');let ctx=canvas.getContext('2d');\nconst staticMapCanvas=document.createElement('canvas'),staticMapContext=staticMapCanvas.getContext('2d');let staticMapKey='',mapRevision=0;\nconst names=['Empty land','Local road','Avenue','Home','Workplace','Shop','Park','Footpath','Station','One-way east','One-way south','One-way west','One-way north','Tunnel portal'],prices=[0,8,24,70,140,110,90,4,90,12,12,12,12,60];\nconst recoveryStorageKey='flowgarden-city-v4';let tracks=new Set(),railBend=0,serviceStart=null,addStopLine=0,inspectFunds=0;let rails=[],inspectRailPlan=null;let cityToken='',ownerToken='',sessionStatus=0,actors=[],inspectResident=null,detail=true,storageError=false;\nconst randomHex=n=>Array.from(crypto.getRandomValues(new Uint8Array(n)),b=>b.toString(16).padStart(2,'0')).join('');\ntry{cityToken=localStorage.getItem(recoveryStorageKey)||randomHex(32);if(!/^[a-f0-9]{64}$/.test(cityToken))throw Error('Invalid recovery key');localStorage.setItem(recoveryStorageKey,cityToken)}catch(e){storageError=true}\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),reducedMotion=matchMedia('(prefers-reduced-motion: reduce)');\nlet ws,connected=false,commandId=0,sequence=0,reconnect,persistentSession=false,restoredCheckpoint=-1;\nlet keepaliveTimer=0,renewalTimer=0,renewalAck=0,renewalClose=false;\nlet river=[],riverWidth=6;\nlet layer=0,onewayDirection=0,tunnelMode=false;\nlet cells=new Map(),stats={},serverView={x:0,y:0,w:30,h:20,layer:0},viewPending=null,viewTimer=0,lastViewSent=0;\nlet cameraMotionUntil=0;\nlet width=1,height=1,dpr=1,initialized=false,tool=-2,selected=null,hover=null,draft=null,noticeTimer;\nconst camera={x:64,y:64,scale:25,angle:0,min:12,max:120,fit:25};\nconst pointers=new Map();let gesture=null,gestureSerial=0;\nconst history=[],sentCommands=[],frameTimes=[];\nlet preferences={grid:false,motion:false};try{preferences={...preferences,...JSON.parse(localStorage.getItem('traffic-city-preferences')||'{}')}}catch{}\nlet palette='',menuPage='home',menuWasRunning=false,menuHistory=false,firstCityFrame=true,lastFrame=null,review=null,removalBounds=null,removeRequest=0,removeWasRunning=false,reviewCamera=null,mutationPending=null,confirmKind='';\nconst cityLab=createCityLab({send,cancelGesture,setTool,toast,focusHome(id){setLayer(0);cancelGesture();camera.x=id%128+.5;camera.y=gridY(id)+.5;cameraChanged();inspect(id,true);$('inspect-title').focus({preventScroll:true})},leaveMenu(){menuWasRunning=false;closeMenu()}});\nconst commandQueue=new CommandQueue(item=>{const{id,...action}=item;ws.send(JSON.stringify({id,action,token:action.op==='resume'?cityToken:'',owner:action.op==='resume'?ownerToken:''}))},{changed:updateDelivery});\nconst lineManager=createLineManager({getLines:()=>rails,getStations:()=>[...cells.values()].filter(c=>c.kind===8).map(c=>c.id),getStatus:()=>sessionStatus,getPaused:()=>stats.paused,getPending:()=>commandQueue.items,send,addStop:beginAddStop,focusStation(id){setLayer(0);camera.x=id%128+.5;camera.y=gridY(id)+.5;cameraChanged();inspect(id,true)},beginService(){setTool(10)},onOpen(){cancelGesture();setTool(-2)}});\n$('lines-open').onclick=()=>lineManager.show();\nfunction beginAddStop(id){setTool(11);addStopLine=id;toast('Choose an existing station. Only this stopped, empty line changes.');}\nfunction updateDelivery(){const key=commandQueue.items.filter(c=>mapEdit(c.op)).map(c=>c.id).join(',');if(key!==pendingPaint){pendingPaint=key;repaint()}const n=commandQueue.items.filter(c=>cityMutation(c.op)).length;const status=$('edit-delivery');status.hidden=!n;status.textContent=n?`${n} ${n===1?'change':'changes'} awaiting the city server…`:'';}\nconst motionReduced=()=>reducedMotion.matches||preferences.motion;\n\nfunction mapArea(){if(frameArea)return frameArea;const top=height<500?104:width<=680?180:150;const bottom=Math.max(top+90,Math.min(height-25,document.querySelector('.bottom-ui').getBoundingClientRect().top-18));return{top,bottom,height:Math.max(90,bottom-top)}}\nfunction origin(){const a=mapArea();return{x:width/2,y:(a.top+a.bottom)/2}}\nfunction screenToWorld(p){const o=origin(),c=Math.cos(camera.angle),s=Math.sin(camera.angle),x=(p.x-o.x)/camera.scale,y=(p.y-o.y)/camera.scale;return{x:camera.x+c*x+s*y,y:camera.y-s*x+c*y}}\nfunction worldToScreen(x,y){const o=origin(),c=Math.cos(camera.angle),s=Math.sin(camera.angle),dx=(x-camera.x)*camera.scale,dy=(y-camera.y)*camera.scale;return{x:o.x+c*dx-s*dy,y:o.y+s*dx+c*dy}}\nfunction position(e){const r=canvas.getBoundingClientRect();return{x:e.clientX-r.left,y:e.clientY-r.top}}\nfunction inside(p){return p.x>=0&&p.y>=0&&p.x<width&&p.y<height}\nfunction tile(p){const w=screenToWorld(p);return{x:Math.floor(w.x),y:Math.floor(w.y)}}\nfunction straighten(a,b){return Math.abs(b.x-a.x)>Math.abs(b.y-a.y)?{x:b.x,y:a.y}:{x:a.x,y:b.y}}\nfunction visibleRect(){const a=mapArea();const corners=[{x:0,y:a.top},{x:width,y:a.top},{x:0,y:a.bottom},{x:width,y:a.bottom}].map(screenToWorld);const x=clamp(Math.floor(Math.min(...corners.map(p=>p.x)))-1,0,127),y=clamp(Math.floor(Math.min(...corners.map(p=>p.y)))-1,0,127);return{x,y,w:clamp(Math.ceil(Math.max(...corners.map(p=>p.x)))+1-x,1,128-x),h:clamp(Math.ceil(Math.max(...corners.map(p=>p.y)))+1-y,1,128-y)}}\nfunction cameraChanged(){repaint();cameraMotionUntil=performance.now()+120;if(camera.scale<=Math.min(width,height)/128){camera.x=64;camera.y=64}camera.x=clamp(camera.x,0,128);camera.y=clamp(camera.y,0,128);$('zoom-label').textContent=(camera.scale/camera.fit).toFixed(1)+'×';scheduleView()}\nfunction anchorZoom(scale,p,anchor=screenToWorld(p)){camera.scale=clamp(scale,camera.min,camera.max);const after=screenToWorld(p);camera.x+=anchor.x-after.x;camera.y+=anchor.y-after.y;cameraChanged()}\nfunction fitCity(){cancelGesture();let ids=[...cells.keys()].filter(id=>layerOf(id)===layer);if(!ids.length)ids=[...cells.keys()].filter(id=>layerOf(id)===0);const xs=ids.map(id=>id%128),ys=ids.map(id=>gridY(id));const minX=ids.length?Math.min(...xs):3,maxX=ids.length?Math.max(...xs):24,minY=ids.length?Math.min(...ys):5,maxY=ids.length?Math.max(...ys):15;camera.x=(minX+maxX+1)/2;camera.y=(minY+maxY+1)/2;const w=maxX-minX+2,h=maxY-minY+3;camera.scale=clamp(Math.min((width-50)/(camera.angle?h:w),mapArea().height/(camera.angle?w:h)),camera.min,camera.max);selected=null;$('inspector').hidden=true;cameraChanged()}\nfunction resize(){const r=canvas.getBoundingClientRect();if(!r.width||!r.height)return;const oldFit=camera.fit,ratio=camera.scale/oldFit;cancelGesture();width=r.width;height=r.height;dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(width*dpr);canvas.height=Math.round(height*dpr);camera.angle=height>width*1.15?-Math.PI/2:0;\n const a=camera.angle?height:width,b=camera.angle?width:height;const min=Math.max(1,Math.min(width,height)/144);camera.min=min;\n const usableW=width-50,usableH=mapArea().height;camera.fit=Math.max(min,Math.min(usableW/(camera.angle?13:24),usableH/(camera.angle?24:13)));camera.max=Math.max(camera.fit*5,96);camera.scale=initialized?clamp(camera.fit*ratio,min,camera.max):camera.fit;initialized=true;cameraChanged();}\nnew ResizeObserver(resize).observe(canvas);\nfunction send(op,fields={}){if(!connected||ws.readyState!==WebSocket.OPEN){toast('Wait for the city connection before editing.');return 0}if(!['resume','view','inspect'].includes(op)&&sessionStatus!==1){toast('Resume your city before editing.');return 0}const action={op,x:0,y:0,x2:0,y2:0,kind:0,...fields};let id;try{id=commandQueue.enqueue(action)}catch{toast('The connection interrupted this change. Reconnect and check the saved city before repeating it.',15000);ws.close();return 0}if(!id){toast('The edit queue is full. This stroke was not sent; wait for pending changes to finish.',8000);return 0}commandId=id;sentCommands.push({id,...action});if(sentCommands.length>200)sentCommands.shift();return id}\nfunction scheduleView(){clearTimeout(viewTimer);viewTimer=setTimeout(syncView,Math.max(0,160-(performance.now()-lastViewSent)))}\nfunction syncView(force=false){if(!connected||viewPending)return;const r=visibleRect();const covered=(r.w*r.h<=1024)===(serverView.w*serverView.h<=1024)&&r.x>=serverView.x&&r.y>=serverView.y&&r.x+r.w<=serverView.x+serverView.w&&r.y+r.h<=serverView.y+serverView.h;\n if(covered&&!force&&layer===serverView.layer&&r.x===serverView.x&&r.y===serverView.y&&r.w===serverView.w&&r.h===serverView.h)return;const id=send('view',{x:r.x,y:r.y,x2:r.w,y2:r.h,kind:layer});if(id){viewPending={id,rect:{...r,layer}};lastViewSent=performance.now()}}\n// Native sessions are bounded. Keep an observed city connected, and rotate a\n// long session only after a native save acknowledgement, before its hard limit.\nfunction scheduleRenewal(delay=25*60*1000){clearTimeout(renewalTimer);renewalTimer=setTimeout(()=>{if(connected&&sessionStatus===1&&!cityLab.active&&!mutationPending&&!gesture&&!document.querySelector('#removal[open],#menu[open]'))renewalAck=send('save');else if(connected)scheduleRenewal(5000)},delay)}\nfunction startConnectionTimers(){clearInterval(keepaliveTimer);keepaliveTimer=setInterval(()=>{if(connected&&sessionStatus===1)syncView(true)},60000);scheduleRenewal()}\nfunction stopConnectionTimers(){clearInterval(keepaliveTimer);clearTimeout(renewalTimer);renewalAck=0}\nfunction connect(){clearTimeout(reconnect);if(storageError){$('connection').textContent='Storage unavailable';toast('Browser storage is unavailable or the city key is invalid. Enable local storage before playing; no city has been replaced.',30000);return}const endpoint=new URL('/live',location.href);endpoint.protocol=location.protocol==='https:'?'wss:':'ws:';const port=new URLSearchParams(location.search).get('session_port');if(port!==null){if(!/^\\d{1,5}$/.test(port)||Number(port)<1||Number(port)>65535){toast('Invalid session port.');return}endpoint.port=String(Number(port))}\n ownerToken=randomHex(16);ws=new WebSocket(endpoint);ws.onopen=()=>{sceneGate.clear();connected=true;commandId=0;sequence=0;sessionStatus=0;commandQueue.reset();viewPending=null;cancelGesture();$('connection').textContent='Resuming…';$('connection').classList.remove('offline');send('resume');startConnectionTimers()};\n ws.onmessage=e=>{const f=JSON.parse(e.data);if(f.seq<=sequence)return;sequence=f.seq;try{commandQueue.acknowledge(f.ack)}catch{toast('The city connection lost command order. Reconnecting without replaying uncertain edits.',15000);ws.close(1002,'command order');return}commandId=Math.max(commandId,f.ack);persistentSession=true;sessionStatus=f.status;const sceneChanged=sceneGate.accept(f);if(sceneChanged){detail=f.detail;actors=f.actors||[];inspectResident=f.inspect;rails=f.rails||[];inspectFunds=f.inspectFunds||0;inspectRailPlan=f.inspectRail;\n if(f.mapChanged){river=riverPoints(f.river||[]);riverWidth=f.riverWidth||6;tracks=new Set(f.tracks||[]);mapRevision++;cells=new Map(f.overview.map(v=>{const id=Math.floor(v/16);return[id,{id,kind:v%16,q:0,walk:0,flow:0,inside:0,junction:0,control:0}]}))}else if(f.reset){for(const c of cells.values()){c.q=0;c.walk=0;c.flow=0;c.inside=0}}\n for(const c of f.cells){if(c.kind)cells.set(c.id,c);else cells.delete(c.id)}if(!detail){for(const c of cells.values())c.q=0;for(const v of f.heat||[]){const c=cells.get(Math.floor(v/32));if(c)c.q=v%32}}\n tileIndex.rebuild(cells);railPaint=railPresentation(tileIndex.stations,rails);trafficMotion.receive(f,performance.now(),cells);stats=f.stats;}if(firstCityFrame&&f.status===1&&f.mapChanged){firstCityFrame=false;fitCity()}if(f.view)serverView=f.view;if(viewPending&&f.ack>=viewPending.id){serverView=f.view||viewPending.rect;viewPending=null}history.push({tick:stats.tick,backlog:stats.requested-stats.arrived,bytes:e.data.length});if(history.length>300)history.shift();update(f);if(selected!==null)inspect(selected,false);scheduleView();if(renewalAck&&f.ack>=renewalAck){renewalAck=0;if(f.status===1&&f.saved===f.stats.tick){renewalClose=true;ws.close(1000,'saved city connection renewal')}else scheduleRenewal(60000)}lineManager.render();if(sceneChanged)repaint();if(f.status===1||f.status===0)commandQueue.flush()};\n ws.onclose=()=>{const delay=renewalClose?250:2500;renewalClose=false;stopConnectionTimers();connected=false;const abandoned=commandQueue.reset().filter(c=>cityMutation(c.op));cityLab.offline();abandonPending();viewPending=null;cancelGesture();$('connection').textContent='Offline';$('connection').classList.add('offline');if(sessionStatus!==2){toast('Reconnecting to your saved city…',6000);reconnect=setTimeout(connect,delay)}if(abandoned.length)toast(`${abandoned.length} pending changes lost their connection. Unsent changes were not applied; check the saved city before repeating an unacknowledged change.`,20000)};ws.onerror=()=>toast('City connection unavailable. Your saved city is retained.',6000);\n}\nfunction toast(message,duration=3500){if(!message)return;clearTimeout(noticeTimer);$('notice').textContent=message;$('notice').classList.add('visible');noticeTimer=setTimeout(()=>{$('notice').classList.remove('visible')},duration)}\nfunction update(f){const street=streetCaption((f.view?.layer||0)===layer?f:{mapChanged:true});$('street-counts').textContent=street.counts;$('street-sample').textContent=street.sample;$('cash').textContent='$'+stats.cash.toLocaleString();$('served').textContent=stats.population+' people';$('backlog').textContent=stats.waiting.toLocaleString();$('wait-total').textContent=stats.waiting.toLocaleString();$('wait-planning').textContent=(stats.planningLong||0).toLocaleString();$('wait-other').textContent=(stats.waiting-(stats.planningLong||0)).toLocaleString();$('planning-total').textContent=(stats.planning||0).toLocaleString();$('queue-stat').title=`${stats.waiting} long waits, including ${stats.planningLong||0} computing routes. ${stats.planning||0} total route-planning requests. Open the breakdown.`;$('arrived').textContent=stats.visits.toLocaleString();$('disconnected').textContent=stats.disconnected.toLocaleString();$('cycle').textContent=(stats.paused?'PLANNING':'IN MOTION')+' · '+(detail?'CYCLE '+stats.tick:'CITY OVERVIEW');$('queue-stat').classList.toggle('congested',stats.waiting>stats.population/4);$('play').disabled=sessionStatus!==1;$('play').setAttribute('aria-label',stats.paused?'Start traffic':'Pause traffic');$('play-icon').innerHTML=stats.paused?'<svg viewBox=\"0 0 20 20\"><path d=\"M6 3l11 7-11 7z\"/></svg>':'<svg viewBox=\"0 0 20 20\"><path d=\"M4 3h4v14H4zM12 3h4v14h-4z\"/></svg>';$('play-label').textContent=stats.paused?'Start':'Pause';$('play').classList.toggle('running',!stats.paused&&sessionStatus===1);document.querySelector('.live-dot').classList.toggle('running',!stats.paused&&sessionStatus===1);\n const level=String(stats.level).padStart(2,'0'),target=stats.growthTarget;$('level').textContent=level;$('chapter').textContent=level;$('mission-title').textContent='ROOM TO GROW';$('mission-short').textContent=stats.growth?'Ready to expand.':`${stats.population} / ${target} people · ${stats.progress} / ${target} visits`;$('target-text').textContent=stats.healthy>=24?'✓ steady':'View goal →';$('progress').style.width=Math.min(100,stats.progress/target*100,stats.population/target*100)+'%';$('grow').disabled=!stats.growth;$('grow').hidden=!stats.growth;$('grow').innerHTML=`Expand district <span>$${stats.growthCost} →</span>`;$('goal-title').textContent='Make room for more';$('mission-copy').textContent=`Reach ${target} residents and ${target} completed visits in this district. Keep long waits below a quarter of the population, with nobody disconnected, for 24 cycles.`;$('growth-note').textContent=`Expansion costs $${stats.growthCost}. The next population, visits and funding requirements double.`;$('permits').textContent=stats.permits+' home permits';$('travel-summary').textContent=`${stats.workVisits} work · ${stats.shopVisits} shopping · ${stats.leisureVisits} leisure visits. ${stats.walkTrips} walking / ${stats.carTrips} driving choices · ${stats.railBoardings||0} rail boardings. Rail operation: $${stats.railSpent||0}. Average completed trip: ${stats.average} cycles.`;\n $('save').disabled=sessionStatus!==1;$('save').textContent='Save now';$('saved').textContent=f.saved>=0?`Saved · cycle ${f.saved}`:'Not saved';$('connection').textContent=sessionStatus===1?(f.saved<stats.tick?'● Live · saving…':'● Saved'):sessionStatus===2?'Another tab is active':sessionStatus===0?'Resuming…':'Recovery needed';$('resume').hidden=sessionStatus===1||sessionStatus===0;$('session-note').textContent='Changes save automatically. Reopen in this browser to resume. Clearing browser data loses this city’s recovery key.';\n if(f.notice&&f.status!==0)toast(f.notice,sessionStatus===1?4000:15000);updateInterface(f);cityLab.receive(f);\n}\nfunction setTool(n){if(n>=0&&cityLab.active&&cityLab.phase!==1){toast('Choose Edit plan before changing this experiment.');return}cancelGesture();tool=n;hover=null;canvas.dataset.mode=n===-2?'move':'build';if(n===-2||n===0)showPalette('');if(n>=8&&n<=11){if(layer)setLayer(0);showPalette('rail')}if(n>=20){showPalette('roads')}if(n>=3&&n<=6&&layer)setLayer(0);if(n===22&&layer)setLayer(0);if(n!==10)serviceStart=null;if(n!==11)addStopLine=0;$('inspector').hidden=true;for(const b of document.querySelectorAll('[data-tool]')){const on=Number(b.dataset.tool)===n;b.classList.toggle('selected',on);b.setAttribute('aria-pressed',String(on))}const touch=matchMedia('(pointer: coarse)').matches;$('hint').textContent=n===-2?(touch?'Drag to explore · pinch to zoom':'Drag to explore · scroll to zoom'):n===0?`Remove ${layer?'underground':'ground'} only · release to review`:n===20?'Choose arrow direction · R rotates · walkers use both directions':n===22?'Tap above an existing tunnel to add a dry-land portal':n===8?'Drag track · diagonal drags make a bend':n===9?'Tap an empty track beside a road or path':n===10?'Tap the first station, then the last station':n===11?'Tap a station to add it to this suspended service':n>2&&n!==7?'Tap to place · two fingers move':layer?'Draw underground · connect to a portal':tunnelMode?'Draw a tunnel · dry entrances at both ends':'Drag bank to bank for a bridge · two fingers move';updateRoadOptions()}\nfunction updateRoadOptions(){\n $('road-options').hidden=palette!=='roads';$('tunnel-mode').disabled=layer===1||tool===22;$('tunnel-mode').setAttribute('aria-pressed',String(tunnelMode&&layer===0));$('tunnel-mode').textContent=layer?'Underground network':tunnelMode?'Tunnel + two entrances':'Surface construction';$('oneway-direction').disabled=tool!==20;\n for(const [n,normal,under]of [[1,'$8 land · $32 bridge','$48 / tile'],[2,'$24 land · $72 bridge','$72 / tile'],[7,'$4 land · $16 bridge','$24 / tile'],[20,'$12 land · $48 bridge','$60 / tile']])document.querySelector(`#roads-palette [data-tool=\"${n}\"] small`).textContent=layer||tunnelMode?under:normal;\n $('road-depth-note').textContent=tool===22?'$60 · dry land above an existing underground road or path.':layer?'Only the underground layer changes. Add a portal on the ground to connect it.':tunnelMode?'At least 3 tiles. Two dry-land entrances cost $60 each; all underground tiles are included in the preview.':'One-way cars need a return route; walkers go both ways. Tunnels leave the ground above their interior untouched.';\n}\nfunction setLayer(next){if(next===layer)return;if(review||removeRequest||mutationPending){toast('Finish or cancel the removal review before switching layers.');return}cancelGesture();layer=next;selected=null;$('inspector').hidden=true;staticMapKey='';repaint();trafficMotion.visible=false;trafficMotion.rendered=[];for(const b of document.querySelectorAll('[data-layer]'))b.setAttribute('aria-pressed',String(Number(b.dataset.layer)===layer));document.body.dataset.layer=String(layer);if(layer&&tool>=3&&tool<=11&&tool!==7||layer&&tool===22){tool=-2;setTool(-2)}updateRoadOptions();scheduleView()}\nfor(const b of document.querySelectorAll('[data-layer]'))b.onclick=()=>setLayer(Number(b.dataset.layer));\n$('tunnel-mode').onclick=()=>{cancelGesture();tunnelMode=!tunnelMode;updateRoadOptions();if(roadTool(tool))setTool(tool)};\n$('oneway-direction').onchange=()=>{cancelGesture();onewayDirection=Number($('oneway-direction').value)};\n$('rail-bend').onclick=()=>{railBend=1-railBend;$('rail-bend').textContent=railBend?'Bend: down, then across ↕':'Bend: across, then down ↔'};\nfor(const b of document.querySelectorAll('[data-tool]'))b.onclick=()=>setTool(Number(b.dataset.tool));\nfor(const b of document.querySelectorAll('button[data-palette]'))b.onclick=()=>{const next=palette===b.dataset.palette?'':b.dataset.palette;showPalette(next);if(next)setTool(next==='roads'?1:3);else setTool(-2)};\nfunction showPalette(name){palette=name;document.body.dataset.palette=name;$('palette').hidden=!name;$('roads-palette').hidden=name!=='roads';$('places-palette').hidden=name!=='places';$('rail-palette').hidden=name!=='rail';$('palette-title').textContent=name==='roads'?'ROADS & PATHS · DRAW A LINE':name==='rail'?'RAIL · TRACK, STATIONS & SERVICES':'EVERYDAY PLACES · TAP A TILE';for(const b of document.querySelectorAll('button[data-palette]'))b.setAttribute('aria-expanded',String(b.dataset.palette===name));updateRoadOptions();cameraChanged();}\n$('palette-close').onclick=()=>setTool(-2);\n$('play').onclick=()=>send('set-running',{kind:stats.paused?1:0});$('grow').onclick=()=>send('grow');$('save').onclick=()=>send('save');$('fit').onclick=fitCity;$('zoom-in').onclick=()=>{cancelGesture();anchorZoom(camera.scale*1.3,origin())};$('zoom-out').onclick=()=>{cancelGesture();anchorZoom(camera.scale/1.3,origin())};$('inspect-close').onclick=closeInspector;\nfunction closeInspector(){repaint();selected=null;$('inspector').hidden=true;if(cityLab.atlas.active)$('atlas-home-select').focus()}\n$('goal-open').onclick=()=>{cancelGesture();$('goal').showModal()};$('queue-stat').onclick=()=>{$('goal-open').click()};\n$('help-open').onclick=()=>{$('help').showModal()};for(const b of document.querySelectorAll('[data-close]'))b.onclick=()=>$(b.dataset.close).close();\nfunction showMenuPage(name){menuPage=name;for(const page of ['home','preferences','manage','examples','confirm'])$('menu-'+page).hidden=page!==name;}\nfunction openMenu(){if($('menu').open)return;cancelGesture();setTool(-2);menuWasRunning=!stats.paused&&!cityLab.active;showMenuPage('home');$('menu').showModal();$('continue').focus();if(!menuHistory){window.history.pushState({trafficCityMenu:true},'');menuHistory=true}}\nfunction clearReview(){if(connected&&sessionStatus===1)send('cancel-review');confirmKind='';review=null;removalBounds=null;removeRequest=0;}\nfunction closeMenu(fromHistory=false){if(!$('menu').open||mutationPending)return;clearReview();$('menu').close();if(menuWasRunning&&stats.paused&&sessionStatus===1)send('set-running',{kind:1});menuWasRunning=false;$('menu-open').focus();if(menuHistory){menuHistory=false;if(!fromHistory)window.history.back()}}\n$('menu-open').onclick=openMenu;$('menu-close').onclick=()=>closeMenu();$('continue').onclick=()=>closeMenu();\n$('examples-open').onclick=()=>{showMenuPage('examples');document.querySelector('[data-scenario]').focus()};for(const b of document.querySelectorAll('[data-scenario]'))b.onclick=()=>reviewScenario(Number(b.dataset.scenario));\n$('preferences-open').onclick=()=>{showMenuPage('preferences');$('grid-setting').focus()};$('manage-open').onclick=()=>{showMenuPage('manage');$('new-city').focus()};for(const b of document.querySelectorAll('[data-menu-back]'))b.onclick=()=>{showMenuPage('home');$('continue').focus()};\nfunction cancelCityReview(){const sample=confirmKind.startsWith('scenario-')?Number(confirmKind.slice(9)):0;clearReview();mutationPending=null;showMenuPage(sample?'examples':'manage');(sample?document.querySelector(`[data-scenario=\"${sample}\"]`):$('new-city')).focus()}\n$('city-cancel').onclick=cancelCityReview;$('confirm-back').onclick=cancelCityReview;\nfunction reviewCity(kind){if(sessionStatus!==1)return;confirmKind=kind;mutationPending=null;showMenuPage('confirm');$('confirm-title').textContent=kind==='reset'?'Start a new city?':'Restore your previous city?';$('confirm-copy').textContent=kind==='reset'?'Your current city becomes the recoverable backup. A new district begins in the middle of the map. Any older backup is replaced.':'Your previous city will replace this one. This uses the backup once; progress in your current city will be discarded.';$('city-confirm').textContent=kind==='reset'?'Start new city':'Restore city';$('city-cancel').textContent='Keep current city';$('confirm-status').textContent='Preparing your saved city…';$('city-confirm').disabled=true;$('city-cancel').focus();send('review-'+kind)}\nfunction reviewScenario(id){if(sessionStatus!==1)return;confirmKind='scenario-'+id;mutationPending=null;showMenuPage('confirm');$('confirm-title').textContent='Load '+['','Garden City','Crossing Challenge','Willow Metro','River Boroughs','Twinbank Region','Commuter Boroughs'][id]+'?';$('confirm-copy').textContent='This creates your own playable copy. Your current city becomes the recoverable backup, replacing any older backup.';$('city-confirm').textContent='Load city';$('city-cancel').textContent='Keep current city';$('confirm-status').textContent='Preparing your saved city…';$('city-confirm').disabled=true;$('city-cancel').focus();send('review-scenario',{kind:id})}\n$('new-city').onclick=()=>reviewCity('reset');$('restore-city').onclick=()=>reviewCity('restore');\n$('city-confirm').onclick=()=>{if(!lastFrame||!confirmKind||mutationPending)return;const id=send(confirmKind.startsWith('scenario-')?'load-scenario':confirmKind==='reset'?'reset-city':'restore-city',{x:lastFrame.confirmation,kind:confirmKind.startsWith('scenario-')?Number(confirmKind.slice(9)):0});if(id){mutationPending={id,type:confirmKind};$('city-confirm').disabled=true;$('city-cancel').disabled=true;$('confirm-back').disabled=true;$('confirm-status').textContent='Saving city change…'}};\n$('menu').addEventListener('cancel',e=>{e.preventDefault();if(mutationPending)return;if(menuPage==='confirm')cancelCityReview();else if(menuPage!=='home'){showMenuPage('home');$('continue').focus()}else closeMenu()});\nwindow.addEventListener('popstate',()=>{if(menuHistory){menuHistory=false;closeMenu(true)}});\n$('grid-setting').checked=preferences.grid;$('motion-setting').checked=preferences.motion;for(const [id,key]of [['grid-setting','grid'],['motion-setting','motion']])$(id).onchange=()=>{preferences[key]=$(id).checked;try{localStorage.setItem('traffic-city-preferences',JSON.stringify(preferences))}catch{toast('This preference cannot be saved on this device.')}};\nfunction cancelRemoval(){if(mutationPending)return;if(reviewCamera){Object.assign(camera,reviewCamera);reviewCamera=null;cameraChanged()}clearReview();if($('removal').open)$('removal').close();if(removeWasRunning&&stats.paused&&sessionStatus===1)send('set-running',{kind:1});removeWasRunning=false;canvas.focus()}\n$('remove-cancel').onclick=cancelRemoval;$('removal').addEventListener('cancel',e=>{e.preventDefault();cancelRemoval()});\n$('remove-confirm').onclick=()=>{if(!review?.valid||mutationPending)return;const id=send('apply-remove',{x:review.id});if(id){mutationPending={id,type:'remove'};$('remove-confirm').disabled=true;$('remove-cancel').disabled=true}};\nfunction abandonPending(){if(reviewCamera){Object.assign(camera,reviewCamera);reviewCamera=null;cameraChanged()}removeRequest=0;removalBounds=null;review=null;mutationPending=null;confirmKind='';if($('removal').open)$('removal').close();$('remove-confirm').disabled=false;$('remove-cancel').disabled=false;$('city-cancel').disabled=false;$('confirm-back').disabled=false;if(menuPage==='confirm'){$('city-confirm').disabled=true;$('confirm-status').textContent='Connection interrupted. Reconnect, then review this action again.'}}\nfunction focusRemoval(original){const selectedLines=(original.layer?[]:rails).filter(l=>railIntersects(l,original));const xs=[original.x,original.x2,...selectedLines.flatMap(l=>[l.a%128,l.b%128])],ys=[original.y,original.y2,...selectedLines.flatMap(l=>[gridY(l.a),gridY(l.b)])];const q={x:Math.min(...xs),x2:Math.max(...xs),y:Math.min(...ys),y2:Math.max(...ys)};reviewCamera={...camera};const sheet=$('removal').getBoundingClientRect(),area=mapArea();const mobile=width<=680;const target=mobile?{x:width/2,y:(area.top+sheet.top-18)/2}:{x:Math.min(width/2,(sheet.left-20)/2),y:(area.top+area.bottom)/2};const availableW=mobile?width-32:sheet.left-45,availableH=mobile?Math.max(80,sheet.top-area.top-30):area.height;const w=q.x2-q.x+2,h=q.y2-q.y+2;camera.scale=clamp(Math.min(camera.scale,availableW/(camera.angle?h:w),availableH/(camera.angle?w:h)),camera.min,camera.max);const anchor=screenToWorld(target);camera.x+=(q.x+q.x2+1)/2-anchor.x;camera.y+=(q.y+q.y2+1)/2-anchor.y;cameraChanged();}\nfunction updateInterface(f){lastFrame=f;if($('finance').open)updateFinances(stats);$('menu-district').textContent='WILLOW · DISTRICT '+String(stats.level).padStart(2,'0');$('menu-summary').textContent=`${stats.population} residents · ${stats.visits} everyday visits`;const savedText=f.saved>=0?`Saved at cycle ${f.saved}`:'Not saved yet';$('menu-saved').textContent=sessionStatus===1?savedText:sessionStatus===2?'Another tab is active. Resume here to continue.':'Connecting to your city…';$('restore-city').disabled=sessionStatus!==1||!f.undo;$('restore-caption').textContent=f.undo?'Return to your previous city →':'No previous city yet';$('new-city').disabled=sessionStatus!==1;$('cancelled-summary').textContent=`${stats.cancelled||0} journeys were cancelled by confirmed demolition. These are counted separately from completed visits.`;\n if(menuPage==='confirm'&&!mutationPending){const expected=confirmKind.startsWith('scenario-')?10+Number(confirmKind.slice(9)):confirmKind==='reset'?1:2;$('city-confirm').disabled=sessionStatus!==1||f.management!==expected||!f.confirmation;$('confirm-status').textContent=$('city-confirm').disabled?'This review is unavailable. Go back and try again.':'Your current city is saved. Nothing changes until you confirm.'}\n if(removeRequest&&f.ack>=removeRequest){const requested=removeRequest;removeRequest=0;if(f.quote?.valid&&f.quote.id===requested&&sessionStatus===1){review=f.quote;const q=review;removalBounds={start:{x:q.x,y:q.y},end:{x:q.x2,y:q.y2},kind:0};$('removal-size').textContent=`${q.layer?'Underground':'Ground'} · ${q.x2-q.x+1} × ${q.y2-q.y+1} selection · ${q.tiles} built ${q.tiles===1?'tile':'tiles'}`;$('removal-mode').textContent=stats.paused?'REVIEW AREA · CITY PAUSED':'REVIEW AREA · CITY STILL RUNNING';$('removal-estimate').textContent=stats.paused?'Counts for the current paused city.':'Movement continues. People and journey counts are a preview; confirmation recalculates who is affected.';$('removal-details').innerHTML=`<dt>Salvage refund</dt><dd>+$${q.refund}</dd>${q.rails?`<dt>Services cancelled</dt><dd>${q.rails}</dd>`:''}<dt>Residents moving out</dt><dd>${q.moveouts}</dd><dt>Residents returning home</dt><dd>${q.relocated}</dd><dt>Journeys cancelled</dt><dd>${q.cancelled}</dd><dt>Home permits returned</dt><dd>${q.homes}</dd>`;$('remove-confirm').disabled=false;$('remove-cancel').disabled=false;$('removal').showModal();focusRemoval(q);$('remove-cancel').focus()}else{removalBounds=null;removeWasRunning=false}}\n if(mutationPending&&f.ack>=mutationPending.id){const pending=mutationPending;mutationPending=null;$('city-cancel').disabled=false;$('confirm-back').disabled=false;$('remove-confirm').disabled=false;$('remove-cancel').disabled=false;if(pending.type==='remove'){reviewCamera=null;review=null;removalBounds=null;if($('removal').open)$('removal').close();if(removeWasRunning&&stats.paused&&sessionStatus===1)send('set-running',{kind:1});removeWasRunning=false;canvas.focus()}else{confirmKind='';menuWasRunning=false;showMenuPage('home');if(sessionStatus===1){fitCity();$('continue').focus()}}}\n}\n// A second pointer irrevocably cancels this stroke. Building requires a fresh gesture.\nfunction cancelGesture(){repaint();gesture=null;draft=null;hover=null;const ids=[...pointers.keys()];pointers.clear();canvas.dataset.gesture='';for(const id of ids){try{if(canvas.hasPointerCapture(id))canvas.releasePointerCapture(id)}catch{}}}\nfunction beginPinch(){const [a,b]=[...pointers.values()],mid={x:(a.x+b.x)/2,y:(a.y+b.y)/2};draft=null;hover=null;gesture={kind:'pinch',anchor:screenToWorld(mid),distance:Math.max(1,Math.hypot(a.x-b.x,a.y-b.y)),scale:camera.scale,blocked:true};canvas.dataset.gesture='pinch'}\ncanvas.addEventListener('pointerdown',e=>{if(tool===0&&(removeRequest||review||mutationPending)){toast('Finish or cancel the current removal review first.');return}if(e.pointerType==='mouse'&&![0,1,2].includes(e.button))return;e.preventDefault();canvas.focus({preventScroll:true});const p=position(e);pointers.set(e.pointerId,{...p,type:e.pointerType});canvas.setPointerCapture(e.pointerId);if(pointers.size>=2){beginPinch();return}const pan=tool===-2||e.button===1||e.button===2||e.shiftKey;gesture={kind:pan?'pan':'build',id:e.pointerId,start:p,camera:{x:camera.x,y:camera.y},moved:false,blocked:false,serial:++gestureSerial};canvas.dataset.gesture=gesture.kind;if(!pan){draft={start:tile(p),end:tile(p),kind:tool,cancelled:false};hover=draft.end}});\ncanvas.addEventListener('pointermove',e=>{const p=position(e);if(!pointers.has(e.pointerId)){if(e.pointerType==='mouse'&&inside(p)&&tool!==-2)hover=tile(p);return}e.preventDefault();pointers.set(e.pointerId,{...p,type:e.pointerType});if(!gesture)return;\n if(pointers.size>=2){if(gesture.kind!=='pinch')beginPinch();const[a,b]=[...pointers.values()],mid={x:(a.x+b.x)/2,y:(a.y+b.y)/2};anchorZoom(gesture.scale*Math.hypot(a.x-b.x,a.y-b.y)/gesture.distance,mid,gesture.anchor);return}\n if(gesture.id!==e.pointerId)return;const dx=p.x-gesture.start.x,dy=p.y-gesture.start.y;if(Math.hypot(dx,dy)>5)gesture.moved=true;\n if(gesture.kind==='pan'){const c=Math.cos(camera.angle),s=Math.sin(camera.angle);camera.x=gesture.camera.x-(c*dx+s*dy)/camera.scale;camera.y=gesture.camera.y-(-s*dx+c*dy)/camera.scale;cameraChanged()}\n else if(gesture.kind==='build'&&draft){if(!inside(p)){draft.cancelled=true;hover=null}else if(!draft.cancelled){draft.end=tool===0?tile(p):tool===8?tile(p):roadTool(tool)?straighten(draft.start,tile(p)):draft.start;hover=draft.end}}});\nfunction endPointer(e,cancelled=false){if(!pointers.has(e.pointerId))return;const p=position(e),old=gesture,stroke=draft?{...draft,start:{...draft.start},end:{...draft.end}}:null;if(cancelled){cancelGesture();return}pointers.delete(e.pointerId); // The browser releases capture after pointerup; consume the stroke first.\n if(pointers.size>=2){beginPinch();return}if(pointers.size===1){const[id,a]=[...pointers.entries()][0];draft=null;gesture={kind:'pan',id,start:{x:a.x,y:a.y},camera:{x:camera.x,y:camera.y},moved:true,blocked:true};canvas.dataset.gesture='pan';return}\n if(old?.kind==='build'&&stroke&&!stroke.cancelled&&!old.blocked&&inside(p)){const start=stroke.start,end=tool===0?tile(p):tool===8?tile(p):roadTool(tool)?straighten(start,tile(p)):start;if(tool===0){removeWasRunning=!stats.paused;removalBounds={start,end,kind:0};removeRequest=send('review-remove',{x:start.x,y:start.y,x2:end.x,y2:end.y,kind:layer})}else if(tool===8)send('build-track',{x:start.x,y:start.y,x2:end.x,y2:end.y,kind:railBend});else if(tool===9)send('build-station',{x:start.x,y:start.y});else if(tool===10){if(cells.get(start.x+start.y*128)?.kind!==8)toast('Choose a station on your track.');else if(!serviceStart){serviceStart=start;$('hint').textContent=`Start: ${start.x}, ${start.y} · tap the last station · Esc cancels`;toast('Now tap the last station.')}else{const first={...serviceStart};send('create-service',{x:first.x,y:first.y,x2:start.x,y2:start.y});setTool(-2);inspect(first.x+first.y*128,true)}}else if(tool===11){send('rail-stop',{x:addStopLine,y:start.x+start.y*128});setTool(-2)}else if(tool===22)send('build-portal',{x:start.x,y:start.y});else send(roadTool(tool)?layer?'build-underground':tunnelMode?'build-tunnel':'build':'build',{x:start.x,y:start.y,x2:end.x,y2:end.y,kind:roadKind(stroke.kind,onewayDirection)})}else if(old?.kind==='pan'&&!old.moved&&!old.blocked&&inside(p)){const at=tile(p);inspect((layer===0?cityLab.pickAtlas(p,worldToScreen,camera.scale):null)??(at.x+at.y*128+layer*16384),true)}\n gesture=null;draft=null;hover=null;canvas.dataset.gesture='';scheduleView();}\ncanvas.addEventListener('pointerup',e=>endPointer(e));canvas.addEventListener('pointercancel',e=>endPointer(e,true));canvas.addEventListener('lostpointercapture',e=>{if(pointers.has(e.pointerId))cancelGesture()});canvas.addEventListener('pointerleave',()=>{hover=null;if(draft)draft.cancelled=true});canvas.addEventListener('contextmenu',e=>e.preventDefault());\ncanvas.addEventListener('wheel',e=>{e.preventDefault();cancelGesture();const delta=e.deltaY*(e.deltaMode===1?16:e.deltaMode===2?height:1);anchorZoom(camera.scale*Math.exp(-clamp(delta,-250,250)*.0025),position(e))},{passive:false});\nwindow.addEventListener('blur',cancelGesture);document.addEventListener('visibilitychange',()=>{if(document.hidden)cancelGesture();painter.setVisible(!document.hidden)});window.addEventListener('pagehide',()=>{cancelGesture();painter.setVisible(false)});window.addEventListener('pageshow',()=>painter.setVisible(!document.hidden));\nwindow.addEventListener('keydown',e=>{if(document.querySelector('dialog[open]'))return;if(e.key==='Escape'){if(lineManager.open){lineManager.close();return}cancelGesture();closeInspector();setTool(-2);return}if(['INPUT','TEXTAREA','SELECT'].includes(e.target.tagName))return;if(e.code==='Space'&&e.target.tagName!=='BUTTON'){e.preventDefault();cancelGesture();send('set-running',{kind:stats.paused?1:0})}else if(e.key==='+'||e.key==='='){$('zoom-in').click()}else if(e.key==='-'){$('zoom-out').click()}else if(e.key.toLowerCase()==='r'&&tool===20){onewayDirection=(onewayDirection+1)%4;$('oneway-direction').value=String(onewayDirection);cancelGesture()}else if(e.key.toLowerCase()==='u'){setLayer(1-layer)}else if(e.key.toLowerCase()==='f'){fitCity()}else if(e.key.startsWith('Arrow')){const v={ArrowLeft:[-75,0],ArrowRight:[75,0],ArrowUp:[0,-75],ArrowDown:[0,75]}[e.key];if(!v)return;e.preventDefault();cancelGesture();const c=Math.cos(camera.angle),s=Math.sin(camera.angle);camera.x+=(c*v[0]+s*v[1])/camera.scale;camera.y+=(-s*v[0]+c*v[1])/camera.scale;cameraChanged()}});\nfunction inspect(id,open){selected=id;if(layer===0&&cityLab.inspectAtlas(id,open))return;const c=cells.get(id),rail=layer===0?railAt(id):null,x=id%128,y=gridY(id);if(open){$('inspector').hidden=false;send('inspect',{x,y,x2:layer})}$('inspect-title').textContent=(c?names[c.kind]:'Open land')+` · ${x}, ${y}`;if(rail&&(!c||c.kind===8)){$('inspect-title').textContent=`Shuttle ${rail.id}${c?.kind===8?' · station '+((rail.stops||[rail.a,rail.b]).indexOf(id)+1):''}`;$('inspect-body').textContent='Walk to the station, wait for a seat, ride, then walk to the destination. Work pays wages; purchases and fares move money through the city.';$('inspect-details').innerHTML=railDetails(rail);return}if(c?.kind===8&&!rail){$('inspect-body').textContent='A station ready for service. Use Rail → Service to connect it to another station.';$('inspect-details').innerHTML='';return}if(!c){$('inspect-body').textContent='Homes add eight people; workplaces offer sixteen jobs. Put useful destinations near homes and connect them.';$('inspect-details').innerHTML='';return}let reason=c.kind===13||layer===1&&cells.get(id%16384)?.kind===13?'A shared all-way stop joins the two layers. Cars reserve the portal before entering.':c.kind>=9&&c.kind<=12?'Cars follow the arrow; walkers travel both ways. The road must be clear before changing its direction.':c.kind===7?'A walking-only shortcut. Cars must use roads.':c.kind===3?'Eight permanent residents live here. Their jobs and destinations determine where they travel.':c.kind===4?'Sixteen jobs. Residents keep their work assignment until you change the city.':c.kind===5?'Residents spend their savings here; part of each purchase becomes city tax. Nearby shops can replace long car trips with short walks.':c.kind===6?'A local place to relax, then return home.':c.junction?'Vehicles yield, obey signals and reserve space beyond this junction.':'Each approach lane stores three cars. Full receiving lanes push queues upstream.';$('inspect-body').textContent=reason;\n const controls=['Yield · flowing turns','Timed signal','Priority E–W','Priority N–S'];let html=`<dl><dt>Cars / people walking</dt><dd>${c.q} / ${c.walk||0}</dd><dt>At destination</dt><dd>${c.inside||0}</dd></dl>`;if(c.junction&&c.kind!==13&&cells.get(id%16384)?.kind!==13)html+=`<p class=\"small\">${controls[c.control||0]} · ${stats.phase===-1?'all red':stats.phase===0?'E–W green':'N–S green'}</p><div class=\"junction-controls\">${controls.map((n,i)=>`<button data-signal=\"${i}\" ${c.control===i?'disabled':''}>${n}</button>`).join('')}</div><p class=\"small\">Change control · $40</p>`;\n const r=inspectResident;if(r&&r.id>0&&(r.home===id||r.cell===id||r.dest===id)){const reasons=['Travelling','No connected route','Waiting behind another car','No space ahead','Yielding or red signal','Conflicting movement','Picking up car','Parking','Planning a shared route','Missing destination','Waiting for a train','Riding the shuttle'];const purposes=['At home','Work','Shopping','Leisure','Returning home'];html+=`<div class=\"resident-card\"><b>Resident ${r.id} · ${purposes[r.purpose]||'At home'}</b><p>${r.state===0?'Resting at home':r.state===3?'At their destination':reasons[r.reason]||'Travelling'} · ${r.mode===2?'driving':r.mode===1?'walking':r.mode===3?(r.state===6?'on rail':'walking + rail'):'choosing transport'}</p><dl><dt>Walk / drive estimate</dt><dd>${r.etaWalk<0?'—':r.etaWalk} / ${r.etaCar<0?'—':r.etaCar}</dd>${inspectRailPlan?.line?`<dt>Rail journey estimate</dt><dd>${inspectRailPlan.eta} cycles</dd>`:''}<dt>Household savings</dt><dd>$${inspectFunds}</dd><dt>Last journey</dt><dd>${r.lastTime} cycles</dd><dt>Waiting</dt><dd>${r.wait} cycles</dd></dl></div>`}if(rail)html+=`<div class=\"rail-card\">${railDetails(rail)}</div>`;$('inspect-details').innerHTML=html;\n}\n// Presentation of the native orthogonal track stroke; never mutates game state.\nfunction trackPreviewPath(a,b,bend=railBend){const corner=bend?{x:a.x,y:b.y}:{x:b.x,y:a.y},out=[{...a}];let p={...a};for(const end of[corner,b]){while((p.x!==end.x||p.y!==end.y)&&out.length<128){p={x:p.x+Math.sign(end.x-p.x),y:p.y+Math.sign(end.y-p.y)};out.push(p)}}return out}\n\nfunction railIntersects(l,q){return railPath(l).some(id=>id%128>=q.x&&id%128<=q.x2&&gridY(id)>=q.y&&gridY(id)<=q.y2)}\nfunction railAt(id){return rails.find(l=>railPath(l).includes(id))}\nfunction railDetails(l){const state=lineState(l,stats.paused);return `<p><b>${state.label}</b></p><p class=\"small\">${state.detail}</p><dl><dt>Line ${l.id} · on train</dt><dd>${l.occupancy} / ${l.capacity}</dd><dt>Stops / boardings</dt><dd>${(l.stops||[l.a,l.b]).length} / ${l.boardings}</dd><dt>Next leg / spent</dt><dd>$${l.expense} / $${l.spent}</dd></dl><button class=\"rail-service\" data-open-lines=\"${l.id}\">Manage line and stops</button><button class=\"rail-service\" data-rail-service=\"${l.id}\">${l.enabled?'Stop at next station':'Start departures'}</button><button class=\"rail-service\" data-rail-stop=\"${l.id}\" ${lineEditable(l)?'':'disabled'}>Add a stop</button>`}\n\nfunction drawRails(now){let bounds=review;if(!bounds&&tool===0&&draft&&!draft.cancelled)bounds={x:Math.min(draft.start.x,draft.end.x),y:Math.min(draft.start.y,draft.end.y),x2:Math.max(draft.start.x,draft.end.x),y2:Math.max(draft.start.y,draft.end.y)};\n const colors=railColors;ctx.lineCap='round';ctx.lineJoin='round';const assigned=railPaint.assigned;ctx.strokeStyle='#96978e';ctx.lineWidth=.12;ctx.beginPath();for(const id of tracks){if(assigned.has(id))continue;const x=id%128+.5,y=gridY(id)+.5;ctx.moveTo(x-.04,y);ctx.lineTo(x+.04,y);for(const d of[1,128])if(tracks.has(id+d)&&Math.abs((id+d)%128-id%128)<=1){ctx.moveTo(x,y);ctx.lineTo((id+d)%128+.5,Math.floor((id+d)/128)+.5)}}ctx.stroke();\n for(const l of rails){const points=railGeometry(l),color=colors[(l.id-1)%colors.length],highlight=bounds&&railIntersects(l,bounds);for(const [width,color2]of[[.33,'#33443624'],[highlight?.37:.25,highlight?'#c26543':'#e7e4d7'],[.10,color]]){ctx.strokeStyle=color2;ctx.lineWidth=width;ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));ctx.stroke()}}\n for(const {id,line:l,waiting,label} of railPaint.stations){const color=l?colors[(l.id-1)%colors.length]:'#8b9587',x=id%128+.5,y=gridY(id)+.5;pathRound(x-.44,y-.42,.88,.84,.13,'#eeeada');pathRound(x-.34,y-.25,.68,.5,.07,color);pathRound(x-.24,y-.15,.48,.30,.03,'#f1f1dc');drawEntrances({id,kind:8});if(camera.scale>=18){ctx.save();ctx.translate(x,y);ctx.rotate(-camera.angle);ctx.fillStyle=color;ctx.font='700 .21px system-ui';ctx.textAlign='center';ctx.textBaselin