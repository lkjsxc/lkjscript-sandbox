tion:column;justify-content:center;min-height:440px;padding-bottom:105px}.menu-story>.eyebrow{letter-spacing:2.8px}.menu-story h1{font-size:clamp(42px,4.8vw,65px);font-weight:450;letter-spacing:-2.8px;line-height:1.07;margin:24px 0}.menu-story>p{font-size:15px;line-height:1.8;color:#7b8e76}.menu-content{position:relative;border-left:1px solid #b6c9ae88;padding-left:42px}.menu-content h2{font-size:31px;font-weight:450;letter-spacing:-1px;margin:14px 0 20px}.menu-summary{font-size:13px;margin-bottom:28px;color:var(--muted)}.save-caption{font-size:10px!important;text-align:center;margin:10px 0 22px;color:var(--muted)}.menu-links{border-top:1px solid #c7d5bf}.menu-links>button{display:flex;justify-content:space-between;align-items:center;width:100%;min-height:51px;padding:12px 1px;background:transparent;font-size:13px;text-align:left;border-bottom:1px solid #c7d5bf}.menu-links>button>span{color:#8b9d80}.session-options{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-top:25px}.session-options button{min-height:38px;padding:8px 12px;border:1px solid #c3d2ba;border-radius:10px;background:#f1f5e6;font-size:11px}.session-options span{font-size:10px;color:var(--muted)}.menu-content .small{margin-top:18px;font-size:10px!important}.back-link{display:block;margin:0 0 30px;padding:6px 0;min-height:40px;background:transparent;color:var(--muted);font-size:12px}.menu-footer{text-align:center;letter-spacing:.5px;font-size:10px;color:#819476;padding:16px 30px calc(22px + var(--safe-bottom))}.preference{display:flex;gap:20px;align-items:center;justify-content:space-between;padding:20px 0;border-bottom:1px solid #c7d5bf}.preference b{font-size:13px;font-weight:600;display:block}.preference small{font-size:11px;display:block;color:var(--muted);margin-top:5px}.preference input{accent-color:var(--green);width:22px;height:22px}.management-choice{display:flex;flex-direction:column;text-align:left;width:100%;gap:6px;padding:16px;border:1px solid #c1d0b8;background:#f2f6e8;border