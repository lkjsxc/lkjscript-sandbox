a.scale*.7-16,w,19,9,'#ce6b48');drawLabel(label,{x:p.x,y:p.y-camera.scale*.7-3},'#fff7e8',10)}\n if(layer===0)cityLab.drawAtlas(ctx,worldToScreen,camera.scale,width,height);\n if(preview){const a=preview.start,b=preview.end,n=preview.kind===0?(Math.abs(b.x-a.x)+1)*(Math.abs(b.y-a.y)+1):Math.abs(b.x-a.x)+Math.abs(b.y-a.y)+1;const p=worldToScreen((a.x+b.x)/2+.5,(a.y+b.y)/2+.5);const surface=roadTool(preview.kind),end=surface?straighten(a,b):b,kind=roadKind(preview.kind,onewayDirection),under=surface&&(layer===1||tunnelMode),quote=surface?(under?undergroundQuote(cells,a,end,kind,layer===0):surfaceQuote(a,end,kind)):null;const text=preview.kind===0?`${Math.abs(b.x-a.x)+1} × ${Math.abs(b.y-a.y)+1} · ${review?'reviewing':removeRequest?'preparing review':'release to review'}`:preview.kind===8?`${n} track tiles · up to $${n*12} + bridges`:quote?`${quote.tiles} tiles · $${quote.cost}${under?' · underground':quote.water?' · bridge':''}${quote.invalid?under?' · at least 3 tiles':' · reach both banks':' · release to build'}`:`${n} ${n===1?'tile':'tiles'} · release to build`;ctx.font='600 10px system-ui';const w=ctx.measureText(text).width+20;pathRound(clamp(p.x-w/2,8,width-w-8),clamp(p.y-46,145,height-220),w,25,12,'#23483df0');drawLabel(text,{x:clamp(p.x,w/2+8,width-w/2-8),y:clamp(p.y-46,145,height-220)+16},'#fffcec',10)}\n frameArea=null;frameTimes.push(performance.now()-start);if(frameTimes.length>180)frameTimes.shift()}\n// Read-only instrumentation binds browser input assertions to actual camera and server frames.\nwindow.__flowgarden={get renderMetrics(){return{draws:drawCount,pendingFrame:!!painter?.pending,paintRequests:painter?.requests||0,visible:painter?.visible??true,indexRebuilds:tileIndex.revision,queries:tileIndex.queryCount,visitedCells:tileIndex.visits}},get pendingCommands(){return commandQueue.items},get layer(){return layer},get tunnelMode(){return tunnelMode},get onewayDirection(){return onewayDirection},get river(){return river.map(p=>({...p}))},get riverWi