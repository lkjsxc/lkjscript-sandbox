declarations.begin
(units
 (use std builtin)
 (type-alias MesoCohort (record (id I64) (population I64) (home I64) (queuedOut I64) (outbound I64) (work I64) (queuedBack I64) (inbound I64) (road I64) (rail I64) (travel I64) (requested I64) (arrived I64) (visits I64) (roadTrips I64) (railTrips I64) (waitTicks I64) (travelTicks I64)))
 (type-alias MesoCity (record (cohorts (list MesoCohort)) (tick I64) (population I64)))
 (type-alias MesoTotals (record (tick I64) (groups I64) (population I64) (home I64) (queued I64) (outbound I64) (work I64) (inbound I64) (requested I64) (arrived I64) (outstanding I64) (visits I64) (roadTrips I64) (railTrips I64) (waitTicks I64) (travelTicks I64) (massError I64) (journeyError I64)))
 (type-alias MesoInput (record (population I64) (groups I64) (ticks I64) (capacity I64) (rail I64) (closedFrom I64) (closedUntil I64)))
 (type-alias MesoResult (record (state MesoCity) (initial MesoTotals) (final MesoTotals)))
 (module create mesocohort
  (function create mass (visibility public) (effect pure) (parameter create c (type MesoCohort)) (returns I64)
   (body (call std::add (call std::add (call std::add (call std::add (call std::add (call std::add (i64 0) (field (local c) (name home))) (field (local c) (name queuedOut))) (field (local c) (name outbound))) (field (local c) (name work))) (field (local c) (name queuedBack))) (field (local c) (name inbound)))))
  (function create outstanding (visibility public) (effect pure) (parameter create c (type MesoCohort)) (returns I64)
   (body (call std::add (call std::add (call std::add (call std::add (i64 0) (field (local c) (name queuedOut))) (field (local c) (name outbound))) (field (local c) (name queuedBack))) (field (local c) (name inbound)))))
  (function create seed (visibility public) (effect pure) (parameter create id (type I64)) (parameter create population (type I64)) (parameter create groups (type I64)) (parameter create road (type I64)) (parameter create rail (type I64)) (returns MesoCohort)
   (body (let (binding people (call std::add (call std::divide (local population) (local groups)) (if (call std::less (local id) (call mesomath::mod (local population) (local groups))) (i64 1) (i64 0)))) (in (record structural (field id (local id)) (field population (local people)) (field home (local people)) (field queuedOut (i64 0)) (field outbound (i64 0)) (field work (i64 0)) (field queuedBack (i64 0)) (field inbound (i64 0)) (field road (local road)) (field rail (if (call std::i64-equal (call mesomath::mod (local id) (i64 4)) (i64 0)) (local rail) (i64 0))) (field travel (call std::add (i64 8) (call mesomath::mod (call std::multiply (local id) (i64 7)) (i64 25)))) (field requested (i64 0)) (field arrived (i64 0)) (field visits (i64 0)) (field roadTrips (i64 0)) (field railTrips (i64 0)) (field waitTicks (i64 0)) (field travelTicks (i64 0)))))))
  (function create step (visibility public) (effect pure) (parameter create c (type MesoCohort)) (parameter create tick (type I64)) (parameter create closed (type Bool)) (returns MesoCohort)
   (body (let (binding homeLeave (call mesomath::release (field (local c) (name home)) (i64 72))) (binding workLeave (call mesomath::release (field (local c) (name work)) (i64 40))) (binding outArrive (call mesomath::release (field (local c) (name outbound)) (field (local c) (name travel)))) (binding backArrive (call mesomath::release (field (local c) (name inbound)) (field (local c) (name travel)))) (binding outQueue (call std::add (field (local c) (name queuedOut)) (local homeLeave))) (binding backQueue (call std::add (field (local c) (name queuedBack)) (local workLeave))) (binding nominal (call std::add (field (local c) (name road)) (field (local c) (name rail)))) (binding storage (call std::multiply (call std::multiply (local nominal) (field (local c) (name travel))) (i64 2))) (binding occupied (call std::subtract (call std::add (field (local c) (name outbound)) (field (local c) (name inbound))) (call std::add (local outArrive) (local backArrive)))) (binding capacity (if (local closed) (i64 0) (call mesomath::min (local nominal) (call mesomath::max (i64 0) (call std::subtract (local storage) (local occupied)))))) (binding outCap (call mesomath::max (call std::divide (call std::add (local capacity) (call mesomath::mod (local tick) (i64 2))) (i64 2)) (call std::subtract (local capacity) (local backQueue)))) (binding outLeave (call mesomath::min (local outQueue) (local outCap))) (binding backLeave (call mesomath::min (local backQueue) (call std::subtract (local capacity) (local outLeave)))) (binding departures (call std::add (local outLeave) (local backLeave))) (binding railDepartures (if (call std::i64-equal (local nominal) (i64 0)) (i64 0) (call std::divide (call std::multiply (local departures) (field (local c) (name rail))) (local nominal)))) (in (record structural (field id (field (local c) (name id))) (field population (field (local c) (name population))) (field home (call std::add (call std::subtract (field (local c) (name home)) (local homeLeave)) (local backArrive))) (field queuedOut (call std::subtract (local outQueue) (local outLeave))) (field outbound (call std::subtract (call std::add (field (local c) (name outbound)) (local outLeave)) (local outArrive))) (field work (call std::add (call std::subtract (field (local c) (name work)) (local workLeave)) (local outArrive))) (field queuedBack (call std::subtract (local backQueue) (local backLeave))) (field inbound (call std::subtract (call std::add (field (local c) (name inbound)) (local backLeave)) (local backArrive))) (field road (field (local c) (name road))) (field rail (field (local c) (name rail))) (field travel (field (local c) (name travel))) (field requested (call std::add (call std::add (call std::add (i64 0) (field (local c) (name requested))) (local homeLeave)) (local workLeave))) (field arrived (call std::add (call std::add (call std::add (i64 0) (field (local c) (name arrived))) (local outArrive)) (local backArrive))) (field visits (call std::add (field (local c) (name visits)) (local outArrive))) (field roadTrips (call std::add (field (local c) (name roadTrips)) (call std::subtract (local departures) (local railDepartures)))) (field railTrips (call std::add (field (local c) (name railTrips)) (local railDepartures))) (field waitTicks (call std::add (call std::add (call std::add (i64 0) (field (local c) (name waitTicks))) (local outQueue)) (local backQueue))) (field travelTicks (call std::add (call std::add (call std::add (i64 0) (field (local c) (name travelTicks))) (field (local c) (name outbound))) (field (local c) (name inbound)))))))))
)
)
declarations.end
