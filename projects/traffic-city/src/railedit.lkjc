declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy) (landscape I64)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (layer I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias Move (record (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (module create railedit
  (function create intersects-path (visibility public) (effect pure) (parameter create path (type (list I64))) (parameter create q (type EditQuote)) (parameter create i (type I64)) (returns Bool)
   (body (if (call std::less (local i) (call std::list-length (types I64) (local path))) (let (binding id (call std::list-get (types I64) (local path) (local i))) (in (call std::bool-or (call std::bool-and (call std::less-equal (field (local q) (name x)) (call game::x (local id))) (call std::bool-and (call std::less-equal (call game::x (local id)) (field (local q) (name x2))) (call std::bool-and (call std::less-equal (field (local q) (name y)) (call game::y (local id))) (call std::less-equal (call game::y (local id)) (field (local q) (name y2)))))) (call intersects-path (local path) (local q) (call std::add (local i) (i64 1)))))) (bool false))))
  (function create intersects (visibility public) (effect pure) (parameter create l (type RailLine)) (parameter create q (type EditQuote)) (returns Bool)
   (body (call intersects-path (call railpath::path (local l)) (local q) (i64 0))))
  (function create selection (visibility public) (effect pure) (parameter create t (type Transit)) (parameter create q (type EditQuote)) (parameter create index (type I64)) (parameter create out (type Removal)) (returns Removal)
   (body (if (call std::less (local index) (call std::list-length (types I64) (field (local t) (name ids)))) (let (binding l (call rail::line (local t) (call std::list-get (types I64) (field (local t) (name ids)) (local index)))) (in (call selection (local t) (local q) (call std::add (local index) (i64 1)) (if (call intersects (local l) (local q)) (record structural (field tiles (field (local out) (name tiles))) (field signals (field (local out) (name signals))) (field selected (field (local out) (name selected))) (field count (field (local out) (name count))) (field homes (field (local out) (name homes))) (field refund (call std::add (field (local out) (name refund)) (if (call std::i64-equal (field (local l) (name cost)) (i64 120)) (i64 60) (i64 0)))) (field rails (call std::add (field (local out) (name rails)) (i64 1))) (field railIds (call game::put (field (local out) (name railIds)) (field (local l) (name id)) (i64 1))) (field tracks (field (local out) (name tracks)))) (local out))))) (local out))))
  (function create clean-queue (visibility public) (effect pure) (parameter create t (type Transit)) (parameter create agents (type Residents)) (parameter create l (type RailLine)) (parameter create items (type (list I64))) (parameter create state (type I64)) (parameter create station (type I64)) (parameter create index (type I64)) (parameter create out (type (list I64))) (returns (list I64))
   (body (if (call std::less (local index) (call std::list-length (types I64) (local items))) (let (binding id (call std::list-get (types I64) (local items) (local index))) (binding r (call game::agent (local agents) (local id))) (binding p (call rail::plan (local t) (local id))) (in (call clean-queue (local t) (local agents) (local l) (local items) (local state) (local station) (call std::add (local index) (i64 1)) (if (call std::bool-and (call std::i64-equal (field (local r) (name state)) (local state)) (call std::bool-and (call std::i64-equal (field (local p) (name line)) (field (local l) (name id))) (call std::bool-or (call std::i64-equal (local state) (i64 6)) (call std::i64-equal (field (local p) (name board)) (local station))))) (call std::list-append (types I64) (local out) (local id)) (local out))))) (local out))))
  (function create clean-platforms (visibility public) (effect pure) (parameter create t (type Transit)) (parameter create agents (type Residents)) (parameter create l (type RailLine)) (parameter create stops (type (list I64))) (parameter create i (type I64)) (returns RailLine)
   (body (if (call std::less (local i) (call std::list-length (types I64) (local stops))) (let (binding station (call std::list-get (types I64) (local stops) (local i))) (binding a (if (call std::i64-equal (local station) (field (local l) (name b))) (local l) (call railpath::set-platform (local l) (local station) (i64 1) (call clean-queue (local t) (local agents) (local l) (call railpath::platform (local l) (local station) (i64 1)) (i64 5) (local station) (i64 0) (list I64))))) (binding b (if (call std::i64-equal (local station) (field (local l) (name a))) (local a) (call railpath::set-platform (local a) (local station) (i64 -1) (call clean-queue (local t) (local agents) (local a) (call railpath::platform (local a) (local station) (i64 -1)) (i64 5) (local station) (i64 0) (list I64))))) (in (call clean-platforms (local t) (local agents) (local b) (local stops) (call std::add (local i) (i64 1))))) (local l))))
  (function create keep-lines (visibility public) (effect pure) (parameter create t (type Transit)) (parameter create removed (type Numbers)) (parameter create agents (type Residents)) (parameter create index (type I64)) (parameter create out (type Transit)) (returns Transit)
   (body (if (call std::less (local index) (call std::list-length (types I64) (field (local t) (name ids)))) (let (binding l (call rail::line (local t) (call std::list-get (types I64) (field (local t) (name ids)) (local index)))) (binding cleaned (record structural (field id (field (local l) (name id))) (field a (field (local l) (name a))) (field b (field (local l) (name b))) (field from (field (local l) (name from))) (field to (field (local l) (name to))) (field elapsed (field (local l) (name elapsed))) (field duration (field (local l) (name duration))) (field dwell (field (local l) (name dwell))) (field status (field (local l) (name status))) (field cost (field (local l) (name cost))) (field capacity (field (local l) (name capacity))) (field rideTicks (field (local l) (name rideTicks))) (field departures (field (local l) (name departures))) (field boardings (field (local l) (name boardings))) (field spent (field (local l) (name spent))) (field enabled (field (local l) (name enabled))) (field queueA (call clean-queue (local t) (local agents) (local l) (field (local l) (name queueA)) (i64 5) (field (local l) (name a)) (i64 0) (list I64))) (field queueB (call clean-queue (local t) (local agents) (local l) (field (local l) (name queueB)) (i64 5) (field (local l) (name b)) (i64 0) (list I64))) (field passengers (call clean-queue (local t) (local agents) (local l) (field (local l) (name passengers)) (i64 6) (i64 0) (i64 0) (list I64))) (field path (field (local l) (name path))) (field stops (field (local l) (name stops))) (field queues (field (local l) (name queues))) (field direction (field (local l) (name direction))))) (in (call keep-lines (local t) (local removed) (local agents) (call std::add (local index) (i64 1)) (if (call std::i64-equal (call game::get (local removed) (field (local l) (name id))) (i64 0)) (record structural (field lines (field (record structural (field lines (call std::map-insert (types I64 RailLine) (field (local out) (name lines)) (field (call