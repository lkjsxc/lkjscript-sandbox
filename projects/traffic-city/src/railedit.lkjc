ns))) (field choices (field (local out) (name choices))) (field boardings (field (local out) (name boardings))) (field completed (field (local out) (name completed))) (field spent (field (local out) (name spent))) (field tracks (field (local out) (name tracks)))) (name plans))) (field choices (field (record structural (field lines (call std::map-insert (types I64 RailLine) (field (local out) (name lines)) (field (call clean-platforms (local t) (local agents) (local cleaned) (call railpath::stops (local l)) (i64 0)) (name id)) (call clean-platforms (local t) (local agents) (local cleaned) (call railpath::stops (local l)) (i64 0)))) (field ids (field (local out) (name ids))) (field nextId (field (local out) (name nextId))) (field plans (field (local out) (name plans))) (field choices (field (local out) (name choices))) (field boardings (field (local out) (name boardings))) (field completed (field (local out) (name completed))) (field spent (field (local out) (name spent))) (field tracks (field (local out) (name tracks)))) (name choices))) (field boardings (field (record structural (field lines (call std::map-insert (types I64 RailLine) (field (local out) (name lines)) (field (call clean-platforms (local t) (local agents) (local cleaned) (call railpath::stops (local l)) (i64 0)) (name id)) (call clean-platforms (local t) (local agents) (local cleaned) (call railpath::stops (local l)) (i64 0)))) (field ids (field (local out) (name ids))) (field nextId (field (local out) (name nextId))) (field plans (field (local out) (name plans))) (field choices (field (local out) (name choices))) (field boardings (field (local out) (name boardings))) (field completed (field (local out) (name completed))) (field spent (field (local out) (name spent))) (field tracks (field (local out) (name tracks)))) (name boardings))) (field completed (field (record structural (field lines (call std::map-insert (types I64 RailLine) (field (local out) (name lines)) (field (call clean-platforms (local t) (local agents) (local cleaned) (call railpath::stops (local l)) (i64 0)) (name id)) (call clean-platforms (local t) (local agents) (local cleaned) (call railpath::stops (local l)) (i64 0)))) (field ids (field (local out) (name ids))) (field nextId (field (local out) (name nextId))) (field plans (field (local out) (name plans))) (field choices (field (local out) (name choices))) (field boardings (field (local out) (name boardings))) (field completed (field (local out) (name completed))) (field spent (field (local out) (name spent))) (field tracks (field (local out) (name tracks)))) (name completed))) (field spent (field (record structural (field lines (call std::map-insert (types I64 RailLine) (field (local out) (name lines)) (field (call clean-platforms (local t) (local agents) (local cleaned) (call railpath::stops (local l)) (i64 0)) (name id)) (call clean-platforms (local t) (local agents) (local cleaned) (call railpath::stops (local l)) (i64 0)))) (field ids (field (local out) (name ids))) (field nextId (field (local out) (name nextId))) (field plans (field (local out) (name plans))) (field choices (field (local out) (name choices))) (field boardings (field (local out) (name boardings))) (field completed (field (local out) (name completed))) (field spent (field (local out) (name spent))) (field tracks (field (local out) (name tracks)))) (name spent))) (field tracks (field (record structural (field lines (call std::map-insert (types I64 RailLine) (field (local out) (name lines)) (field (call clean-platforms (local t) (local agents) (local cleaned) (call railpath::stops (local l)) (i64 0)) (name id)) (call clean-platforms (local t) (local agents) (local cleaned) (call railpath::stops (local l)) (i64 0)))) (field ids (field (local out) (name ids))) (field nextId (field (local out) (name nextId))) (field plans (field (local out) (name plans))) (field choices (field (local out) (name choices))) (field boardings (field (local out) (name boardings))) (field completed (field (local out) (name completed))) (field spent (field (local out) (name spent))) (field tracks (field (local out) (name tracks)))) (name tracks)))) (local out))))) (local out))))
  (function create keep-plans (visibility public) (effect pure) (parameter create t (type Transit)) (parameter create agents (type Residents)) (parameter create ids (type (list I64))) (parameter create index (type I64)) (parameter create out (type Transit)) (returns Transit)
   (body (if (call std::less (local index) (call std::list-length (types I64) (local ids))) (let (binding id (call std::list-get (types I64) (local ids) (local index))) (binding r (call game::agent (local agents) (local id))) (binding p (call rail::plan (local t) (local id))) (binding l (call rail::line (local out) (field (local p) (name line)))) (binding active (call std::bool-or (call std::i64-equal (field (local r) (name state)) (i64 1)) (call std::bool-or (call std::i64-equal (field (local r) (name state)) (i64 2)) (call std::bool-or (call std::i64-equal (field (local r) (name state)) (i64 5)) (call std::i64-equal (field (local r) (name state)) (i64 6)))))) (in (call keep-plans (local t) (local agents) (local ids) (call std::add (local index) (i64 1)) (record structural (field lines (field (local out) (name lines))) (field ids (field (local out) (name ids))) (field nextId (field (local out) (name nextId))) (field plans (if (call std::bool-and (local active) (call std::less (i64 0) (field (local l) (name id)))) (call std::map-insert (types I64 RailPlan) (field (local out) (name plans)) (local id) (local p)) (field (local out) (name plans)))) (field choices (if (call std::less (i64 0) (call game::get (field (local t) (name choices)) (local id))) (call game::put (field (local out) (name choices)) (local id) (call game::get (field (local t) (name choices)) (local id))) (field (local out) (name choices)))) (field boardings (field (local out) (name boardings))) (field completed (field (local out) (name completed))) (field spent (field (local out) (name spent))) (field tracks (field (local out) (name tracks))))))) (local out))))
  (function create remove-transit (visibility public) (effect pure) (parameter create t (type Transit)) (parameter create removed (type Numbers)) (parameter create agents (type Residents)) (parameter create ids (type (list I64))) (returns Transit)
   (body (call keep-plans (local t) (local agents) (local ids) (i64 0) (call keep-lines (local t) (local removed) (local agents) (i64 0) (record structural (field lines (map I64 RailLine)) (field ids (list I64)) (field nextId (field (local t) (name nextId))) (field plans (map I64 RailPlan)) (field choices (map I64 I64)) (field boardings (field (local t) (name boardings))) (field completed (field (local t) (name completed))) (field spent (field (local t) (name spent))) (field tracks (field (local t) (name tracks))))))))
)
)
declarations.end
