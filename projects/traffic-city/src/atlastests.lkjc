  (test create atlas-maximum-roster-union (visibility private) (actual (call std::list-length (types AtlasHome) (field (call atlasfixtures::max-union) (name homes)))) (expected (i64 512)))
  (test create atlas-wire-row-width (visibility private) (actual (call std::list-length (types I64) (call std::list-get (types AtlasWireHome) (field (call atlasreport::wire (call atlasfixtures::report) (bool true)) (name homes)) (i64 0)))) (expected (i64 13)))
  (test create atlas-wire-metadata-without-repeat (visibility private) (actual (field (call atlasreport::wire (call atlasfixtures::report) (bool false)) (name homes))) (expected (list AtlasWireHome)))
  (test create atlas-repeat-retains-counts (visibility private) (actual (field (call atlasreport::wire (call atlasfixtures::report) (bool false)) (name same))) (expected (i64 3)))
  (test create atlas-unfinished-counts-repeated-observations (visibility private) (actual (call std::map-get-or (types I64 AtlasSample) (call atlassample::sample (record structural (field agents (call std::map-insert (types I64 Resident) (map I64 Resident) (i64 1) (record structural (field id (i64 1)) (field home (i64 0)) (field job (i64 0)) (field dest (i64 0)) (field purpose (i64 0)) (field cycle (i64 0)) (field state (i64 1)) (field cell (i64 0)) (field from (i64 0)) (field to (i64 0)) (field step (i64 0)) (field route (i64 0)) (field mode (i64 0)) (field prior (i64 0)) (field dir (i64 0)) (field lane (i64 0)) (field slot (i64 0)) (field elapsed (i64 0)) (field duration (i64 0)) (field wait (i64 9)) (field ready (i64 0)) (field departed (i64 0)) (field etaWalk (i64 0)) (field etaCar (i64 0)) (field eta (i64 0)) (field journeys (i64 0)) (field lastTime (i64 0)) (field reason (i64 1)) (field exitKey (i64 0)) (field zone (i64 0)) (field mask (i64 0))))) (field ids (list I64 (i64 1))) (field routes (map I64 Route)) (field lookup (map I64 I64)) (field nextRoute (i64 0)) (field nextId (i64 0)) (field q (map I64 I64)) (field walkq (map I64 I64)) (field flow (map I64 I64)) (field inside (map I64 I64)) (field employment (map I64 I64)) (field transit (record structural (field lines (map I64 RailLine)) (field ids (list I64)) (field nextId (i64 0)) (field plans (map I64 RailPlan)) (field choices (map I64 I64)) (field boardings (i64 0)) (field completed (i64 0)) (field spent (i64 0)) (field tracks (map I64 I64)))) (field tick (i64 0)) (field requested (i64 0)) (field arrived (i64 0)) (field visits (i64 0)) (field workVisits (i64 0)) (field shopVisits (i64 0)) (field leisureVisits (i64 0)) (field walkTrips (i64 0)) (field carTrips (i64 0)) (field waitTicks (i64 0)) (field travelTicks (i64 0)) (field totalDuration (i64 0)) (field population (i64 0)) (field waiting (i64 0)) (field disconnected (i64 0)) (field moving (i64 0)) (field healthy (i64 0)) (field born (i64 0)) (field re