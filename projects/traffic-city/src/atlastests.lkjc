declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy) (landscape I64)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (layer I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias MovementStep (record (city City) (arrivals (list I64))))
 (type-alias Move (record (arrivals (list I64)) (estimates Numbers) (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (type-alias View (record (x I64) (y I64) (w I64) (h I64) (layer I64)))
 (type-alias Cell (record (id I64) (kind I64) (q I64) (walk I64) (flow I64) (inside I64) (junction I64) (control I64)))
 (type-alias Seen (map I64 Cell))
 (type-alias Picture (record (seen Seen) (changed (list Cell))))
 (type-alias RailView (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (occupancy I64) (waitingA I64) (waitingB I64) (expense I64) (enabled Bool) (path (list I64)) (stops (list I64)) (direction I64) (platforms (list RailPlatform))))
 (type-alias Actor (record (id I64) (home I64) (dest I64) (purpose I64) (state I64) (from I64) (to I64) (dir I64) (prior I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (mode I64) (wait I64) (reason I64) (ready I64) (out I64) (rank I64)))
 (type-alias Saved (record (format I64) (owner Text) (serial I64) (city City)))
 (type-alias Claim (record (status I64) (saved Saved)))
 (type-alias State (record (city City) (view View) (seen Seen) (seq I64) (ack I64) (saved I64) (token Text) (owner Text) (status I64) (mapVersion I64) (selection I64) (quote EditQuote) (management I64) (confirmation I64) (undo Bool) (lab Lab)))
 (type-alias Stats (record (tick I64) (cash I64) (level I64) (permits I64) (requested I64) (arrived I64) (population I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (moving I64) (waiting I64) (disconnected I64) (walkTrips I64) (carTrips I64) (average I64) (growthTarget I64) (growthCost I64) (progress I64) (healthy I64) (version I64) (tiles I64) (phase I64) (routes I64) (originX I64) (originY I64) (cancelled I64) (railLines I64) (railBoardings I64) (railCompleted I64) (railSpent I64) (railWaiting I64) (paused Bool) (growth Bool) (ecoHouseholds I64) (ecoBusinesses I64) (ecoOpening I64) (ecoGrants I64) (ecoExports I64) (ecoSalvage I64) (ecoConstruction I64) (ecoOperating I64) (ecoWithdrawn I64) (ecoWages I64) (ecoSales I64) (ecoTaxes I64) (ecoFares I64) (ecoConcessions I64) (ecoUpkeepDue I64) (ecoPeriodTaxes I64) (ecoPeriodFares I64) (ecoPeriodOperating I64) (ecoLastTaxes I64) (ecoLastFares I64) (ecoLastOperating I64) (wealthError I64) (planning I64) (planningLong I64)))
 (type-alias Frame (record (view View) (persistent Bool) (seq I64) (ack I64) (reset Bool) (cells (list Cell)) (actors (list Actor)) (overview (list I64)) (mapChanged Bool) (heat (list I64)) (stats Stats) (notice Text) (saved I64) (status I64) (inspect Resident) (detail Bool) (actorLimit I64) (quote EditQuote) (management I64) (confirmation I64) (undo Bool) (rails (list RailView)) (inspectRail RailPlan) (inspectFunds I64) (tracks (list I64)) (river (list I64)) (riverWidth I64) (lab LabView) (streetWalkers I64) (streetDrivers I64)))
 (type-alias Input (record (id I64) (action Command) (token Text) (owner Text)))
 (type-alias Header (record (name Text) (value Bytes)))
 (type-alias HeaderValue (record (count I64) (value Text)))
 (type-alias Open (record (headers (list Header)) (path Text) (query Text)))
 (type-alias Message (record (body (stream Bytes)) (kind std::SessionMessageKind)))
 (type-alias PeerClose (record (code (option I64)) (reason Text)))
 (type-alias Decision (record (closing (option std::SessionClose)) (kind std::SessionDecisionKind) (messages (list std::SessionOutbound)) (rejection (option std::SessionReject)) (state (option State))))
 (type-alias PlanningCounts (record (total I64) (long I64)))
 (type-alias RailPlatform (record (station I64) (forward I64) (reverse I64)))
 (type-alias LabMeasure (record (visits I64) (arrived I64) (duration I64) (waitCycles I64) (disconnectedCycles I64) (outstanding I64) (cancelled I64) (population I64) (netFunds I64) (operating I64) (boardings I64) (wealthError I64)))
 (type-alias Lab (record (phase I64) (horizon I64) (step I64) (disconnect I64) (plan City) (trial City) (control LabMeasure) (changed LabMeasure) (quote EditQuote) (confirmation I64) (controlAtlas AtlasLedger) (changedAtlas AtlasLedger) (atlas AtlasView) (atlasSent Bool)))
 (type-alias LabChange (record (lab Lab) (notice Text)))
 (type-alias LabView (record (phase I64) (horizon I64) (step I64) (realTick I64) (planCost I64) (newResidents I64) (moveouts I64) (cancelled I64) (confirmation I64) (control LabMeasure) (changed LabMeasure) (atlas AtlasWire) (atlasChanged Bool)))
 (type-alias AtlasSample (record (time I64) (wait I64) (lost I64)))
 (type-alias AtlasLedger (map I64 AtlasSample))
 (type-alias AtlasHome (record (home I64) (before I64) (after I64) (same I64) (less I64) (more I64) (equal I64) (baseTime I64) (planTime I64) (baseWait I64) (planWait I64) (baseLost I64) (planLost I64)))
 (type-alias AtlasHomes (map I64 AtlasHome))
 (type-alias AtlasHomePair (record (key I64) (value AtlasHome)))
 (type-alias AtlasView (record (homes (list AtlasHome)) (same I64) (less I64) (more I64) (equal I64) (removed I64) (added I64) (baseTime I64) (planTime I64) (baseWait I64) (planWait I64) (baseLost I64) (planLost I64)))
 (type-alias AtlasWireHome (list I64))
 (type-alias AtlasWire (record (homes (list AtlasWireHome)) (same I64) (less I64) (more I64) (equal I64) (removed I64) (added I64) (baseTime I64) (planTime I64) (baseWait I64) (planWait I64) (baseLost I64) (planLost I64)))
 (type-alias StreetPool (record (walk (list I64)) (cars (list I64))))
 (type-alias StreetSample (record (actors (list Actor)) (walking I64) (driving I64)))
 (module create atlastests
  (test create atlas-empty-roster (visibility private) (actual (call atlasreport::report (record structural (field agents (map I64 Resident)) (field ids (list I64)) (field routes (map I64 Route)) (field lookup (map I64 I64)) (field nextRoute (i64 0)) (field nextId (i64 0)) (field q (map I64 I64)) (field walkq (map I64 I64)) (field flow (map I64 I64)) (field inside (map I64 I64)) (field employment (map I64 I64)) (field transit (record structural (field lines (map I64 RailLine)) (field ids (list I64)) (field nextId (i64 0)) (field plans (map I64 RailPlan)) (field choices (map I64 I64)) (field boardings (i64 0)) (field completed (i64 0)) (field spent (i64 0)) (field tracks (map I64 I64)))) (field tick (i64 0)) (field requested (i64 0)) (field arrived (i64 0)) (field visits (i64 0)) (field workVisits (i64 0)) (field shopVisits (i64 0)) (field leisureVisits (i64 0)) (field walkTrips (i64 0)) (field carTrips (i64 0)) (field waitTicks (i64 0)) (field travelTicks (i64 0)) (field totalDuration (i64 0)) (field population (i64 0)) (field waiting (i64 0)) (field disconnected (i64 0)) (field moving (i64 0)) (field healthy (i64 0)) (field born (i64 0)) (field removed (i64 0)) (field cancelled (i64 0))) (record structural (field agents (map I64 Resident)) (field ids (list I64)) (field routes (map I64 Route)) (field lookup (map I64 I64)) (field nextRoute (i64 0)) (field nextId (i64 0)) (field q (map I64 I64)) (field walkq (map I64 I64)) (field flow (map I64 I64)) (field inside (map I64 I64)) (field employment (map I64 I64)) (field transit (record structural (field lines (map I64 RailLine)) (field ids (list I64)) (field nextId (i64 0)) (field plans (map I64 RailPlan)) (field choices (map I64 I64)) (field boardings (i64 0)) (field completed (i64 0)) (field spent (i64 0)) (field tracks (map I64 I64)))) (field tick (i64 0)) (field requested (i64 0)) (field arrived (i64 0)) (field visits (i64 0)) (field workVisits (i64 0)) (field shopVisits (i64 0)) (field leisureVisits (i64 0)) (field 