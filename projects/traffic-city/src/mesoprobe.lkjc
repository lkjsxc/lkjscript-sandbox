declarations.begin
(units
 (use std builtin)
 (type-alias MesoCohort (record (id I64) (population I64) (home I64) (queuedOut I64) (outbound I64) (work I64) (queuedBack I64) (inbound I64) (road I64) (rail I64) (travel I64) (requested I64) (arrived I64) (visits I64) (roadTrips I64) (railTrips I64) (waitTicks I64) (travelTicks I64)))
 (type-alias MesoCity (record (cohorts (list MesoCohort)) (tick I64) (population I64)))
 (type-alias MesoTotals (record (tick I64) (groups I64) (population I64) (home I64) (queued I64) (outbound I64) (work I64) (inbound I64) (requested I64) (arrived I64) (outstanding I64) (visits I64) (roadTrips I64) (railTrips I64) (waitTicks I64) (travelTicks I64) (massError I64) (journeyError I64)))
 (type-alias MesoInput (record (population I64) (groups I64) (ticks I64) (capacity I64) (rail I64) (closedFrom I64) (closedUntil I64)))
 (type-alias MesoResult (record (state MesoCity) (initial MesoTotals) (final MesoTotals)))
 (module create mesoprobe
  (function create add (visibility public) (effect pure) (parameter create sum (type MesoTotals)) (parameter create c (type MesoCohort)) (returns MesoTotals)
   (body (record structural (field tick (field (local sum) (name tick))) (field groups (call std::add (field (local sum) (name groups)) (i64 1))) (field population (call std::add (field (local sum) (name population)) (field (local c) (name population)))) (field home (call std::add (field (local sum) (name home)) (field (local c) (name home)))) (field queued (call std::add (call std::add (call std::add (i64 0) (field (local sum) (name queued))) (field (local c) (name queuedOut))) (field (local c) (name queuedBack)))) (field outbound (call std::add (field (local sum) (name outbound)) (field (local c) (name outbound)))) (field work (call std::add (field (local sum) (name work)) (field (local c) (name work)))) (field inbound (call std::add (field (local sum) (name inbound)) (field (local c) (name inbound)))) (field requested (call std::add (field (local sum) (name requested)) (field (local c) (name requested)))) (field arrived (call std::add (field (local sum) (name arrived)) (field (local c) (name arrived)))) (field outstanding (call std::add (field (local sum) (name outstanding)) (call mesocohort::outstanding (local c)))) (field visits (call std::add (field (local sum) (name visits)) (field (local c) (name visits)))) (field roadTrips (call std::add (field (local sum) (name roadTrips)) (field (local c) (name roadTrips)))) (field railTrips (call std::add (field (local sum) (name railTrips)) (field (local c) (name railTrips)))) (field waitTicks (call std::add (field (local sum) (name waitTicks)) (field (local c) (name waitTicks)))) (field travelTicks (call std::add (field (local sum) (name travelTicks)) (field (local c) (name travelTicks)))) (field massError (call std::add (field (local sum) (name massError)) (call std::subtract (call mesocohort::mass (local c)) (field (local c) (name population))))) (field journeyError (call std::add (field (local sum) (name journeyError)) (call std::subtract (call std::subtract (field (local c) (name requested)) (field (local c) (name arrived))) (call mesocohort::outstanding (local c))))))))
  (function create loop (visibility public) (effect pure) (parameter create cohorts (type (list MesoCohort))) (parameter create id (type I64)) (parameter create sum (type MesoTotals)) (returns MesoTotals)
   (body (if (call std::less (local id) (call std::list-length (types MesoCohort) (local cohorts))) (call loop (local cohorts) (call std::add (local id) (i64 1)) (call add (local sum) (call std::list-get (types MesoCohort) (local cohorts) (local id)))) (local sum))))
  (function create totals (visibility public) (effect pure) (parameter create city (type MesoCity)) (returns MesoTotals)
   (body (call loop (field (local city) (name cohorts)) (i64 0) (record structural (field tick (field (local city) (name tick))) (field groups (i64 0)) (field population (i64 0)) (field home (i64 0)) (field queued (i64 0)) (field outbound (i64 0)) (field work (i64 0)) (field inbound (i64 0)) (field requested (i64 0)) (field arrived (i64 0)) (field outstanding (i64 0)) (field visits (i64 0)) (field roadTrips (i64 0)) (field railTrips (i64 0)) (field waitTicks (i64 0)) (field travelTicks (i64 0)) (field massError (i64 0)) (field journeyError (i64 0))))))
  (function create run (visibility public) (effect pure) (parameter create input (type MesoInput)) (returns MesoResult)
   (body (let (binding seed (call mesocity::seed (local input))) (binding city (call mesocity::advance (local seed) (call mesomath::min (i64 4096) (call mesomath::max (i64 0) (field (local input) (name ticks)))) (field (local input) (name closedFrom)) (field (local input) (name closedUntil)))) (in (record structural (field state (local city)) (field initial (call totals (local seed))) (field final (call totals (local city))))))))
  (test create massError-0-false (visibility private) (actual (field (field (call run (record structural (field population (i64 0)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 0)))) (name final)) (name massError))) (expected (i64 0)))
  (test create journeyError-0-false (visibility private) (actual (field (field (call run (record structural (field population (i64 0)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 0)))) (name final)) (name journeyError))) (expected (i64 0)))
  (test create population-0-false (visibility private) (actual (field (field (call run (record structural (field population (i64 0)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 0)))) (name final)) (name population))) (expected (i64 0)))
  (test create massError-0-true (visibility private) (actual (field (field (call run (record structural (field population (i64 0)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 12)))) (name final)) (name massError))) (expected (i64 0)))
  (test create journeyError-0-true (visibility private) (actual (field (field (call run (record structural (field population (i64 0)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 12)))) (name final)) (name journeyError))) (expected (i64 0)))
  (test create population-0-true (visibility private) (actual (field (field (call run (record structural (field population (i64 0)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 12)))) (name final)) (name population))) (expected (i64 0)))
  (test create massError-1-false (visibility private) (actual (field (field (call run (record structural (field population (i64 1)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 0)))) (name final)) (name massError))) (expected (i64 0)))
  (test create journeyError-1-false (visibility private) (actual (field (field (call run (record structural (field population (i64 1)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 0)))) (name final)) (name journeyError))) (expected (i64 0)))
  (test create population-1-false (visibility private) (actual (field (field (call run (record structural (field population (i64 1)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 0)))) (name final)) (name population))) (expected (i64 1)))
  (test create massError-1-true (visibility private) (actual (field (field (call run (record structural (field population (i64 1)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 12)))) (name final)) (name massError))) (expected (i64 0)))
  (test create journeyError-1-true (visibility private) (actual (field (field (call run (record structural (field population (i64 1)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 12)))) (name final)) (name journeyError))) (expected (i64 0)))
  (test create population-1-true (visibility private) (actual (field (field (call run (record structural (field population (i64 1)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 12)))) (name final)) (name population))) (expected (i64 1)))
  (test create massError-100003-false (visibility private) (actual (field (field (call run (record structural (field population (i64 100003)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 0)))) (name final)) (name massError))) (expected (i64 0)))
  (test create journeyError-100003-false (visibility private) (actual (field (field (call run (record structural (field population (i64 100003)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 0)))) (name final)) (name journeyError))) (expected (i64 0)))
  (test create population-100003-false (visibility private) (actual (field (field (call run (record structural (field population (i64 100003)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 0)))) (name final)) (name population))) (expected (i64 100003)))
  (test create massError-100003-true (visibility private) (actual (field (field (call run (record structural (field population (i64 100003)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 12)))) (name final)) (name massError))) (expected (i64 0)))
  (test create journeyError-100003-true (visibility private) (actual (field (field (call run (record structural (field population (i64 100003)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 12)))) (name final)) (name journeyError))) (expected (i64 0)))
  (test create population-100003-true (visibility private) (actual (field (field (call run (record structural (field population (i64 100003)) (field groups (i64 4)) (field ticks (i64 12)) (field capacity (i64 3)) (field rail (i64 5)) (field closedFrom (i64 0)) (field closedUntil (i64 12)))) (name final)) (name population))) (expected (i64 100003)))
(component create probe (visibility private) (port create run (type (function (MesoInput) MesoResult)) (function run))))
 (target create meso-benchmark (component mesoprobe::probe) (runner command) (port mesoprobe::probe::run)))
declarations.end
