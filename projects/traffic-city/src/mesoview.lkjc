declarations.begin
(units
 (use std builtin)
 (type-alias MesoCohort (record (id I64) (population I64) (home I64) (queuedOut I64) (outbound I64) (work I64) (queuedBack I64) (inbound I64) (road I64) (rail I64) (travel I64) (requested I64) (arrived I64) (visits I64) (roadTrips I64) (railTrips I64) (waitTicks I64) (travelTicks I64)))
 (type-alias MesoCity (record (cohorts (list MesoCohort)) (tick I64) (population I64)))
 (type-alias MesoTotals (record (tick I64) (groups I64) (population I64) (home I64) (queued I64) (outbound I64) (work I64) (inbound I64) (requested I64) (arrived I64) (outstanding I64) (visits I64) (roadTrips I64) (railTrips I64) (waitTicks I64) (travelTicks I64) (massError I64) (journeyError I64)))
 (type-alias MesoInput (record (population I64) (groups I64) (ticks I64) (capacity I64) (rail I64) (closedFrom I64) (closedUntil I64)))
 (type-alias MesoResult (record (state MesoCity) (initial MesoTotals) (final MesoTotals)))
 (type-alias MesoView (record (x I64) (y I64) (w I64) (h I64)))
 (type-alias MesoRow (list I64))
 (type-alias MesoFrame (record (stats MesoTotals) (view MesoView) (level I64) (drawLimit I64) (rows (list MesoRow))))
 (type-alias MesoViewInput (record (model MesoInput) (view MesoView)))
 (type-alias MesoViewResult (record (frame MesoFrame) (city MesoCity)))
 (module create mesoview
  (function create view (visibility public) (effect pure) (parameter create view (type MesoView)) (returns MesoView)
   (body (let (binding x (call mesomath::min (i64 15) (call mesomath::max (i64 0) (field (local view) (name x))))) (binding y (call mesomath::min (i64 31) (call mesomath::max (i64 0) (field (local view) (name y))))) (in (record structural (field x (local x)) (field y (local y)) (field w (call mesomath::min (call std::subtract (i64 16) (local x)) (call mesomath::max (i64 1) (field (local view) (name w))))) (field h (call mesomath::min (call std::subtract (i64 32) (local y)) (call mesomath::max (i64 1) (field (local view) (name h))))))))))
  (function create visible (visibility public) (effect pure) (parameter create id (type I64)) (parameter create view (type MesoView)) (returns Bool)
   (body (let (binding x (call mesomath::mod (local id) (i64 16))) (binding y (call std::divide (local id) (i64 16))) (in (if (call std::less-equal (field (local view) (name x)) (local x)) (if (call std::less (local x) (call std::add (field (local view) (name x)) (field (local view) (name w)))) (if (call std::less-equal (field (local view) (name y)) (local y)) (call std::less (local y) (call std::add (field (local view) (name y)) (field (local view) (name h)))) (bool false)) (bool false)) (bool false))))))
  (function create rows (visibility public) (effect pure) (parameter create cohorts (type (list MesoCohort))) (parameter create view (type MesoView)) (parameter create index (type I64)) (parameter create out (type (list MesoRow))) (returns (list MesoRow))
   (body (if (call std::less (local index) (call std::list-length (types MesoCohort) (local cohorts))) (let (binding c (call std::list-get (types MesoCohort) (local cohorts) (local index))) (in (call rows (local cohorts) (local view) (call std::add (local index) (i64 1)) (if (call visible (field (local c) (name id)) (local view)) (call std::list-append (types MesoRow) (local out) (list I64 (field (local c) (name id)) (field (local c) (name population)) (field (local c) (name home)) (field (local c) (name queuedOut)) (field (local c) (name outbound)) (field (local c) (name work)) (field (local c) (name queuedBack)) (field (local c) (name inbound)) (field (local c) (name road)) (field (local c) (name rail)) (field (local c) (name travel)))) (local out))))) (local out))))
  (function create frame (visibility public) (effect pure) (parameter create city (type MesoCity)) (parameter create requested (type MesoView)) (returns MesoFrame)
   (body (let (binding view (call view (local requested))) (binding area (call std::multiply (field (local view) (name w)) (field (local view) (name h)))) (binding level (if (call std::less-equal (local area) (i64 16)) (i64 2) (if (call std::less-equal (local area) (i64 96)) (i64 1) (i64 0)))) (in (record structural (field stats (call mesoprobe::totals (local city))) (field view (local view)) (field level (local level)) (field drawLimit (if (call std::i64-equal (local level) (i64 2)) (i64 1536) (if (call std::i64-equal (local level) (i64 1)) (i64 640) (i64 256)))) (field rows (call rows (field (local city) (name cohorts)) (local view) (i64 0) (list MesoRow))))))))
  (function create run (visibility public) (effect pure) (parameter create input (type MesoViewInput)) (returns MesoViewResult)
   (body (let (binding result (call mesoprobe::run (field (local input) (name model)))) (in (record structural (field frame (call frame (field (local result) (name state)) (field (local input) (name view)))) (field city (field (local result) (name state))))))))
  (test create viewport-0 (visibility private) (actual (call visible (i64 0) (record structural (field x (i64 0)) (field y (i64 0)) (field w (i64 1)) (field h (i64 1))))) (expected (bool true)))
  (test create viewport-16 (visibility private) (actual (call visible (i64 16) (record structural (field x (i64 0)) (field y (i64 0)) (field w (i64 1)) (field h (i64 1))))) (expected (bool false)))
  (test create viewport-255 (visibility private) (actual (call visible (i64 255) (record structural (field x (i64 15)) (field y (i64 15)) (field w (i64 1)) (field h (i64 1))))) (expected (bool true)))
  (test create viewport-256 (visibility private) (actual (call visible (i64 256) (record structural (field x (i64 0)) (field y (i64 16)) (field w (i64 1)) (field h (i64 1))))) (expected (bool true)))
  (test create viewport-17 (visibility private) (actual (call visible (i64 17) (record structural (field x (i64 0)) (field y (i64 0)) (field w (i64 1)) (field h (i64 1))))) (expected (bool false)))
(component create projection (visibility private) (port create run (type (function (MesoViewInput) MesoViewResult)) (function run))))
 (target create meso-view (component mesoview::projection) (runner command) (port mesoview::projection::run)))
declarations.end
