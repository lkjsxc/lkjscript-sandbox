field cancelled (field (local result) (name cancelled)))))) (local result))))) (local result))))
  (function create resolve-cycles (visibility public) (effect pure) (parameter create world (type World)) (parameter create sim (type Sim)) (returns Sim)
   (body (if (call std::i64-equal (call game::mod (field (local sim) (name tick)) (i64 16)) (i64 0)) (let (binding facts (call people::facts (local world) (field (local sim) (name agents)) (field (local sim) (name ids)) (i64 0) (record structural (field occ (map I64 I64)) (field heads (map I64 I64)) (field headReady (map I64 I64)) (field busy (map I64 I64)) (field q (map I64 I64)) (field walkq (map I64 I64)) (field inside (map I64 I64)) (field employment (map I64 I64)) (field waiting (i64 0)) (field disconnected (i64 0)) (field moving (i64 0))))) (binding deps (call cycle-dependencies (local world) (local sim) (local facts) (i64 0) (map I64 I64))) (binding scan (call cycle-scan (field (local sim) (name ids)) (local deps) (i64 0) (record structural (field done (map I64 I64)) (field members (map I64 I64))))) (in (call cycle-rotate (local world) (local sim) (field (local scan) (name members)) (i64 0) (local sim)))) (local sim))))
)
