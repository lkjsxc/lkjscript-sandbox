declarations.begin
(units
 (use std builtin)
 (type-alias Numbers (map I64 I64))
 (type-alias Pair (record (key I64) (value I64)))
 (type-alias Route (record (path (list I64)) (cost I64) (version I64) (origin I64) (dest I64) (mode I64)))
 (type-alias Routes (map I64 Route))
 (type-alias RoutePair (record (key I64) (value Route)))
 (type-alias World (record (tiles Numbers) (ids (list I64)) (homes (list I64)) (jobs (list I64)) (shops (list I64)) (parks (list I64)) (junctions Numbers) (signals Numbers) (overview (list I64)) (version I64)))
 (type-alias Resident (record (id I64) (home I64) (job I64) (dest I64) (purpose I64) (cycle I64) (state I64) (cell I64) (from I64) (to I64) (step I64) (route I64) (mode I64) (prior I64) (dir I64) (lane I64) (slot I64) (elapsed I64) (duration I64) (wait I64) (ready I64) (departed I64) (etaWalk I64) (etaCar I64) (eta I64) (journeys I64) (lastTime I64) (reason I64) (exitKey I64) (zone I64) (mask I64)))
 (type-alias Residents (map I64 Resident))
 (type-alias ResidentPair (record (key I64) (value Resident)))
 (type-alias RailLine (record (id I64) (a I64) (b I64) (from I64) (to I64) (elapsed I64) (duration I64) (dwell I64) (status I64) (cost I64) (capacity I64) (rideTicks I64) (departures I64) (boardings I64) (spent I64) (enabled Bool) (queueA (list I64)) (queueB (list I64)) (passengers (list I64)) (path (list I64)) (stops (list I64)) (queues Buckets) (direction I64)))
 (type-alias RailLines (map I64 RailLine))
 (type-alias RailPlan (record (line I64) (board I64) (alight I64) (accessRoute I64) (egressRoute I64) (stage I64) (eta I64)))
 (type-alias RailPlans (map I64 RailPlan))
 (type-alias Transit (record (lines RailLines) (ids (list I64)) (nextId I64) (plans RailPlans) (choices Numbers) (boardings I64) (completed I64) (spent I64) (tracks Numbers)))
 (type-alias RailSearch (record (plan Plan) (choice RailPlan) (complete Bool)))
 (type-alias RailBatch (record (transit Transit) (agents Residents) (queue (list I64)) (passengers (list I64)) (count I64)))
 (type-alias Sim (record (agents Residents) (ids (list I64)) (routes Routes) (lookup Numbers) (nextRoute I64) (nextId I64) (q Numbers) (walkq Numbers) (flow Numbers) (inside Numbers) (employment Numbers) (transit Transit) (tick I64) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (population I64) (waiting I64) (disconnected I64) (moving I64) (healthy I64) (born I64) (removed I64) (cancelled I64)))
 (type-alias City (record (world World) (sim Sim) (cash I64) (level I64) (permits I64) (paused Bool) (milestone I64) (originX I64) (originY I64) (economy Economy)))
 (type-alias Command (record (op Text) (x I64) (y I64) (x2 I64) (y2 I64) (kind I64)))
 (type-alias Outcome (record (city City) (notice Text)))
 (type-alias EditQuote (record (id I64) (version I64) (x I64) (y I64) (x2 I64) (y2 I64) (tiles I64) (homes I64) (moveouts I64) (relocated I64) (cancelled I64) (refund I64) (rails I64) (valid Bool)))
 (type-alias Removal (record (tiles Numbers) (signals Numbers) (selected Numbers) (count I64) (homes I64) (refund I64) (rails I64) (railIds Numbers) (tracks Numbers)))
 (type-alias Relocation (record (agents Residents) (ids (list I64)) (moveouts I64) (relocated I64) (cancelled I64)))
 (type-alias Buckets (map I64 (list I64)))
 (type-alias Axis (record (columns Numbers) (rows Numbers)))
 (type-alias Search (record (hx Numbers) (hy Numbers) (buckets Buckets) (dist Numbers) (parent Numbers) (pending I64)))
 (type-alias CycleScan (record (done Numbers) (members Numbers)))
 (type-alias Facts (record (occ Numbers) (heads Numbers) (headReady Numbers) (busy Numbers) (q Numbers) (walkq Numbers) (inside Numbers) (employment Numbers) (waiting I64) (disconnected I64) (moving I64)))
 (type-alias Move (record (agents Residents) (routes Routes) (lookup Numbers) (nextRoute I64) (occ Numbers) (busy Numbers) (flow Numbers) (inside Numbers) (budget I64) (cash I64) (transit Transit) (requested I64) (arrived I64) (visits I64) (workVisits I64) (shopVisits I64) (leisureVisits I64) (walkTrips I64) (carTrips I64) (waitTicks I64) (travelTicks I64) (totalDuration I64) (income I64)))
 (type-alias Plan (record (routes Routes) (lookup Numbers) (nextRoute I64) (budget I64) (id I64)))
 (type-alias Economy (record (wallets Numbers) (firms Numbers) (active Bool) (opening I64) (grants I64) (exports I64) (salvage I64) (construction I64) (operating I64) (withdrawn I64) (households I64) (businesses I64) (wages I64) (sales I64) (taxes I64) (fares I64) (concessions I64) (upkeepDue I64) (periodTaxes I64) (periodFares I64) (periodOperating I64) (lastTaxes I64) (lastFares I64) (lastOperating I64)))
 (type-alias RailPair (record (board I64) (alight I64) (estimate I64)))
 (type-alias TrackBuild (record (tiles Numbers) (cost I64) (valid Bool)))
 (module create cycles
  (function create cycle-next (visibility public) (effect pure) (parameter create world (type World)) (parameter create sim (type Sim)) (parameter create f (type Facts)) (parameter create r (type Resident)) (returns I64)
   (body (if (call std::bool-and (call std::i64-equal (field (local r) (name state)) (i64 2)) (call std::bool-and (call std::i64-equal (field (local r) (name mode)) (i64 2)) (call std::bool-and (call std::less-equal (field (local r) (name duration)) (field (local r) (name elapsed))) (call std::bool-and (call std::less-equal (i64 8) (field (local r) (name wait))) (call std::bool-and (call std::i64-equal (field (local r) (name exitKey)) (i64 0)) (call std::bool-and (call game::road (call game::get (field (local world) (name tiles)) (field (local r) (name cell)))) (call std::bool-and (call std::i64-equal (call game::get (field (local world) (name junctions)) (field (local r) (name cell))) (i64 0)) (call std::i64-equal (call game::get (field (local f) (name heads)) (call people::resident-lane (local r))) (field (local r) (name id)))))))))) (let (binding route (call game::route (field (local sim) (name routes)) (field (local r) (name route)))) (binding step (call std::add (field (local r) (name step)) (i64 1))) (in (if (call std::less (local step) (call std::list-length (types I64) (field (local route) (name path)))) (let (binding next (call std::list-get (types I64) (field (local route) (name path)) (local step))) (binding kind (call game::get (field (local world) (name tiles)) (local next))) (binding key (call game::lane-key (local next) (call game::direction (field (local r) (name cell)) (local next)) (call game::lane (local kind) (field (local r) (name id))))) (in (if (call std::bool-and (call game::road (local kind)) (call std::bool-and (call std::i64-equal (call game::manhattan (field (local r) (name cell)) (local next)) (i64 1)) (call std::bool-and (call std::i64-equal (call game::get (field (local world) (name junctions)) (local next)) (i64 0)) (call std::i64-equal (call game::get (field (local f) (name occ)) (local key)) (i64 3))))) (call game::get (field (local f) (name heads)) (local key)) (i64 0)))) (i64 0)))) (i64 0))))
  (function create cycle-dependencies (visibility public) (effect pure) (parameter create world (type World)) (parameter create sim (type Sim)) (parameter create f (type Facts)) (parameter create index (type I64)) (parameter create deps (type Numbers)) (returns Numbers)
   (body (if (call std::less (local index) (call std::list-length (types I64) (field (local sim) (name ids)))) (let (binding id (call std::list-get (types I64) (field (local sim) (name ids)) (local index))) (binding next (call cycle-next (local world) (local sim) (local f) (call game::agent (field (local sim) (name agents)) (local id)))) (in (call cycle-dependencies (local world) (local sim) (local f) (call std::add (local index) (i64 1)) (if (call std::less (i64 0) (local next)) (call game::put (local deps) (local id) (local next)) (local deps))))) (local deps))))
  (function create cycle-mark (visibility public) (effect pure) (parameter create ids (type (list I64))) (parameter create index (type I64)) (parameter create marked (type Numbers)) (returns Numbers)
   (body (if (call std::less (local index) (call std::list-length (types I64) (local ids))) (call cycle-mark (local ids) (call std::add (local index) (i64 1)) (call game::put (local marked) (call std::list-get (types I64) (local ids) (local index)) (i64 1))) (local marked))))
  (function create cycle-walk (visibility public) (effect pure) (parameter create deps (type Numbers)) (parameter create id (type I64)) (parameter create path (type (list I64))) (parameter create positions (type Numbers)) (parameter create scan (type CycleScan)) (returns CycleScan)
   (body (let (binding position (call game::get (local positions) (local id))) (in (if (call std::less (i64 0) (local position)) (record structural (field done (call cycle-mark (local path) (i64 0) (field (local scan) (name done)))) (field members (call cycle-mark (local path) (call std::subtract (local position) (i64 1)) (field (local scan) (name members))))) (if (call std::bool-or (call std::i64-equal (call game::get (local deps) (local id)) (i64 0)) (call std::less (i64 0) (call game::get (field (local scan) (name done)) (local id)))) (record structural (field done (call cycle-mark (local path) (i64 0) (field (local scan) (name done)))) (field members (field (local scan) (name members)))) (call cycle-walk (local deps) (call game::get (local deps) (local id)) (call std::list-append (types I64) (local path) (local id)) (call game::put (local positions) (local id) (call std::add (call std::list-length (types I64) (local path)) (i64 1))) (local scan))))))))
  (function create cycle-scan (visibility public) (effect pure) (parameter create ids (type (list I64))) (parameter create deps (type Numbers)) (parameter create index (type I64)) (parameter create scan (type CycleScan)) (returns CycleScan)
   (body (if (call std::less (local index) (call std::list-length (types I64) (local ids))) (let (binding id (call std::list-get (types I64) (local ids) (local index))) (in (call cycle-scan (local ids) (local deps) (call std::add (local index) (i64 1)) (if (call std::bool-and (call std::less (i64 0) (call game::get (local deps) (local id))) (call std::i64-equal (call game::get (field (local scan) (name done)) (local id)) (i64 0))) (call cycle-walk (local deps) (local id) (list I64) (map I64 I64) (local scan)) (local scan))))) (local scan))))
  (function create cycle-rotate (visibility public) (effect pure) (parameter create world (type World)) (parameter create original (type Sim)) (parameter create members (type Numbers)) (parameter create index (type I64)) (parameter create result (type Sim)) (returns Sim)
   (body (if (call std::less (local index) (call std::list-length (types I64) (field (local original) (name ids)))) (let (binding id (call std::list-get (types I64) (field (local original) (name ids)) (local index))) (binding r (call game::agent (field (local original) (name agents)) (local id))) (in (call cycle-rotate (local world) (local original) (local members) (call std::add (local index) (i64 1)) (if (call std::less (i64 0) (call game::get (local members) (local id))) (let (binding route (call game::route (field (local original) (name routes)) (field (local r) (name route)))) (binding step (call std::add (field (local r) (name step)) (i64 1))) (binding next (call std::list-get (types I64) (field (local route) (name path)) (local step))) (in (record structural (field agents (call std::map-insert (types I64 Resident) (field (local result) (name agents)) (local id) (record structural (field id (field (local r) (name id))) (field home (field (local r) (name home))) (field job (field (local r) (name job))) (field dest (field (local r) (name dest))) (field purpose (field (local r) (name purpose))) (field cycle (field (local r) (name cycle))) (field state (field (local r) (name state))) (field cell (local next)) (field from (field (local r) (name cell))) (field to (local next)) (field step (local step)) (field route (field (local r) (name route))) (field mode (field (local r) (name mode))) (field prior (field (local r) (name dir))) (field dir (call game::direction (field (local r) (name cell)) (local next))) (field lane (call game::lane (call game::get (field (local world) (name tiles)) (local next)) (local id))) (field slot (i64 2)) (field elapsed (i64 0)) (field duration (call game::edge-time (local world) (local next) (i64 2))) (field wait (i64 0)) (field ready (field (local original) (name tick))) (field departed (field (local r) (name departed))) (field etaWalk (field (local r) (name etaWalk))) (field etaCar (field (local r) (name etaCar))) (field eta (field (lo